---
import SectionHeader from '../primitives/SectionHeader.astro';

const mapLat = '55.795720635738';
const mapLon = '49.128799438477';
const mapAddress = 'Казань, ул. Карла Маркса, 48, корп. 1';
const mapWidgetSrc = `https://yandex.ru/map-widget/v1/?ll=${mapLon}%2C${mapLat}&mode=search&ol=geo&ouri=ymapsbm1%3A%2F%2Fgeo%3Fdata%3DCgozODkyNjQyNzkxEknQoNC-0YHRgdC40Y8sINCa0LDQt9Cw0L3RjCwg0YPQu9C40YbQsCDQmtCw0YDQutC70LAg0JzQsNGA0LrRgdCwLCA0OCDQutC-0YDQv9GD0YEgMSIKDbULVkIVwe1C&pt=${mapLon}%2C${mapLat}%2Cpm2rdm&z=17`;

const items = [
  {
    label: 'Адрес',
    value: 'ул. Карла Маркса, 48, корп. 1<br/>Казань, 420015',
  },
  {
    label: 'Телефон',
    value: '<a href="tel:+78432236666">+7 843 223-66-66</a>',
  },
  {
    label: 'Мессенджеры',
    // TODO(wa-number): подтвердить, какой из двух номеров (+7 843 223-66-66 vs 236-66-66) подключён к WhatsApp — сейчас в ссылке использован первый.
    value: '<a href="https://wa.me/78432236666" target="_blank" rel="noopener">WhatsApp</a>&ensp;·&ensp;<a href="https://max.ru/" target="_blank" rel="noopener">Max</a>&ensp;·&ensp;<a href="https://t.me/platinental_kazan" target="_blank" rel="noopener">Telegram</a>&ensp;·&ensp;<a href="https://instagram.com/platinental_kazan" target="_blank" rel="noopener">Instagram</a><sup class="contact__star">*</sup>',
  },
  {
    label: 'Режим работы',
    value: 'Ежедневно 9:00–20:00',
  },
];
---

<section class="contacts" id="contacts" aria-label="Контакты">
  <div class="contacts__inner">
    <SectionHeader title="Контакты" />

    <div class="contacts__grid">
      <dl class="contacts__list">
        {items.map((item, i) => (
          <div class="contact" data-reveal style={`transition-delay: ${i * 80}ms`}>
            <dt class="contact__label">{item.label}</dt>
            <dd class="contact__value" set:html={item.value} />
          </div>
        ))}
      </dl>

      <div class="contacts__map" data-reveal aria-label="Карта расположения клиники">
        <div class="contacts__map-placeholder" aria-hidden="true">
          <span class="contacts__map-label">Яндекс.Карта</span>
          <span class="contacts__map-point"></span>
        </div>
        <iframe
          title="Карта The Platinental Казань"
          class="contacts__map-iframe"
          data-map-src={mapWidgetSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <a
          href={`https://yandex.ru/maps/?ll=${mapLon}%2C${mapLat}&mode=search&pt=${mapLon},${mapLat}&text=${encodeURIComponent(mapAddress)}&z=17`}
          target="_blank"
          rel="noopener"
          class="contacts__map-link"
        >
          Открыть карту →
        </a>
      </div>
    </div>

    <p class="contacts__foot-note">
      <span aria-hidden="true">*</span> Instagram принадлежит компании Meta, признанной экстремистской и запрещённой на территории РФ.
    </p>
  </div>
</section>

<style>
  .contacts {
    background: var(--surface-page);
    padding: var(--space-32) 0;
  }

  @media (min-width: 1024px) { .contacts { padding: var(--space-40) 0; } }

  .contacts__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 768px) { .contacts__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .contacts__inner { padding: 0 48px; } }

  .contacts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 1024px) {
    .contacts__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-16);
      align-items: start;
    }
  }

  .contacts__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 560px) {
    .contacts__list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .contacts__list { grid-template-columns: 1fr; gap: var(--space-8); }
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .contact__label {
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .contact__value {
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--text-primary);
  }

  .contact__value :global(a) {
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .contact__value :global(a:hover) {
    border-bottom-color: var(--text-primary);
  }

  .contact__value :global(.contact__star) {
    font-size: 0.75em;
    color: var(--text-muted);
    vertical-align: super;
    margin-left: 2px;
    border: none;
  }

  .contacts__foot-note {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 72ch;
  }

  .contacts__map {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--color-cream-100);
  }

  .contacts__map-placeholder {
    position: relative;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background:
      linear-gradient(rgba(10,10,10,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(10,10,10,0.05) 1px, transparent 1px),
      linear-gradient(160deg, var(--color-sand-200) 0%, var(--color-cream-100) 100%);
    background-size: 2.25rem 2.25rem, 2.25rem 2.25rem, auto;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .contacts__map-label {
    font-family: var(--font-display);
    font-size: var(--text-lead);
    color: var(--text-primary);
  }

  .contacts__map-coords {
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .contacts__map-point {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    background: var(--color-champagne-500, #C4A882);
    box-shadow: 0 0 0 0.75rem rgba(196,168,130,0.18);
  }
  .contacts__map-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out);
  }
  .contacts__map.is-ready .contacts__map-iframe { opacity: 1; }
  .contacts__map.is-ready .contacts__map-placeholder { opacity: 0; pointer-events: none; }
  .contacts__map-link {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.92);
    text-decoration: none;
    color: var(--text-primary);
    font-size: var(--text-caption);
    letter-spacing: 0.04em;
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('.contacts__map');
    const iframe = root?.querySelector('.contacts__map-iframe');
    if (!root || !iframe || !(iframe instanceof HTMLIFrameElement)) return;

    const loadMap = () => {
      if (iframe.src) return;
      const src = iframe.dataset.mapSrc;
      if (!src) return;
      iframe.src = src;
      iframe.addEventListener('load', () => root.classList.add('is-ready'), { once: true });
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          loadMap();
          io.disconnect();
        }
      }, { rootMargin: '240px 0px' });
      io.observe(root);
    } else {
      loadMap();
    }
  })();
</script>
