---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import clinicReception from '../../assets/photos/clinic-reception.webp';

const pills = ['Пластическая хирургия', 'Косметология', 'Космецевтика'];
---

<BaseLayout
  title="The Platinental — Liquid Opal Hero"
  description="Демо hero главной в стиле hybrid premium liquid glass для The Platinental Казань."
  canonical="https://kzn.platinental.ru/concept/liquid-opal-hero"
  darkHero={false}
>
  <section class="opal-hero" aria-labelledby="opal-hero-heading">
    <div class="opal-shell">
      <div class="opal-copy" data-reveal>
        <p class="opal-kicker">Hero demo · Hybrid premium liquid glass</p>
        <div class="opal-pill-row" aria-label="Направления клиники">
          {pills.map((pill) => <span class="opal-pill">{pill}</span>)}
        </div>
        <h1 id="opal-hero-heading" class="opal-title">
          Эстетическая хирургия
          в новой светлой
          digital-эстетике
        </h1>
        <p class="opal-lead">
          Центральная композиция, холодный перламутровый свет и сдержанный liquid glass
          вместо тяжёлого премиального драматизма. Этот hero нужен как точка согласования
          нового визуального языка главной.
        </p>
      </div>

      <div class="opal-stage" data-reveal>
        <div class="opal-glow opal-glow-left" aria-hidden="true"></div>
        <div class="opal-glow opal-glow-right" aria-hidden="true"></div>
        <div class="opal-glow opal-glow-center" aria-hidden="true"></div>

        <div class="opal-main-card">
          <div class="opal-media-shell">
            <Image
              src={clinicReception}
              alt="Reception-зона клиники The Platinental в светлом modern premium стиле"
              width={1200}
              height={1500}
              class="opal-image"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <div class="glass-panel glass-panel-top">
            <span class="glass-label">Liquid glass accent</span>
            <strong>Светлый premium без визуальной тяжести</strong>
          </div>

          <div class="glass-panel glass-panel-side">
            <span class="glass-stat">01</span>
            <p>Glass используется только в ключевых вторичных слоях: status-panel, chips и CTA-shell.</p>
          </div>

          <div class="glass-chip-strip">
            <span>Private clinic</span>
            <span>Kazan</span>
            <span>Light-tech premium</span>
          </div>

          <div class="glass-cta-shell">
            <a href="#contact" class="opal-button opal-button-primary">Записаться на консультацию</a>
            <a href="/prices" class="opal-button opal-button-secondary">Узнать стоимость</a>
          </div>
        </div>
      </div>

      <div class="opal-footnote" data-reveal>
        <div class="opal-footnote-grid">
          <div>
            <span class="opal-meta-label">Palette</span>
            <p>Cool pearl · icy blue · muted opal · deep slate</p>
          </div>
          <div>
            <span class="opal-meta-label">Type</span>
            <p>Prata для display, Manrope для UI и body</p>
          </div>
          <div>
            <span class="opal-meta-label">Composition</span>
            <p>Hero строится вокруг центрального visual core, а не split-screen сетки</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Prata&family=Manrope:wght@400;500;600;700&display=swap&subset=cyrillic');

  .opal-hero {
    min-height: 100dvh;
    padding: calc(var(--nav-height) + 32px) 0 56px;
    background:
      radial-gradient(circle at 18% 14%, rgba(214, 236, 251, 0.82), transparent 26%),
      radial-gradient(circle at 82% 12%, rgba(203, 226, 245, 0.72), transparent 30%),
      linear-gradient(180deg, #fcfeff 0%, #f3f8fc 46%, #eff4f8 100%);
    color: #20303a;
    overflow: hidden;
  }

  .opal-shell {
    width: min(1280px, calc(100% - 40px));
    margin: 0 auto;
    display: grid;
    gap: 22px;
  }

  .opal-copy {
    max-width: 840px;
    margin: 0 auto;
    text-align: center;
  }

  .opal-kicker,
  .opal-pill,
  .glass-label,
  .opal-meta-label {
    font-family: 'Manrope', var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .opal-kicker {
    color: rgba(32, 48, 58, 0.54);
    margin: 0;
  }

  .opal-pill-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 0;
  }

  .opal-pill {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 14px;
    color: rgba(24, 46, 61, 0.76);
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    background: linear-gradient(180deg, rgba(255,255,255,0.68), rgba(255,255,255,0.32));
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.68),
      0 12px 30px rgba(94, 129, 155, 0.12);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
  }

  .opal-title {
    margin: 20px auto 0;
    max-width: 11.8ch;
    font-family: 'Prata', var(--font-display);
    font-size: clamp(3.2rem, 5.3vw, 5.8rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: #20303a;
    text-wrap: balance;
  }

  .opal-lead {
    max-width: 58ch;
    margin: 18px auto 0;
    font-family: 'Manrope', var(--font-body);
    font-size: clamp(1rem, 1vw, 1.08rem);
    line-height: 1.72;
    color: rgba(32, 48, 58, 0.72);
  }

  .opal-stage {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
    min-height: 690px;
    display: grid;
    align-items: center;
  }

  .opal-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(40px);
    pointer-events: none;
  }

  .opal-glow-left {
    left: 7%;
    top: 14%;
    width: 220px;
    height: 220px;
    background: rgba(166, 213, 242, 0.34);
  }

  .opal-glow-right {
    right: 6%;
    bottom: 14%;
    width: 260px;
    height: 260px;
    background: rgba(194, 223, 241, 0.42);
  }

  .opal-glow-center {
    left: 50%;
    top: 16%;
    width: 420px;
    height: 180px;
    transform: translateX(-50%);
    background: rgba(227, 240, 250, 0.48);
  }

  .opal-main-card {
    position: relative;
    width: min(100%, 980px);
    margin: 0 auto;
    border-radius: 42px;
    padding: 18px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.62), rgba(255,255,255,0.26));
    border: 1px solid rgba(255,255,255,0.46);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.66),
      0 40px 90px rgba(86, 123, 151, 0.16);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
  }

  .opal-main-card::before {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: 34px;
    border: 1px solid rgba(255,255,255,0.28);
    pointer-events: none;
  }

  .opal-media-shell {
    position: relative;
    border-radius: 30px;
    overflow: hidden;
    background: rgba(255,255,255,0.38);
    min-height: 590px;
  }

  .opal-image {
    width: 100%;
    height: 100%;
    min-height: 590px;
    object-fit: cover;
    object-position: center center;
    display: block;
    filter: saturate(0.92) contrast(1.03) brightness(1.04);
  }

  .glass-panel,
  .glass-cta-shell {
    position: absolute;
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.58), rgba(255,255,255,0.22));
    border: 1px solid rgba(255,255,255,0.5);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.7),
      0 24px 54px rgba(83, 113, 138, 0.16);
  }

  .glass-panel-top {
    left: 50%;
    top: 20px;
    transform: translateX(-50%);
    width: min(420px, calc(100% - 90px));
    border-radius: 24px;
    padding: 16px 18px;
    text-align: center;
  }

  .glass-label {
    color: rgba(28, 55, 72, 0.56);
  }

  .glass-panel-top strong {
    display: block;
    margin-top: 8px;
    font-family: 'Prata', var(--font-display);
    font-size: clamp(1.35rem, 1.8vw, 1.8rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #1c3442;
  }

  .glass-panel-side {
    right: 24px;
    bottom: 112px;
    width: min(280px, calc(100% - 60px));
    border-radius: 24px;
    padding: 16px;
    color: rgba(28, 52, 66, 0.78);
  }

  .glass-stat {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: rgba(255,255,255,0.48);
    border: 1px solid rgba(255,255,255,0.54);
    font-family: 'Manrope', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #1d3a4a;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.7);
  }

  .glass-panel-side p {
    margin: 12px 0 0;
    font-family: 'Manrope', sans-serif;
    font-size: 0.92rem;
    line-height: 1.58;
  }

  .glass-chip-strip {
    position: absolute;
    left: 26px;
    bottom: 116px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 46%;
  }

  .glass-chip-strip span {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    font-family: 'Manrope', sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(29, 58, 74, 0.72);
    backdrop-filter: blur(22px) saturate(155%);
    -webkit-backdrop-filter: blur(22px) saturate(155%);
    background: linear-gradient(180deg, rgba(255,255,255,0.56), rgba(255,255,255,0.22));
    border: 1px solid rgba(255,255,255,0.46);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.68),
      0 14px 32px rgba(83, 113, 138, 0.12);
  }

  .glass-cta-shell {
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px;
    border-radius: 999px;
  }

  .opal-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 999px;
    font-family: 'Manrope', var(--font-body);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .opal-button:hover {
    transform: translateY(-1px);
  }

  .opal-button-primary {
    background: linear-gradient(180deg, #23465a, #173848);
    color: #f6fbff;
    box-shadow: 0 12px 28px rgba(35, 70, 90, 0.24);
  }

  .opal-button-secondary {
    color: #24485d;
    background: rgba(255,255,255,0.4);
    border: 1px solid rgba(255,255,255,0.5);
  }

  .opal-footnote {
    max-width: 1080px;
    margin: 0 auto 0;
  }

  .opal-footnote-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .opal-footnote-grid > div {
    min-height: 120px;
    padding: 18px;
    border-radius: 24px;
    background: rgba(255,255,255,0.58);
    border: 1px solid rgba(255,255,255,0.42);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.66),
      0 20px 46px rgba(86, 123, 151, 0.08);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
  }

  .opal-meta-label {
    color: rgba(28, 55, 72, 0.55);
  }

  .opal-footnote-grid p {
    margin: 12px 0 0;
    font-family: 'Manrope', sans-serif;
    font-size: 0.96rem;
    line-height: 1.6;
    color: rgba(32, 48, 58, 0.78);
  }

  @media (max-width: 1024px) {
    .opal-stage {
      min-height: auto;
    }

    .opal-main-card {
      width: 100%;
    }

    .opal-media-shell,
    .opal-image {
      min-height: 520px;
    }

    .opal-footnote-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .opal-hero {
      padding-top: calc(var(--nav-height-mobile) + 28px);
      padding-bottom: 44px;
    }

    .opal-shell {
      width: min(100% - 24px, 1280px);
      gap: 24px;
    }

    .opal-title {
      max-width: 11ch;
      font-size: clamp(2.45rem, 10vw, 3.5rem);
    }

    .opal-lead {
      max-width: none;
    }

    .opal-main-card {
      padding: 14px;
      border-radius: 28px;
    }

    .opal-main-card::before {
      inset: 8px;
      border-radius: 20px;
    }

    .opal-media-shell {
      min-height: 470px;
      border-radius: 20px;
    }

    .opal-image {
      min-height: 470px;
    }

    .glass-panel-top {
      top: 14px;
      width: calc(100% - 28px);
      border-radius: 20px;
      padding: 14px 16px;
    }

    .glass-panel-side {
      right: 14px;
      left: 14px;
      width: auto;
      bottom: 126px;
      border-radius: 22px;
      padding: 14px;
    }

    .glass-chip-strip {
      left: 14px;
      right: 14px;
      bottom: 88px;
      max-width: none;
      gap: 8px;
    }

    .glass-chip-strip span {
      min-height: 34px;
      font-size: 0.7rem;
    }

    .glass-cta-shell {
      left: 14px;
      right: 14px;
      bottom: 14px;
      transform: none;
      border-radius: 24px;
      padding: 10px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .opal-button {
      width: 100%;
    }
  }
</style>
