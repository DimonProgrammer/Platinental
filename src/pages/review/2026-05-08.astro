  'легкомысленные метафоры про премиальность',
  'каталожная риторика про результат',
  'шутливые формулировки про операции',
  'общеклиническая авторская риторика',
  'неподтверждённый статус патента',
  'неподтверждённые аппараты',
  'неподтверждённые публичные роли',
];

const reviewPages = [
  {
    url: '/',
    title: 'Главная',
    call705: [
      'Тон стал спокойнее и медицински точнее: акцент на анатомии, пропорциях, показаниях и плане пациента.',
