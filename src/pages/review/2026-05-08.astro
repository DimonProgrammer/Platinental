---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Navigation from '../../components/site/sections/Navigation.astro';
import Footer from '../../components/site/sections/Footer.astro';

const deployedAt = '8 мая 2026';

const routes = [
  { href: '/', label: 'Главная' },
  { href: '/plastika', label: 'Пластика' },
  { href: '/kosmetologiya', label: 'Косметология' },
  { href: '/about', label: 'О клинике' },
  { href: '/doctors', label: 'Врачи' },
  { href: '/prices', label: 'Цены' },
  { href: '/contacts', label: 'Контакты' },
  { href: '/documents', label: 'Документы' },
  { href: '/kosmecevtika', label: 'Космецевтика' },
];

