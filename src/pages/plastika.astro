---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/primitives/Button.astro';
import SectionHeader from '../components/primitives/SectionHeader.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import FAQ from '../components/sections/FAQ.astro';
import Contacts from '../components/sections/Contacts.astro';
import { plastikaOps } from '../data/plastika';
import { doctors } from '../data/doctors';

const faceOps = plastikaOps.filter((o) => o.category === 'face');
const bodyOps = plastikaOps.filter((o) => o.category === 'body');

// surgeons for plastika (exclude cosmetologist, all plastika)
const surgeons = doctors.filter((d) => d.tags.includes('plastika'));
---

<BaseLayout
  title="Пластическая хирургия в Казани — клиника Platinental"
  description="27 операций пластической хирургии: ринопластика от 200 000 ₽, маммопластика от 450 000 ₽, блефаропластика от 60 000 ₽. 7 пластических хирургов, ASPS/ISAPS. Казань, запись +7 843 223-66-66."
  canonical="https://kzn.platinental.ru/plastika"
  darkHero={true}
>
  <!-- Hero -->
  <section class="p-hero" aria-labelledby="p-hero-title">
    <div class="p-hero__inner" data-reveal>
      <span class="eyebrow">THE PLATINENTAL · КАЗАНЬ</span>
      <h1 id="p-hero-title" class="p-hero__title font-display">
        Пластическая хирургия<br/>в&nbsp;Казани&nbsp;— <em>Platinental</em>
      </h1>
      <p class="p-hero__lede">
        Мы&nbsp;не&nbsp;делаем «идеальный нос из&nbsp;каталога» и&nbsp;не&nbsp;«увеличиваем грудь до&nbsp;размера». Platinental работает как&nbsp;дорогое ателье: сначала замеры&nbsp;— потом методика. Цель одна: все заметят изменение, но&nbsp;никто не&nbsp;свяжет его с&nbsp;операцией.
      </p>
      <div class="p-hero__actions">
        <Button href="/#form" variant="primary" size="lg">Записаться на&nbsp;консультацию</Button>
        <Button href="/prices" variant="ghost" size="lg">Цены</Button>
      </div>
    </div>
  </section>

  <!-- Tabs + Operations -->
  <section class="ops" aria-label="Операции пластической хирургии">
    <div class="ops__inner">
      <div class="ops__tabs" role="tablist" aria-label="Категории операций">
        <button type="button" class="ops__tab is-active" data-tab="face" role="tab" aria-selected="true">
          Лицо <span class="ops__count">{faceOps.length}</span>
        </button>
        <button type="button" class="ops__tab" data-tab="body" role="tab" aria-selected="false">
          Тело <span class="ops__count">{bodyOps.length}</span>
        </button>
      </div>

      <div class="ops__panel is-active" data-panel="face" role="tabpanel">
        <div class="ops__grid">
          {faceOps.map((op, i) => (
            <article class="op-card" data-reveal style={`transition-delay: ${Math.min(i * 40, 240)}ms`}>
              <span class="op-card__badge">{op.badge}</span>
              <h3 class="op-card__name font-display">{op.name}</h3>
              <p class="op-card__desc" set:html={op.desc} />
              <div class="op-card__price font-display">{op.price}</div>
              <Button href="/#form" variant="link" arrow={true} class="op-card__cta">Записаться</Button>
            </article>
          ))}
        </div>
      </div>

      <div class="ops__panel" data-panel="body" role="tabpanel">
        <div class="ops__grid">
          {bodyOps.map((op, i) => (
            <article class="op-card" data-reveal style={`transition-delay: ${Math.min(i * 40, 240)}ms`}>
              <span class="op-card__badge">{op.badge}</span>
              <h3 class="op-card__name font-display">{op.name}</h3>
              <p class="op-card__desc" set:html={op.desc} />
              <div class="op-card__price font-display">{op.price}</div>
              <Button href="/#form" variant="link" arrow={true} class="op-card__cta">Записаться</Button>
            </article>
          ))}
        </div>
      </div>

      <p class="ops__disclaimer">
        Цены носят информационный характер и&nbsp;не&nbsp;являются публичной офертой. Точная стоимость определяется врачом на&nbsp;консультации.
      </p>
    </div>
  </section>

  <!-- Dark quote strip -->
  <section class="p-quote" aria-label="Философия клиники">
    <div class="p-quote__inner" data-reveal>
      <blockquote class="p-quote__text font-display">
        «Сделать это&nbsp;так, чтобы все заметили результат, но&nbsp;никто не&nbsp;догадался, что&nbsp;дело в&nbsp;пластике»
      </blockquote>
    </div>
  </section>

  <!-- Surgeons -->
  <section class="surgeons" aria-label="Хирурги направления">
    <div class="surgeons__inner">
      <SectionHeader eyebrow="Команда" title="Хирурги направления" />

      <div class="surgeons__grid">
        {surgeons.map((d, i) => (
          <article class="surgeon-card" data-reveal style={`transition-delay: ${i * 70}ms`}>
            <span class="surgeon-card__badge">{d.spec}</span>
            <h3 class="surgeon-card__name font-display">{d.name}</h3>
            <p class="surgeon-card__price">{d.priceMain}</p>
            <Button href={`/doctors#${d.slug}`} variant="link" arrow={true}>
              Подробнее о&nbsp;враче
            </Button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA errors -->
  <section class="p-cta" aria-label="Приглашение на консультацию">
    <div class="p-cta__inner" data-reveal>
      <h2 class="p-cta__title font-display">Неудачная пластика <em>видна всем</em></h2>
      <p class="p-cta__text">
        Перекачанные губы, несоразмерные скулы, глаза, потерявшие живость&nbsp;— это всегда вопрос эстетического вкуса хирурга, не&nbsp;его рук. Чтобы убедиться, что&nbsp;результат улучшит ваше лицо, а&nbsp;не&nbsp;изменит его до&nbsp;неузнаваемости&nbsp;— начните с&nbsp;детального анализа черт лица. Хирург делает замеры, объясняет что&nbsp;возможно именно в&nbsp;вашем случае.
      </p>
      <Button href="/#form" variant="primary" size="lg">Записаться на&nbsp;консультацию</Button>
      <p class="p-cta__note">Перезвоним в&nbsp;течение часа.</p>
    </div>
  </section>

  <FinalCTA />
  <FAQ />
  <Contacts />
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab ?? 'face';
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      panels.forEach((p) => {
        p.classList.toggle('is-active', p.dataset.panel === target);
      });
    });
  });
</script>

<style>
  /* Hero */
  .p-hero {
    background: var(--surface-page);
    padding: calc(var(--nav-height-mobile) + var(--space-12)) 0 var(--space-16);
    border-bottom: 1px solid var(--border-subtle);
  }
  @media (min-width: 768px) {
    .p-hero { padding: calc(var(--nav-height) + var(--space-16)) 0 var(--space-20); }
  }

  .p-hero__inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 20px;
  }
  @media (min-width: 768px) { .p-hero__inner { padding: 0 32px; } }

  .p-hero__title {
    font-size: clamp(2rem, 1rem + 3vw, 3.5rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-5);
    text-wrap: balance;
    max-width: 24ch;
  }

  .p-hero__title em {
    color: var(--accent-hover);
    font-weight: 300;
  }

  .p-hero__lede {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 64ch;
    margin-bottom: var(--space-8);
  }

  .p-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: center;
  }

  .p-hero__actions :global(.btn--ghost) { color: rgba(255, 255, 255, 0.85); }
  .p-hero__actions :global(.btn--ghost:hover) { color: var(--accent); }

  /* Ops: tabs + grid */
  .ops {
    background: var(--surface-alt);
    padding: var(--space-16) 0 var(--space-20);
  }
  @media (min-width: 1024px) { .ops { padding: var(--space-20) 0 var(--space-24); } }

  .ops__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
  }
  @media (min-width: 768px) { .ops__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .ops__inner { padding: 0 48px; } }

  .ops__tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .ops__tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 40px;
    padding: 0 18px;
    background: transparent;
    border: 1px solid var(--border-soft);
    border-radius: 99px;
    font-family: inherit;
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .ops__tab:hover { border-color: var(--text-primary); color: var(--text-primary); }

  .ops__tab.is-active {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--text-inverse);
  }

  .ops__count {
    font-size: 11px;
    opacity: 0.65;
  }

  .ops__panel { display: none; }
  .ops__panel.is-active { display: block; }

  .ops__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 560px) { .ops__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .ops__grid { grid-template-columns: repeat(3, 1fr); } }

  .op-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-base) var(--ease-out);
  }

  .op-card:hover {
    border-color: var(--border-soft);
    transform: translateY(-2px);
  }

  .op-card__badge {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .op-card__name {
    font-size: var(--text-h5);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
    color: var(--text-primary);
    letter-spacing: var(--tracking-heading);
  }

  .op-card__desc {
    font-size: var(--text-ui);
    line-height: 1.55;
    color: var(--text-muted);
    flex: 1;
  }

  .op-card__price {
    font-size: var(--text-lead);
    font-weight: 300;
    font-style: italic;
    color: var(--accent-hover);
    letter-spacing: 0;
    margin-top: var(--space-2);
  }

  .op-card__cta {
    margin-top: var(--space-2);
    align-self: flex-start;
  }

  .ops__disclaimer {
    margin-top: var(--space-10);
    font-size: var(--text-caption);
    color: var(--text-muted);
    line-height: 1.55;
    max-width: 64ch;
  }

  /* Dark quote strip */
  .p-quote {
    background: var(--surface-inverse);
    color: var(--text-inverse);
    padding: var(--space-16) 0;
    position: relative;
    overflow: hidden;
  }

  .p-quote::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 80% 30%, rgba(196, 168, 130, 0.14), transparent 55%),
      radial-gradient(circle at 20% 80%, rgba(196, 168, 130, 0.06), transparent 45%);
    pointer-events: none;
  }

  .p-quote__inner {
    position: relative;
    max-width: 920px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  @media (min-width: 768px) { .p-quote__inner { padding: 0 32px; } }

  .p-quote__text {
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    line-height: 1.25;
    letter-spacing: var(--tracking-heading);
    color: var(--text-inverse);
    text-wrap: balance;
  }

  /* Surgeons */
  .surgeons {
    background: var(--surface-page);
    padding: var(--space-20) 0;
  }

  @media (min-width: 1024px) { .surgeons { padding: var(--space-24) 0; } }

  .surgeons__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 768px) { .surgeons__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .surgeons__inner { padding: 0 48px; } }

  .surgeons__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 560px) { .surgeons__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .surgeons__grid { grid-template-columns: repeat(3, 1fr); } }

  .surgeon-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--surface-alt);
    border-radius: var(--radius-md);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .surgeon-card:hover { transform: translateY(-2px); }

  .surgeon-card__badge {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-hover);
  }

  .surgeon-card__name {
    font-size: var(--text-h5);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
    color: var(--text-primary);
    letter-spacing: var(--tracking-heading);
  }

  .surgeon-card__price {
    font-size: var(--text-ui);
    color: var(--text-muted);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  /* CTA errors */
  .p-cta {
    background: var(--surface-alt);
    padding: var(--space-20) 0;
  }

  @media (min-width: 1024px) { .p-cta { padding: var(--space-24) 0; } }

  .p-cta__inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .p-cta__title {
    font-size: var(--text-h3);
    font-weight: 400;
    font-style: italic;
    color: var(--text-primary);
    letter-spacing: var(--tracking-display);
    line-height: 1.08;
    text-wrap: balance;
  }

  .p-cta__title em {
    color: var(--accent-hover);
    font-weight: 300;
  }

  .p-cta__text {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 64ch;
  }

  .p-cta__note {
    font-size: var(--text-caption);
    color: var(--text-muted);
  }
</style>
