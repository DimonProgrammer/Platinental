---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/site/sections/Navigation.astro';
import PageHero from '../components/site/sections/PageHero.astro';
import PageLeadMagnet from '../components/site/sections/PageLeadMagnet.astro';
import SurgicalPartnersBlock from '../components/site/sections/SurgicalPartnersBlock.astro';
import FinalCTA from '../components/site/sections/FinalCTA.astro';
import Footer from '../components/site/sections/Footer.astro';
import { priceCategories } from '../data/prices';
import { formatCurrencyPlainText } from '../lib/formatText';

const tabs = priceCategories.map((c) => ({ key: c.key, label: c.label }));
---

<SiteLayout
  title="Прайс-лист — The Platinental Казань"
  description="Цены на пластические операции, косметологические процедуры и консультации врачей клиники The Platinental Казань."
>
  <Navigation />
  <main id="main">
    <PageHero
      pageMarkerLabel="Прайс"
      eyebrow="Цены"
      h1="Цены на услуги клиники The Platinental в Казани"
      lead="Цены по направлениям клиники в одном месте: пластическая хирургия, косметология, космецевтика и консультации врачей. Детальный расчёт зависит от выбранного врача, объёма вмешательства и индивидуального плана."
      ctaPrimary={{ label: 'Записаться на консультацию', href: '#form' }}
      ctaSecondary={{ label: 'Задать вопрос', href: 'https://wa.me/78432236666' }}
      metaPlacement="cta"
      ctaPlacement="after-meta"
      meta={[
        { num: '₽', label: 'пластическая хирургия' },
        { num: '?', label: 'косметология и космецевтика' },
        { num: '—', label: 'консультации врачей' },
      ]}
    />

    <section class="v3-prices v3-surface-cream" aria-labelledby="prices-heading">
      <div class="v3-container v3-container-default">
        <h2 id="prices-heading" class="sr-only">Прайс-лист</h2>

        <!-- Category tabs -->
        <div class="prices-tabs" role="tablist" aria-label="Категории услуг" data-v3-reveal>
          {tabs.map((t, i) => (
            <button
              role="tab"
              class="price-tab"
              data-tab={t.key}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${t.key}`}
              id={`tab-${t.key}`}
            >
              {t.label}
            </button>
          ))}
        </div>

        <!-- Category panels -->
        {priceCategories.map((cat, i) => (
          <div
            role="tabpanel"
            id={`panel-${cat.key}`}
            aria-labelledby={`tab-${cat.key}`}
            class={`price-panel ${i === 0 ? 'is-active' : ''}`}
            data-panel={cat.key}
          >
            {cat.groups.map((group) => (
              <div class:list={['price-group', cat.key === 'consultations' && 'price-group--consultations']} data-v3-reveal>
                <h3 class="price-group-title v3-h3">{group.title}</h3>
                <div class="price-table-wrap">
                <table class:list={['price-table', cat.key === 'consultations' && 'price-table--consultations']}>
                  {group.columns && (
                    <colgroup>
                      {group.columns.map((col) => (
                        <col style={`width:${col.width || 'auto'}`} />
                      ))}
                    </colgroup>
                  )}
                  <thead>
                    {group.columns ? (
                      <tr>
                        {group.columns.map((col) => (
                          <th
                            style={`text-align:${col.align || 'left'}`}
                            class="v3-eyebrow"
                          >
                            {col.label}
                          </th>
                        ))}
                      </tr>
                    ) : (
                      <tr>
                        <th class="v3-eyebrow" style="width:70%">Услуга</th>
                        <th class="v3-eyebrow" style="width:30%; text-align:right">Стоимость</th>
                      </tr>
                    )}
                  </thead>
                  <tbody>
                    {group.rows.map((row) => (
                      group.columns ? (
                        <tr>
                          {group.columns.map((col) => (
                            <td
                              style={`text-align:${col.align || 'left'}`}
                              class={col.key === 'service' ? 'price-service' : 'price-val'}
                              data-label={col.label}
                            >
                              {col.key === 'service'
                                ? [row.service, row.sub && <span class="price-sub">{row.sub}</span>, row.code && <span class="price-sub price-code"> · {row.code}</span>]
                                : <span set:html={formatCurrencyPlainText(String(row[col.key as keyof typeof row] ?? '—'))}></span>}
                            </td>
                          ))}
                        </tr>
                      ) : (
                        <tr>
                          <td class="price-service">{row.service}</td>
                          <td class="price-val" style="text-align:right" data-label="Стоимость" set:html={formatCurrencyPlainText(row.price ?? '—')}></td>
                        </tr>
                      )
                    ))}
                  </tbody>
                </table>
                </div>
                <div class="price-group-cta">
                  <span class="v3-caption">Нужна точная сумма по этому разделу?</span>
                  <a href="#form" class="v3-link v3-link-action">Уточнить стоимость</a>
                </div>
              </div>
            ))}
          </div>
        ))}

        <p class="prices-disclaimer v3-caption" data-v3-reveal>
          Цены носят информационный характер и не являются публичной офертой. Точная стоимость определяется врачом на консультации. Имеются противопоказания, необходима консультация специалиста.
        </p>
      </div>
    </section>

    <PageLeadMagnet
      eyebrow="Разбор стоимости"
      heading="Понять порядок<br />бюджета до визита"
      lead="Если вы не понимаете, с какой суммы начинается ваш случай, оставьте заявку. Администратор поможет сориентироваться по разделу прайса и запишет к профильному врачу."
      items={[
        { mark: '?', title: 'Какая задача', text: 'нос, веки, грудь, кожа, уход или консультация' },
        { mark: '—', title: 'Какой объём', text: 'первичная операция, повторный случай или поддерживающая процедура' },
        { mark: '₽', title: 'Что уточнить', text: 'консультация, анализы, операция и восстановление обсуждаются отдельно' },
      ]}
      ctaPrimary={{ label: 'Разобрать стоимость', href: '#form' }}
      ctaSecondary={{ label: 'Написать в WhatsApp', href: 'https://wa.me/78432236666' }}
      surface="sand"
    />

    <SurgicalPartnersBlock />

    <FinalCTA
      heading="Узнайте точную<br />стоимость"
      lead="Запишитесь на консультацию — хирург расскажет, что именно нужно и сколько это стоит в вашем случае."
      submitLabel="Записаться на консультацию"
    />
  </main>
  <Footer />
</SiteLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .v3-prices {
    padding-top: clamp(1rem, 3vw, 2rem);
    padding-bottom: var(--v3-gap-deep);
  }

  /* Tabs */
  .prices-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--v3-border-hair);
    margin-bottom: var(--v3-gap-small);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .prices-tabs::-webkit-scrollbar { display: none; }
  .price-tab {
    font-family: var(--v3-font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--v3-ink-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.875rem 1.5rem;
    min-height: 48px;
    cursor: pointer;
    white-space: nowrap;
    touch-action: manipulation;
    transition: color var(--v3-duration-fast) var(--v3-ease-out),
                border-color var(--v3-duration-fast) var(--v3-ease-out);
    margin-bottom: -1px;
  }
  .price-tab[aria-selected="true"] {
    color: var(--v3-ink);
    border-bottom-color: var(--v3-champagne-deep);
  }
  .price-tab:hover { color: var(--v3-ink); }

  /* Panels */
  .price-panel { display: none; }
  .price-panel.is-active { display: block; }

  /* Price group */
  .price-group {
    margin-bottom: var(--v3-gap-small);
  }
  .price-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .price-group-title {
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--v3-border-soft);
    margin-bottom: 0;
  }

  /* Table */
  .price-table {
    width: 100%;
    border-collapse: collapse;
  }
  .price-table--consultations {
    min-width: 58rem;
    table-layout: fixed;
  }
  .price-table th {
    display: table-cell;
    font-family: var(--v3-font-body);
    font-size: var(--v3-text-eyebrow);
    font-weight: 400;
    letter-spacing: var(--v3-tracking-eyebrow);
    text-transform: uppercase;
    color: var(--v3-ink-muted);
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--v3-border-hair);
    white-space: nowrap;
  }
  .price-table--consultations th {
    white-space: normal;
    line-height: 1.25;
    vertical-align: bottom;
  }
  .price-table th:first-child { padding-left: 0; }
  .price-table th:last-child { padding-right: 0; }
  .price-table tr:not(:last-child) td {
    border-bottom: 1px solid var(--v3-border-hair);
  }
  .price-table td {
    padding: 0.875rem 0.5rem;
    vertical-align: baseline;
  }
  .price-table td:first-child { padding-left: 0; }
  .price-table td:last-child { padding-right: 0; }
  .price-service {
    font-family: var(--v3-font-body);
    font-size: var(--v3-text-body);
    color: var(--v3-ink);
    line-height: 1.5;
  }
  .price-sub {
    font-size: 0.875rem;
    color: var(--v3-ink-muted);
  }
  .price-group--consultations .price-service {
    padding-right: 1rem;
  }
  .price-group--consultations .price-val {
    font-size: 0.9375rem;
  }
  .price-group--consultations .price-sub,
  .price-group--consultations .price-code {
    display: inline;
    white-space: normal;
  }
  .price-val {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: 1rem;
    color: var(--v3-champagne-deep);
    white-space: nowrap;
  }
  .price-val a,
  .price-service a {
    color: inherit !important;
    font: inherit !important;
    text-decoration: none !important;
  }
  .price-group-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--v3-border-soft);
    border-radius: var(--v3-radius-lg);
    background: color-mix(in srgb, var(--v3-surface-card) 86%, transparent);
  }
  .price-group-cta .v3-caption {
    color: var(--v3-ink);
    text-transform: none;
    letter-spacing: 0.005em;
    font-size: 0.875rem;
    font-family: var(--v3-font-body);
  }

  .prices-disclaimer {
    margin-top: var(--v3-gap-medium);
    padding-top: 1.5rem;
    border-top: 1px solid var(--v3-border-hair);
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
    font-style: normal;
    font-family: var(--v3-font-display);
    max-width: 72ch;
  }

  @media (max-width: 640px) {
    .price-tab { padding: 0.625rem 1rem; font-size: 0.875rem; }
    .price-group {
      margin-bottom: 2rem;
    }
    .price-group-title {
      font-size: 1.35rem;
      line-height: 1.15;
      padding-bottom: 0.875rem;
      margin-bottom: 0.75rem;
    }
    .price-table-wrap {
      overflow: visible;
    }
    .price-table,
    .price-table thead,
    .price-table tbody,
    .price-table tr,
    .price-table th,
    .price-table td {
      display: block;
      width: 100%;
    }
    .price-table,
    .price-table--consultations {
      min-width: 0;
      table-layout: auto;
    }
    .price-table colgroup,
    .price-table thead {
      display: none;
    }
    .price-table tbody {
      display: grid;
      gap: 0.75rem;
    }
    .price-table tr {
      padding: 0.875rem 0;
      border-top: 1px solid var(--v3-border-hair);
    }
    .price-table tr:last-child {
      border-bottom: 1px solid var(--v3-border-hair);
    }
    .price-table tr:not(:last-child) td {
      border-bottom: 0;
    }
    .price-table td,
    .price-table td:first-child,
    .price-table td:last-child {
      padding: 0;
    }
    .price-service {
      font-size: 0.98rem;
      line-height: 1.45;
      margin-bottom: 0.625rem;
    }
    .price-sub {
      display: block;
      margin-top: 0.25rem;
      font-size: 0.78rem;
      line-height: 1.35;
    }
    .price-val {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      min-height: 1.75rem;
      font-size: 1rem;
      line-height: 1.25;
      text-align: right !important;
    }
    .price-val::before {
      content: attr(data-label);
      flex: 1;
      min-width: 0;
      font-family: var(--v3-font-body);
      font-size: 0.76rem;
      line-height: 1.25;
      letter-spacing: var(--v3-tracking-eyebrow);
      text-transform: uppercase;
      color: var(--v3-ink-muted);
      text-align: left;
      white-space: normal;
    }
    .price-val + .price-val {
      margin-top: 0.35rem;
    }
    .price-group--consultations .price-service {
      padding-right: 0;
    }
    .price-group--consultations .price-val {
      font-size: 1rem;
    }
    .price-group-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  function initPriceTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.price-tab');
    const panels = document.querySelectorAll<HTMLElement>('.price-panel');

    tabs.forEach((tab) => {
      if (tab.dataset.priceTabBound === '1') return;
      tab.dataset.priceTabBound = '1';
      tab.addEventListener('click', () => {
      const key = tab.dataset.tab;
      tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
      panels.forEach((p) => p.classList.remove('is-active'));
      tab.setAttribute('aria-selected', 'true');
      document.querySelector(`[data-panel="${key}"]`)?.classList.add('is-active');
      });
    });
  }

  if (document.readyState !== 'loading') initPriceTabs();
  else document.addEventListener('DOMContentLoaded', initPriceTabs);
  document.addEventListener('astro:page-load', initPriceTabs);
</script>
