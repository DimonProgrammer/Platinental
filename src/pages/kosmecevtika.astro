---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/primitives/Button.astro';
import SectionHeader from '../components/primitives/SectionHeader.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Contacts from '../components/sections/Contacts.astro';
import { brands, categories, products, badgeLabels } from '../data/kosmecevtika';

const principles = [
  {
    n: '01',
    title: 'Правильный подбор',
    text: 'Косметолог знает, что&nbsp;происходит с&nbsp;вашей кожей&nbsp;— он&nbsp;подбирает средства под&nbsp;конкретный случай, а&nbsp;не&nbsp;по&nbsp;общим рекомендациям.',
  },
  {
    n: '02',
    title: 'Совместимость с&nbsp;процедурами',
    text: 'Некоторые ингредиенты несовместимы с&nbsp;инъекциями или&nbsp;лазером. Врач подбирает домашний уход так, чтобы он&nbsp;усиливал, а&nbsp;не&nbsp;нивелировал результат.',
  },
  {
    n: '03',
    title: 'Без подделок',
    text: 'Все средства&nbsp;— из&nbsp;официальных каналов поставок. Без&nbsp;маркетплейсов, без&nbsp;рисков купить неоригинальный продукт.',
  },
];

const brandBySlug = Object.fromEntries(brands.map((b) => [b.slug, b]));

const categoryCounts = categories.map((c) => ({
  ...c,
  count: products.filter((p) => p.category === c.key).length,
}));

const totalProducts = products.length;
---

<BaseLayout
  title="Космецевтика — профессиональная косметика клиники Platinental Казань"
  description="Профессиональная космецевтика клиники Platinental: SkinCeuticals, ZO Skin Health, SkinMedica, Obagi, Filorga. Средства по рекомендации косметолога — без подделок, оригинальные поставки."
  canonical="https://kzn.platinental.ru/kosmecevtika"
>
  <!-- Hero -->
  <section class="c-hero" aria-labelledby="c-hero-title">
    <div class="c-hero__inner" data-reveal>
      <span class="eyebrow">Космецевтика</span>
      <h1 id="c-hero-title" class="c-hero__title font-display">
        Профессиональная косметика <em>по&nbsp;рекомендации врача</em>
      </h1>
      <p class="c-hero__lede">
        Профессиональная уходовая косметика, которую косметологи клиники подбирают для&nbsp;домашнего ухода между процедурами и&nbsp;послеоперационной реабилитации. Только оригинальные поставки от&nbsp;официальных представителей.
      </p>
      <div class="c-hero__actions">
        <Button href="#catalog" variant="primary" size="lg">Смотреть каталог</Button>
        <Button href="#form" variant="ghost" size="lg">Записаться на&nbsp;подбор</Button>
      </div>
    </div>
  </section>

  <!-- Brands strip -->
  <section class="brands" aria-label="Бренды в каталоге">
    <div class="brands__inner">
      <span class="brands__label">Мы&nbsp;выбираем препараты брендов, которые используем сами</span>
      <ul class="brands__list">
        {brands.map((b) => (
          <li class="brands__item">
            <span class="brands__name font-display">{b.name}</span>
            <span class="brands__country">{b.country}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Catalog -->
  <section class="catalog" id="catalog" aria-label="Каталог космецевтики">
    <div class="catalog__inner">
      <div class="cat-tabs" role="tablist" aria-label="Категории каталога">
        <button
          type="button"
          class="cat-tab is-active"
          data-tab="all"
          role="tab"
          aria-selected="true"
        >
          Все
          <span class="cat-tab__count">{totalProducts}</span>
        </button>
        {categoryCounts.map((c) => (
          <button
            type="button"
            class="cat-tab"
            data-tab={c.key}
            role="tab"
            aria-selected="false"
          >
            {c.shortLabel ?? c.label}
            <span class="cat-tab__count">{c.count}</span>
          </button>
        ))}
      </div>

      <div class="products" role="tabpanel">
        {products.map((p, i) => {
          const brand = brandBySlug[p.brand];
          return (
            <article
              class:list={['product', `is-tone-${p.tone}`]}
              data-category={p.category}
              data-reveal
              style={`transition-delay: ${Math.min(i * 35, 280)}ms`}
            >
              <div class="product__media" aria-hidden="true">
                {p.badge && (
                  <span class:list={['product__badge', `is-${p.badge}`]} set:html={badgeLabels[p.badge]} />
                )}
                <div class="product__bottle">
                  <span class="product__bottle-brand font-display">{brand?.name}</span>
                  <span class="product__bottle-name">{p.name}</span>
                  <span class="product__bottle-volume">{p.volume}</span>
                </div>
              </div>
              <div class="product__body">
                <span class="product__brand">{brand?.name}</span>
                <h3 class="product__name font-display">{p.name}</h3>
                <p class="product__benefit">{p.benefit}</p>
                <div class="product__footer">
                  <div class="product__price-wrap">
                    <span class:list={['product__price', p.price === 'по назначению' && 'is-muted']}>{p.price}</span>
                    <span class="product__volume">{p.volume}</span>
                  </div>
                  <div class="product__actions">
                    <a href="#form" class="product__btn-request">Оставить заявку</a>
                    <a href="tel:+78432236666" class="product__btn-call" aria-label="Позвонить в клинику">
                      <svg viewBox="0 0 18 18" fill="none" width="16" height="16" aria-hidden="true" style="display:block">
                        <path d="M3.5 2C3.5 2 2 2 2 3.5c0 1.5 1 6.5 5.5 11S15.5 16 17 16c1.5 0 1.5-1.5 1.5-1.5l-1-3c0-.5-.5-.75-1-.5l-2 1c-.5.25-1 .1-1.3-.3C11.8 10.1 10 8.2 8.3 6.8c-.4-.35-.55-.8-.3-1.3l1-2c.25-.5 0-1-.5-1L3.5 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <p class="catalog__disclaimer">
        Цены и&nbsp;наличие актуальны на&nbsp;момент публикации и&nbsp;могут меняться. Не&nbsp;являются публичной офертой. Полный перечень средств&nbsp;— на&nbsp;консультации косметолога.
      </p>
    </div>
  </section>

  <!-- Why -->
  <section class="why" aria-label="Почему покупать у врача">
    <div class="why__inner">
      <SectionHeader eyebrow="Почему&nbsp;у&nbsp;врача" title="Почему лучше покупать у&nbsp;косметолога" />

      <ol class="why__list">
        {principles.map((p, i) => (
          <li class="why__item" data-reveal style={`transition-delay: ${i * 100}ms`}>
            <span class="why__num font-display">{p.n}</span>
            <div class="why__body">
              <h3 class="why__title font-display" set:html={p.title} />
              <p class="why__text" set:html={p.text} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- How it works -->
  <section class="how" id="form" aria-label="Как подобрать уход">
    <div class="how__inner" data-reveal>
      <div class="how__col how__col--text">
        <span class="eyebrow">Как это работает</span>
        <h2 class="how__title font-display">
          Подбор ухода занимает <em>30 минут</em>
        </h2>
        <ol class="how__steps">
          <li class="how__step">
            <span class="how__step-num font-display">1</span>
            <div>
              <h3 class="how__step-title">Консультация</h3>
              <p class="how__step-text">Косметолог осматривает кожу, уточняет домашний уход и&nbsp;процедуры, которые вы&nbsp;проходите.</p>
            </div>
          </li>
          <li class="how__step">
            <span class="how__step-num font-display">2</span>
            <div>
              <h3 class="how__step-title">Схема</h3>
              <p class="how__step-text">Подбираем 3–5&nbsp;средств под&nbsp;ваши задачи&nbsp;— утро, вечер, постуход. Обсуждаем бюджет и&nbsp;совместимость.</p>
            </div>
          </li>
          <li class="how__step">
            <span class="how__step-num font-display">3</span>
            <div>
              <h3 class="how__step-title">Получение</h3>
              <p class="how__step-text">Забираете средства в&nbsp;клинике&nbsp;— оплата при&nbsp;получении. Нужные позиции привозим под&nbsp;заказ в&nbsp;течение 2–5&nbsp;дней.</p>
            </div>
          </li>
        </ol>
      </div>

      <aside class="how__col how__col--form">
        <div class="how__form-card">
          <h3 class="how__form-title font-display">Записаться на&nbsp;подбор</h3>
          <p class="how__form-lede">Оставьте телефон&nbsp;— перезвоним в&nbsp;течение рабочего дня и&nbsp;подберём удобное время.</p>
          <form class="how__form" action="#" method="post" novalidate>
            <label class="how__field">
              <span class="how__field-label">Имя</span>
              <input type="text" name="name" required class="how__input" placeholder="Как к&nbsp;вам обращаться" />
            </label>
            <label class="how__field">
              <span class="how__field-label">Телефон</span>
              <input type="tel" name="phone" required class="how__input" placeholder="+7 (___) ___-__-__" />
            </label>
            <label class="how__field">
              <span class="how__field-label">Задача</span>
              <textarea name="message" rows="3" class="how__input" placeholder="Коротко о&nbsp;задаче: возраст, тип кожи, что&nbsp;беспокоит"></textarea>
            </label>
            <Button type="submit" variant="primary" size="lg" fullWidth>Отправить заявку</Button>
            <p class="how__consent">
              Нажимая кнопку, вы&nbsp;соглашаетесь на&nbsp;<a href="/privacy">обработку персональных данных</a>
            </p>
          </form>
        </div>
      </aside>
    </div>
  </section>

  <FinalCTA />
  <Contacts />
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.cat-tab');
  const items = document.querySelectorAll<HTMLElement>('.product');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      items.forEach((item) => {
        const cat = item.dataset.category;
        const show = target === 'all' || target === cat;
        item.style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
  /* Hero */
  .c-hero {
    background: var(--surface-page);
    padding: calc(var(--nav-height-mobile) + var(--space-12)) 0 var(--space-12);
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 768px) {
    .c-hero { padding: calc(var(--nav-height) + var(--space-16)) 0 var(--space-16); }
  }

  .c-hero__inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 768px) { .c-hero__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .c-hero__inner { padding: 0 48px; } }

  .c-hero__title {
    font-size: clamp(2rem, 1rem + 3vw, 3.25rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-5);
    text-wrap: balance;
    max-width: 22ch;
  }

  .c-hero__title em {
    color: var(--accent-hover);
    font-weight: 300;
  }

  .c-hero__lede {
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 62ch;
    margin-bottom: var(--space-8);
  }

  .c-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-10);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-8);
  }

  .c-hero__meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .c-hero__meta-num {
    font-size: clamp(2rem, 1rem + 1.8vw, 2.75rem);
    font-style: italic;
    font-weight: 300;
    color: var(--accent-hover);
    line-height: 1;
  }

  .c-hero__meta-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .c-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  /* Brands */
  .brands {
    background: var(--surface-alt);
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-8) 0;
  }

  .brands__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6) var(--space-8);
  }

  @media (min-width: 768px) { .brands__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .brands__inner { padding: 0 48px; } }

  .brands__label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .brands__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-8);
    align-items: baseline;
  }

  .brands__item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .brands__name {
    font-size: clamp(1.125rem, 0.7rem + 0.9vw, 1.4rem);
    font-style: italic;
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1;
  }

  .brands__country {
    font-size: 10px;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Catalog */
  .catalog {
    background: var(--surface-page);
    padding: var(--space-16) 0;
  }

  @media (min-width: 1024px) { .catalog { padding: var(--space-20) 0 var(--space-24); } }

  .catalog__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 768px) { .catalog__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .catalog__inner { padding: 0 48px; } }

  /* Tabs */
  .cat-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-8) 0 var(--space-10);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cat-tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 40px;
    padding: 0 18px;
    background: transparent;
    border: 1px solid var(--border-soft);
    border-radius: 99px;
    font-family: inherit;
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }

  .cat-tab:hover { border-color: var(--text-primary); color: var(--text-primary); }

  .cat-tab.is-active {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--text-inverse);
  }

  .cat-tab__count {
    font-size: 11px;
    opacity: 0.65;
  }

  /* Products grid */
  .products {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 560px) { .products { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .products { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1280px) { .products { grid-template-columns: repeat(4, 1fr); gap: var(--space-6); } }

  .product {
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  .product:hover {
    border-color: var(--border-soft);
    transform: translateY(-2px);
  }

  .product__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  /* Tone backgrounds */
  .is-tone-cream .product__media {
    background:
      radial-gradient(circle at 30% 20%, rgba(196, 168, 130, 0.14), transparent 60%),
      linear-gradient(180deg, #FAF5EC 0%, #F2EADB 100%);
  }
  .is-tone-blush .product__media {
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.4), transparent 60%),
      linear-gradient(180deg, #F5E8DF 0%, #EBD5C5 100%);
  }
  .is-tone-sage .product__media {
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.35), transparent 60%),
      linear-gradient(180deg, #E3E8DE 0%, #C8D1C1 100%);
  }
  .is-tone-stone .product__media {
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.3), transparent 60%),
      linear-gradient(180deg, #E8E3DA 0%, #CFC5B5 100%);
  }
  .is-tone-champagne .product__media {
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 253, 248, 0.5), transparent 60%),
      linear-gradient(180deg, #E8D6B8 0%, #C9A77C 100%);
  }
  .is-tone-ink .product__media {
    background:
      radial-gradient(circle at 30% 20%, rgba(196, 168, 130, 0.25), transparent 55%),
      linear-gradient(180deg, #1C1917 0%, #0A0A0A 100%);
    color: #F5EBD9;
  }

  .product__bottle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    max-width: 80%;
    position: relative;
    padding: var(--space-6) var(--space-4);
    background: rgba(255, 253, 248, 0.4);
    border: 1px solid rgba(10, 10, 10, 0.08);
    border-radius: 6px;
    backdrop-filter: blur(1px);
  }

  .is-tone-ink .product__bottle {
    background: rgba(10, 10, 10, 0.4);
    border-color: rgba(196, 168, 130, 0.25);
  }

  .product__bottle-brand {
    font-size: 9px;
    font-style: normal;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.55);
  }

  .is-tone-ink .product__bottle-brand { color: rgba(245, 235, 217, 0.7); }

  .product__bottle-name {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 0.65rem + 0.9vw, 1.25rem);
    font-style: italic;
    font-weight: 400;
    color: rgba(10, 10, 10, 0.85);
    line-height: 1.1;
    text-wrap: balance;
  }

  .is-tone-ink .product__bottle-name { color: rgba(245, 235, 217, 0.95); }

  .product__bottle-volume {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.5);
    margin-top: var(--space-1);
  }

  .is-tone-ink .product__bottle-volume { color: rgba(245, 235, 217, 0.55); }

  .product__badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 99px;
    z-index: 2;
  }

  .product__badge.is-new {
    background: var(--text-primary);
    color: var(--text-inverse);
  }

  .product__badge.is-best {
    background: var(--accent);
    color: var(--text-primary);
  }

  .product__badge.is-rx {
    background: rgba(255, 253, 248, 0.9);
    color: var(--text-primary);
    border: 1px solid rgba(10, 10, 10, 0.1);
  }

  .product__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1;
    border-top: 1px solid var(--border-subtle);
  }

  .product__brand {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .product__name {
    font-size: var(--text-h6);
    font-weight: 400;
    font-style: italic;
    line-height: 1.2;
    color: var(--text-primary);
    letter-spacing: var(--tracking-heading);
    margin-bottom: var(--space-2);
  }

  .product__benefit {
    font-size: var(--text-caption);
    line-height: 1.55;
    color: var(--text-muted);
    flex: 1;
    margin-bottom: var(--space-3);
  }

  .product__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-3);
