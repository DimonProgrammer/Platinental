---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/site/sections/Navigation.astro';
import PageHero from '../components/site/sections/PageHero.astro';
import PageLeadMagnet from '../components/site/sections/PageLeadMagnet.astro';
import FinalCTA from '../components/site/sections/FinalCTA.astro';
import Footer from '../components/site/sections/Footer.astro';
import { brands, categories, products } from '../data/kosmecevtika';
import { formatCurrencyPlainText } from '../lib/formatText';

const badgeLabel: Record<string, string> = {
  new: 'Новинка',
  best: 'Хит',
  rx: 'По рекомендации',
};

const toneStyle: Record<string, string> = {
  cream: 'background: var(--v3-cream-alt)',
  blush: 'background: #F5EDE8',
  sage: 'background: #EAF0EA',
  stone: 'background: var(--v3-sand)',
  champagne: 'background: #F5EBD8',
  ink: 'background: var(--v3-ink); color: var(--v3-on-ink)',
};
---

<SiteLayout
  title="Профессиональная космецевтика в Казани | The Platinental"
  description="Профессиональная космецевтика в клинике The Platinental Казань: ANUBIS, Ultraceuticals, HELIOCARE. Подбор средств врачом-косметологом."
>
  <Navigation />
  <main id="main">
    <PageHero
      pageMarker="03 / 04"
      pageMarkerLabel="Услуги"
      eyebrow="Космецевтика"
      h1="Космецевтика в Казани по рекомендации врача"
      lead="Врач-косметолог подбирает космецевтику для подготовки кожи, восстановления после процедур и поддержания результата между визитами. Средства можно купить в клинике после рекомендации специалиста."
      ctaPrimary={{ label: 'Записаться на подбор', href: '#form' }}
      ctaSecondary={{ label: 'Смотреть каталог', href: '#catalog' }}
      metaLabel="На подборе разберём:"
      metaPlacement="cta"
      ctaPlacement="after-meta"
      meta={[
        { num: '•', label: 'состояние кожи и текущие назначения' },
        { num: '—', label: 'подготовка, процедуры и восстановление' },
        { num: '+', label: 'средства, доступные в клинике' },
        { num: '?', label: 'что сочетать в вашем уходе' },
      ]}
    />
    <!-- Brands -->
    <section class="v3-brands v3-surface-sand" aria-labelledby="brands-heading">
      <div class="v3-container v3-container-default">
        <header class="brands-header" data-v3-stagger>
          <span class="v3-eyebrow">Производители</span>
          <h2 id="brands-heading" class="v3-h2"><em>Мы выбираем проверенные оригинальные препараты брендов, которые используем сами</em></h2>
        </header>
        <ul class="brands-grid" data-v3-stagger>
          {brands.map((b) => (
            <li class="brand-card">
              <span class="brand-name v3-h3">{b.name}</span>
              <span class:list={['brand-country', 'v3-eyebrow', !b.country && 'brand-country--empty']}>{b.country}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <PageLeadMagnet
      eyebrow="Подбор средств"
      heading="Схема ухода<br />после оценки кожи"
      lead="Врач-косметолог оценивает кожу, процедуры и привычные средства, затем собирает понятную схему без конфликтующих ингредиентов."
      items={[
        { mark: '✓', title: 'Утро / вечер', text: 'что использовать ежедневно и в каком порядке' },
        { mark: '—', title: 'Что исключить', text: 'ингредиенты, которые конфликтуют с лазером, инъекциями или восстановлением' },
        { mark: '+', title: 'Под заказ', text: 'нужные позиции можно привезти в клинику' },
      ]}
      ctaPrimary={{ label: 'Записаться на подбор', href: '#form' }}
      ctaSecondary={{ label: 'Смотреть каталог', href: '#catalog' }}
      surface="cream"
    />

    <!-- Products by category -->
    <span id="catalog" aria-hidden="true"></span>
    {categories.map((cat) => {
      const catProducts = products.filter((p) => p.category === cat.key);
      if (catProducts.length === 0) return null;
      return (
        <section class="v3-cat-products v3-surface-cream" aria-labelledby={`cat-${cat.key}-heading`}>
          <div class="v3-container v3-container-wide">
            <header class="cat-header" data-v3-stagger>
              <span class="v3-eyebrow">{cat.shortLabel ?? cat.label}</span>
              <h2 id={`cat-${cat.key}-heading`} class="v3-h2"><em>{cat.label}</em></h2>
              <p class="v3-lead cat-desc">{cat.description}</p>
            </header>
            <ul class="products-grid" data-v3-stagger>
              {catProducts.map((p) => (
                <li class="product-card" style={toneStyle[p.tone] ?? ''}>
                  {p.badge && (
                    <span class="product-badge v3-eyebrow">{badgeLabel[p.badge]}</span>
                  )}
                  <div class="product-brand v3-eyebrow">{p.brand.toUpperCase()}</div>
                  <h3 class="product-name v3-h3">{p.name}</h3>
                  <p class="product-volume v3-caption">{p.volume}</p>
                  <p class="product-benefit v3-body">{p.benefit}</p>
                  <p class="product-price" set:html={formatCurrencyPlainText(p.price)}></p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    })}

    <!-- Disclaimer -->
    <div class="v3-container v3-container-wide catalog-disclaimer" data-v3-reveal>
      <p class="v3-caption">Цены и наличие актуальны на момент публикации и могут меняться. Не являются публичной офертой. Полный перечень средств — на консультации косметолога.</p>
    </div>

    <!-- Почему у врача -->
    <section class="v3-why-doctor v3-surface-sand" aria-labelledby="why-doctor-heading">
      <div class="v3-container v3-container-default">
        <header class="why-header" data-v3-stagger>
          <span class="v3-eyebrow">Почему у врача</span>
          <h2 id="why-doctor-heading" class="v3-h2"><em>Почему лучше покупать у косметолога</em></h2>
        </header>
        <ol class="why-list" data-v3-stagger>
          {[
            { n: '01', title: 'Правильный подбор', text: 'Косметолог оценивает состояние кожи и подбирает средства под конкретный случай, процедуры и этап восстановления.' },
            { n: '02', title: 'Совместимость с процедурами', text: 'Некоторые ингредиенты несовместимы с инъекциями или лазером. Врач подбирает средства с учётом процедур, восстановления и результата, который нужно поддержать.' },
	            { n: '03', title: 'Проверенный источник', text: 'Клиника работает с поставками, которым доверяет. По конкретному средству администратор подскажет наличие и происхождение.' },
          ].map((item) => (
            <li class="why-item">
              <span class="why-num v3-eyebrow">{item.n}</span>
              <div class="why-body">
                <h3 class="v3-h3">{item.title}</h3>
                <p class="v3-body">{item.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Как это работает -->
    <section class="v3-how-works v3-surface-cream" aria-labelledby="how-works-heading">
      <div class="v3-container v3-container-default">
        <header class="how-header" data-v3-stagger>
          <span class="v3-eyebrow">Процесс</span>
          <h2 id="how-works-heading" class="v3-h2"><em>Как это работает</em></h2>
          <p class="v3-lead how-lead">Подбор ухода проходит после оценки кожи и текущего ухода</p>
        </header>
        <ol class="how-list" data-v3-stagger>
          {[
            { n: '1', title: 'Консультация', text: 'Косметолог осматривает кожу, уточняет текущие средства и процедуры, которые вы проходите.' },
            { n: '2', title: 'Схема', text: 'Подбираем 3–5 средств под ваши задачи — утро, вечер, постуход. Обсуждаем бюджет и совместимость.' },
            { n: '3', title: 'Получение', text: 'Забираете средства в клинике — оплата при получении. Если нужной позиции нет в наличии, администратор уточнит срок привоза под заказ.' },
          ].map((step) => (
            <li class="how-item">
              <span class="how-num v3-eyebrow">{step.n}</span>
              <div class="how-body">
                <h3 class="v3-h3">{step.title}</h3>
                <p class="v3-body">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <FinalCTA
      eyebrow="Подбор косметолога"
      heading="Записаться<br />на подбор"
      lead="Оставьте телефон — администратор свяжется в рабочее время и подберёт удобное время."
      submitLabel="Отправить заявку"
    />
  </main>
  <Footer />
</SiteLayout>

<style>
  /* Brands */
  .v3-brands {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .brands-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .brands-lead { max-width: 52ch; }
  .brands-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    background: var(--v3-border-hair);
  }
  .brand-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: center;
    min-height: 8.5rem;
    padding: 1.5rem 1.75rem;
    background: var(--v3-cream);
  }
  .brand-name { color: var(--v3-ink); }
  .brand-country { color: var(--v3-ink-muted); }
  .brand-country--empty {
    min-height: 1.35rem;
  }

  /* Category sections */
  .v3-cat-products {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .cat-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .cat-desc { max-width: 52ch; }

  /* Products grid */
  .products-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    position: relative;
  }
  .product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--v3-champagne-deep);
    font-size: 0.625rem;
  }
  .product-brand { color: var(--v3-ink-muted); margin-bottom: 0.25rem; }
  .product-name { color: var(--v3-ink); font-size: 1.0625rem; }
  .product-volume { color: var(--v3-ink-muted); text-transform: none; letter-spacing: 0.005em; }
  .product-benefit { margin: 0; font-size: 0.875rem; color: var(--v3-ink-secondary); flex: 1; }
  .product-price {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: 1.125rem;
    color: var(--v3-champagne-deep);
    margin-top: 0.5rem;
  }

  /* Catalog disclaimer */
  .catalog-disclaimer {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    border-top: 1px solid var(--v3-border-hair);
  }
  .catalog-disclaimer .v3-caption {
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
    font-family: var(--v3-font-body);
    font-size: 0.875rem;
  }

  /* Why doctor */
  .v3-why-doctor {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .why-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .why-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .why-item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--v3-border-hair);
    align-items: baseline;
  }
  .why-item:last-child { border-bottom: 1px solid var(--v3-border-hair); }
  .why-num { color: var(--v3-ink-muted); }
  .why-body { display: flex; flex-direction: column; gap: 0.5rem; }
  .why-body p { margin: 0; }

  /* How it works */
  .v3-how-works {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .how-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .how-lead { max-width: 40ch; }
  .how-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--v3-border-hair);
  }
  .how-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 1.75rem;
    background: var(--v3-cream);
  }
  .how-num { color: var(--v3-ink-muted); }
  .how-body { display: flex; flex-direction: column; gap: 0.5rem; }
  .how-body p { margin: 0; }

  @media (max-width: 768px) {
    .why-item { grid-template-columns: 2.5rem 1fr; gap: 1rem; }
    .how-list { grid-template-columns: 1fr; }
  }

  @media (max-width: 1024px) {
    .brands-grid { grid-template-columns: repeat(2, 1fr); }
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .brands-grid { grid-template-columns: 1fr; }
    .products-grid { grid-template-columns: 1fr; }
  }
</style>
