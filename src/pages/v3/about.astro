---
import V3Layout from '../../layouts/V3Layout.astro';
import Navigation from '../../components/v3/sections/Navigation.astro';
import PageHero from '../../components/v3/sections/PageHero.astro';
import FinalCTA from '../../components/v3/sections/FinalCTA.astro';
import FAQ from '../../components/v3/sections/FAQ.astro';
import Footer from '../../components/v3/sections/Footer.astro';

const milestones = [
  { year: '2011', text: 'Открытие клиники в Казани. Первые операции, первые пациенты.' },
  { year: '2014', text: 'Расширение направления косметологии. Собственная операционная.' },
  { year: '2018', text: 'Патент на изобретение «Способ подтяжки шеи» (РФ № 2741620).' },
  { year: '2022', text: 'Команда пополнилась молодыми хирургами из ведущих московских клиник.' },
  { year: '2024', text: 'Внедрение face-preserving philosophy — деликатная хирургия без потери естественности.' },
];

const principles = [
  {
    num: '01',
    title: 'Честность прежде всего',
    text: 'Если операция не нужна — мы скажем об этом. Если риски высоки — объясним. Консультация — это не продажа.',
  },
  {
    num: '02',
    title: 'Результат, который не виден',
    text: 'Главный признак хорошей работы — окружающие замечают, что человек выглядит лучше, но не понимают почему.',
  },
  {
    num: '03',
    title: 'Авторские методики',
    text: 'У каждого хирурга клиники своя школа и отработанные техники. Нет единого шаблона — есть индивидуальный подбор.',
  },
  {
    num: '04',
    title: 'Команда, а не одиночка',
    text: 'Хирург и косметолог работают вместе. После операции — реабилитация внутри клиники, не у сторонних специалистов.',
  },
];

const accreditations = [
  { abbr: 'ASPS', full: 'American Society of Plastic Surgeons' },
  { abbr: 'ISAPS', full: 'International Society of Aesthetic Plastic Surgery' },
  { abbr: 'РИНПХ', full: 'Российская академия наук. Хирурги — члены профессиональных ассоциаций' },
];

const faqItems = [
  {
    q: 'Platinental — это филиал московской клиники?',
    a: 'Нет. Platinental Казань — самостоятельное юридическое лицо (ООО «Платинентал Казань»). С московской клиникой у нас общий бренд и один из основателей, но это отдельные проекты.',
    open: true,
  },
  {
    q: 'С какого года работает клиника?',
    a: 'С 2011 года. За это время в клинике выполнены тысячи операций и процедур.',
  },
  {
    q: 'Есть ли у хирургов международные сертификаты?',
    a: 'Ряд хирургов является членами ASPS и ISAPS — американской и международной ассоциаций пластических хирургов. Это личные квалификации конкретных специалистов, подтверждённые международным профессиональным сообществом.',
  },
  {
    q: 'Где находится клиника?',
    a: 'ул. Карла Маркса, 48, корп. 1. Казань, 420015. Приём ежедневно с 9:00 до 20:00.',
  },
];
---

<V3Layout
  title="О клинике — Platinental Казань"
  description="Platinental — клиника пластической хирургии и косметологии в Казани с 2011 года. Авторские методики, деликатный подход, команда хирургов с международной квалификацией."
>
  <Navigation />
  <main id="main">
    <PageHero
      eyebrow="О нас"
      h1="Клиника пластической хирургии&nbsp;— с&nbsp;2011&nbsp;года в&nbsp;Казани"
      lead="Частная клиника, где хирург слушает дольше, чем оперирует. Деликатный результат — когда изменения видны только тем, кто знает, что искать."
      ctaPrimary={{ label: 'Записаться на консультацию', href: '#form' }}
      ctaSecondary={{ label: 'Познакомиться с врачами', href: '/v3/doctors' }}
    />

    <!-- История -->
    <section class="v3-timeline v3-surface-sand" aria-labelledby="timeline-heading">
      <div class="v3-container v3-container-default">
        <header class="timeline-header" data-v3-reveal>
          <span class="v3-eyebrow">История</span>
          <h2 id="timeline-heading" class="v3-h2"><em>Как мы росли</em></h2>
        </header>
        <ol class="timeline-list" data-v3-reveal>
          {milestones.map((m) => (
            <li class="timeline-item">
              <span class="timeline-year v3-eyebrow">{m.year}</span>
              <p class="timeline-text v3-body">{m.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Принципы -->
    <section class="v3-about-principles v3-surface-cream" aria-labelledby="principles-heading">
      <div class="v3-container v3-container-default">
        <header class="principles-header" data-v3-reveal>
          <span class="v3-eyebrow">Философия</span>
          <h2 id="principles-heading" class="v3-h2"><em>Как мы работаем</em></h2>
        </header>
        <ol class="principles-list" data-v3-reveal>
          {principles.map((p) => (
            <li class="principle-item">
              <span class="principle-num v3-eyebrow">{p.num}</span>
              <div class="principle-body">
                <h3 class="v3-h3">{p.title}</h3>
                <p class="v3-body">{p.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Аккредитации -->
    <section class="v3-accred v3-surface-ink" aria-labelledby="accred-heading">
      <div class="v3-container v3-container-default">
        <div class="accred-inner" data-v3-reveal>
          <span class="v3-eyebrow">Квалификация</span>
          <h2 id="accred-heading" class="v3-h2"><em>Профессиональное признание</em></h2>
          <p class="v3-lead accred-lead">
            Хирурги клиники — члены российских и международных профессиональных объединений.
            Обучение в ведущих мировых центрах, участие в конгрессах.
          </p>
          <ul class="accred-list">
            {accreditations.map((a) => (
              <li class="accred-item">
                <span class="accred-abbr v3-h3">{a.abbr}</span>
                <span class="v3-body accred-full">{a.full}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <FAQ
      eyebrow="О клинике"
      heading="Частые вопросы"
      items={faqItems}
    />

    <FinalCTA
      heading="Познакомьтесь<br />с&nbsp;клиникой"
      lead="Запишитесь на первичную консультацию. Расскажем о возможностях и ответим на все вопросы."
    />
  </main>
  <Footer />
</V3Layout>

<style>
  /* Timeline */
  .v3-timeline {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--v3-border-hair);
    align-items: baseline;
  }
  .timeline-item:last-child { border-bottom: 1px solid var(--v3-border-hair); }
  .timeline-year { color: var(--v3-champagne-deep); }
  .timeline-text { margin: 0; }

  /* Principles */
  .v3-about-principles {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .principles-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    background: var(--v3-border-hair);
  }
  .principle-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 2rem 2.5rem;
    background: var(--v3-cream);
  }
  .principle-num { color: var(--v3-ink-muted); }
  .principle-body { display: flex; flex-direction: column; gap: 0.75rem; }
  .principle-body .v3-body { margin: 0; }

  /* Accreditations */
  .v3-accred {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .accred-inner {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-h1-lead);
    max-width: 52rem;
  }
  .accred-lead { max-width: 52ch; }
  .accred-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--v3-border-on-ink);
  }
  .accred-item {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 2rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--v3-border-on-ink);
    align-items: baseline;
  }
  .accred-abbr { color: var(--v3-champagne); }
  .accred-full { color: var(--v3-on-ink-secondary); margin: 0; }

  @media (max-width: 768px) {
    .timeline-item { grid-template-columns: 4rem 1fr; gap: 1rem; }
    .principles-list { grid-template-columns: 1fr; }
    .accred-item { grid-template-columns: 6rem 1fr; gap: 1rem; }
  }
</style>
