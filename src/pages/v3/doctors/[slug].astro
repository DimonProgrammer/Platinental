---
import V3Layout from '../../../layouts/V3Layout.astro';
import Navigation from '../../../components/v3/sections/Navigation.astro';
import FinalCTA from '../../../components/v3/sections/FinalCTA.astro';
import FAQ from '../../../components/v3/sections/FAQ.astro';
import Footer from '../../../components/v3/sections/Footer.astro';
import { doctors } from '../../../data/doctors';
import type { Doctor } from '../../../data/doctors';

export async function getStaticPaths() {
  return doctors.map((d) => ({
    params: { slug: d.slug },
    props: { doctor: d },
  }));
}

interface Props { doctor: Doctor }
const { doctor: d } = Astro.props;

const isSurgeon = d.tags.includes('plastika');
const consultationPrice = d.priceMain;

const faqItems = [
  {
    q: `Как записаться к ${d.name.split(' ')[0]}?`,
    a: 'Позвоните по номеру <a href="tel:+78432236666">+7 843 223-66-66</a>, напишите в WhatsApp или заполните форму на сайте. Администратор подберёт удобное время.',
    open: true,
  },
  {
    q: 'Сколько длится первичная консультация?',
    a: 'Первичная консультация — 30–60 минут. Хирург осматривает, замеряет пропорции, отвечает на вопросы, показывает похожие случаи из практики.',
  },
  isSurgeon ? {
    q: 'Нужна ли подготовка к операции?',
    a: 'Да. Перечень анализов и обследований врач выдаёт на консультации. Как правило: клинический и биохимический анализ крови, коагулограмма, ЭКГ, справки от терапевта.',
  } : {
    q: 'Как подготовиться к косметологической процедуре?',
    a: 'Зависит от процедуры. На консультации врач даст точные рекомендации: что исключить за несколько дней, как ухаживать за кожей в период восстановления.',
  },
  {
    q: 'Можно ли получить онлайн-консультацию?',
    a: d.priceSub?.includes('Онлайн')
      ? 'Да, онлайн-консультации доступны. Запишитесь через форму или WhatsApp — укажите, что вам нужен онлайн-формат.'
      : 'Этот специалист принимает очно. Если вы находитесь за пределами Казани — свяжитесь с нами, обсудим варианты.',
  },
];
---

<V3Layout
  title={`${d.name} — ${d.spec} — Platinental Казань`}
  description={`${d.name} — ${isSurgeon ? 'пластический хирург' : 'врач-косметолог'} клиники Platinental Казань. Специализация, образование, запись на консультацию.`}
>
  <Navigation />
  <main id="main">

    <!-- Hero -->
    <section class="v3-doc-hero v3-surface-cream" aria-labelledby="doc-heading">
      <div class="v3-container v3-container-wide doc-hero-grid">
        <div class="doc-hero-text" data-v3-reveal>
          <nav class="doc-breadcrumb" aria-label="Хлебные крошки">
            <a href="/v3/" class="v3-link bc-link">Главная</a>
            <span class="bc-sep" aria-hidden="true">→</span>
            <a href="/v3/doctors" class="v3-link bc-link">Врачи</a>
          </nav>
          <span class="v3-eyebrow doc-spec">{d.spec}</span>
          <h1 id="doc-heading" class="v3-h1 doc-h1">
            <em>{d.name}</em>
          </h1>
          <p class="v3-lead doc-lead" set:html={d.short}></p>
          <div class="doc-price-row">
            <span class="doc-price">{consultationPrice}</span>
            {d.priceSub && <span class="v3-caption doc-price-sub">{d.priceSub}</span>}
          </div>
          <div class="doc-cta">
            <a href="#form" class="v3-btn v3-btn-primary">Записаться {d.nameBtn}</a>
          </div>
        </div>

        <div class="doc-hero-photo" data-v3-reveal>
          {d.photo ? (
            <img
              src={d.photo}
              alt={d.name}
              width="480"
              height="600"
              loading="eager"
              class="doc-photo-img"
            />
          ) : (
            <div class="doc-photo-placeholder" aria-hidden="true">
              <span class="doc-initials">{d.initials}</span>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Specialization -->
    <section class="v3-doc-spec v3-surface-sand" aria-labelledby="spec-heading">
      <div class="v3-container v3-container-default">
        <header class="doc-section-header" data-v3-reveal>
          <span class="v3-eyebrow">Специализация</span>
          <h2 id="spec-heading" class="v3-h2"><em>Что делает</em></h2>
        </header>
        <ul class="spec-list" data-v3-reveal>
          {d.details.specialization.map((s) => (
            <li class="spec-item">
              <span class="spec-dot" aria-hidden="true"></span>
              <span class="v3-body spec-text">{s}</span>
            </li>
          ))}
        </ul>

        {d.details.patent && (
          <div class="patent-note" data-v3-reveal>
            <span class="v3-eyebrow">Патент</span>
            <p class="v3-body patent-text">{d.details.patent}</p>
          </div>
        )}

        {d.details.awards && (
          <div class="awards-note" data-v3-reveal>
            <span class="v3-eyebrow">Квалификация</span>
            <p class="v3-body">{d.details.awards}</p>
          </div>
        )}
      </div>
    </section>

    <!-- Education -->
    <section class="v3-doc-edu v3-surface-cream" aria-labelledby="edu-heading">
      <div class="v3-container v3-container-default">
        <header class="doc-section-header" data-v3-reveal>
          <span class="v3-eyebrow">Образование</span>
          <h2 id="edu-heading" class="v3-h2"><em>Где учился</em></h2>
        </header>
        <ol class="edu-timeline" data-v3-reveal>
          {d.details.education.map((e) => (
            <li class="edu-item">
              <span class="edu-year v3-eyebrow">{e.year}</span>
              <p class="edu-text v3-body">{e.text}</p>
            </li>
          ))}
        </ol>

        {d.details.additionalEducation && d.details.additionalEducation.length > 0 && (
          <div class="edu-additional" data-v3-reveal>
            <h3 class="v3-h3 edu-additional-title">Дополнительное образование</h3>
            <ul class="edu-add-list">
              {d.details.additionalEducation.map((e) => (
                <li class="edu-add-item">
                  {e.year && <span class="edu-add-year v3-eyebrow">{e.year}</span>}
                  <span class="v3-body">{e.text}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {d.details.congresses && (
          <p class="v3-body edu-congresses" data-v3-reveal>{d.details.congresses}</p>
        )}
      </div>
    </section>

    <!-- Works preview -->
    {d.works.some((w) => w.after !== null) && (
      <section class="v3-doc-works v3-surface-sand" aria-labelledby="works-heading">
        <div class="v3-container v3-container-wide">
          <header class="doc-section-header" data-v3-reveal>
            <span class="v3-eyebrow">Работы</span>
            <h2 id="works-heading" class="v3-h2"><em>Результаты</em></h2>
          </header>
          <ul class="works-grid" data-v3-reveal>
            {d.works.filter((w) => w.after !== null).map((w) => (
              <li class="work-item">
                <div class="work-img-wrap">
                  <img src={w.after!} alt={w.caption} width="400" height="500" loading="lazy" />
                </div>
                <p class="work-caption v3-caption">{w.caption}</p>
              </li>
            ))}
          </ul>
          <p class="works-disclaimer v3-caption" data-v3-reveal>
            Фотографии результатов публикуются с письменного согласия пациентов.
          </p>
        </div>
      </section>
    )}

    <FAQ
      eyebrow="Вопросы"
      heading={`Вопросы о приёме`}
      items={faqItems}
    />

    <FinalCTA
      heading={`Записаться<br />${d.nameBtn}`}
      lead={`Первичная консультация: ${consultationPrice}. Задайте вопросы — врач ответит без спешки.`}
      submitLabel={`Записаться ${d.nameBtn}`}
    />
  </main>
  <Footer />
</V3Layout>

<style>
  /* Hero */
  .v3-doc-hero {
    padding-top: clamp(1.5rem, 4vh, 3rem);
    padding-bottom: var(--v3-gap-deep);
  }
  .doc-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(1.5rem, 4vh, 3rem);
  }
  .doc-hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-h1-lead);
  }
  .doc-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }
  .bc-link {
    font-size: 0.875rem;
    color: var(--v3-ink-muted);
    border-color: var(--v3-ink-muted);
  }
  .bc-sep { color: var(--v3-ink-muted); font-size: 0.75rem; }
  .doc-spec { color: var(--v3-champagne-deep); margin-bottom: var(--v3-gap-eyebrow-h1); }
  .doc-h1 { font-size: clamp(1.75rem, 3.5vw, 3rem); }
  .doc-lead { max-width: 44ch; }
  .doc-price-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--v3-border-soft);
  }
  .doc-price {
    font-family: var(--v3-font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--v3-champagne-deep);
  }
  .doc-price-sub { color: var(--v3-ink-muted); text-transform: none; letter-spacing: 0.005em; }
  .doc-cta { margin-top: 0.5rem; }

  .doc-hero-photo {
    max-width: 36rem;
    margin-left: auto;
    width: 100%;
  }
  .doc-photo-img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .doc-photo-placeholder {
    aspect-ratio: 4/5;
    background: var(--v3-sand);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .doc-initials {
    font-family: var(--v3-font-display);
    font-style: italic;
    font-size: clamp(4rem, 10vw, 8rem);
    color: var(--v3-ink-muted);
  }

  /* Section shared */
  .v3-doc-spec,
  .v3-doc-edu {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .doc-section-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }

  /* Spec list */
  .spec-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .spec-item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--v3-border-hair);
  }
  .spec-item:last-of-type { border-bottom: 1px solid var(--v3-border-hair); }
  .spec-dot {
    flex-shrink: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--v3-champagne-deep);
    margin-top: 0.4em;
  }
  .spec-text { margin: 0; }

  .patent-note,
  .awards-note {
    margin-top: var(--v3-gap-small);
    padding: 1.5rem;
    background: var(--v3-cream);
    border-left: 3px solid var(--v3-champagne);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .patent-text { margin: 0; }

  /* Education timeline */
  .edu-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .edu-item {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--v3-border-hair);
    align-items: baseline;
  }
  .edu-item:last-of-type { border-bottom: 1px solid var(--v3-border-hair); }
  .edu-year { color: var(--v3-champagne-deep); }
  .edu-text { margin: 0; }

  .edu-additional {
    margin-top: var(--v3-gap-small);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .edu-additional-title { color: var(--v3-ink); }
  .edu-add-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .edu-add-item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-size: 0.9375rem;
    color: var(--v3-ink-secondary);
  }
  .edu-add-year { color: var(--v3-ink-muted); flex-shrink: 0; min-width: 3rem; }
  .edu-congresses { margin-top: var(--v3-gap-small); color: var(--v3-ink-secondary); }

  /* Works */
  .v3-doc-works {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .works-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .work-item { display: flex; flex-direction: column; gap: 0.5rem; }
  .work-img-wrap {
    aspect-ratio: 4/5;
    overflow: hidden;
    background: var(--v3-cream);
  }
  .work-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .work-caption { color: var(--v3-ink-muted); text-transform: none; letter-spacing: 0.005em; }
  .works-disclaimer {
    margin-top: 1.5rem;
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
    font-style: italic;
    font-family: var(--v3-font-display);
  }

  @media (max-width: 1024px) {
    .doc-hero-grid { grid-template-columns: 1fr; }
    .doc-hero-photo { max-width: 26rem; margin-inline: 0; }
    .works-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .edu-item { grid-template-columns: 1fr; gap: 0.25rem; }
    .works-grid { grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
  }
</style>
