---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/site/sections/Navigation.astro';
import PageHero from '../components/site/sections/PageHero.astro';
import FinalCTA from '../components/site/sections/FinalCTA.astro';
import Footer from '../components/site/sections/Footer.astro';
import { documentsList } from '../data/legalDocuments';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const hasPublicFile = (href: string) => existsSync(join(process.cwd(), 'public', href.replace(/^\//, '')));
---

<SiteLayout
  title="Документы и лицензии — The Platinental Казань"
  description="Документы The Platinental Казань: лицензия, политика обработки персональных данных, согласия, пользовательское соглашение и реквизиты клиники."
>
  <Navigation />
  <main id="main">
    <PageHero
      pageMarkerLabel="Документы"
      eyebrow="Прозрачность и соответствие"
      h1="Документы и лицензии клиники The Platinental"
      lead="ООО «Платинентал Казань» · Лицензия ЛО-16-01-003022 · ул. Карла Маркса, 48, корп. 1, Казань, 420015"
      ctaPrimary={{ label: 'Записаться на консультацию', href: '#form' }}
      ctaSecondary={{ label: 'Контакты клиники', href: '/contacts' }}
      meta={[
        { num: '✓', label: 'лицензия и юридическое лицо' },
        { num: '—', label: 'правила и согласия' },
        { num: '!', label: 'информация не является офертой' },
      ]}
    />

    <section class="v3-docs v3-surface-cream" aria-labelledby="docs-heading">
      <div class="v3-container v3-container-default">
        <h2 id="docs-heading" class="sr-only">Документы клиники</h2>

        <ul class="docs-list">
          {documentsList.map((d) => {
            const isAvailable = hasPublicFile(d.href);
            return (
            <li class="doc-item">
              <span class="v3-minimark doc-mark" aria-hidden="true">•</span>
              <div class="doc-info">
                <p class="doc-title v3-h3">{d.title}</p>
                <p class="v3-caption doc-issuer">{d.type} · {d.size}{!isAvailable && ' · по запросу в клинике'}</p>
              </div>
              {isAvailable ? (
                <a href={d.href} class="v3-link doc-link" target="_blank" rel="noopener noreferrer">{d.label}</a>
              ) : (
                <span class="v3-caption doc-status">Файл готовим</span>
              )}
            </li>
            );
          })}
        </ul>

        <p class="docs-note v3-body">
          Документы представлены для ознакомления. Оригиналы можно запросить в клинике. При заключении договора на медицинские услуги все формы подписываются офлайн.
        </p>

        <div class="docs-legal">
          <div class="v3-body legal-text">
            <p>
              Информация на сайте kzn.platinental.ru носит исключительно популярно-просветительский характер, не может быть использована как пособие по самолечению и ни при каких условиях не является публичной офертой, определяемой положениями ч. 2 ст. 437 Гражданского кодекса Российской Федерации. Для получения подробной информации о наличии, стоимости услуг и записи на приём обращайтесь по телефону <a href="tel:+78432236666" class="v3-link">8 (843) 223-66-66</a> или по электронной почте <a href="mailto:platinental.kzn@gmail.com" class="v3-link">platinental.kzn@gmail.com</a>.
            </p>
          </div>

          <dl class="legal-org">
            <div class="legal-row">
              <dt class="v3-eyebrow">Организация</dt>
              <dd class="v3-body">ООО «Платинентал Казань»</dd>
            </div>
            <div class="legal-row">
              <dt class="v3-eyebrow">Юридический адрес</dt>
              <dd class="v3-body">420015, Республика Татарстан, г. Казань, ул. Карла Маркса, д. 48</dd>
            </div>
            <div class="legal-row">
              <dt class="v3-eyebrow">Фактический адрес</dt>
              <dd class="v3-body">420015, Республика Татарстан, г. Казань, ул. Карла Маркса, д. 48</dd>
            </div>
            <div class="legal-row">
              <dt class="v3-eyebrow">Телефоны</dt>
              <dd class="v3-body">
                <a href="tel:+79656122888" class="v3-link">+7 965 612-28-88</a>, <a href="tel:+78432236666" class="v3-link">223-66-66</a>
              </dd>
            </div>
          </dl>
        </div>

        <p class="docs-disclaimer v3-caption">
          Для разработки плана лечения вам необходима личная консультация специалиста. Для получения подробной информации о стоимости товаров и услуг обращайтесь по указанным телефонам.
        </p>

        <p class="docs-disclaimer v3-caption">
          Срок ожидания предоставления платных медицинских услуг может быть до 6 месяцев, требуется обязательная предварительная запись.
        </p>
      </div>
    </section>

    <FinalCTA
      eyebrow="Документы и запись"
      heading="Остались вопросы<br />по документам?"
      lead="Оставьте контакт — администратор подскажет, какие документы можно посмотреть заранее, и запишет на консультацию."
      submitLabel="Задать вопрос"
    />
  </main>
  <Footer />
</SiteLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .v3-docs {
    padding-top: var(--v3-gap-small);
    padding-bottom: var(--v3-gap-deep);
  }
  .docs-list {
    list-style: none;
    margin: 0 0 var(--v3-gap-medium);
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .doc-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    padding-block: 1.75rem;
    border-top: 1px solid var(--v3-border-hair);
  }
  .doc-mark { margin-top: 0.125rem; }
  .doc-item:last-child { border-bottom: 1px solid var(--v3-border-hair); }
  .doc-meta { display: flex; flex-direction: column; gap: 0.375rem; }
  .doc-num { color: var(--v3-ink-muted); }
  .doc-date { color: var(--v3-ink-muted); text-transform: none; letter-spacing: 0.005em; }
  .doc-title { color: var(--v3-ink); margin-bottom: 0.25rem; }
  .doc-issuer { margin: 0; }
  .doc-link { font-size: 0.9375rem; white-space: nowrap; }
  .doc-status { color: var(--v3-ink-muted); white-space: nowrap; }

  .docs-legal {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-h2-body);
    padding: var(--v3-gap-medium) 0;
    border-top: 1px solid var(--v3-border-hair);
  }
  .legal-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 64ch;
  }
  .legal-text p { margin: 0; }

  .docs-disclaimer {
    text-align: center;
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
    font-style: normal;
    font-family: var(--v3-font-display);
    padding-top: 1rem;
    border-top: 1px solid var(--v3-border-hair);
  }

  @media (max-width: 768px) {
    .doc-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .doc-mark { display: none; }
  }
</style>
