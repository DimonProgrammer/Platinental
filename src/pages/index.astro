---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/site/sections/Navigation.astro';
import Hero from '../components/site/sections/Hero.astro';
import DecisionCompass from '../components/site/sections/DecisionCompass.astro';
import ConsultationQuiz from '../components/site/sections/ConsultationQuiz.astro';
import ServicesGrid from '../components/site/sections/ServicesGrid.astro';
import Principles from '../components/site/sections/Principles.astro';
import Procedures from '../components/site/sections/Procedures.astro';
import QuoteBridge from '../components/site/sections/QuoteBridge.astro';
import DoctorsPreview from '../components/site/sections/DoctorsPreview.astro';
import BeforeAfter from '../components/site/sections/BeforeAfter.astro';
import Reviews from '../components/site/sections/Reviews.astro';
import FinalCTA from '../components/site/sections/FinalCTA.astro';
import FAQ from '../components/site/sections/FAQ.astro';
import Contacts from '../components/site/sections/Contacts.astro';
import Footer from '../components/site/sections/Footer.astro';
---

<SiteLayout
  title="The Platinental Казань — клиника пластической хирургии и косметологии"
  description="Клиника The Platinental в Казани. Пластическая хирургия, косметология и индивидуальный план лечения. С 2011 года."
>
  <Navigation />
  <main id="main">
    <Hero />
    <DecisionCompass />
    <ConsultationQuiz />
    <ServicesGrid />
    <Principles />
    <QuoteBridge />
    <DoctorsPreview />
    <Procedures />
    <BeforeAfter />
    <Reviews />
    <FinalCTA />
    <FAQ />
    <Contacts />
  </main>
  <Footer />
</SiteLayout>

<style is:global>
  /* ZapfHumnst BT вместо Cormorant на всём сайте */
  [data-v3] {
    --v3-font-display: 'ZapfHumnst BT', Georgia, serif;
  }
</style>
