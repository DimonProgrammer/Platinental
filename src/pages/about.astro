---
import V3Layout from '../layouts/V3Layout.astro';
import Navigation from '../components/v3/sections/Navigation.astro';
import PageHero from '../components/v3/sections/PageHero.astro';
import FinalCTA from '../components/v3/sections/FinalCTA.astro';
import FAQ from '../components/v3/sections/FAQ.astro';
import Footer from '../components/v3/sections/Footer.astro';
import { Image } from 'astro:assets';
import clinicReception from '../assets/photos/clinic-reception-ai.png';
import clinicLobby from '../assets/photos/clinic-lounge-ai.png';
import clinicExterior from '../assets/photos/clinic-exterior-ai.png';

const milestones = [
  { year: '2011', text: 'Открытие клиники в Казани. Первые операции, первые пациенты.' },
  { year: '2014', text: 'Расширение направления косметологии. Собственная операционная.' },
  { year: '2018', text: 'Патент на изобретение «Способ подтяжки шеи» (РФ № 2741620).' },
  { year: '2022', text: 'Команда пополнилась молодыми хирургами из ведущих московских клиник.' },
  { year: '2024', text: 'Внедрение face-preserving philosophy — деликатная хирургия без потери естественности.' },
];

const principles = [
  {
    num: '01',
    title: 'Хирурги клиники обучались в РНИМУ им. Пирогова, 1-м МГМУ им. Сеченова и РНЦХ им. Петровского.',
    text: '',
  },
  {
    num: '02',
    title: 'У наших хирургов — исключительная квалификация и опыт, авторские методики.',
    text: '',
  },
  {
    num: '03',
    title: 'Гармонизирующий подход: замеры и расчёт пропорций перед каждой операцией, единая методология для всех врачей клиники.',
    text: '',
  },
];

const accreditations = [
  { abbr: 'РНИМУ им. Пирогова', full: 'Ординатура по пластической хирургии' },
  { abbr: '1-й МГМУ им. Сеченова', full: 'Ординатура по пластической хирургии' },
  { abbr: 'РНЦХ им. Петровского', full: 'Ординатура по пластической хирургии' },
  { abbr: 'Челюстно-лицевая хирургия', full: 'Отдельное направление — для сложных и вторичных ринопластик' },
  { abbr: 'Исключительная квалификация и опыт', full: 'Членство хирургов клиники' },
  { abbr: 'Патенты', full: 'Авторские методики, разработанные хирургами клиники. Детали — на страницах конкретных врачей' },
];

const faqItems = [
  {
    q: 'The Platinental — это филиал московской клиники?',
    a: 'Нет. The Platinental Казань — самостоятельное юридическое лицо (ООО «Платинентал Казань»). С московской клиникой у нас общий бренд и один из основателей, но это отдельные проекты.',
    open: true,
  },
  {
    q: 'С какого года работает клиника?',
    a: 'С 2011 года. За это время в клинике выполнены тысячи операций и процедур.',
  },
  {
    q: 'Есть ли у хирургов международные сертификаты?',
    a: 'Все хирурги клиники — выпускники ординатуры РНИМУ Пирогова, Сеченовского университета, РНЦХ Петровского. У отдельных специалистов — членство в международных профессиональных ассоциациях; уточнить можно на странице конкретного врача.',
  },
  {
    q: 'Где находится клиника?',
    a: 'ул. Карла Маркса, 48, корп. 1. Казань, 420015. Приём ежедневно с 9:00 до 20:00.',
  },
];
---

<V3Layout
  title="О клинике — The Platinental Казань"
  description="The Platinental — клиника пластической хирургии и косметологии в Казани с 2011 года. Авторские методики, деликатный подход, исключительная квалификация хирургов."
>
  <Navigation />
  <main id="main">
    <PageHero
      pageMarker="—"
      pageMarkerLabel="О клинике"
      eyebrow="PLATINENTAL КАЗАНЬ"
      h1="Ум, честь и совесть современной пластической хирургии"
      lead="Концепция интеллигентной и уважительной гармонизации внешности."
      ctaPrimary={{ label: 'Записаться на консультацию', href: '#form' }}
      ctaSecondary={{ label: 'Врачи клиники', href: '/doctors' }}
    />

    <!-- Философия -->
    <section class="v3-philosophy v3-surface-cream" aria-label="Философия клиники">
      <div class="v3-container v3-container-wide philosophy-grid" data-v3-reveal>
        <div class="philosophy-text">
          <blockquote class="philosophy-quote">
            <p class="v3-display"><em>«Мы не создаём абстрактно красивые лица. Мы создаём образы с характером — запоминающиеся, со своей индивидуальностью, усиливающие звучание привлекательных черт»</em></p>
          </blockquote>
          <div class="philosophy-body">
            <p class="v3-lead">С момента основания клиника придерживается одного принципа: чтобы на выходе получить превосходные пропорции, мы всегда начинаем с замеров.</p>
            <p class="v3-body">Хирург не просто выполняет операцию, а проектирует результат. Замеры, расчёт пропорций, индивидуальный план — и только потом скальпель. У каждого врача клиники своя школа, свой опыт и авторские техники — и при этом общая философия: деликатная, уважительная гармонизация.</p>
            <p class="v3-body">Идейный вдохновитель этой философии — Андрей Искорнев, один из учредителей клиники, хирург, оперирующий в Москве и Лос-Анджелесе, действительный член ASPS, ISAPS и IPRAS.</p>
          </div>
          <div>
            <a href="/doctors" class="v3-btn v3-btn-secondary">Познакомиться с врачами</a>
          </div>
        </div>
        <div class="philosophy-photo v3-photo-film v3-photo-shutter" data-v3-reveal>
          <div class="v3-photo-breathing">
            <Image
              src={clinicReception}
              alt="Ресепшн клиники The Platinental — мраморная стойка и подвесные светильники"
              widths={[480, 800, 1200]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              class="philosophy-img"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- История -->
    <section class="v3-timeline v3-surface-sand" aria-labelledby="timeline-heading">
      <div class="v3-container v3-container-default">
        <header class="timeline-header" data-v3-stagger>
          <span class="v3-eyebrow">История</span>
          <h2 id="timeline-heading" class="v3-h2"><em>Как мы росли</em></h2>
        </header>
        <ol class="timeline-list" data-v3-reveal>
          {milestones.map((m) => (
            <li class="timeline-item">
              <span class="timeline-year v3-eyebrow">{m.year}</span>
              <p class="timeline-text v3-body">{m.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Галерея клиники -->
    <section class="v3-clinic-gallery v3-surface-cream" aria-label="Интерьеры клиники">
      <div class="gallery-strip v3-container v3-container-wide" data-v3-reveal>
        <div class="gallery-img-wrap">
          <Image
            src={clinicLobby}
            alt="Зона ожидания клиники The Platinental — фирменный интерьер с логотипом"
            width={720}
            height={960}
            loading="lazy"
            class="gallery-img"
          />
        </div>
        <div class="gallery-img-wrap">
          <Image
            src={clinicExterior}
            alt="Фасад клиники The Platinental — ул. Карла Маркса, 48"
            width={720}
            height={960}
            loading="lazy"
            class="gallery-img"
          />
        </div>
      </div>
    </section>

    <!-- Экономика качества -->
    <section class="v3-economics v3-surface-ink" aria-labelledby="economics-heading">
      <div class="v3-container v3-container-wide economics-grid" data-v3-reveal>
        <div class="economics-left">
          <span class="v3-eyebrow economics-eyebrow">Экономика качества</span>
          <h2 id="economics-heading" class="v3-display economics-display">
            <em>Ошибки хирурга<br />видны всегда.</em>
          </h2>
        </div>
        <div class="economics-right">
          <p class="v3-lead economics-lead">Хорошее «дорого» не ограничивается персональным подходом и красивым интерьером. В «дорого» вы платите за эстетический вкус, уникальный опыт и репутацию тех, кто умеет создавать идеальное по индивидуальным меркам.</p>
          <p class="v3-body economics-body">Вы покупаете годы учёбы и упорного труда — страховку от ошибок и посредственности. Именно поэтому выбор хирурга важнее выбора клиники: результат живёт на вашем лице, а не на сайте.</p>
        </div>
      </div>
    </section>

    <!-- Принципы -->
    <section class="v3-about-principles v3-surface-cream" aria-labelledby="principles-heading">
      <div class="v3-container v3-container-default">
        <header class="principles-header" data-v3-stagger>
          <span class="v3-eyebrow">О клинике</span>
          <h2 id="principles-heading" class="v3-h2"><em>Что стоит за каждой операцией</em></h2>
        </header>
        <ol class="principles-list" data-v3-stagger>
          {principles.map((p) => (
            <li class="principle-item">
              <span class="principle-num v3-eyebrow">{p.num}</span>
              <div class="principle-body">
                <h3 class="v3-h3">{p.title}</h3>
                {p.text && <p class="v3-body">{p.text}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Аккредитации -->
    <section class="v3-accred v3-surface-ink" aria-labelledby="accred-heading">
      <div class="v3-container v3-container-default">
        <div class="accred-inner" data-v3-reveal>
          <span class="v3-eyebrow">Квалификация</span>
          <h2 id="accred-heading" class="v3-h2"><em>Образование и аккредитация</em></h2>
          <ul class="accred-list">
            {accreditations.map((a) => (
              <li class="accred-item">
                <span class="accred-abbr v3-h3">{a.abbr}</span>
                <span class="v3-body accred-full">{a.full}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <FAQ
      eyebrow="О клинике"
      heading="Частые вопросы"
      items={faqItems}
    />

    <!-- Цитата Искорнева -->
    <section class="v3-iskornev v3-surface-ink" aria-label="Цитата основателя">
      <div class="v3-container v3-container-default iskornev-wrap" data-v3-reveal>
        <blockquote class="iskornev-quote">
          <p class="v3-h2 iskornev-text"><em>«В мире, где избыточность является минимальным стандартом, деликатность ценится как новое сокровище. Именно так мы относимся к внешности наших пациентов. Внося едва заметные коррективы, мы создаём образ, в котором вам будет комфортно покорять новый мир.»</em></p>
          <footer class="iskornev-author v3-eyebrow">
            Андрей Искорнев, один из учредителей и идейный вдохновитель · Член ASPS, ISAPS, IPRAS
          </footer>
        </blockquote>
        <figure class="iskornev-media">
          <img
            src="/quote/iskornev-portrait-2026.png"
            alt="Портрет Андрея Искорнева"
            class="iskornev-photo"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <FinalCTA
      heading="Познакомьтесь<br />с клиникой"
      lead="Запишитесь на первичную консультацию. Расскажем о возможностях и ответим на все вопросы."
    />
  </main>
  <Footer />
</V3Layout>

<style>
  /* Philosophy */
  .v3-philosophy {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .philosophy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .philosophy-text {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-small);
  }
  .philosophy-quote { margin: 0; }
  .philosophy-quote .v3-display { max-width: 28ch; }
  .philosophy-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 56ch;
  }
  .philosophy-body p { margin: 0; }
  .philosophy-photo {
    position: sticky;
    top: calc(var(--v3-nav-h, 4rem) + 2rem);
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--v3-radius-xl);
  }
  .philosophy-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 3/4;
    object-fit: cover;
    object-position: center top;
  }

  /* Clinic gallery */
  .v3-clinic-gallery {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .gallery-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }
  .gallery-img-wrap {
    aspect-ratio: 3/4;
    overflow: hidden;
    border-radius: var(--v3-radius-xl);
  }
  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s ease;
  }
  .gallery-img-wrap:hover .gallery-img {
    transform: scale(1.03);
  }

  /* Economics */
  .v3-economics {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .economics-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .economics-eyebrow { color: var(--v3-on-ink-muted); }
  .economics-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .economics-display {
    color: var(--v3-on-ink);
    margin: 0;
  }
  .economics-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }
  .economics-lead { color: var(--v3-on-ink); margin: 0; }
  .economics-body { color: var(--v3-on-ink-secondary); margin: 0; }

  /* Iskornev quote */
  .v3-iskornev {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .iskornev-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .iskornev-quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-h1-lead);
  }
  .iskornev-text { color: var(--v3-on-ink); margin: 0; }
  .iskornev-author { color: var(--v3-on-ink-muted); }
  .iskornev-media {
    position: relative;
    margin: 0;
    justify-self: end;
    width: min(100%, 24rem);
  }
  .iskornev-media::before {
    content: '';
    position: absolute;
    inset: -1rem 1rem 1rem -1rem;
    border: 1px solid rgba(255, 254, 242, 0.12);
    border-radius: calc(var(--v3-radius-xl) + 0.375rem);
    pointer-events: none;
  }
  .iskornev-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 27 / 36;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--v3-radius-xl);
  }

  /* Timeline */
  .v3-timeline {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--v3-border-hair);
    align-items: baseline;
  }
  .timeline-item:last-child { border-bottom: 1px solid var(--v3-border-hair); }
  .timeline-year {
    color: var(--v3-champagne-deep);
    letter-spacing: 0.12em;
  }
  .timeline-text {
    margin: 0;
    color: var(--v3-ink-secondary);
  }

  /* Principles */
  .v3-about-principles {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .principles-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    background: var(--v3-border-hair);
  }
  .principle-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 2rem 2.5rem;
    background: var(--v3-cream);
  }
  .principle-num { color: var(--v3-ink-muted); }
  .principle-body { display: flex; flex-direction: column; gap: 0.75rem; }
  .principle-body .v3-body { margin: 0; }

  /* Accreditations */
  .v3-accred {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .accred-inner {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-h1-lead);
    max-width: 52rem;
  }
  .accred-lead { max-width: 52ch; }
  .accred-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--v3-border-on-ink);
  }
  .accred-item {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 2rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--v3-border-on-ink);
    align-items: baseline;
  }
  .accred-abbr { color: var(--v3-champagne); }
  .accred-full { color: var(--v3-on-ink-secondary); margin: 0; }

  @media (max-width: 1024px) {
    .philosophy-grid { grid-template-columns: 1fr; }
    .philosophy-photo { position: static; order: -1; }
    .economics-grid { grid-template-columns: 1fr; }
    .iskornev-wrap {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .iskornev-media {
      justify-self: start;
      width: min(100%, 22rem);
    }
    .iskornev-media::before {
      inset: -0.75rem 0.75rem 0.75rem -0.75rem;
    }
  }
  @media (max-width: 768px) {
    .timeline-item { grid-template-columns: 4rem 1fr; gap: 1rem; }
    .principles-list { grid-template-columns: 1fr; }
    .accred-item { grid-template-columns: 1fr; gap: 0.25rem; }
    .gallery-strip { grid-template-columns: 1fr; }
  }
</style>
