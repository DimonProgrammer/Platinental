---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/site/sections/Navigation.astro';
import PageHero from '../components/site/sections/PageHero.astro';
import PageLeadMagnet from '../components/site/sections/PageLeadMagnet.astro';
import SurgicalPartnersBlock from '../components/site/sections/SurgicalPartnersBlock.astro';
import FinalCTA from '../components/site/sections/FinalCTA.astro';
import FAQ from '../components/site/sections/FAQ.astro';
import Footer from '../components/site/sections/Footer.astro';
import { Image } from 'astro:assets';
import aboutClinicReception from '../assets/photos/about-clinic-reception.png';
import aboutClinicExterior from '../assets/photos/about-clinic-exterior.png';
import aboutClinicLogoWall from '../assets/photos/about-clinic-logo-wall.png';
import aboutClinicLounge from '../assets/photos/about-clinic-lounge.png';

const principles = [
  {
    num: '01',
    title: 'Сильная квалификация врачей',
    text: 'Хирурги клиники проходили подготовку в РНИМУ им. Пирогова, 1-м МГМУ им. Сеченова, РНЦХ им. Петровского и других профильных медицинских центрах.',
  },
  {
    num: '02',
    title: 'Своя специализация у каждого врача',
    text: 'Врачи клиники работают по своим направлениям и глубоко ведут узкие профили: пластика лица и тела, ринопластика, маммопластика, косметология, челюстно-лицевая хирургия и регенеративные методики.',
  },
  {
    num: '03',
    title: 'План операции после очной оценки',
    text: 'Врач разбирает анатомию, состояние тканей, показания, ограничения и задачу пациента. После этого обсуждаются метод, объём вмешательства, подготовка и восстановление.',
  },
];

const management = [
  {
    name: 'Сергеева Гузель Ильдусовна',
    role: 'Директор клиники',
    text: 'Отвечает за работу ООО «Платинентал Казань» и организационный контур клиники.',
    initials: 'СГ',
  },
  {
    name: 'Грицай Олеся Анатольевна',
    role: 'Главный врач, врач-косметолог',
    text: 'Ведёт косметологическое направление и сопровождение пациентов до и после процедур.',
    photo: '/doctors/gritsay/photo.png',
    photoAlt: 'Портрет Грицай Олеси Анатольевны',
  },
];

const clinicGallery = [
  {
    src: aboutClinicReception,
    alt: 'Ресепшн клиники The Platinental — мраморная стойка и световая композиция',
    title: 'Ресепшн',
    className: 'gallery-img gallery-img-reception',
  },
  {
    src: aboutClinicExterior,
    alt: 'Фасад клиники The Platinental на улице Карла Маркса, 48',
    title: 'Фасад на Карла Маркса',
    className: 'gallery-img gallery-img-exterior',
  },
  {
    src: aboutClinicLogoWall,
    alt: 'Интерьер клиники The Platinental — брендовая стена у ресепшна',
    title: 'Брендовая зона',
    className: 'gallery-img gallery-img-logo',
  },
  {
    src: aboutClinicLounge,
    alt: 'Зона ожидания клиники The Platinental с диваном и фирменным знаком',
    title: 'Зона ожидания',
    className: 'gallery-img gallery-img-lounge',
  },
];

const faqItems = [
  {
    q: 'Кто ведёт приём в The Platinental Казань?',
    a: 'В клинике принимают пластические хирурги, косметологи и специалисты смежных направлений. Профиль каждого врача указан на его странице: образование, специализация, ключевые направления и подтверждённые профессиональные факты.',
    open: true,
  },
  {
    q: 'С какого года работает клиника?',
    a: 'С 2011 года. За это время клиника развила направления пластической хирургии, косметологии и космецевтики в Казани.',
  },
  {
    q: 'Где посмотреть образование и квалификацию врачей?',
    a: 'На страницах врачей указаны профильное образование, ординатура, дополнительное обучение и членство в профессиональных ассоциациях, если оно подтверждено для конкретного специалиста.',
  },
  {
    q: 'Где находится клиника?',
    a: 'ул. Карла Маркса, 48, корп. 1. Казань, 420015. Приём ежедневно с 9:00 до 20:00.',
  },
];
---

<SiteLayout
  title="О клинике The Platinental Казань — хирургия и косметология"
  description="The Platinental — клиника пластической хирургии и косметологии в Казани с 2011 года. Деликатный подход, профильная подготовка врачей и открытые документы."
>
  <Navigation />
  <main id="main">
    <PageHero
      pageMarker="—"
      pageMarkerLabel="О клинике"
      eyebrow="PLATINENTAL КАЗАНЬ"
      h1="Пластическая хирургия и косметология для деликатной гармонизации внешности в клинике The Platinental Казань"
      lead="Сила клиники — в команде врачей с разными хирургическими школами, специализациями и эстетическим видением. Пациент приходит с запросом, а команда помогает выбрать специалиста и тактику: хирургическую, косметологическую или комбинированную — под анатомию, ткани, ожидания и допустимый объём изменений."
      ctaPrimary={{ label: 'Записаться на консультацию', href: '#form' }}
      ctaSecondary={{ label: 'Смотреть врачей', href: '/doctors' }}
    />

    <!-- Философия -->
    <section class="v3-philosophy v3-surface-cream" aria-label="Философия клиники">
      <div class="v3-container v3-container-wide philosophy-grid" data-v3-reveal>
        <div class="philosophy-text">
          <blockquote class="philosophy-quote">
            <p class="v3-display"><em>Сильная врачебная команда для точного и естественного результата</em></p>
          </blockquote>
          <div class="philosophy-body">
            <p class="v3-lead">The Platinental Казань — клиника пластической хирургии и косметологии в центре Казани. Главная сила клиники — врачебная команда: пластические хирурги, косметологи и специалисты смежных направлений с серьёзной подготовкой, опытом и собственным профессиональным фокусом.</p>
            <p class="v3-body">Здесь работают с эстетикой лица и тела, ринопластикой, маммопластикой, челюстно-лицевой хирургией, косметологией и регенеративными методиками. У отдельных врачей есть авторские разработки, патентная работа и международный профессиональный опыт.</p>
          </div>
          <div>
            <a href="/doctors" class="v3-btn v3-btn-secondary">Познакомиться с командой</a>
          </div>
        </div>
        <div class="philosophy-photo v3-photo-film v3-photo-shutter" data-v3-reveal>
          <div class="v3-photo-breathing">
            <Image
              src={aboutClinicReception}
              alt="Ресепшн клиники The Platinental — мраморная стойка и подвесные светильники"
              widths={[480, 800, 1200]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              class="philosophy-img"
            />
          </div>
        </div>
      </div>
    </section>

    <PageLeadMagnet
      eyebrow="Перед первым визитом"
      heading="Первое знакомство<br />с клиникой"
      lead="Если вы только выбираете клинику, не обязательно сразу принимать решение об операции. Оставьте заявку — администратор подскажет, с какого специалиста начать, какие вопросы подготовить и какие документы посмотреть заранее."
      items={[
        { mark: '✓', title: 'Документы', text: 'лицензия, юрлицо, адрес и правила оказания услуг' },
        { mark: '+', title: 'Команда', text: 'кто из специалистов работает с вашей задачей' },
        { mark: '→', title: 'Первичный визит', text: 'что взять с собой и как проходит консультация' },
      ]}
      ctaPrimary={{ label: 'Получить ориентир', href: '#form' }}
      ctaSecondary={{ label: 'Смотреть документы', href: '/documents' }}
      surface="sand"
    />

    <SurgicalPartnersBlock />

    <!-- Галерея клиники -->
    <section class="v3-clinic-gallery v3-surface-cream" aria-label="Интерьеры клиники">
      <div class="gallery-shell v3-container v3-container-wide">
        <header class="gallery-header" data-v3-stagger>
          <span class="v3-eyebrow">Пространство</span>
          <h2 class="v3-h2"><em>Клиника внутри и снаружи</em></h2>
        </header>
        <div class="gallery-strip" data-v3-reveal>
          {clinicGallery.map((item, index) => (
            <figure class={`gallery-img-wrap gallery-img-wrap-${index + 1}`}>
              <Image
                src={item.src}
                alt={item.alt}
                widths={[420, 640, 900, 1200]}
                sizes="(max-width: 768px) 100vw, (max-width: 1180px) 50vw, 33vw"
                loading="lazy"
                class={item.className}
              />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Принципы -->
    <section class="v3-about-principles v3-surface-cream" aria-labelledby="principles-heading">
      <div class="v3-container v3-container-default">
        <header class="principles-header" data-v3-stagger>
          <span class="v3-eyebrow">О клинике</span>
          <h2 id="principles-heading" class="v3-h2"><em>Что стоит за каждой операцией</em></h2>
        </header>
        <ol class="principles-list" data-v3-stagger>
          {principles.map((p) => (
            <li class="principle-item">
              <span class="principle-num v3-eyebrow">{p.num}</span>
              <div class="principle-body">
                <h3 class="v3-h3">{p.title}</h3>
                {p.text && <p class="v3-body">{p.text}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="v3-management v3-surface-cream" aria-labelledby="management-heading">
      <div class="v3-container v3-container-default">
        <header class="management-header" data-v3-stagger>
          <span class="v3-eyebrow">Ответственные лица</span>
          <h2 id="management-heading" class="v3-h2"><em>Управление и медицинский контур</em></h2>
        </header>
        <ul class="management-list">
          {management.map((item) => (
            <li class="management-item">
              <figure class="management-photo-wrap" aria-hidden={item.photo ? 'false' : 'true'}>
                {item.photo ? (
                  <img
                    src={item.photo}
                    alt={item.photoAlt}
                    class="management-photo"
                    loading="lazy"
                    decoding="async"
                    width="420"
                    height="520"
                  />
                ) : (
                  <div class="management-photo management-photo-placeholder">
                    <span>{item.initials}</span>
                  </div>
                )}
              </figure>
              <div class="management-copy">
                <span class="v3-eyebrow management-role">{item.role}</span>
                <h3 class="v3-h3 management-name">{item.name}</h3>
                <p class="v3-body management-text">{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <FinalCTA
      heading="Познакомьтесь<br />с клиникой"
      lead="Запишитесь на первичную консультацию. Расскажем о возможностях и ответим на все вопросы."
    />

    <FAQ
      eyebrow="О клинике"
      heading="Частые вопросы"
      items={faqItems}
    />
  </main>
  <Footer />
</SiteLayout>

<style>
  /* Philosophy */
  .v3-philosophy {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .philosophy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .philosophy-text {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-small);
  }
  .philosophy-quote { margin: 0; }
  .philosophy-quote .v3-display { max-width: 28ch; }
  .philosophy-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 56ch;
  }
  .philosophy-body p { margin: 0; }
  .philosophy-photo {
    position: sticky;
    top: calc(var(--v3-nav-h, 4rem) + 2rem);
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--v3-radius-xl);
  }
  .philosophy-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 3/4;
    object-fit: cover;
    object-position: center top;
  }
  .philosophy-photo.v3-photo-film > * {
    filter: none;
  }
  .philosophy-photo.v3-photo-film:hover > *,
  .philosophy-photo.v3-photo-film:focus-within > * {
    filter: none;
  }

  /* Clinic gallery */
  .v3-clinic-gallery {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .gallery-shell {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-small);
  }
  .gallery-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    max-width: 46rem;
  }
  .gallery-strip {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr) minmax(0, 0.92fr);
    grid-auto-rows: minmax(18rem, 28vw);
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }
  .gallery-img-wrap {
    position: relative;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--v3-radius-lg);
    background: var(--v3-surface-card);
    border: 1px solid var(--v3-border-soft);
  }
  .gallery-img-wrap-1 {
    grid-row: span 2;
  }
  .gallery-img-wrap-4 {
    grid-column: span 2;
  }
  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s ease;
  }
  .gallery-img-reception { object-position: center center; }
  .gallery-img-exterior { object-position: center center; }
  .gallery-img-logo { object-position: center center; }
  .gallery-img-lounge { object-position: center center; }
  .gallery-img-wrap:hover .gallery-img {
    transform: scale(1.03);
  }
  /* Principles */
  .v3-about-principles {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .principles-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    background: var(--v3-border-hair);
  }
  .principle-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 2rem 2.5rem;
    background: var(--v3-cream);
  }
  .principle-num { color: var(--v3-ink-muted); }
  .principle-body { display: flex; flex-direction: column; gap: 0.75rem; }
  .principle-body .v3-body { margin: 0; }

  /* Management */
  .v3-management {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .management-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
    max-width: 42rem;
  }
  .management-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--v3-border-hair);
  }
  .management-item {
    background: var(--v3-cream);
    padding: clamp(1rem, 2vw, 1.5rem);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.25rem);
  }
  .management-photo-wrap {
    margin: 0;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--v3-radius-lg);
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--v3-sand) 68%, var(--v3-cream)), var(--v3-cream));
    border: 1px solid color-mix(in srgb, var(--v3-border-soft) 78%, transparent);
  }
  .management-photo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }
  .management-photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--v3-champagne-deep);
    font-family: var(--v3-font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .management-copy {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .management-role {
    color: var(--v3-champagne-deep);
  }
  .management-name,
  .management-text {
    margin: 0;
  }
  .management-text {
    color: var(--v3-ink-secondary);
  }

  @media (max-width: 1024px) {
    .philosophy-grid { grid-template-columns: 1fr; }
    .philosophy-photo { position: static; order: -1; }
    .management-list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 768px) {
    .principles-list { grid-template-columns: 1fr; }
    .gallery-strip {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .gallery-img-wrap,
    .gallery-img-wrap-1,
    .gallery-img-wrap-4 {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 3 / 4;
    }
    .gallery-img-wrap-2 { aspect-ratio: 4 / 5; }
  }
</style>
