---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import clinicReception from '../../assets/photos/clinic-reception.webp';
import clinicLobby from '../../assets/photos/clinic-lobby.webp';
import clinicExterior from '../../assets/photos/clinic-exterior.webp';
---

<BaseLayout
  title="The Platinental — 3 направления дизайна"
  description="Три кардинально разных светлых концепта для выбора визуального направления сайта The Platinental Казань."
  canonical="https://kzn.platinental.ru/concept/style-directions"
  darkHero={false}
>
  <div class="directions-page">
    <section class="sd-intro" aria-labelledby="sd-intro-heading">
      <div class="sd-shell">
        <p class="sd-eyebrow">Concept selection board</p>
        <h1 id="sd-intro-heading" class="sd-title">
          Три светлых направления,
          которые совсем не похожи
          друг на друга
        </h1>
        <p class="sd-lead">
          Это не одна страница в трёх оттенках, а три разные дизайнерские логики.
          Все они светлые, современные и заметно отстраиваются от текущего сайта
          клиники: от WordPress-ощущения, типовой клинической подачи и тяжёлой
          “просто премиальной” картинки без чёткого характера.
        </p>
      </div>
    </section>

    <section class="direction direction-opal" aria-labelledby="opal-heading">
      <div class="sd-shell direction-grid">
        <div class="direction-copy" data-reveal>
          <p class="direction-code">Direction 01</p>
          <h2 id="opal-heading" class="direction-title direction-title-opal">
            Liquid Opal
          </h2>
          <p class="direction-sub">
            Светлый футуристичный premium с аккуратным liquid glass.
          </p>
          <p class="direction-text">
            Это вариант про прозрачность, блеск, мягкие слои и ощущение современной
            luxury-tech эстетики. Использовать glass не как gimmick на всём сайте,
            а точечно: в hero-панелях, вторичных карточках, фильтрах, floating-элементах.
          </p>

          <ul class="direction-points">
            <li>Палитра: ice blue, silver, cool pearl</li>
            <li>Типографика: Instrument Serif + Manrope</li>
            <li>Формы: rounded glass-panels, мягкие блики, layered depth</li>
          </ul>

          <div class="swatches">
            <span style="--sw:#F4FAFF"></span>
            <span style="--sw:#DCEEFF"></span>
            <span style="--sw:#9CC7DE"></span>
            <span style="--sw:#173041"></span>
          </div>
        </div>

        <div class="direction-preview preview-opal" data-reveal>
          <div class="preview-opal-stage">
            <Image
              src={clinicReception}
              alt="Reception-зона клиники как основа для концепта Liquid Opal"
              width={1200}
              height={1500}
              class="preview-image preview-image-opal"
              loading="eager"
            />
            <div class="glass-card glass-card-main">
              <span class="glass-kicker">New hero card</span>
              <strong>Эстетическая хирургия без визуальной тяжести</strong>
              <p>Лёгкий, дорогой, почти косметический свет вместо драматичного люкса.</p>
            </div>
            <div class="glass-card glass-card-chip">Liquid glass only on accents</div>
          </div>
        </div>
      </div>
    </section>

    <section class="direction direction-gallery" aria-labelledby="gallery-heading">
      <div class="sd-shell direction-grid">
        <div class="direction-copy" data-reveal>
          <p class="direction-code">Direction 02</p>
          <h2 id="gallery-heading" class="direction-title direction-title-gallery">
            Gallery Mono
          </h2>
          <p class="direction-sub">
            Почти монохромная editorial-система с очень тихим sage-акцентом.
          </p>
          <p class="direction-text">
            Этот вариант ощущается как дорогой арт-каталог или частная галерея,
            а не как “сайт клиники”. Много белого поля, чёткая сетка, минимальное
            количество цвета, сильная типографика и очень дисциплинированная структура.
          </p>

          <ul class="direction-points">
            <li>Палитра: chalk white, stone, soft graphite, pale sage</li>
            <li>Типографика: Prata + Sora</li>
            <li>Формы: прямоугольные карточки, ровные поля, grid-first layout</li>
          </ul>

          <div class="swatches">
            <span style="--sw:#FAFAF7"></span>
            <span style="--sw:#E9EAE3"></span>
            <span style="--sw:#B7C0B5"></span>
            <span style="--sw:#232629"></span>
          </div>
        </div>

        <div class="direction-preview preview-gallery" data-reveal>
          <div class="gallery-frame gallery-frame-large">
            <Image
              src={clinicExterior}
              alt="Фасад клиники как основа для концепта Gallery Mono"
              width={1400}
              height={1100}
              class="preview-image preview-image-gallery"
              loading="eager"
            />
          </div>
          <div class="gallery-meta">
            <div class="gallery-card">
              <span>A1</span>
              <strong>Частная клиника, а не лендинг</strong>
            </div>
            <div class="gallery-card">
              <span>A2</span>
              <strong>Сетка и дисциплина важнее декоративности</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="direction direction-rose" aria-labelledby="rose-heading">
      <div class="sd-shell direction-grid">
        <div class="direction-copy" data-reveal>
          <p class="direction-code">Direction 03</p>
          <h2 id="rose-heading" class="direction-title direction-title-rose">
            Rose Current
          </h2>
          <p class="direction-sub">
            Современный soft editorial с пудрово-розовым и вишнёвым контрастом.
          </p>
          <p class="direction-text">
            Это самый fashion-oriented сценарий из трёх. Он светлый, но не нейтральный:
            в нём есть настроение, более женственная эмоциональность и ощущение beauty-editorial,
            при этом без ухода в салонность и без тёплого бежевого шика.
          </p>

          <ul class="direction-points">
            <li>Палитра: shell pink, milk, muted rose, dark cherry</li>
            <li>Типографика: Cormorant Garamond + Manrope</li>
            <li>Формы: мягкие радиусы, layered cards, fashion-style copy blocks</li>
          </ul>

          <div class="swatches">
            <span style="--sw:#FFF8FA"></span>
            <span style="--sw:#F5E4EA"></span>
            <span style="--sw:#C490A4"></span>
            <span style="--sw:#40252F"></span>
          </div>
        </div>

        <div class="direction-preview preview-rose" data-reveal>
          <div class="rose-stage">
            <div class="rose-copy-card">
              <span>New mood</span>
              <strong>Светлая эстетика может быть не только белой и бежевой</strong>
            </div>
            <Image
              src={clinicLobby}
              alt="Интерьер клиники как основа для концепта Rose Current"
              width={1200}
              height={900}
              class="preview-image preview-image-rose"
              loading="eager"
            />
            <div class="rose-chip-row">
              <span>Editorial</span>
              <span>Fashion-aware</span>
              <span>Soft contrast</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sd-next" aria-labelledby="sd-next-heading">
      <div class="sd-shell sd-next-box" data-reveal>
        <p class="sd-eyebrow">Next step</p>
        <h2 id="sd-next-heading" class="sd-next-title">
          Согласуем одно направление и потом уже доводим его до полноценной главной.
        </h2>
        <p class="sd-next-copy">
          Я бы сейчас не смешивал их между собой. Логика правильная такая:
          выбираем один характер, один цветовой вектор и один тип композиции,
          а потом уже углубляем hero, блоки, формы, типографику и фото-подачу.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&family=Prata&family=Sora:wght@400;500;600&display=swap&subset=cyrillic');

  .directions-page {
    background: #f7f8f7;
    color: #1f2428;
  }

  .directions-page :global(main) {
    background: transparent;
  }

  .sd-shell {
    width: min(1280px, calc(100% - 40px));
    margin: 0 auto;
  }

  .sd-intro {
    padding: calc(var(--nav-height) + 56px) 0 48px;
    background:
      radial-gradient(circle at top right, rgba(210, 228, 241, 0.5), transparent 30%),
      linear-gradient(180deg, #fbfcfc 0%, #f4f6f6 100%);
  }

  .sd-eyebrow,
  .direction-code,
  .glass-kicker,
  .gallery-card span,
  .rose-copy-card span,
  .ms-panel-label {
    font-family: 'Manrope', var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sd-eyebrow,
  .direction-code {
    color: rgba(31, 36, 40, 0.55);
  }

  .sd-title {
    font-family: 'Prata', var(--font-display);
    font-size: clamp(2.8rem, 4.7vw, 5.2rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: 12ch;
    margin: 14px 0 0;
  }

  .sd-lead,
  .direction-text,
  .direction-sub,
  .direction-points li,
  .sd-next-copy,
  .glass-card p {
    font-family: 'Manrope', var(--font-body);
    font-size: clamp(1rem, 1vw, 1.0625rem);
    line-height: 1.7;
  }

  .sd-lead {
    max-width: 60ch;
    margin: 22px 0 0;
    color: rgba(31, 36, 40, 0.72);
  }

  .direction {
    padding: 64px 0;
  }

  .direction-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 36px;
    align-items: center;
  }

  .direction-copy {
    min-width: 0;
  }

  .direction-title {
    margin: 10px 0 0;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .direction-title-opal {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(2.7rem, 4vw, 4.4rem);
    color: #173041;
  }

  .direction-title-gallery {
    font-family: 'Prata', serif;
    font-size: clamp(2.5rem, 3.8vw, 4rem);
    color: #232629;
  }

  .direction-title-rose {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.8rem, 4.2vw, 4.5rem);
    font-style: italic;
    color: #40252f;
  }

  .direction-sub {
    margin: 14px 0 0;
    color: rgba(31, 36, 40, 0.88);
  }

  .direction-text {
    margin: 14px 0 0;
    color: rgba(31, 36, 40, 0.72);
    max-width: 56ch;
  }

  .direction-points {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: grid;
    gap: 10px;
  }

  .direction-points li {
    position: relative;
    padding-left: 16px;
    color: rgba(31, 36, 40, 0.7);
  }

  .direction-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78rem;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.4;
  }

  .swatches {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }

  .swatches span {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: var(--sw);
    border: 1px solid rgba(31, 36, 40, 0.08);
    box-shadow: 0 12px 24px rgba(31, 36, 40, 0.05);
  }

  .direction-preview {
    min-width: 0;
  }

  .preview-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .direction-opal {
    background:
      radial-gradient(circle at 20% 20%, rgba(183, 221, 247, 0.32), transparent 24%),
      linear-gradient(180deg, #f4f9ff 0%, #edf4fb 100%);
  }

  .preview-opal-stage {
    position: relative;
    min-height: 620px;
    border-radius: 34px;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(219, 234, 247, 0.35)),
      rgba(244, 250, 255, 0.8);
    border: 1px solid rgba(114, 150, 178, 0.18);
    box-shadow: 0 30px 70px rgba(71, 103, 128, 0.12);
  }

  .preview-image-opal {
    filter: saturate(0.92) contrast(1.04) brightness(1.02);
  }

  .glass-card {
    position: absolute;
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.22));
    border: 1px solid rgba(255, 255, 255, 0.42);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      0 18px 46px rgba(65, 91, 118, 0.16);
    color: #163040;
  }

  .glass-card-main {
    left: 24px;
    bottom: 24px;
    width: min(320px, calc(100% - 48px));
    border-radius: 24px;
    padding: 18px;
  }

  .glass-card-main strong {
    display: block;
    font-family: 'Instrument Serif', serif;
    font-size: 1.9rem;
    line-height: 1.06;
    font-style: italic;
    margin-top: 10px;
  }

  .glass-card-main p {
    margin: 10px 0 0;
    color: rgba(22, 48, 64, 0.78);
  }

  .glass-card-chip {
    top: 22px;
    right: 22px;
    border-radius: 999px;
    padding: 12px 16px;
    font-family: 'Manrope', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .direction-gallery {
    background: linear-gradient(180deg, #f8f8f5 0%, #f2f3ef 100%);
  }

  .direction-gallery .direction-grid {
    align-items: start;
  }

  .preview-gallery {
    display: grid;
    gap: 14px;
  }

  .gallery-frame,
  .gallery-card {
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(35, 38, 41, 0.1);
    box-shadow: 0 20px 40px rgba(35, 38, 41, 0.06);
  }

  .gallery-frame-large {
    aspect-ratio: 1.18 / 1;
    border-radius: 8px;
    overflow: hidden;
  }

  .preview-image-gallery {
    filter: grayscale(8%) saturate(0.9) contrast(1.02);
  }

  .gallery-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .gallery-card {
    min-height: 136px;
    padding: 18px;
    border-radius: 8px;
  }

  .gallery-card span {
    color: #7a8573;
  }

  .gallery-card strong {
    display: block;
    margin-top: 18px;
    font-family: 'Sora', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    color: #232629;
  }

  .direction-rose {
    background:
      radial-gradient(circle at top left, rgba(251, 223, 233, 0.35), transparent 22%),
      linear-gradient(180deg, #fff8fa 0%, #f8eef2 100%);
  }

  .rose-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 16px;
    align-items: start;
  }

  .rose-copy-card,
  .rose-chip-row span {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(64, 37, 47, 0.1);
    box-shadow: 0 18px 36px rgba(96, 67, 78, 0.08);
  }

  .rose-copy-card {
    border-radius: 26px;
    padding: 22px;
  }

  .rose-copy-card span {
    font-family: 'Manrope', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(64, 37, 47, 0.55);
  }

  .rose-copy-card strong {
    display: block;
    margin-top: 18px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    line-height: 1.04;
    font-style: italic;
    color: #40252f;
  }

  .preview-image-rose {
    border-radius: 30px;
    overflow: hidden;
    min-height: 560px;
    box-shadow: 0 24px 48px rgba(96, 67, 78, 0.1);
  }

  .rose-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    grid-column: 1 / -1;
  }

  .rose-chip-row span {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 16px;
    border-radius: 999px;
    font-family: 'Manrope', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b4453;
  }

  .sd-next {
    padding: 58px 0 84px;
    background: linear-gradient(180deg, #f7f8f7 0%, #eff2f1 100%);
  }

  .sd-next-box {
    max-width: 920px;
    padding: 28px 32px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(31, 36, 40, 0.08);
    box-shadow: 0 20px 46px rgba(31, 36, 40, 0.05);
  }

  .sd-next-title {
    margin: 12px 0 0;
    font-family: 'Prata', serif;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #20262a;
  }

  .sd-next-copy {
    margin: 16px 0 0;
    color: rgba(31, 36, 40, 0.72);
    max-width: 62ch;
  }

  @media (max-width: 1100px) {
    .direction-grid,
    .rose-stage {
      grid-template-columns: 1fr;
    }

    .gallery-meta {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .sd-shell {
      width: min(100% - 24px, 1280px);
    }

    .sd-intro {
      padding-top: calc(var(--nav-height-mobile) + 34px);
    }

    .direction {
      padding: 46px 0;
    }

    .preview-opal-stage {
      min-height: 500px;
    }

    .glass-card-main {
      left: 14px;
      right: 14px;
      width: auto;
      bottom: 14px;
    }

    .glass-card-chip {
      top: 14px;
      right: 14px;
      left: auto;
    }

    .swatches {
      flex-wrap: wrap;
    }

    .preview-image-rose {
      min-height: 420px;
    }

    .sd-next-box {
      padding: 22px 20px;
    }
  }
</style>
