---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/site/sections/Navigation.astro';
import PageHero from '../components/site/sections/PageHero.astro';
import PageLeadMagnet from '../components/site/sections/PageLeadMagnet.astro';
import FAQ from '../components/site/sections/FAQ.astro';
import FinalCTA from '../components/site/sections/FinalCTA.astro';
import Footer from '../components/site/sections/Footer.astro';
import { doctors } from '../data/doctors';
import { getSurgicalBase } from '../data/partners';
import { formatCurrencyPlainText, formatTypographyHtml } from '../lib/formatText';

const allDoctors = doctors;
const doctorCardCopy: Record<string, { spec?: string; short?: string }> = {
  iskornev: {
    spec: 'ЭСТЕТИЧЕСКАЯ ХИРУРГИЯ ЛИЦА И ШЕИ',
    short: 'Основатель The Platinental Москва и один из учредителей The Platinental Казань. Эстетическая хирургия лица и шеи, консультации и операции в Казани по индивидуальному графику.',
  },
  meloyan: {
    spec: 'ЭСТЕТИЧЕСКАЯ И РЕКОНСТРУКТИВНАЯ ХИРУРГИЯ',
    short: 'Эстетическая и реконструктивная хирургия с широкой хирургической базой: ринопластика, эстетическая хирургия молочных желёз, смежные задачи по лицу, телу и сосудистому профилю.',
  },
  tulatova: {
    spec: 'ДЕЛИКАТНАЯ ХИРУРГИЯ ЛИЦА И ВЕК',
    short: 'Деликатная хирургия лица: омоложение, работа с веками, верхней и средней третью лица с учетом анатомии и состояния тканей.',
  },
  vasilev: {
    spec: 'К.М.Н. · БЛЕФАРОПЛАСТИКА · МАММОПЛАСТИКА · КОНТУРИРОВАНИЕ ТЕЛА',
    short: 'Кандидат медицинских наук, соавтор четырёх зарегистрированных патентов. Работает с блефаропластикой, маммопластикой, контурированием тела и хирургической коррекцией шейно-подбородочной зоны.',
  },
  mardanova: {
    spec: 'РИНОПЛАСТИКА · БЛЕФАРОПЛАСТИКА',
    short: 'Главный профиль — риносептопластика: работа с формой носа, дыханием, пропорциями лица и восстановлением.',
  },
  brechko: {
    short: 'Сильная сторона — блефаропластика и работа с CO₂-лазером в задачах, где требуется аккуратная коррекция.',
  },
};

const doctorGroups = [
  {
    id: 'founder',
    title: 'Основатель The Platinental Москва, один из учредителей The Platinental Казань',
    lead: 'Андрей Искорнев — пластический хирург, учредитель и главный специалист клиники MESOBAR (Лос-Анджелес). Его хирургический профиль связан с пропорциями лица, анатомией и индивидуальным запросом пациента.',
    doctors: allDoctors.filter((doctor) => doctor.group === 'founder'),
  },
  {
    id: 'surgery',
    title: 'Хирурги клиники',
    lead: 'Пластическая и челюстно-лицевая хирургия: лицо, тело, сложные и повторные случаи.',
    doctors: allDoctors.filter((doctor) => doctor.group === 'surgery'),
  },
  {
    id: 'orthopedia',
    title: 'Регенеративная медицина, ортопедия и нейрохирургия',
    lead: 'Направление Бабаяна А.В. — метод MIBRAR, работа с позвоночником, суставами и восстановительным потенциалом тканей.',
    doctors: allDoctors.filter((doctor) => doctor.group === 'orthopedia'),
  },
  {
    id: 'cosmetology',
    title: 'Косметология',
    lead: 'Инъекционные, аппаратные и реабилитационные процедуры в связке с хирургическим лечением.',
    doctors: allDoctors.filter((doctor) => doctor.group === 'cosmetology'),
  },
].filter((group) => group.doctors.length > 0);
const filterOptions = [
  { id: 'all', label: 'Все специалисты' },
  { id: 'plastika', label: 'Пластическая хирургия' },
  { id: 'face', label: 'Лицо' },
  { id: 'body', label: 'Тело' },
  { id: 'cosmetology', label: 'Косметология' },
];
---

<SiteLayout
  title="Врачи The Platinental Казань — пластические хирурги и косметологи"
  description="Врачи The Platinental Казань: пластические хирурги, врач-косметолог и приглашённые специалисты по отдельным направлениям. Профили, образование и стоимость консультации."
>
  <Navigation />
  <main id="main">
    <PageHero
      pageMarker="04 / 04"
      pageMarkerLabel="Команда"
      eyebrow="THE PLATINENTAL · КАЗАНЬ"
      h1="Врачи клиники The Platinental в Казани"
      lead="Команда с профильной хирургической подготовкой, клинической практикой и узкими фокусными профилями: эстетическая хирургия лица и шеи, ринопластика, маммопластика, ортогнатическая хирургия, косметология и восстановление кожи после операций."
      ctaPrimary={{ label: 'Записаться на консультацию', href: '#form' }}
      ctaSecondary={{ label: 'Посмотреть врачей', href: '#doctors-heading' }}
    />

    <section class="v3-doctors v3-surface-cream" aria-labelledby="doctors-heading">
      <div class="v3-container v3-container-wide">
        <h2 id="doctors-heading" class="sr-only">Врачи клиники</h2>
        <div class="doctor-picker">
          <div>
            <p class="doctor-picker-title">Не знаете, к кому записаться?</p>
            <p class="v3-body">Опишите задачу администратору: лицо, тело, кожа, восстановление или сложный случай. Мы предложим врача по профилю.</p>
          </div>
          <a href="#form" class="v3-link v3-link-action">Помочь выбрать</a>
        </div>
        <ul class="doctors-filters" aria-label="Фильтр врачей по направлению">
          {filterOptions.map((option) => (
            <li>
              <button
                type="button"
                class={`filter-chip${option.id === 'all' ? ' is-active' : ''}`}
                data-doctor-filter={option.id}
                aria-pressed={option.id === 'all' ? 'true' : 'false'}
              >
                {option.label}
              </button>
            </li>
          ))}
        </ul>
        <div class="doctor-groups">
          {doctorGroups.map((group) => (
            <section class:list={['doctor-group', `doctor-group--${group.id}`]} data-doctor-group>
              <header class="doctor-group-header">
                <h3 class="v3-h3 doctor-group-title">{group.title}</h3>
                <p class="v3-body doctor-group-lead">{group.lead}</p>
              </header>
              <ul class="doctors-grid">
                {group.doctors.map((d) => {
                  const cardCopy = doctorCardCopy[d.slug];
                  const surgicalBase = getSurgicalBase(d.surgicalBase);
                  return (
                    <li class:list={['doctor-card', d.group === 'founder' && 'doctor-card--wide']} data-v3-reveal data-doctor-card data-tags={d.tags.join(' ')}>
                      <a href={`/doctors/${d.slug}`} class="doctor-link">
                        <div class="doctor-photo">
                          {d.photo ? (
                            <img
                              src={d.photo}
                              alt={d.name}
                              width="400"
                              height="500"
                              loading="lazy"
                              style={`--doctor-photo-scale:${d.photoFrame?.scale ?? 1.12}; --doctor-photo-x:${d.photoFrame?.x ?? '0%'}; --doctor-photo-y:${d.photoFrame?.y ?? '-3%'};`}
                            />
                          ) : (
                            <div class="doctor-initials" aria-hidden="true">{d.initials}</div>
                          )}
                        </div>
                        <div class="doctor-info">
                          <p class="doctor-spec v3-eyebrow">{cardCopy?.spec ?? d.spec}</p>
                          <h3 class="doctor-name v3-h3">{d.name}</h3>
                          <p class="doctor-short v3-body" set:html={formatTypographyHtml(cardCopy?.short ?? d.short)}></p>
                          {surgicalBase && <p class="doctor-base v3-caption">Операционная база: {surgicalBase.shortName}</p>}
                          {d.bookingEnabled === false ? (
                            <div class="doctor-price doctor-price-muted">
                              <span class="price-primary v3-caption">Открыть профиль</span>
                            </div>
                          ) : (
                            <div class="doctor-price">
                              <span class="price-primary v3-caption" set:html={formatCurrencyPlainText(d.priceMain)}></span>
                              {d.priceSub && <span class="price-sub v3-caption" set:html={formatCurrencyPlainText(d.priceSub)}></span>}
                            </div>
                          )}
                        </div>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <PageLeadMagnet
      eyebrow="Подбор врача"
      heading="Не знаете,<br />к кому записаться?"
      lead="Опишите задачу коротко — администратор направит к врачу нужного профиля"
      items={[
        { mark: '?', title: 'Запрос', text: 'что хотите изменить или уточнить' },
        { mark: '+', title: 'Профиль', text: 'хирург, челюстно-лицевой хирург или косметолог' },
        { mark: '→', title: 'Запись', text: 'подберём время и формат консультации' },
      ]}
      ctaPrimary={{ label: 'Подобрать врача', href: '#form' }}
      ctaSecondary={{ label: 'Смотреть всех', href: '#doctors-heading' }}
      surface="sand"
    />

    <FAQ items={[
      {
        q: 'Сколько стоит первичная консультация?',
        a: 'У косметолога — от 2 000 ₽. У хирурга — от 5 000 ₽.',
        open: true,
      },
      {
        q: 'Есть ли противопоказания к операциям?',
        a: 'Да. Часть — общие для любой хирургии: беременность, лактация, онкология, нарушения свёртываемости крови, тяжёлые хронические заболевания. Часть — индивидуальные: их хирург видит только на очной консультации.',
      },
      {
        q: 'Через сколько дней виден результат после ботулинотерапии?',
        a: 'Первый эффект появляется через 3–5 дней, окончательный — через 10–14 дней. Держится 4–6 месяцев в зависимости от препарата и индивидуальных особенностей.',
      },
      {
        q: 'Вы работаете с мужчинами?',
        a: 'Да. Чаще всего мужчины приходят с запросами на ринопластику, коррекцию век, подбородка и гинекомастии. Врач учитывает мужскую анатомию и запрос на сдержанный результат.',
      },
      {
        q: 'Как проходит первичная консультация хирурга?',
        a: 'Хирург осматривает, делает необходимые замеры и фотопротокол, объясняет возможную тактику и отвечает на вопросы.',
      },
      {
        q: 'Как долго длится реабилитация?',
        a: 'Зависит от операции. Блефаропластика — 7–14 дней. Ринопластика — 2–3 недели. Маммопластика — 2–4 недели ограничений. SMAS-лифтинг — 3–4 недели. Точные сроки хирург назовёт на консультации.',
      },
    ]} />

    <FinalCTA
      heading="Не знаете,<br />к кому записаться?"
      lead="Если вы не знаете, к какому врачу записаться — оставьте заявку, администратор подберёт специалиста под вашу задачу."
    />
  </main>
  <Footer />
</SiteLayout>

<script>
  function initDoctorFilters() {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-doctor-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-doctor-card]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-doctor-group]'));
    if (buttons.length === 0 || cards.length === 0) return;

    const updateGroups = () => {
      groups.forEach((group) => {
        const groupCards = Array.from(group.querySelectorAll<HTMLElement>('[data-doctor-card]'));
        group.hidden = groupCards.every((card) => card.hidden);
      });
    };

    buttons.forEach((button) => {
      if (button.dataset.bound === '1') return;
      button.dataset.bound = '1';
      button.addEventListener('click', () => {
        const filter = button.dataset.doctorFilter ?? 'all';
        buttons.forEach((b) => {
          const active = b === button;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        cards.forEach((card) => {
          const tags = (card.dataset.tags ?? '').split(' ');
          const visible = filter === 'all' || tags.includes(filter);
          card.hidden = !visible;
        });
        updateGroups();
      });
    });
    updateGroups();
  }

  if (document.readyState !== 'loading') initDoctorFilters();
  else document.addEventListener('DOMContentLoaded', initDoctorFilters);
  document.addEventListener('astro:page-load', initDoctorFilters);
</script>

<style>
  :global(.v3-page-hero) {
    padding-bottom: clamp(1.25rem, 4vh, 2.5rem);
  }
  .v3-doctors {
    padding-top: clamp(0.5rem, 1.8vw, 1.5rem);
    padding-bottom: var(--v3-gap-deep);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .doctors-filters {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }
  .doctor-picker {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    max-width: 64rem;
    margin: 0 0 1.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--v3-border-soft);
    border-radius: var(--v3-radius-xl);
    background: var(--v3-surface-card);
    box-shadow: var(--v3-shadow-sm);
  }
  .doctor-picker-title {
    margin: 0 0 0.25rem;
    font-family: var(--v3-font-body);
    font-weight: 500;
    color: var(--v3-ink);
  }
  .doctor-picker .v3-body { color: var(--v3-ink-secondary); }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.875rem;
    min-height: 42px;
    border: 1px solid var(--v3-border-soft);
    border-radius: var(--v3-radius-pill);
    font-family: var(--v3-font-body);
    font-size: 0.8125rem;
    color: var(--v3-ink-secondary);
    background: var(--v3-surface-card);
    letter-spacing: 0.005em;
    cursor: pointer;
    transition:
      color var(--v3-duration-fast) var(--v3-ease-out),
      background var(--v3-duration-fast) var(--v3-ease-out),
      border-color var(--v3-duration-fast) var(--v3-ease-out),
      transform var(--v3-duration-fast) var(--v3-ease-out);
  }
  .filter-chip:hover,
  .filter-chip:focus-visible,
  .filter-chip.is-active {
    color: var(--v3-on-ink);
    background: var(--v3-ink);
    border-color: var(--v3-ink);
    outline: none;
  }
  .filter-chip:hover,
  .filter-chip:focus-visible {
    transform: translateY(-1px);
  }
  .doctor-groups {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .doctor-group[hidden] { display: none; }
  .doctor-group-header {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--v3-border-soft);
    margin-bottom: 1rem;
  }
  .doctor-group-title,
  .doctor-group-lead {
    margin: 0;
  }
  .doctor-group-lead {
    color: var(--v3-ink-muted);
  }
  .doctors-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .doctor-group--founder .doctors-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .doctors-grid-cosm {
    grid-template-columns: repeat(2, 1fr);
    max-width: 48rem;
  }
  .doctor-card {
    background: var(--v3-surface-card);
    min-width: 0;
    border: 1px solid var(--v3-border-hair);
    border-radius: var(--v3-radius-xl);
    box-shadow: var(--v3-shadow-sm);
  }
  .doctor-card[hidden] { display: none; }
  .v3-surface-sand .doctor-card {
    background: var(--v3-surface-card);
  }
  .doctor-link {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-decoration: none;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    padding: 1.25rem;
    border-radius: inherit;
    transition: background var(--v3-duration-fast) var(--v3-ease-out), transform var(--v3-duration-fast) var(--v3-ease-out);
  }
  .doctor-link:hover {
    background: var(--v3-surface-muted);
    transform: translateY(-2px);
  }
  .v3-surface-sand .doctor-link:hover { background: var(--v3-sand-deep); }
  .doctor-card--wide {
    max-width: 68rem;
  }
  .doctor-card--wide .doctor-link {
    display: grid;
    grid-template-columns: minmax(14rem, 20rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: center;
  }
  .doctor-card--wide .doctor-photo {
    width: 100%;
    max-width: none;
    margin: 0;
  }
  .doctor-card--wide .doctor-info {
    padding: 0;
    max-width: 48rem;
  }
  .doctor-card--wide .doctor-short {
    max-width: 54ch;
    font-size: 1rem;
  }
  .doctor-card--wide .doctor-price {
    margin-top: 0.5rem;
  }

  .doctor-photo {
    width: 100%;
    max-width: none;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: linear-gradient(180deg, var(--v3-surface-muted), var(--v3-sand));
    position: relative;
    border-radius: var(--v3-radius-lg);
    margin: 0;
    flex: 0 0 auto;
    border: 1px solid var(--v3-border-soft);
  }
  .doctor-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transform: translate(var(--doctor-photo-x, 0%), var(--doctor-photo-y, -3%)) scale(var(--doctor-photo-scale, 1.12));
    transform-origin: center top;
  }
  .doctor-initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--v3-ink-muted);
  }

  .doctor-info {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
    min-width: 0;
  }
  .doctor-spec { color: var(--v3-ink-muted); }
  .doctor-name { color: var(--v3-ink); }
  .doctor-short { color: var(--v3-ink-secondary); margin: 0; font-size: 0.9375rem; line-height: 1.5; }
  .doctor-base {
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
    margin: 0;
  }
  .doctor-price {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }
  .price-primary { color: var(--v3-champagne-deep); text-transform: none; letter-spacing: 0.005em; font-family: var(--v3-font-display); font-style: normal; font-size: 0.9375rem; }
  .price-sub { color: var(--v3-ink-muted); text-transform: none; letter-spacing: 0.005em; }
  .doctor-price-muted .price-primary {
    color: var(--v3-ink-secondary);
  }

  @media (max-width: 1024px) {
    .doctors-grid { grid-template-columns: repeat(2, 1fr); }
    .doctors-grid-cosm { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .doctor-picker {
      grid-template-columns: 1fr;
      padding: 1rem;
    }
    .doctors-filters {
      gap: 0.5rem;
      margin-bottom: 1.25rem;
    }
    .filter-chip {
      min-height: 44px;
      padding: 0.55rem 0.8rem;
    }
    .doctor-group-header { grid-template-columns: 1fr; }
    .doctors-grid { grid-template-columns: 1fr; }
    .doctors-grid-cosm { grid-template-columns: 1fr; }
    .doctor-card--wide .doctor-link {
      display: flex;
    }
    .doctor-card--wide .doctor-photo {
      width: 100%;
      margin: 0;
    }
    .doctor-card--wide .doctor-info {
      padding: 0;
    }
  }
</style>
