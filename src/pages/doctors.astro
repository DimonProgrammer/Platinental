---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/primitives/Button.astro';
import DoctorCardFull from '../components/cards/DoctorCardFull.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import FAQ from '../components/sections/FAQ.astro';
import Contacts from '../components/sections/Contacts.astro';
import { doctors } from '../data/doctors';

const filters = [
  { key: 'all', label: 'Все специалисты' },
  { key: 'plastika', label: 'Пластическая хирургия' },
  { key: 'face', label: 'Лицо' },
  { key: 'body', label: 'Тело' },
  { key: 'cosmetology', label: 'Косметология' },
];
---

<BaseLayout
  title="Врачи клиники Platinental в Казани — пластические хирурги и косметологи"
  description="Врачи клиники Platinental в Казани: пластические хирурги, челюстно-лицевой хирург, врач-косметолог. Ординатура РНИМУ им. Пирогова, Сеченовского университета, РНЦХ Петровского. Запись: +7 843 223-66-66."
  canonical="https://kzn.platinental.ru/doctors"
>
  <!-- Hero -->
  <section class="doctors-hero" aria-labelledby="doctors-title">
    <div class="doctors-hero__inner">
      <div data-reveal>
        <span class="eyebrow">THE PLATINENTAL · КАЗАНЬ</span>
        <h1 id="doctors-title" class="doctors-hero__title font-display">
          Врачи клиники<br/>Platinental в&nbsp;Казани
        </h1>
        <p class="doctors-hero__lede">
          В&nbsp;клинике работают хирурги с&nbsp;собственной школой и&nbsp;авторскими техниками. На&nbsp;консультации подберём специалиста под&nbsp;вашу задачу.
        </p>
        <div class="doctors-hero__actions">
          <Button href="/#form" variant="primary" size="lg">Записаться на&nbsp;консультацию</Button>
          <Button href="#team" variant="ghost" size="lg">Посмотреть врачей</Button>
        </div>
      </div>

      <aside class="doctors-hero__stats" data-reveal>
        <div class="doctors-hero__stat">
          <span class="doctors-hero__stat-n font-display">15+</span>
          <span class="doctors-hero__stat-label">Лет в&nbsp;медицине</span>
        </div>
        <div class="doctors-hero__stat">
          {/* TODO(verify-2011): уточнить год — 2011 или 2013 */}
          <span class="doctors-hero__stat-n font-display">2011</span>
          <span class="doctors-hero__stat-label">Клиника в&nbsp;Казани</span>
        </div>
        <div class="doctors-hero__stat">
          <span class="doctors-hero__stat-n font-display">4</span>
          <span class="doctors-hero__stat-label">Направления&nbsp;— пластика, тело, ЧЛХ, косметология</span>
        </div>
      </aside>
    </div>
  </section>

  <!-- Filters + Cards -->
  <section class="team" id="team" aria-label="Список врачей">
    <div class="team__inner">
      <div class="team__filters" role="toolbar" aria-label="Фильтр специалистов">
        {filters.map((f) => (
          <button
            type="button"
            class:list={['team__filter', f.key === 'all' && 'is-active']}
            data-filter={f.key}
          >{f.label}</button>
        ))}
      </div>

      <div class="team__grid" data-doctors-grid>
        {doctors.map((d, i) => <DoctorCardFull doctor={d} index={i} />)}
      </div>

      <p class="team__note">
        Если&nbsp;вы&nbsp;не&nbsp;знаете, к&nbsp;какому врачу записаться&nbsp;— оставьте заявку, администратор подберёт специалиста под&nbsp;вашу задачу.
      </p>
    </div>
  </section>

  <FinalCTA />
  <FAQ />
  <Contacts />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const grid = document.querySelector<HTMLElement>('[data-doctors-grid]');

  if (buttons.length && grid) {
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'all';
        buttons.forEach((b) => b.classList.toggle('is-active', b === btn));

        const cards = grid.querySelectorAll<HTMLElement>('.doctor-card');
        cards.forEach((card) => {
          const tags = (card.dataset.tags ?? '').split(' ');
          const show = filter === 'all' || tags.includes(filter);
          card.style.display = show ? '' : 'none';
        });
      });
    });
  }
</script>

<style>
  /* Hero */
  .doctors-hero {
    background: var(--surface-page);
    padding: calc(var(--nav-height-mobile) + var(--space-12)) 0 var(--space-16);
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 768px) {
    .doctors-hero { padding: calc(var(--nav-height) + var(--space-16)) 0 var(--space-20); }
  }

  .doctors-hero__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    gap: var(--space-10);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) { .doctors-hero__inner { padding: 0 32px; } }
  @media (min-width: 1024px) {
    .doctors-hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-16);
      align-items: end;
    }
  }
  @media (min-width: 1200px) { .doctors-hero__inner { padding: 0 48px; } }

  .doctors-hero__title {
    font-size: clamp(2rem, 1rem + 3vw, 3.5rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-5);
    text-wrap: balance;
  }

  .doctors-hero__lede {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 52ch;
    margin-bottom: var(--space-8);
  }

  .doctors-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
  }

  .doctors-hero__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--border-subtle);
  }

  @media (min-width: 1024px) {
    .doctors-hero__stats {
      grid-template-columns: 1fr;
      border-top: none;
      padding: 0;
      gap: var(--space-6);
    }
  }

  .doctors-hero__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  @media (min-width: 1024px) {
    .doctors-hero__stat {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--border-subtle);
    }
    .doctors-hero__stat:last-child { border-bottom: none; }
  }

  .doctors-hero__stat-n {
    font-size: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    font-weight: 300;
    font-style: italic;
    color: var(--accent-hover);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .doctors-hero__stat-label {
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Team section */
  .team {
    background: var(--surface-alt);
    padding: var(--space-16) 0 var(--space-20);
  }

  @media (min-width: 1024px) { .team { padding: var(--space-20) 0 var(--space-24); } }

  .team__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 768px) { .team__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .team__inner { padding: 0 48px; } }

  .team__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .team__filter {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 16px;
    background: transparent;
    border: 1px solid var(--border-soft);
    border-radius: 99px;
    font-family: inherit;
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .team__filter:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
  }

  .team__filter.is-active {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--text-inverse);
  }

  .team__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 960px) {
    .team__grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
  }

  .team__note {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-caption);
    color: var(--text-muted);
    max-width: 70ch;
  }
</style>
