---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Navigation from '../../components/site/sections/Navigation.astro';
import PageLeadMagnet from '../../components/site/sections/PageLeadMagnet.astro';
import MedicalDisclaimer from '../../components/site/sections/MedicalDisclaimer.astro';
import FinalCTA from '../../components/site/sections/FinalCTA.astro';
import FAQ from '../../components/site/sections/FAQ.astro';
import Footer from '../../components/site/sections/Footer.astro';
import { doctors } from '../../data/doctors';
import { doctorPriceSheets } from '../../data/prices';
import { getSurgicalBase } from '../../data/partners';
import type { Doctor } from '../../data/doctors';
import { formatCurrencyPlainText } from '../../lib/formatText';

export async function getStaticPaths() {
  return doctors.map((d) => ({
    params: { slug: d.slug },
    props: { doctor: d },
  }));
}

interface Props { doctor: Doctor }
const { doctor: d } = Astro.props;

const isSurgeon = d.tags.includes('plastika');
const isCosmetologist = d.tags.includes('cosmetology');
const bookingEnabled = d.bookingEnabled !== false;
const surgicalBase = getSurgicalBase(d.surgicalBase);
const consultationPrice = d.priceMain;
const doctorPriceSheet = doctorPriceSheets.find((sheet) => sheet.doctorSlug === d.slug);
const hasOnlinePrice = (d.priceSub ?? '').includes('Онлайн');
const resultImages = d.resultCases?.map((item) => item.src) ?? [];
const galleryImages = resultImages.length > 0 ? resultImages : (d.gallery ?? []);
const hasResultCases = resultImages.length > 0;
const heroTrustItems = [
  isCosmetologist ? 'Инъекционная косметология' : d.tags.includes('body') ? 'Хирургия тела' : 'Хирургия лица',
  d.details.specialization[0]?.split(',')[0],
  hasOnlinePrice ? 'Онлайн-консультация' : undefined,
  d.patents?.length ? 'Патентная работа' : d.details.awards ? 'Профильная экспертиза' : undefined,
].filter((item): item is string => Boolean(item)).slice(0, 4);

const faqItems = [
  bookingEnabled ? {
    q: `Как записаться ${d.nameBtn}?`,
    a: 'Позвоните по номеру <a href="tel:+78432236666">+7 843 223-66-66</a>, напишите в <a href="https://t.me/platinental_kazan">Telegram</a>, <a href="https://max.ru">Max</a> или <a href="https://wa.me/78432236666">WhatsApp</a>, либо заполните форму на сайте. Администратор подберёт удобное время.',
    open: true,
  } : {
    q: 'В чём подход Андрея Искорнева?',
    a: 'В основе подхода — работа с пропорциями лица, анатомией, мимикой и индивидуальным запросом пациента. Цель — гармоничный образ без шаблонного результата.',
    open: true,
  },
  {
    q: 'Сколько длится первичная консультация?',
    a: 'Первичная консультация длится до 30 минут. Врач осматривает, задаёт уточняющие вопросы, объясняет возможные решения и дальнейшие шаги.',
  },
  isSurgeon ? {
    q: 'Нужна ли подготовка к операции?',
    a: 'Да. Перечень анализов и обследований врач выдаёт на консультации после осмотра и оценки вашей ситуации.',
  } : {
    q: 'Как подготовиться к косметологической процедуре?',
    a: 'Зависит от процедуры. На консультации врач даст точные рекомендации: что исключить за несколько дней, как ухаживать за кожей в период восстановления.',
  },
  {
    q: 'Можно ли получить онлайн-консультацию?',
    a: hasOnlinePrice
      ? 'Да, онлайн-консультации доступны. Запишитесь через форму, Telegram, Max или WhatsApp — укажите, что вам нужен онлайн-формат.'
      : 'Да, онлайн-консультации доступны. Формат и стоимость администратор уточнит при записи.',
  },
].filter((item): item is { q: string; a: string; open?: boolean } => Boolean(item));
---

<SiteLayout
  title={`${d.name} — ${d.spec} — The Platinental Казань`}
  description={`${d.name} — ${isSurgeon ? 'пластический хирург' : 'врач-косметолог'} клиники The Platinental Казань. Специализация, образование, запись на консультацию.`}
>
  <Navigation />
  <main id="main">

    <!-- Hero -->
    <section class="v3-doc-hero v3-surface-cream" aria-labelledby="doc-heading">
      <div class="v3-container v3-container-wide doc-hero-grid">
        <div class="doc-hero-text" data-v3-reveal>
          <nav class="doc-breadcrumb" aria-label="Хлебные крошки">
            <a href="/" class="bc-link">Главная</a>
            <span class="bc-sep" aria-hidden="true">→</span>
            <a href="/doctors" class="bc-link">Врачи</a>
          </nav>
          <span class="v3-eyebrow doc-spec">{d.spec}</span>
          <h1 id="doc-heading" class="v3-h1 doc-h1">
            <em>{d.name}</em>
          </h1>
          <p class="v3-lead doc-lead" set:html={d.short}></p>
          {heroTrustItems.length > 0 && (
            <ul class="doc-trust-list" aria-label="Ключевые преимущества врача">
              {heroTrustItems.map((item) => (
                <li><span class="v3-minimark" aria-hidden="true">•</span>{item}</li>
              ))}
            </ul>
          )}
          {bookingEnabled ? (
            <>
              <div class="doc-price-row">
                <span class="doc-price" set:html={formatCurrencyPlainText(consultationPrice)}></span>
                {d.priceSub && <span class="v3-caption doc-price-sub" set:html={formatCurrencyPlainText(d.priceSub)}></span>}
                {surgicalBase && (
                  <span class="v3-caption doc-base">
                    Операционная база: <a href={surgicalBase.href} target="_blank" rel="noopener noreferrer" class="v3-link">{surgicalBase.shortName}</a>, {surgicalBase.city}, {surgicalBase.address}
                  </span>
                )}
              </div>
              <div class="doc-cta">
                <button type="button" class="v3-btn v3-btn-primary" data-booking-open data-doctor={d.nameBtn}>
                  Записаться {d.nameBtn}
                </button>
              </div>
            </>
          ) : (
            <div class="doc-price-row doc-price-row-muted">
              <span class="doc-price">Гармонизирующая пластическая хирургия</span>
              <span class="v3-caption doc-price-sub">Лицо, шея, пропорции и естественное омоложение.</span>
              <a href="/doctors" class="v3-btn v3-btn-secondary doc-profile-link">Выбрать врача клиники</a>
            </div>
          )}
        </div>

        <div class="doc-hero-photo" data-v3-reveal>
          {d.photo ? (
            <img
              src={d.photo}
              alt={d.name}
              width="480"
              height="600"
              loading="eager"
              class="doc-photo-img"
              style={`--doctor-photo-scale:${d.photoFrame?.scale ?? 1.08}; --doctor-photo-x:${d.photoFrame?.x ?? '0%'}; --doctor-photo-y:${d.photoFrame?.y ?? '-2%'};`}
            />
          ) : (
            <div class="doc-photo-placeholder" aria-hidden="true">
              <span class="doc-initials">{d.initials}</span>
            </div>
          )}
        </div>
      </div>
	    </section>
	    <MedicalDisclaimer />

    {d.stats && d.stats.length > 0 && (
      <section class="v3-doc-stats v3-surface-sand" aria-label="Статистика">
        <div class="v3-container v3-container-wide">
          <ul class="stats-row" data-v3-stagger>
            {d.stats.map((s) => (
              <li class="stats-item">
                <span class="stats-value-row">
                  <span class="stats-value">{s.value}</span>
                  {s.description && (
                    <span class="stats-help" tabindex="0" aria-label={s.description}>
                      ?
                      <span class="stats-tooltip" role="tooltip">{s.description}</span>
                    </span>
                  )}
                </span>
                <span class="v3-caption stats-label">{s.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <PageLeadMagnet
      eyebrow={isSurgeon ? 'Перед консультацией хирурга' : 'Перед консультацией косметолога'}
      heading={isSurgeon ? 'Что подготовить<br />к приёму' : 'Что рассказать<br />на приёме'}
      lead={isSurgeon
        ? 'Чем точнее вы опишете задачу, сроки и ожидания, тем предметнее врач объяснит возможный маршрут.'
        : 'Врачу важно понять не только процедуру, но и состояние кожи, домашний уход, предыдущие вмешательства и сроки восстановления.'}
      items={isSurgeon ? [
        { mark: '?', title: 'Запрос', text: 'что хочется изменить и какой результат выглядит естественным' },
        { mark: '—', title: 'Сроки', text: 'работа, поездки, спорт и важные даты после операции' },
        { mark: '₽', title: 'Бюджет', text: 'консультация помогает понять порядок расходов по вашему случаю' },
      ] : [
        { mark: '•', title: 'Кожа', text: 'сухость, пигментация, воспаления, тонус или мимика' },
        { mark: '+', title: 'Уход', text: 'что уже используете утром и вечером' },
        { mark: '—', title: 'Процедуры', text: 'что делали раньше и как кожа реагировала' },
      ]}
      ctaPrimary={bookingEnabled
        ? { label: `Записаться ${d.nameBtn}`, href: '#form' }
        : { label: 'Выбрать врача клиники', href: '/doctors' }}
      ctaSecondary={{ label: 'Задать вопрос', href: 'https://wa.me/78432236666' }}
      surface="sand"
    />

    {d.approach && (
      <section class="v3-doc-approach v3-surface-cream" aria-labelledby="approach-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Подход</span>
            <h2 id="approach-heading" class="v3-h2"><em>{d.approach.title}</em></h2>
          </header>
          <p class="v3-lead approach-body" data-v3-reveal set:html={d.approach.body}></p>
        </div>
      </section>
    )}

    {d.regenerativeComparison && (
      <section class="v3-doc-regen v3-surface-sand" aria-labelledby="regen-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Методика</span>
            <h2 id="regen-heading" class="v3-h2"><em>{d.regenerativeComparison.title}</em></h2>
          </header>

          <div class="regen-intro" data-v3-reveal>
            <p class="v3-lead">{d.regenerativeComparison.lead}</p>
            <a href={d.regenerativeComparison.source.href} target="_blank" rel="noopener" class="v3-link regen-source">
              {d.regenerativeComparison.source.label}
            </a>
          </div>

          <div class="regen-grid" data-v3-stagger>
            {d.regenerativeComparison.columns.map((column) => (
              <article class="regen-card">
                <h3 class="regen-title">{column.title}</h3>
                <ul class="regen-list">
                  {column.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>

          <p class="regen-note v3-caption" data-v3-reveal>{d.regenerativeComparison.note}</p>
        </div>
      </section>
    )}

    <!-- Education -->
    <section class="v3-doc-edu v3-surface-cream" aria-labelledby="edu-heading">
      <div class="v3-container v3-container-default">
        <header class="doc-section-header" data-v3-stagger>
          <span class="v3-eyebrow">Образование</span>
          <h2 id="edu-heading" class="v3-h2"><em>Профессиональная подготовка</em></h2>
        </header>
        <ol class="edu-timeline" data-v3-stagger>
          {d.details.education.map((e) => (
            <li class={`edu-item${e.year ? '' : ' edu-item--no-year'}`}>
              {e.year && <span class="edu-year v3-eyebrow">{e.year}</span>}
              <p class="edu-text v3-body">{e.text}</p>
            </li>
          ))}
        </ol>

        {d.details.additionalEducation && d.details.additionalEducation.length > 0 && (
          <div class="edu-additional" data-v3-reveal>
            <h3 class="v3-h3 edu-additional-title">Дополнительное образование</h3>
            <ul class="edu-add-list">
              {d.details.additionalEducation.map((e) => (
                <li class="edu-add-item">
                  {e.year && <span class="edu-add-year v3-eyebrow">{e.year}</span>}
                  <span class="v3-body">{e.text}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {d.details.congresses && (
          <p class="v3-body edu-congresses" data-v3-reveal>{d.details.congresses}</p>
        )}

        <div class="doc-support-grid" data-v3-stagger>
          {d.profileNote && (
            <article class="doc-support-card">
              <span class="v3-eyebrow">{d.profileNote.label}</span>
              <p class="v3-body" set:html={d.profileNote.body}></p>
            </article>
          )}

          {d.details.awards && (
            <article class="doc-support-card">
              <span class="v3-eyebrow">Квалификация</span>
              <p class="v3-body" set:html={d.details.awards}></p>
            </article>
          )}

          {d.patents?.map((patent) => (
            <article class="doc-support-card doc-patent-card">
              <span class="v3-eyebrow">Патент</span>
              <h3 class="patent-title">{patent.number} · {patent.title}</h3>
              <p class="v3-body patent-text">{patent.description}</p>
              <dl class="patent-meta">
                <div>
                  <dt>Роль</dt>
                  <dd>{patent.role}</dd>
                </div>
                <div>
                  <dt>Соавторы</dt>
                  <dd>{patent.coauthors.join(', ')}</dd>
                </div>
                <div>
                  <dt>Патентообладатель</dt>
                  <dd>{patent.holder}</dd>
                </div>
              </dl>
              <a href={patent.href} target="_blank" rel="noopener noreferrer" class="v3-link patent-link">
                Проверить в базе ФИПС
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    {doctorPriceSheet && doctorPriceSheet.items.length > 0 && !isCosmetologist && (
      <section class="v3-doc-prices v3-surface-sand" aria-labelledby="doc-prices-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Стоимость услуг</span>
            <h2 id="doc-prices-heading" class="v3-h2"><em>Индивидуальный прайс врача</em></h2>
          </header>
          <div class="doc-price-table-wrap" data-v3-reveal>
            <table class="doc-price-table">
              <tbody>
                {doctorPriceSheet.items.map((item) => (
                  <tr>
                    <td class="doc-price-service">{item.procedure}</td>
                    <td class="doc-price-value" set:html={formatCurrencyPlainText(item.price)}></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="v3-caption doc-price-disclaimer" data-v3-reveal>
            Цены носят информационный характер. Точную стоимость врач определяет на консультации после осмотра и обсуждения задачи.
          </p>
          {surgicalBase && (
            <p class="v3-caption doc-price-disclaimer doc-price-base" data-v3-reveal>
              Где проводится операция: <a href={surgicalBase.href} target="_blank" rel="noopener noreferrer" class="v3-link">{surgicalBase.name}</a>, {surgicalBase.city}, {surgicalBase.address}.
            </p>
          )}
        </div>
      </section>
    )}

    {isCosmetologist && (
      <section class="v3-doc-prices v3-surface-sand" aria-labelledby="doc-prices-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Косметология</span>
            <h2 id="doc-prices-heading" class="v3-h2"><em>Прайс и направления</em></h2>
          </header>
          <div class="doc-price-link-card" data-v3-reveal>
            <div class="doc-price-link-copy">
              <p class="v3-body">
                Для косметологии используем общий прайс направления: актуальные цены, инъекционные и аппаратные методики, а также терапевтические процедуры.
              </p>
              <ul class="doc-price-link-list">
                {d.details.specialization.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="doc-price-link-actions">
              <a href="/kosmetologiya" class="v3-btn v3-btn-primary">Открыть косметологию</a>
              <a href="/prices" class="v3-link">Смотреть общий прайс</a>
            </div>
          </div>
        </div>
      </section>
    )}

    {d.documents && d.documents.length > 0 && (
      <section class="v3-doc-docs v3-surface-cream" aria-labelledby="docs-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Документы</span>
            <h2 id="docs-heading" class="v3-h2"><em>Дипломы и публикации</em></h2>
          </header>
          <ul class="docs-grid" data-v3-stagger>
            {d.documents.map((doc) => (
              <li class="doc-card">
                <a href={doc.src} target="_blank" rel="noopener" class="doc-card-link">
                  <span class="doc-card-icon" aria-hidden="true">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                      <line x1="9" y1="14" x2="15" y2="14" />
                      <line x1="9" y1="17" x2="13" y2="17" />
                    </svg>
                  </span>
                  <span class="doc-card-meta">
                    <span class="v3-eyebrow doc-card-kind">{
                      doc.kind === 'diploma' ? 'Диплом' :
                      doc.kind === 'certificate' ? 'Сертификат' :
                      doc.kind === 'cv' ? 'Резюме' :
                      doc.kind === 'patent' ? 'Патент' :
                      'Публикация'
                    }</span>
                    <span class="doc-card-title">{doc.title}</span>
                    <span class="v3-caption doc-card-cta">Открыть PDF →</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {galleryImages.length > 0 && (
      <section class="v3-doc-gallery v3-surface-sand" aria-labelledby="gallery-heading">
        <div class="v3-container v3-container-wide">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Работы</span>
            <h2 id="gallery-heading" class="v3-h2"><em>{hasResultCases ? 'До и после' : 'Результаты'}</em></h2>
          </header>
          <ul class:list={['gallery-grid', hasResultCases && 'gallery-grid--cases']} data-v3-stagger data-gallery>
            {galleryImages.map((src, i) => (
              <li class="gallery-item">
                <button type="button" class="gallery-btn" data-gallery-open data-index={i} aria-label={`Открыть фото ${i + 1}`}>
                  <img src={src} alt={d.resultCases?.[i]?.title ?? ''} width="800" height="500" loading="eager" decoding="async" />
                </button>
              </li>
            ))}
          </ul>
          <p class="works-disclaimer v3-caption" data-v3-reveal>
            Фотографии результатов публикуются с письменного согласия пациентов. Слева — до, справа — после. Результат индивидуален.
          </p>
        </div>
      </section>
    )}

    {galleryImages.length > 0 && (
      <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Просмотр фотографии">
        <button type="button" class="lightbox-close" data-lightbox-close aria-label="Закрыть"><span aria-hidden="true">×</span></button>
        <button type="button" class="lightbox-prev" data-lightbox-prev aria-label="Предыдущее фото"><span aria-hidden="true">‹</span></button>
        <button type="button" class="lightbox-next" data-lightbox-next aria-label="Следующее фото"><span aria-hidden="true">›</span></button>
        <figure class="lightbox-figure">
          <img data-lightbox-img alt="" />
          <figcaption class="v3-caption lightbox-counter" data-lightbox-counter></figcaption>
        </figure>
      </div>
    )}

    <FAQ
      eyebrow="Вопросы"
      heading={bookingEnabled ? 'Вопросы о приёме' : 'Вопросы о враче'}
      items={faqItems}
    />

    {bookingEnabled ? (
      <FinalCTA
        heading={`Записаться<br />${d.nameBtn}`}
        lead={`Консультация: ${[d.priceMain, d.priceSub].filter(Boolean).join(' · ')}. Задайте вопросы и получите подробные ответы.`}
        submitLabel={`Записаться ${d.nameBtn}`}
      />
    ) : (
      <section class="doc-founder-cta v3-surface-ink" aria-labelledby="founder-cta-heading">
        <div class="v3-container v3-container-default doc-founder-cta-inner" data-v3-reveal>
          <span class="v3-eyebrow">Консультация в Казани</span>
          <h2 id="founder-cta-heading" class="v3-h2"><em>Подобрать врача в Казани</em></h2>
          <p class="v3-lead">
            Опишите задачу — администратор подскажет, какой специалист The Platinental Казань подходит под ваш запрос.
          </p>
          <a href="/doctors" class="v3-btn v3-btn-primary">Перейти к врачам</a>
        </div>
      </section>
    )}
  </main>
  <Footer />
</SiteLayout>

<script is:inline define:vars={{ images: galleryImages }}>
  function initDoctorPage() {
    // Booking button binding
    document.querySelectorAll('[data-booking-open]').forEach((b) => {
      if (b.dataset.bookingBound === '1') return;
      b.dataset.bookingBound = '1';
      b.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const doctor = b.getAttribute('data-doctor') ?? undefined;
        window.dispatchEvent(new CustomEvent('open-booking', { detail: { doctor } }));
      });
    });

    if (!images || images.length === 0) return;
    const root = document.querySelector('[data-lightbox]');
    if (!root) return;
    const imgEl = root.querySelector('[data-lightbox-img]');
    const counterEl = root.querySelector('[data-lightbox-counter]');
    const closeBtn = root.querySelector('[data-lightbox-close]');
    const prevBtn = root.querySelector('[data-lightbox-prev]');
    const nextBtn = root.querySelector('[data-lightbox-next]');

    let idx = 0;
    let lastFocus = null;

    const render = () => {
      imgEl.src = images[idx];
      counterEl.textContent = `${idx + 1} / ${images.length}`;
    };
    const open = (i) => {
      lastFocus = document.activeElement;
      idx = i;
      render();
      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      closeBtn?.focus();
    };
    const close = () => {
      root.hidden = true;
      document.documentElement.style.overflow = '';
      lastFocus?.focus?.();
    };
    const next = () => { idx = (idx + 1) % images.length; render(); };
    const prev = () => { idx = (idx - 1 + images.length) % images.length; render(); };

    document.querySelectorAll('[data-gallery-open]').forEach((btn) => {
      if (btn.dataset.lbBound === '1') return;
      btn.dataset.lbBound = '1';
      btn.addEventListener('click', () => open(parseInt(btn.dataset.index ?? '0', 10)));
    });

    closeBtn?.addEventListener('click', close);
    nextBtn?.addEventListener('click', next);
    prevBtn?.addEventListener('click', prev);
    root.addEventListener('click', (e) => { if (e.target === root) close(); });
    document.addEventListener('keydown', (e) => {
      if (root.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') next();
      else if (e.key === 'ArrowLeft') prev();
    });
  }
  if (document.readyState !== 'loading') initDoctorPage();
  else document.addEventListener('DOMContentLoaded', initDoctorPage);
  document.addEventListener('astro:page-load', initDoctorPage);
</script>

