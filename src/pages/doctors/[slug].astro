      linear-gradient(135deg, color-mix(in srgb, var(--v3-sand) 46%, var(--v3-surface-card)), var(--v3-surface-card)),
      var(--v3-surface-card);
    box-shadow: var(--v3-shadow-sm);
  }
  .path-essay p {
    margin: 0;
    color: var(--v3-ink-secondary);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.7;
  }
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .focus-grid--single {
    grid-template-columns: minmax(0, 1fr);
  }
  .focus-card {
    min-width: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--v3-border-soft) 72%, transparent);
    border-radius: var(--v3-radius-xl);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--v3-sand) 38%, var(--v3-surface-card)), var(--v3-surface-card)),
      var(--v3-surface-card);
    box-shadow: var(--v3-shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .focus-card:nth-child(2n) {
    transform: translateY(clamp(0.5rem, 1.2vw, 1rem));
  }
  .focus-grid--single .focus-card {
    display: grid;
    grid-template-columns: minmax(17rem, 0.55fr) minmax(0, 1fr);
    gap: clamp(2rem, 4.5vw, 4rem);
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }
  .focus-document {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    align-self: start;
  }
  .focus-document img {
    display: block;
    width: 100%;
    max-height: clamp(20rem, 33vw, 28rem);
    object-fit: var(--case-fit, contain);
    object-position: center;
    padding: clamp(0.875rem, 2vw, 1.125rem);
    border: 1px solid color-mix(in srgb, var(--v3-border-soft) 72%, transparent);
    border-radius: calc(var(--v3-radius-lg) + 0.25rem);
    background: #fff;
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, var(--v3-ink) 8%, transparent);
  }
  .focus-document figcaption {
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
  }
  .focus-card-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.875rem, 1.6vw, 1.25rem);
    max-width: 40rem;
  }
  .focus-eyebrow {
    color: var(--v3-champagne-deep);
  }
  .focus-title {
    margin: 0;
    font-family: var(--v3-font-display);
    font-size: clamp(1.35rem, 2vw, 2rem);
    font-weight: 400;
    line-height: 1.12;
    color: var(--v3-ink);
  }
  .focus-card p {
    margin: 0;
    color: var(--v3-ink-secondary);
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.65;
  }
  .focus-list {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .focus-list li {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--v3-border-soft) 78%, transparent);
    border-radius: 999px;
    color: var(--v3-ink-muted);
    background: color-mix(in srgb, var(--v3-surface-card) 82%, transparent);
    font-family: var(--v3-font-body);
    font-size: 0.875rem;
    line-height: 1.25;
  }
  .review-header {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .review-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .review-grid--multi {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }
  .review-quote {
    margin: 0;
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    max-width: 54rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--v3-border-soft) 72%, transparent);
    border-radius: var(--v3-radius-xl);
    background:
      linear-gradient(135deg, var(--v3-surface-card), color-mix(in srgb, var(--v3-sand) 34%, var(--v3-surface-card))),
      var(--v3-surface-card);
    box-shadow: var(--v3-shadow-sm);
    position: relative;
    overflow: hidden;
  }
  .review-quote::before {
    content: '“';
    position: absolute;
    right: clamp(1.25rem, 4vw, 3rem);
    top: -0.35em;
    font-family: var(--v3-font-display);
    font-size: clamp(5rem, 12vw, 9rem);
    line-height: 1;
    color: color-mix(in srgb, var(--v3-champagne-deep) 13%, transparent);
    pointer-events: none;
  }
  .review-label {
    margin: 0;
    width: fit-content;
    max-width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--v3-border-soft) 78%, transparent);
    border-radius: 999px;
    color: var(--v3-ink-muted);
    font-family: var(--v3-font-body);
    font-size: 0.8125rem;
    line-height: 1.25;
  }
  .review-quote blockquote {
    margin: 0;
    max-width: 44rem;
    font-family: var(--v3-font-body);
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    font-weight: 400;
    line-height: 1.65;
    color: var(--v3-ink-secondary);
  }
  .review-quote figcaption {
    color: var(--v3-ink-muted);
    font-family: var(--v3-font-body);
    font-size: 0.875rem;
  }

  .doc-price-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--v3-border-hair);
    border-radius: var(--v3-radius-xl);
    background: var(--v3-surface-card);
    padding-inline: clamp(1rem, 2vw, 1.5rem);
  }
  .doc-price-table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
  }
  .doc-price-table tr:not(:last-child) td {
    border-bottom: 1px solid var(--v3-border-hair);
  }
  .doc-price-table td {
    padding: 1rem 0;
    vertical-align: baseline;
  }
  .doc-price-service {
    padding-right: 1.5rem;
    color: var(--v3-ink);
  }
  .doc-price-value {
    text-align: right;
    white-space: nowrap;
    color: var(--v3-champagne-deep);
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: 1.125rem;
  }
  .doc-price-disclaimer {
    margin-top: 1rem;
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
  }
  .doc-price-base {
    margin-top: 0.5rem;
  }
  .doc-price-link-card {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 0.7fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--v3-border-hair);
    border-radius: var(--v3-radius-xl);
    background: var(--v3-surface-card);
  }
  .doc-price-link-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .doc-price-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .doc-price-link-list li {
    position: relative;
    padding-left: 1rem;
    color: var(--v3-ink-secondary);
  }
  .doc-price-link-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68rem;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--v3-accent-strong);
  }
  .doc-price-link-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
  }

  /* Education timeline */
  .edu-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .edu-item {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--v3-border-hair);
    align-items: baseline;
  }
  .edu-item:last-of-type { border-bottom: 1px solid var(--v3-border-hair); }
  .edu-year { color: var(--v3-champagne-deep); }
  .edu-text { margin: 0; }
  .edu-item--no-year,
  .edu-timeline--profile .edu-item {
    grid-template-columns: 1fr;
    padding-left: 0;
  }
  .edu-timeline--profile .edu-text {
    max-width: 54ch;
  }

  .edu-additional {
    margin-top: var(--v3-gap-small);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .edu-additional-title { color: var(--v3-ink); }
  .edu-add-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .edu-add-item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-size: 0.9375rem;
    color: var(--v3-ink-secondary);
  }
  .edu-add-year { color: var(--v3-ink-muted); flex-shrink: 0; min-width: 3rem; }
  .edu-congresses { margin-top: var(--v3-gap-small); color: var(--v3-ink-secondary); }
  .doc-support-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1rem;
    margin-top: var(--v3-gap-small);
  }
  .doc-support-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem;
    border: 1px solid var(--v3-border-hair);
    border-radius: var(--v3-radius-lg);
    background: var(--v3-surface-muted);
  }
  .doc-support-card--media {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.72fr);
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: center;
  }
  .doc-support-copy {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
  }
  .doc-support-media {
    margin: 0;
    display: grid;
    gap: 0.625rem;
  }
  .doc-support-media img {
    display: block;
    width: 100%;
    max-height: clamp(18rem, 32vw, 26rem);
    object-fit: contain;
    object-position: center;
    padding: clamp(0.75rem, 1.6vw, 1rem);
    border: 1px solid color-mix(in srgb, var(--v3-border-soft) 72%, transparent);
    border-radius: calc(var(--v3-radius-lg) + 0.25rem);
    background: #fff;
    box-shadow: 0 1rem 2.25rem color-mix(in srgb, var(--v3-ink) 8%, transparent);
  }
  .doc-support-media figcaption {
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
  }
  :global(.support-note-help) {
    position: relative;
    top: -0.08em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    height: 1.1rem;
    margin-left: 0.2rem;
    border: 1px solid var(--v3-border-soft);
    border-radius: 999px;
    color: var(--v3-ink-muted);
    background: var(--v3-surface-card);
    font-size: 0.68rem;
    line-height: 1;
    cursor: help;
  }
  :global(.support-note-help:focus-visible) {
    outline: 2px solid var(--v3-champagne-deep);
    outline-offset: 3px;
  }
  :global(.support-note-help:hover::after),
  :global(.support-note-help:focus::after),
  :global(.support-note-help:focus-visible::after) {
    content: attr(aria-label);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.65rem);
    z-index: 5;
    width: min(18rem, 78vw);
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--v3-border-soft);
    border-radius: var(--v3-radius-lg);
    background: var(--v3-surface-card);
    box-shadow: var(--v3-shadow-md);
    color: var(--v3-ink-secondary);
    font-family: var(--v3-font-body);
    font-size: 0.8125rem;
    line-height: 1.45;
    text-align: left;
    transform: translateX(-50%);
  }
  .v3-doc-patents {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .patents-intro {
    max-width: 44rem;
    margin: 0;
  }
  .patents-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: var(--v3-gap-small);
  }
  .doc-patent-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-height: 100%;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border: 1px solid var(--v3-border-soft);
    border-radius: var(--v3-radius-lg);
    background: var(--v3-surface-card);
    box-shadow: var(--v3-shadow-sm);
  }
  .patent-title {
    margin: 0;
    font-family: var(--v3-font-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.25;
    color: var(--v3-ink);
  }
  .patent-text { margin: 0; }
  .patent-meaning {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
  .patent-meaning-label {
    margin: 0;
    color: var(--v3-champagne-deep);
  }
  .patent-meaning-list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .patent-meaning-list li {
    position: relative;
    padding-left: 1rem;
    color: var(--v3-ink-secondary);
    font-family: var(--v3-font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .patent-meaning-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--v3-champagne-deep);
  }
  .patent-meta {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  .patent-meta div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    align-items: baseline;
  }
  .patent-meta dt {
    color: var(--v3-ink-muted);
    font-family: var(--v3-font-body);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .patent-meta dd {
    margin: 0;
    color: var(--v3-ink-secondary);
  }
  .patent-link {
    align-self: flex-start;
    margin-top: 0.25rem;
  }

  /* Works */
  .v3-doc-works {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .works-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .work-item { display: flex; flex-direction: column; gap: 0.5rem; }
  .work-img-wrap {
    aspect-ratio: 4/5;
    overflow: hidden;
    background: var(--v3-cream);
    border-radius: var(--v3-radius-lg);
    border: 1px solid var(--v3-border-soft);
  }
  .work-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .work-caption { color: var(--v3-ink-muted); text-transform: none; letter-spacing: 0.005em; }
  .works-disclaimer {
    margin-top: 1.5rem;
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
    font-style: normal;
    font-family: var(--v3-font-display);
  }

  @media (max-width: 1024px) {
    .doc-hero-grid { grid-template-columns: 1fr; }
    .doc-hero-text { max-width: 40rem; }
    .doc-hero-photo { max-width: 26rem; margin-inline: 0; }
    .mid-cta-inner { grid-template-columns: 1fr; }
    .mid-cta-actions { align-items: flex-start; }
    .mid-cta-actions .v3-btn { width: auto; }
    .care-layout { grid-template-columns: 1fr; }
    .care-header { position: static; }
    .doc-support-card--media { grid-template-columns: 1fr; }
    .doc-support-media { max-width: 28rem; }
    .patents-grid { grid-template-columns: 1fr; }
    .works-grid { grid-template-columns: repeat(2, 1fr); }
    .doc-price-link-card { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .v3-doc-hero {
      padding-bottom: 4rem;
    }
    .doc-hero-grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }
    .doc-hero-text {
      display: contents;
      gap: 0.875rem;
    }
    .doc-hero-copy {
      order: 1;
      gap: 0.75rem;
    }
    .doc-hero-photo {
      order: 2;
    }
    .doc-hero-booking {
      order: 3;
      gap: 0.875rem;
    }
    .doc-lead,
    .doc-price-row {
      max-width: none;
    }
    .doc-price-row {
      padding-top: 0.375rem;
    }
    .v3-doc-mid-cta {
      padding-top: 3.5rem;
      padding-bottom: 3.5rem;
    }
    .mid-cta-actions,
    .mid-cta-actions .v3-btn {
      width: 100%;
    }
    .mid-cta-messengers {
      justify-content: flex-start;
    }
    .doc-hero-photo {
      overflow: hidden;
      border-radius: var(--v3-radius-xl);
      width: min(100%, 22rem);
      max-width: 22rem;
      margin-inline: 0;
    }
    .doc-cta .v3-btn,
    .doc-profile-link {
      width: 100%;
      justify-content: center;
    }
    .care-list { grid-template-columns: 1fr; }
    .focus-grid,
    .review-grid--multi {
      grid-template-columns: 1fr;
    }
    .focus-grid--single .focus-card {
      display: flex;
      grid-template-columns: none;
      gap: 1.25rem;
    }
    .focus-document img {
      max-height: 26rem;
    }
    .focus-card:nth-child(2n) {
      transform: none;
    }
    .path-essay,
    .focus-card,
    .review-quote {
      padding: 1.25rem;
      border-radius: var(--v3-radius-lg);
    }
    .edu-item { grid-template-columns: 1fr; gap: 0.25rem; }
    .works-grid { grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
  }

  /* Stats strip */
  .v3-doc-stats {
    padding-top: clamp(1.5rem, 4vh, 3rem);
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
  }
  .stats-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
    gap: clamp(1rem, 3vw, 3rem);
    border-top: 1px solid var(--v3-border-soft);
    border-bottom: 1px solid var(--v3-border-soft);
    padding-block: clamp(1.25rem, 3vh, 2.25rem);
  }
  .stats-heading {
    margin: 0 0 0.85rem;
    color: var(--v3-ink-muted);
  }
  .stats-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .stats-value-row {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }
  .stats-value {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.05;
    color: var(--v3-champagne-deep);
  }
  .stats-help {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.45rem;
    height: 1.45rem;
    border: 1px solid var(--v3-border-soft);
    border-radius: 999px;
    color: var(--v3-ink-muted);
    background: var(--v3-surface-card);
    font-family: var(--v3-font-body);
    font-size: 0.75rem;
    line-height: 1;
    cursor: help;
  }
  .stats-help:focus-visible {
    outline: 2px solid var(--v3-champagne-deep);
    outline-offset: 3px;
  }
  .stats-tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.75rem);
    z-index: 4;
    width: min(18rem, 80vw);
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--v3-border-soft);
    border-radius: var(--v3-radius-lg);
    background: var(--v3-surface-card);
    box-shadow: var(--v3-shadow-md);
    color: var(--v3-ink-secondary);
    font-family: var(--v3-font-body);
    font-size: 0.8125rem;
    line-height: 1.45;
    text-align: left;
    display: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 0.35rem);
    pointer-events: none;
    transition:
      opacity var(--v3-duration-fast) var(--v3-ease-out),
      transform var(--v3-duration-fast) var(--v3-ease-out);
  }
  .stats-help:hover .stats-tooltip,
  .stats-help:focus .stats-tooltip,
  .stats-help:focus-visible .stats-tooltip {
    display: block;
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .stats-label {
    color: var(--v3-ink-secondary);
