<script is:inline>
  function initDoctorPage() {
    // Booking button binding
    document.querySelectorAll('[data-booking-open]').forEach((b) => {
      if (b.dataset.bookingBound === '1') return;
      b.dataset.bookingBound = '1';
      b.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const doctor = b.getAttribute('data-doctor') ?? undefined;
        window.dispatchEvent(new CustomEvent('open-booking', { detail: { doctor } }));
      });
    });

    const galleryRoot = document.querySelector('[data-gallery]');
    if (!galleryRoot) return;
    const galleryButtons = Array.from(galleryRoot.querySelectorAll('[data-gallery-open]'));
    if (galleryButtons.length === 0) return;
    const images = galleryButtons.map((btn) => btn.getAttribute('data-gallery-src')).filter(Boolean);
    if (images.length === 0) return;

    const root = document.querySelector('[data-lightbox]');
    if (!root) return;
    if (root.dataset.lightboxReady === '1') {
      root.dataset.lightboxImages = JSON.stringify(images);
      return;
    }

    root.dataset.lightboxReady = '1';
    root.dataset.lightboxImages = JSON.stringify(images);
    const imgEl = root.querySelector('[data-lightbox-img]');
    const counterEl = root.querySelector('[data-lightbox-counter]');
    const closeBtn = root.querySelector('[data-lightbox-close]');
    const prevBtn = root.querySelector('[data-lightbox-prev]');
    const nextBtn = root.querySelector('[data-lightbox-next]');

    let idx = 0;
    let lastFocus = null;

    const getImages = () => {
      try {
        const parsed = JSON.parse(root.dataset.lightboxImages ?? '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };

    const render = () => {
      const currentImages = getImages();
      if (currentImages.length === 0) return;
      imgEl.src = currentImages[idx];
      counterEl.textContent = `${idx + 1} / ${currentImages.length}`;
    };
    const open = (i) => {
      lastFocus = document.activeElement;
      idx = i;
      render();
      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      closeBtn?.focus();
    };
    const close = () => {
      root.hidden = true;
      document.documentElement.style.overflow = '';
      lastFocus?.focus?.();
    };
    const next = () => {
      const currentImages = getImages();
      if (currentImages.length === 0) return;
      idx = (idx + 1) % currentImages.length;
      render();
    };
    const prev = () => {
      const currentImages = getImages();
      if (currentImages.length === 0) return;
      idx = (idx - 1 + currentImages.length) % currentImages.length;
      render();
    };

    galleryButtons.forEach((btn) => {
      if (btn.dataset.lbBound === '1') return;
      btn.dataset.lbBound = '1';
      btn.addEventListener('click', () => open(parseInt(btn.dataset.index ?? '0', 10)));
    });

    closeBtn?.addEventListener('click', close);
    nextBtn?.addEventListener('click', next);
    prevBtn?.addEventListener('click', prev);
    root.addEventListener('click', (e) => { if (e.target === root) close(); });
    document.addEventListener('keydown', (e) => {
      if (root.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') next();
      else if (e.key === 'ArrowLeft') prev();
    });
  }
  if (document.readyState !== 'loading') initDoctorPage();
  else document.addEventListener('DOMContentLoaded', initDoctorPage);
  document.addEventListener('astro:page-load', initDoctorPage);
</script>

