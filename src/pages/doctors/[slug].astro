---
import V3Layout from '../../layouts/V3Layout.astro';
import Navigation from '../../components/v3/sections/Navigation.astro';
import FinalCTA from '../../components/v3/sections/FinalCTA.astro';
import FAQ from '../../components/v3/sections/FAQ.astro';
import Footer from '../../components/v3/sections/Footer.astro';
import { doctors } from '../../data/doctors';
import { doctorPriceSheets } from '../../data/prices';
import type { Doctor } from '../../data/doctors';

export async function getStaticPaths() {
  return doctors.map((d) => ({
    params: { slug: d.slug },
    props: { doctor: d },
  }));
}

interface Props { doctor: Doctor }
const { doctor: d } = Astro.props;

const isSurgeon = d.tags.includes('plastika');
const consultationPrice = d.priceMain;
const doctorPriceSheet = doctorPriceSheets.find((sheet) => sheet.doctorSlug === d.slug);
const hasOnlinePrice = (d.priceSub ?? '').includes('Онлайн');

const faqItems = [
  {
    q: `Как записаться ${d.nameBtn}?`,
    a: 'Позвоните по номеру <a href="tel:+78432236666">+7 843 223-66-66</a>, напишите в WhatsApp или заполните форму на сайте. Администратор подберёт удобное время.',
    open: true,
  },
  {
    q: 'Сколько длится первичная консультация?',
    a: 'Первичная консультация длится до 30 минут. Врач осматривает, задаёт уточняющие вопросы, объясняет возможные решения и дальнейшие шаги.',
  },
  isSurgeon ? {
    q: 'Нужна ли подготовка к операции?',
    a: 'Да. Перечень анализов и обследований врач выдаёт на консультации после осмотра и оценки вашей ситуации.',
  } : {
    q: 'Как подготовиться к косметологической процедуре?',
    a: 'Зависит от процедуры. На консультации врач даст точные рекомендации: что исключить за несколько дней, как ухаживать за кожей в период восстановления.',
  },
  {
    q: 'Можно ли получить онлайн-консультацию?',
    a: hasOnlinePrice
      ? 'Да, онлайн-консультации доступны. Запишитесь через форму или WhatsApp — укажите, что вам нужен онлайн-формат.'
      : 'Да, онлайн-консультации доступны. Формат и стоимость администратор уточнит при записи.',
  },
];
---

<V3Layout
  title={`${d.name} — ${d.spec} — The Platinental Казань`}
  description={`${d.name} — ${isSurgeon ? 'пластический хирург' : 'врач-косметолог'} клиники The Platinental Казань. Специализация, образование, запись на консультацию.`}
>
  <Navigation />
  <main id="main">

    <!-- Hero -->
    <section class="v3-doc-hero v3-surface-cream" aria-labelledby="doc-heading">
      <div class="v3-container v3-container-wide doc-hero-grid">
        <div class="doc-hero-text" data-v3-reveal>
          <nav class="doc-breadcrumb" aria-label="Хлебные крошки">
            <a href="/" class="bc-link">Главная</a>
            <span class="bc-sep" aria-hidden="true">→</span>
            <a href="/doctors" class="bc-link">Врачи</a>
          </nav>
          <span class="v3-eyebrow doc-spec">{d.spec}</span>
          <h1 id="doc-heading" class="v3-h1 doc-h1">
            <em>{d.name}</em>
          </h1>
          <p class="v3-lead doc-lead" set:html={d.short}></p>
          <div class="doc-price-row">
            <span class="doc-price">{consultationPrice}</span>
            {d.priceSub && <span class="v3-caption doc-price-sub">{d.priceSub}</span>}
          </div>
          <div class="doc-cta">
            <button type="button" class="v3-btn v3-btn-primary" data-booking-open data-doctor={d.nameBtn}>
              Записаться {d.nameBtn}
            </button>
          </div>
        </div>

        <div class="doc-hero-photo" data-v3-reveal>
          {d.photo ? (
            <img
              src={d.photo}
              alt={d.name}
              width="480"
              height="600"
              loading="eager"
              class="doc-photo-img"
            />
          ) : (
            <div class="doc-photo-placeholder" aria-hidden="true">
              <span class="doc-initials">{d.initials}</span>
            </div>
          )}
        </div>
      </div>
    </section>

    {d.stats && d.stats.length > 0 && (
      <section class="v3-doc-stats v3-surface-sand" aria-label="Статистика">
        <div class="v3-container v3-container-wide">
          <ul class="stats-row" data-v3-stagger>
            {d.stats.map((s) => (
              <li class="stats-item">
                <span class="stats-value">{s.value}</span>
                <span class="v3-caption stats-label">{s.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {d.approach && (
      <section class="v3-doc-approach v3-surface-cream" aria-labelledby="approach-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Подход</span>
            <h2 id="approach-heading" class="v3-h2"><em>{d.approach.title}</em></h2>
          </header>
          <p class="v3-lead approach-body" data-v3-reveal set:html={d.approach.body}></p>
        </div>
      </section>
    )}

    <!-- Specialization -->
    <section class="v3-doc-spec v3-surface-sand" aria-labelledby="spec-heading">
      <div class="v3-container v3-container-default">
        <header class="doc-section-header" data-v3-stagger>
          <span class="v3-eyebrow">Специализация</span>
          <h2 id="spec-heading" class="v3-h2"><em>Что делает</em></h2>
        </header>
        <ul class="spec-list" data-v3-stagger>
          {d.details.specialization.map((s) => (
            <li class="spec-item">
              <span class="spec-dot" aria-hidden="true"></span>
              <span class="v3-body spec-text">{s}</span>
            </li>
          ))}
        </ul>

        {d.details.patent && (
          <div class="patent-note" data-v3-reveal>
            <span class="v3-eyebrow">Патент</span>
            <p class="v3-body patent-text">{d.details.patent}</p>
          </div>
        )}

        {d.details.awards && (
          <div class="awards-note" data-v3-reveal>
            <span class="v3-eyebrow">Квалификация</span>
            <p class="v3-body" set:html={d.details.awards}></p>
          </div>
        )}

        {d.profileNote && (
          <div class="awards-note" data-v3-reveal>
            <span class="v3-eyebrow">{d.profileNote.label}</span>
            <p class="v3-body" set:html={d.profileNote.body}></p>
          </div>
        )}
      </div>
    </section>

    {doctorPriceSheet && doctorPriceSheet.items.length > 0 && (
      <section class="v3-doc-prices v3-surface-cream" aria-labelledby="doc-prices-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Стоимость услуг</span>
            <h2 id="doc-prices-heading" class="v3-h2"><em>Индивидуальный прайс врача</em></h2>
          </header>
          <div class="doc-price-table-wrap" data-v3-reveal>
            <table class="doc-price-table">
              <tbody>
                {doctorPriceSheet.items.map((item) => (
                  <tr>
                    <td class="doc-price-service">{item.procedure}</td>
                    <td class="doc-price-value">{item.price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="v3-caption doc-price-disclaimer" data-v3-reveal>
            Цены носят информационный характер. Точную стоимость врач определяет на консультации после осмотра и обсуждения задачи.
          </p>
        </div>
      </section>
    )}

    <!-- Education -->
    <section class="v3-doc-edu v3-surface-cream" aria-labelledby="edu-heading">
      <div class="v3-container v3-container-default">
        <header class="doc-section-header" data-v3-stagger>
          <span class="v3-eyebrow">Образование</span>
          <h2 id="edu-heading" class="v3-h2"><em>Профессиональная подготовка</em></h2>
        </header>
        <ol class="edu-timeline" data-v3-stagger>
          {d.details.education.map((e) => (
            <li class={`edu-item${e.year ? '' : ' edu-item--no-year'}`}>
              {e.year && <span class="edu-year v3-eyebrow">{e.year}</span>}
              <p class="edu-text v3-body">{e.text}</p>
            </li>
          ))}
        </ol>

        {d.details.additionalEducation && d.details.additionalEducation.length > 0 && (
          <div class="edu-additional" data-v3-reveal>
            <h3 class="v3-h3 edu-additional-title">Дополнительное образование</h3>
            <ul class="edu-add-list">
              {d.details.additionalEducation.map((e) => (
                <li class="edu-add-item">
                  {e.year && <span class="edu-add-year v3-eyebrow">{e.year}</span>}
                  <span class="v3-body">{e.text}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {d.details.congresses && (
          <p class="v3-body edu-congresses" data-v3-reveal>{d.details.congresses}</p>
        )}
      </div>
    </section>

    {d.documents && d.documents.length > 0 && (
      <section class="v3-doc-docs v3-surface-cream" aria-labelledby="docs-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Документы</span>
            <h2 id="docs-heading" class="v3-h2"><em>Дипломы и публикации</em></h2>
          </header>
          <ul class="docs-grid" data-v3-stagger>
            {d.documents.map((doc) => (
              <li class="doc-card">
                <a href={doc.src} target="_blank" rel="noopener" class="doc-card-link">
                  <span class="doc-card-icon" aria-hidden="true">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                      <line x1="9" y1="14" x2="15" y2="14" />
                      <line x1="9" y1="17" x2="13" y2="17" />
                    </svg>
                  </span>
                  <span class="doc-card-meta">
                    <span class="v3-eyebrow doc-card-kind">{
                      doc.kind === 'diploma' ? 'Диплом' :
                      doc.kind === 'certificate' ? 'Сертификат' :
                      doc.kind === 'cv' ? 'Резюме' :
                      doc.kind === 'patent' ? 'Патент' :
                      'Публикация'
                    }</span>
                    <span class="doc-card-title">{doc.title}</span>
                    <span class="v3-caption doc-card-cta">Открыть PDF →</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {d.gallery && d.gallery.length > 0 && (
      <section class="v3-doc-gallery v3-surface-sand" aria-labelledby="gallery-heading">
        <div class="v3-container v3-container-wide">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Работы</span>
            <h2 id="gallery-heading" class="v3-h2"><em>Результаты</em></h2>
          </header>
          <ul class="gallery-grid" data-v3-stagger data-gallery>
            {d.gallery.map((src, i) => (
              <li class="gallery-item">
                <button type="button" class="gallery-btn" data-gallery-open data-index={i} aria-label={`Открыть фото ${i + 1}`}>
                  <img src={src} alt="" width="400" height="500" loading="lazy" />
                </button>
              </li>
            ))}
          </ul>
          <p class="works-disclaimer v3-caption" data-v3-reveal>
            Фотографии результатов публикуются с письменного согласия пациентов. Результат индивидуален.
          </p>
        </div>
      </section>
    )}

    {d.gallery && d.gallery.length > 0 && (
      <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Просмотр фотографии">
        <button type="button" class="lightbox-close" data-lightbox-close aria-label="Закрыть"><span aria-hidden="true">×</span></button>
        <button type="button" class="lightbox-prev" data-lightbox-prev aria-label="Предыдущее фото"><span aria-hidden="true">‹</span></button>
        <button type="button" class="lightbox-next" data-lightbox-next aria-label="Следующее фото"><span aria-hidden="true">›</span></button>
        <figure class="lightbox-figure">
          <img data-lightbox-img alt="" />
          <figcaption class="v3-caption lightbox-counter" data-lightbox-counter></figcaption>
        </figure>
      </div>
    )}

    <FAQ
      eyebrow="Вопросы"
      heading={`Вопросы о приёме`}
      items={faqItems}
    />

    <FinalCTA
      heading={`Записаться<br />${d.nameBtn}`}
      lead={`Консультация: ${[d.priceMain, d.priceSub].filter(Boolean).join(' · ')}. Задайте вопросы и получите подробные ответы.`}
      submitLabel={`Записаться ${d.nameBtn}`}
    />
  </main>
  <Footer />
</V3Layout>

<script define:vars={{ images: d.gallery ?? [] }}>
  function initDoctorPage() {
    // Booking button binding
    document.querySelectorAll('[data-booking-open]').forEach((b) => {
      if (b.dataset.bookingBound === '1') return;
      b.dataset.bookingBound = '1';
      b.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const doctor = b.getAttribute('data-doctor') ?? undefined;
        window.dispatchEvent(new CustomEvent('open-booking', { detail: { doctor } }));
      });
    });

    if (!images || images.length === 0) return;
    const root = document.querySelector('[data-lightbox]');
    if (!root) return;
    const imgEl = root.querySelector('[data-lightbox-img]');
    const counterEl = root.querySelector('[data-lightbox-counter]');
    const closeBtn = root.querySelector('[data-lightbox-close]');
    const prevBtn = root.querySelector('[data-lightbox-prev]');
    const nextBtn = root.querySelector('[data-lightbox-next]');

    let idx = 0;
    let lastFocus = null;

    const render = () => {
      imgEl.src = images[idx];
      counterEl.textContent = `${idx + 1} / ${images.length}`;
    };
    const open = (i) => {
      lastFocus = document.activeElement;
      idx = i;
      render();
      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      closeBtn?.focus();
    };
    const close = () => {
      root.hidden = true;
      document.documentElement.style.overflow = '';
      lastFocus?.focus?.();
    };
    const next = () => { idx = (idx + 1) % images.length; render(); };
    const prev = () => { idx = (idx - 1 + images.length) % images.length; render(); };

    document.querySelectorAll('[data-gallery-open]').forEach((btn) => {
      if (btn.dataset.lbBound === '1') return;
      btn.dataset.lbBound = '1';
      btn.addEventListener('click', () => open(parseInt(btn.dataset.index ?? '0', 10)));
    });

    closeBtn?.addEventListener('click', close);
    nextBtn?.addEventListener('click', next);
    prevBtn?.addEventListener('click', prev);
    root.addEventListener('click', (e) => { if (e.target === root) close(); });
    document.addEventListener('keydown', (e) => {
      if (root.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') next();
      else if (e.key === 'ArrowLeft') prev();
    });
  }
  if (document.readyState !== 'loading') initDoctorPage();
  else document.addEventListener('DOMContentLoaded', initDoctorPage);
  document.addEventListener('astro:page-load', initDoctorPage);
</script>

<style>
  /* Hero */
  .v3-doc-hero {
    padding-top: clamp(1.5rem, 4vh, 3rem);
    padding-bottom: var(--v3-gap-deep);
  }
  .doc-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(1.5rem, 4vh, 3rem);
  }
  .doc-hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-h1-lead);
  }
  .doc-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--v3-ink-muted);
  }
  .bc-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
    touch-action: manipulation;
    padding-block: 0.375rem;
  }
  .bc-link:hover,
  .bc-link:focus-visible { color: var(--v3-ink); }
  .bc-sep { color: var(--v3-ink-faint); font-size: 0.75rem; }
  .doc-spec { color: var(--v3-champagne-deep); margin-bottom: var(--v3-gap-eyebrow-h1); }
  .doc-h1 { font-size: clamp(1.75rem, 3.5vw, 3rem); }
  .doc-lead { max-width: 44ch; }
  .doc-price-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--v3-border-soft);
  }
  .doc-price {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--v3-champagne-deep);
  }
  .doc-price-sub { color: var(--v3-ink-muted); text-transform: none; letter-spacing: 0.005em; }
  .doc-cta { margin-top: 0.5rem; }

  .doc-hero-photo {
    max-width: 36rem;
    margin-left: auto;
    width: 100%;
  }
  .doc-photo-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1/1;
    object-fit: cover;
    object-position: center;
    display: block;
    background: var(--v3-sand);
    border-radius: 50%;
  }
  .doc-photo-placeholder {
    aspect-ratio: 1/1;
    background: var(--v3-sand);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  .doc-initials {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: clamp(4rem, 10vw, 8rem);
    color: var(--v3-ink-muted);
  }

  /* Section shared */
  .v3-doc-spec,
  .v3-doc-edu {
    padding-top: var(--v3-gap-medium);
    padding-bottom: var(--v3-gap-medium);
  }
  .v3-doc-prices {
    padding-top: var(--v3-gap-medium);
    padding-bottom: var(--v3-gap-medium);
  }
  .doc-section-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-h2-body);
  }

  /* Spec list */
  .spec-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .spec-item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--v3-border-hair);
  }
  .spec-item:last-of-type { border-bottom: 1px solid var(--v3-border-hair); }
  .spec-dot {
    flex-shrink: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--v3-champagne-deep);
    margin-top: 0.4em;
  }
  .spec-text { margin: 0; }

  .patent-note,
  .awards-note {
    margin-top: var(--v3-gap-small);
    padding: 1.5rem;
    background: var(--v3-cream);
    border-left: 3px solid var(--v3-champagne);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .patent-text { margin: 0; }
  .doc-price-table-wrap {
    overflow-x: auto;
    border-top: 1px solid var(--v3-border-hair);
  }
  .doc-price-table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
  }
  .doc-price-table tr:not(:last-child) td {
    border-bottom: 1px solid var(--v3-border-hair);
  }
  .doc-price-table td {
    padding: 1rem 0;
    vertical-align: baseline;
  }
  .doc-price-service {
    padding-right: 1.5rem;
    color: var(--v3-ink);
  }
  .doc-price-value {
    text-align: right;
    white-space: nowrap;
    color: var(--v3-champagne-deep);
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: 1.125rem;
  }
  .doc-price-disclaimer {
    margin-top: 1rem;
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
  }

  /* Education timeline */
  .edu-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .edu-item {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--v3-border-hair);
    align-items: baseline;
  }
  .edu-item:last-of-type { border-bottom: 1px solid var(--v3-border-hair); }
  .edu-year { color: var(--v3-champagne-deep); }
  .edu-text { margin: 0; }
  .edu-item--no-year { grid-template-columns: 1fr; }

  .edu-additional {
    margin-top: var(--v3-gap-small);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .edu-additional-title { color: var(--v3-ink); }
  .edu-add-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .edu-add-item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-size: 0.9375rem;
    color: var(--v3-ink-secondary);
