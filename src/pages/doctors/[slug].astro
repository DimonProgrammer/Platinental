---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Navigation from '../../components/site/sections/Navigation.astro';
import PageLeadMagnet from '../../components/site/sections/PageLeadMagnet.astro';
import FinalCTA from '../../components/site/sections/FinalCTA.astro';
import FAQ from '../../components/site/sections/FAQ.astro';
import Footer from '../../components/site/sections/Footer.astro';
import { doctors } from '../../data/doctors';
import { doctorPriceSheets } from '../../data/prices';
import { getSurgicalBase } from '../../data/partners';
import type { Doctor } from '../../data/doctors';
import { formatCurrencyPlainText, formatTypographyHtml } from '../../lib/formatText';

export async function getStaticPaths() {
  return doctors.map((d) => ({
    params: { slug: d.slug },
    props: { doctor: d },
  }));
}

interface Props { doctor: Doctor }
const { doctor: d } = Astro.props;

const isSurgeon = d.tags.includes('plastika');
const isCosmetologist = d.tags.includes('cosmetology');
const defaultDoctorSeoSpecialty =
  isSurgeon ? 'пластический хирург'
    : isCosmetologist ? 'врач-косметолог'
      : d.group === 'orthopedia' ? 'нейрохирург и травматолог-ортопед'
        : 'врач';
const doctorSeoSpecialty = d.seoSpecialty ?? defaultDoctorSeoSpecialty;
const bookingEnabled = d.bookingEnabled !== false;
const surgicalBase = getSurgicalBase(d.surgicalBase);
const hasSurgicalBase = Boolean(surgicalBase);
const consultationPrice = d.priceMain;
const doctorPriceSheet = doctorPriceSheets.find((sheet) => sheet.doctorSlug === d.slug);
const hasOnlinePrice = (d.priceSub ?? '').includes('Онлайн');
const resultImages = d.resultCases?.map((item) => item.src) ?? [];
const galleryImages = resultImages.length > 0 ? resultImages : (d.gallery ?? []);
const hasResultCases = resultImages.length > 0;
const resultCasesAspect = d.resultCasesAspect ?? '8 / 5';
const resultCasesFit = d.resultCasesFit ?? 'cover';
const galleryAspect = d.galleryAspect ?? '4 / 5';
const galleryFit = d.galleryFit ?? 'cover';
const showResultCaseTitles = d.slug === 'mamedov';
const hasNamedResultCases = showResultCaseTitles && Boolean(d.resultCases?.some((item) => item.title && !/^Кейс \d+$/u.test(item.title)));
const prototypeReviews = d.reviews ?? (d.review ? [d.review] : []);
const hasEditorialProfile = Boolean(d.careAreas?.length || d.professionalPath || prototypeReviews.length || d.focusSections?.length);
const bookingCtaLabel = d.nameBtn === 'записаться' ? 'Записаться на консультацию' : `Записаться ${d.nameBtn}`;
const bookingFaqQuestion = d.nameBtn === 'записаться' ? 'Как записаться на консультацию?' : `Как записаться ${d.nameBtn}?`;
const finalCtaHeading = d.slug === 'iskornev'
  ? 'Записаться к<br />Искорневу А.А.'
  : d.nameBtn === 'записаться'
    ? 'Записаться<br />на приём'
    : `Записаться<br />${d.nameBtn}`;
const finalCtaLead = d.slug === 'iskornev'
  ? 'Администратор уточнит ближайшие даты, формат консультации и какие материалы подготовить к приёму.'
  : `${[d.priceMain, d.priceSub].filter(Boolean).join(' · ')}. Администратор уточнит удобное время и поможет подготовиться к приёму.`;
const messengerLinks = [
  { label: 'Telegram', href: 'https://t.me/platinental_kazan' },
  { label: 'Max', href: 'https://max.ru' },
  { label: 'WhatsApp', href: 'https://wa.me/78432236666' },
];

const defaultFaqItems = [
  bookingEnabled ? {
    q: bookingFaqQuestion,
    a: 'Позвоните по номеру <a href="tel:+78432236666">+7 843 223-66-66</a>, напишите в <a href="https://t.me/platinental_kazan">Telegram</a>, <a href="https://max.ru">Max</a> или <a href="https://wa.me/78432236666">WhatsApp</a>, либо заполните форму на сайте. Администратор подберёт удобное время.',
    open: true,
  } : {
    q: 'В чём подход Андрея Искорнева?',
    a: 'В основе подхода — работа с пропорциями лица, анатомией, мимикой и индивидуальным запросом пациента. Цель — гармоничный образ без шаблонного результата.',
    open: true,
  },
  {
    q: 'Как проходит первичная консультация?',
    a: 'Врач осматривает, задаёт уточняющие вопросы, объясняет возможные решения и дальнейшие шаги. Формат и объём консультации зависят от запроса пациента.',
  },
  isSurgeon ? {
    q: 'Нужна ли подготовка к операции?',
    a: 'Да. Перечень анализов и обследований врач выдаёт на консультации после осмотра и оценки вашей ситуации.',
  } : {
    q: 'Как подготовиться к косметологической процедуре?',
    a: 'Зависит от процедуры. На консультации врач даст точные рекомендации: что исключить за несколько дней, как ухаживать за кожей в период восстановления.',
  },
  {
    q: 'Можно ли получить онлайн-консультацию?',
    a: hasOnlinePrice
      ? 'Да, онлайн-консультации доступны. Запишитесь через форму, Telegram, Max или WhatsApp — укажите, что вам нужен онлайн-формат.'
      : 'Да, онлайн-консультации доступны. Формат и стоимость администратор уточнит при записи.',
  },
].filter((item): item is { q: string; a: string; open?: boolean } => Boolean(item));
const faqItems = d.faq ?? defaultFaqItems;
const doctorTitleSpecialty = doctorSeoSpecialty.charAt(0).toUpperCase() + doctorSeoSpecialty.slice(1);
const doctorDescription = `${d.name} — ${doctorSeoSpecialty} The Platinental Казань. Профиль врача, образование, направления работы и запись на консультацию.`;
const siteUrl = Astro.site ?? new URL('https://kzn.platinental.ru');
const doctorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  '@id': new URL(`/doctors/${d.slug}/#physician`, siteUrl).toString(),
  name: d.name,
  url: new URL(`/doctors/${d.slug}/`, siteUrl).toString(),
  image: d.photo ? new URL(d.photo, siteUrl).toString() : undefined,
  medicalSpecialty: doctorSeoSpecialty,
  worksFor: { '@id': new URL('/#clinic', siteUrl).toString() },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Карла Маркса, 48, корп. 1',
    addressLocality: 'Казань',
    postalCode: '420015',
    addressCountry: 'RU',
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', siteUrl).toString() },
    { '@type': 'ListItem', position: 2, name: 'Врачи', item: new URL('/doctors/', siteUrl).toString() },
    { '@type': 'ListItem', position: 3, name: d.name, item: new URL(`/doctors/${d.slug}/`, siteUrl).toString() },
  ],
};
---

<SiteLayout
  title={`${d.name} — ${doctorTitleSpecialty} в Казани`}
  description={doctorDescription}
  jsonLd={[doctorSchema, breadcrumbSchema]}
>
  <Navigation />
  <main id="main">

    <!-- Hero -->
    <section class="v3-doc-hero v3-surface-cream" aria-labelledby="doc-heading">
      <div class="v3-container v3-container-wide doc-hero-grid">
        <div class="doc-hero-text" data-v3-reveal>
          <div class="doc-hero-copy">
            <nav class="doc-breadcrumb" aria-label="Хлебные крошки">
              <a href="/" class="bc-link">Главная</a>
              <span class="bc-sep" aria-hidden="true">→</span>
              <a href="/doctors" class="bc-link">Врачи</a>
            </nav>
            <span class="v3-eyebrow doc-spec">{d.spec}</span>
            <h1 id="doc-heading" class="v3-h1 doc-h1">
              <em>{d.name}</em>
            </h1>
            <p class="v3-lead doc-lead" set:html={formatTypographyHtml(d.short)}></p>
          </div>
          <div class="doc-hero-booking">
            {bookingEnabled ? (
              <>
                <div class="doc-price-row">
                  <span class="doc-price" set:html={formatCurrencyPlainText(consultationPrice)}></span>
                  {d.priceSub && <span class="v3-caption doc-price-sub" set:html={formatCurrencyPlainText(d.priceSub)}></span>}
                {hasSurgicalBase && (
                  <span class="v3-caption doc-base">
                    Операции проходят на базе клиники «{surgicalBase?.shortName}».
                  </span>
                )}
              </div>
                <div class="doc-cta">
                  <button type="button" class="v3-btn v3-btn-primary" data-booking-open data-doctor={d.nameBtn}>
                    {bookingCtaLabel}
                  </button>
                </div>
              </>
            ) : (
              <div class="doc-price-row doc-price-row-muted">
                <span class="doc-price">Гармонизирующая пластическая хирургия</span>
                <span class="v3-caption doc-price-sub">Лицо, шея, пропорции и естественное омоложение.</span>
                <a href="/doctors" class="v3-btn v3-btn-secondary doc-profile-link">Выбрать врача клиники</a>
              </div>
            )}
          </div>
        </div>

        <div class="doc-hero-photo" data-v3-reveal>
          {d.photo ? (
            <img
              src={d.photo}
              alt={d.name}
              width="480"
              height="600"
              loading="eager"
              class="doc-photo-img"
              style={`--doctor-photo-scale:${d.photoFrame?.scale ?? 1.08}; --doctor-photo-x:${d.photoFrame?.x ?? '0%'}; --doctor-photo-y:${d.photoFrame?.y ?? '-2%'};`}
            />
          ) : (
            <div class="doc-photo-placeholder" aria-hidden="true">
              <span class="doc-initials">{d.initials}</span>
            </div>
          )}
        </div>
      </div>
	    </section>

    {d.stats && d.stats.length > 0 && (
      <section class="v3-doc-stats v3-surface-sand" aria-label="Статистика">
        <div class="v3-container v3-container-wide">
          {d.slug === 'iskornev' && (
            <p class="v3-eyebrow stats-heading">Действительный член международных профессиональных организаций:</p>
          )}
          <ul class="stats-row" data-v3-stagger>
            {d.stats.map((s) => (
              <li class="stats-item">
                <span class="stats-value-row">
                  <span class="stats-value">{s.value}</span>
                  {s.description && (
                    <span class="stats-help" tabindex="0" aria-label={s.description}>
                      ?
                      <span class="stats-tooltip" role="tooltip">{s.description}</span>
                    </span>
                  )}
                </span>
                <span class="v3-caption stats-label">{s.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {d.approach && (
      <section class="v3-doc-approach v3-surface-cream" aria-labelledby="approach-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header">
            <span class="v3-eyebrow">Подход</span>
            <h2 id="approach-heading" class="v3-h2"><em>{d.approach.title}</em></h2>
          </header>
          <p class="v3-lead approach-body" data-v3-reveal set:html={formatTypographyHtml(d.approach.body)}></p>
        </div>
      </section>
    )}

    {d.careAreas && d.careAreas.length > 0 && (
      <section class="v3-doc-care v3-surface-sand" aria-labelledby="care-heading">
        <div class="v3-container v3-container-wide">
          <div class="care-layout">
            <header class="doc-section-header care-header" data-v3-stagger>
              <span class="v3-eyebrow">{d.careEyebrow ?? 'С чем обращаются'}</span>
              <h2 id="care-heading" class="v3-h2"><em>{d.careHeading ?? 'Запросы, с которыми работает врач'}</em></h2>
              <p class="v3-lead care-lead">
                {d.careIntro ?? 'На консультации врач оценивает исходные данные, показания, ограничения и план дальнейших действий.'}
              </p>
            </header>
            <div class="care-groups" data-v3-stagger>
              {d.careAreas.map((area) => (
                <article class="care-group">
                  <h3 class="care-title">{area.title}</h3>
                  {area.intro && <p class="v3-body care-intro">{area.intro}</p>}
                  <ul class="care-list">
                    {area.items.map((item) => <li>{item}</li>)}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    {d.focusSections && d.focusSections.length > 0 && (
      <section class="v3-doc-focus v3-surface-cream" aria-labelledby="focus-heading">
        <div class="v3-container v3-container-wide">
          <header class="doc-section-header doc-section-header--wide" data-v3-stagger>
            <span class="v3-eyebrow">{d.focusEyebrow ?? 'План'}</span>
            <h2 id="focus-heading" class="v3-h2"><em>{d.focusHeading ?? 'Что важно понять до решения'}</em></h2>
          </header>
          <div class:list={['focus-grid', d.focusSections.length === 1 && 'focus-grid--single']} data-v3-stagger>
            {d.focusSections.map((section) => (
              <article class="focus-card">
                {section.image && (
                  <figure class="focus-document">
                    <img src={section.image.src} alt={section.image.alt} width="969" height="1400" loading="eager" decoding="async" />
                    {section.image.caption && <figcaption class="v3-caption">{section.image.caption}</figcaption>}
                  </figure>
                )}
                <div class="focus-card-content">
                  {section.eyebrow && <span class="v3-eyebrow focus-eyebrow">{section.eyebrow}</span>}
                  <h3 class="focus-title">{section.title}</h3>
                  {section.body?.map((paragraph) => (
                    <p class="v3-body">{paragraph}</p>
                  ))}
                  {section.items && section.items.length > 0 && (
                    <ul class="focus-list">
                      {section.items.map((item) => <li>{item}</li>)}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {d.regenerativeComparison && (
      <section class="v3-doc-regen v3-surface-sand" aria-labelledby="regen-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Методика</span>
            <h2 id="regen-heading" class="v3-h2"><em>{d.regenerativeComparison.title}</em></h2>
          </header>

          <div class="regen-intro" data-v3-reveal>
            <p class="v3-lead">{d.regenerativeComparison.lead}</p>
            <a href={d.regenerativeComparison.source.href} target="_blank" rel="noopener" class="v3-link regen-source">
              {d.regenerativeComparison.source.label}
            </a>
          </div>

          <div class="regen-grid" data-v3-stagger>
            {d.regenerativeComparison.columns.map((column) => (
              <article class="regen-card">
                <h3 class="regen-title">{column.title}</h3>
                <ul class="regen-list">
                  {column.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>

          <p class="regen-note v3-caption" data-v3-reveal>{d.regenerativeComparison.note}</p>
        </div>
      </section>
    )}

    {d.professionalPath && (
      <section class="v3-doc-path v3-surface-cream" aria-labelledby="path-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">{d.professionalPath.eyebrow ?? 'Путь врача'}</span>
            <h2 id="path-heading" class="v3-h2"><em>{d.professionalPath.title}</em></h2>
          </header>
          <div class="path-essay" data-v3-stagger>
            {d.professionalPath.body.map((paragraph) => (
              <p class="v3-body">{paragraph}</p>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Education -->
    <section class="v3-doc-edu v3-surface-cream" aria-labelledby="edu-heading">
      <div class="v3-container v3-container-default">
        <header class="doc-section-header" data-v3-stagger>
          <span class="v3-eyebrow">Образование</span>
          <h2 id="edu-heading" class="v3-h2"><em>Профессиональная подготовка</em></h2>
        </header>
        <ol class:list={['edu-timeline', d.slug === 'babayan' && 'edu-timeline--profile']} data-v3-stagger>
          {d.details.education.map((e) => (
            <li class={`edu-item${e.year ? '' : ' edu-item--no-year'}`}>
              {e.year && <span class="edu-year v3-eyebrow">{e.year}</span>}
              <p class="edu-text v3-body">{e.text}</p>
            </li>
          ))}
        </ol>

        {d.details.additionalEducation && d.details.additionalEducation.length > 0 && (
          <div class="edu-additional" data-v3-reveal>
            <h3 class="v3-h3 edu-additional-title">Дополнительное образование</h3>
            <ul class="edu-add-list">
              {d.details.additionalEducation.map((e) => (
                <li class="edu-add-item">
                  {e.year && <span class="edu-add-year v3-eyebrow">{e.year}</span>}
                  <span class="v3-body">{e.text}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {d.details.congresses && (
          <p class="v3-body edu-congresses" data-v3-reveal>{d.details.congresses}</p>
        )}

        <div class="doc-support-grid" data-v3-stagger>
          {d.profileNote && (
            <article class="doc-support-card">
              <span class="v3-eyebrow">{d.profileNote.label}</span>
              <p class="v3-body" set:html={formatTypographyHtml(d.profileNote.body)}></p>
            </article>
          )}

          {d.supportNotes?.map((note) => (
            <article class:list={['doc-support-card', note.image && 'doc-support-card--media']}>
              <div class="doc-support-copy">
                <span class="v3-eyebrow">{note.label}</span>
                <p class="v3-body" set:html={formatTypographyHtml(note.body)}></p>
              </div>
              {note.image && (
                <figure class="doc-support-media">
                  <img src={note.image.src} alt={note.image.alt} width="969" height="1400" loading="eager" decoding="async" />
                  {note.image.caption && <figcaption class="v3-caption">{note.image.caption}</figcaption>}
                </figure>
              )}
            </article>
          ))}

        </div>
      </div>
    </section>

    {d.patents && d.patents.length > 0 && (
      <section class="v3-doc-patents v3-surface-sand" aria-labelledby="patents-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">{d.patentsEyebrow ?? 'Патенты'}</span>
            <h2 id="patents-heading" class="v3-h2"><em>{d.patentsHeading ?? 'Патенты в хирургической практике'}</em></h2>
            <p class="v3-lead patents-intro">
              {d.patentsIntro ?? 'Зарегистрированные разработки показывают участие врача в развитии хирургических способов и профессиональной практики.'}
            </p>
          </header>
          <div class="patents-grid" data-v3-stagger>
            {d.patents.map((patent) => (
              <article class="doc-patent-card">
                <span class="v3-eyebrow">Патент</span>
                <h3 class="patent-title">{patent.number} · {patent.title}</h3>
                <p class="v3-body patent-text">{patent.description}</p>
                {patent.practicalMeaning && patent.practicalMeaning.length > 0 && (
                  <div class="patent-meaning">
                    <p class="v3-caption patent-meaning-label">Практический смысл</p>
                    <ul class="patent-meaning-list">
                      {patent.practicalMeaning.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}
                <dl class="patent-meta">
                  <div>
                    <dt>Роль</dt>
                    <dd>{patent.role}</dd>
                  </div>
                  <div>
                    <dt>Соавторы</dt>
                    <dd>{patent.coauthors.join(', ')}</dd>
                  </div>
                  {patent.holder && (
                    <div>
                      <dt>Патентообладатель</dt>
                      <dd>{patent.holder}</dd>
                    </div>
                  )}
                </dl>
                <a href={patent.href} target="_blank" rel="noopener noreferrer" class="v3-link patent-link">
                  Проверить в базе ФИПС
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {doctorPriceSheet && doctorPriceSheet.items.length > 0 && !isCosmetologist && (
      <section class="v3-doc-prices v3-surface-sand" aria-labelledby="doc-prices-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Стоимость услуг</span>
            <h2 id="doc-prices-heading" class="v3-h2"><em>Индивидуальный прайс врача</em></h2>
          </header>
          <div class="doc-price-table-wrap" data-v3-reveal>
            <table class="doc-price-table">
              <tbody>
                {doctorPriceSheet.items.map((item) => (
                  <tr>
                    <td class="doc-price-service">{item.procedure}</td>
                    <td class="doc-price-value" set:html={formatCurrencyPlainText(item.price)}></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="v3-caption doc-price-disclaimer" data-v3-reveal>
            Цены носят информационный характер. Точную стоимость врач определяет на консультации после осмотра и обсуждения задачи.
          </p>
          {hasSurgicalBase && (
            <p class="v3-caption doc-price-disclaimer doc-price-base" data-v3-reveal>
              Операции проходят на базе клиники «{surgicalBase?.shortName}»: {surgicalBase?.address}. Детали подготовки врач уточняет на консультации.
            </p>
          )}
        </div>
      </section>
    )}

    {isCosmetologist && (
      <section class="v3-doc-prices v3-surface-sand" aria-labelledby="doc-prices-heading">
        <div class="v3-container v3-container-default">
          <header class="doc-section-header" data-v3-stagger>
            <span class="v3-eyebrow">Косметология</span>
