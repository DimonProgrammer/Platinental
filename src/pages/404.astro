---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/site/sections/Navigation.astro';
import Footer from '../components/site/sections/Footer.astro';
---

<SiteLayout
  title="Страница не найдена — The Platinental Казань"
  description="Запрошенная страница не найдена. Вернитесь на главную страницу клиники The Platinental Казань."
  canonical="/"
  robots="noindex, follow"
  includeClinicSchema={false}
>
  <Navigation />
  <main id="main">
    <section class="v3-404 v3-surface-cream" aria-labelledby="notfound-heading">
      <div class="v3-container v3-container-default notfound-inner">
        <div data-v3-reveal>
          <span class="v3-eyebrow">The Platinental · Казань</span>
          <p class="notfound-code" aria-hidden="true">404</p>
          <h1 id="notfound-heading" class="v3-h1 notfound-h1">
            <em>Страница не найдена</em>
          </h1>
          <p class="v3-lead notfound-lead">
            Такой страницы нет — возможно, она переехала или была удалена. Перейдите на главную или выберите раздел:
          </p>
          <nav class="notfound-links v3-body" aria-label="Разделы сайта">
            <a href="/" class="v3-link">Главная</a>
            <a href="/plastika" class="v3-link">Пластическая хирургия</a>
            <a href="/kosmetologiya" class="v3-link">Косметология</a>
            <a href="/doctors" class="v3-link">Врачи</a>
            <a href="/prices" class="v3-link">Цены</a>
            <a href="/contacts" class="v3-link">Контакты</a>
          </nav>
          <div class="notfound-cta">
            <a href="/" class="v3-btn v3-btn-primary">На главную</a>
            <a href="/contacts" class="v3-btn v3-btn-secondary">Контакты клиники</a>
          </div>
          <p class="notfound-phone v3-caption">
            Или позвоните <a href="tel:+78432236666" class="v3-link">+7 (843) 223-66-66</a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</SiteLayout>

<style>
  .v3-404 {
    min-height: calc(100svh - var(--v3-nav-h, 4rem) + 4rem);
    padding-top: clamp(4rem, 9vh, 7rem);
    padding-bottom: clamp(4rem, 9vh, 7rem);
    display: flex;
    align-items: center;
    text-align: center;
  }
  .notfound-inner > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 44rem;
    margin-inline: auto;
  }
  .notfound-inner .v3-eyebrow {
    margin-bottom: var(--v3-gap-h1-lead);
  }
  .notfound-code {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-weight: 300;
    font-size: clamp(5.5rem, 13vw, 11rem);
    line-height: 0.95;
    color: color-mix(in srgb, var(--v3-ink) 14%, var(--v3-cream));
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
    letter-spacing: 0;
  }
  .notfound-h1 {
    margin: 0 0 var(--v3-gap-h1-lead);
  }
  .notfound-lead {
    max-width: 40ch;
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
  }
  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    max-width: 42rem;
    margin: 0 0 clamp(1.75rem, 3vw, 2.5rem);
  }
  .notfound-links .v3-link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
  }
  .notfound-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.9375rem;
  }
  .notfound-phone {
    margin: 1rem 0 0;
  }
  @media (max-width: 768px) {
    .v3-404 {
      min-height: calc(100svh - var(--v3-nav-h, 4rem) + 4rem);
      padding-top: clamp(3rem, 10vh, 5rem);
      padding-bottom: clamp(3rem, 10vh, 5rem);
    }
    .notfound-links {
      gap: 0.25rem 1rem;
    }
  }
  @media (max-width: 560px) {
    .notfound-code {
      font-size: clamp(5rem, 30vw, 7rem);
    }
    .notfound-links {
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }
    .notfound-cta {
      width: 100%;
      gap: 0.75rem;
    }
  }
</style>
