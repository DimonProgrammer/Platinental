---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/primitives/Button.astro';

const sections = [
  { href: '/', label: 'Главная' },
  { href: '/plastika', label: 'Пластическая хирургия' },
  { href: '/kosmetologiya', label: 'Косметология' },
  { href: '/doctors', label: 'Врачи' },
  { href: '/prices', label: 'Цены' },
  { href: '/contacts', label: 'Контакты' },
];
---

<BaseLayout
  title="Страница не найдена — Platinental Казань"
  description="Страница не найдена. Вернитесь на главную Platinental Казань или выберите нужный раздел."
>
  <section class="nf" aria-labelledby="nf-title">
    <div class="nf__inner" data-reveal>
      <div class="nf__badge font-display" aria-hidden="true">404</div>

      <h1 id="nf-title" class="nf__title font-display">
        Страница <em>не&nbsp;найдена</em>
      </h1>

      <p class="nf__text">
        Такой страницы нет&nbsp;— возможно, она переехала или была удалена. Перейдите на&nbsp;главную или выберите раздел:
      </p>

      <nav class="nf__nav" aria-label="Навигация по разделам">
        {sections.map((s, i) => (
          <>
            <a href={s.href} class="nf__nav-link">{s.label}</a>
            {i < sections.length - 1 && <span class="nf__sep" aria-hidden="true">·</span>}
          </>
        ))}
      </nav>

      <div class="nf__actions">
        <Button href="/" variant="inverse" size="lg">На&nbsp;главную</Button>
        <Button href="/contacts" variant="ghost" size="lg" class="nf__ghost">Контакты клиники</Button>
      </div>

      <p class="nf__phone">
        Или позвоните <a href="tel:+78432236666">+7&nbsp;(843)&nbsp;223-66-66</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    background: var(--surface-inverse);
    color: var(--text-inverse);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--nav-height-mobile) + var(--space-12)) 20px var(--space-12);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .nf { padding: calc(var(--nav-height) + var(--space-16)) 32px var(--space-16); }
  }

  .nf::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 50% 40%, rgba(196, 168, 130, 0.18), transparent 60%);
    pointer-events: none;
  }

  .nf__inner {
    position: relative;
    max-width: 720px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nf__badge {
    font-size: clamp(5rem, 3rem + 8vw, 10rem);
    font-weight: 300;
    line-height: 0.9;
    color: var(--accent);
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
    opacity: 0.85;
  }

  .nf__title {
    font-size: clamp(1.75rem, 1rem + 2.2vw, 2.75rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    color: var(--text-inverse);
    margin-bottom: var(--space-5);
    text-wrap: balance;
  }

  .nf__title em {
    color: var(--accent);
    font-weight: 300;
  }

  .nf__text {
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--text-inverse-muted);
    max-width: 50ch;
    margin-bottom: var(--space-8);
  }

  .nf__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    justify-content: center;
    align-items: center;
    margin-bottom: var(--space-10);
  }

  .nf__nav-link {
    font-size: var(--text-ui);
    color: var(--accent);
    padding: 4px 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nf__nav-link:hover { color: var(--text-inverse); }

  .nf__sep {
    color: rgba(255, 253, 248, 0.2);
    padding: 0 10px;
    user-select: none;
  }

  @media (max-width: 520px) {
    .nf__sep { display: none; }
    .nf__nav {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
    margin-bottom: var(--space-8);
  }

  .nf__ghost { color: var(--text-inverse) !important; }

  .nf__phone {
    font-size: var(--text-caption);
    color: var(--text-inverse-muted);
  }

  .nf__phone a {
    color: var(--text-inverse);
    border-bottom: 1px solid rgba(255, 253, 248, 0.3);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .nf__phone a:hover { border-bottom-color: var(--accent); }
</style>
