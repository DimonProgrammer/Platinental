---
import V3Layout from '../layouts/V3Layout.astro';
import Navigation from '../components/v3/sections/Navigation.astro';
import PageHero from '../components/v3/sections/PageHero.astro';
import FinalCTA from '../components/v3/sections/FinalCTA.astro';
import FAQ from '../components/v3/sections/FAQ.astro';
import Footer from '../components/v3/sections/Footer.astro';
import { kosmProcs } from '../data/kosmetologiya';
import { doctors } from '../data/doctors';

const cosmetologists = doctors.filter((d) => d.tags.includes('cosmetology'));

const categoryMeta = {
  injection: { label: 'Инъекционная косметология', eyebrow: 'Инъекции' },
  hardware: { label: 'Аппаратная косметология', eyebrow: 'Аппаратная' },
  therapy: { label: 'Терапевтические процедуры', eyebrow: 'Терапия' },
};

const categories = ['injection', 'hardware', 'therapy'] as const;

const faqItems = [
  {
    q: 'Сколько стоит первичная консультация?',
    a: 'У косметолога — от <strong>2 000 ₽</strong>. У хирурга — от <strong>5 000 ₽</strong>.',
    open: true,
  },
  {
    q: 'Есть ли противопоказания к операциям?',
    a: 'Да. Часть — общие для любой хирургии: беременность, лактация, онкология, нарушения свёртываемости крови, тяжёлые хронические заболевания. Часть — индивидуальные: их хирург видит только на очной консультации.',
  },
  {
    q: 'Через сколько дней виден результат после ботокса?',
    a: 'Первый эффект появляется через 3–5 дней, окончательный — через 10–14 дней. Держится 4–6 месяцев в зависимости от препарата и индивидуальных особенностей.',
  },
  {
    q: 'Вы работаете с мужчинами?',
    a: 'Каждый пятый пациент — мужчина. Чаще всего приходят с носом, веками, подбородком и коррекцией гинекомастии. У мужской эстетики своё правило: результат не должен читаться как вмешательство — хирурги работают именно в этом ключе.',
  },
  {
    q: 'Как проходит первичная консультация хирурга?',
    a: 'Хирург осматривает, замеряет, фотографирует, подбирает методику — и отвечает на все вопросы без спешки.',
  },
  {
    q: 'Как долго длится реабилитация?',
    a: 'Зависит от операции:<br />— Блефаропластика — 7–14 дней<br />— Ринопластика — 2–3 недели<br />— Маммопластика — 2–4 недели ограничений<br />— SMAS-лифтинг — 3–4 недели<br /><br />Точные сроки хирург назовёт на консультации.',
  },
];
---

<V3Layout
  title="Косметология — The Platinental Казань"
  description="Инъекционная, аппаратная и терапевтическая косметология в клинике The Platinental Казань. Ботулотоксин, филлеры, лазер CO₂, биоревитализация."
>
  <Navigation />
  <main id="main">
    <PageHero
      pageMarker="02 / 04"
      pageMarkerLabel="Услуги"
      eyebrow="Косметология"
      h1="Косметология в Казани — клиника The Platinental"
      lead="Косметолог при консультации клиента может порекомендовать процедуры, которые отсрочат операции на годы. Хирурги смотрят шире и не спешат к скальпелю. Если результат можно получить без операционных действий, через косметолога, — рекомендация будет в пользу этого пути."
      ctaPrimary={{ label: 'Записаться на консультацию', href: '#form' }}
      ctaSecondary={{ label: 'Цены', href: '/prices' }}
    />

    <section class="v3-kosm-quote v3-surface-sand" aria-labelledby="kosm-quote-heading">
      <div class="v3-container v3-container-wide">
        <div class="kosm-quote-shell" data-v3-reveal>
          <span class="v3-eyebrow kosm-quote-kicker">Подход клиники</span>
          <blockquote id="kosm-quote-heading" class="kosm-quote-text v3-display">
            <em>«Для создания живого лица недостаточно просто вколоть филлер. Мы предлагаем более тонкие и сложные техники»</em>
          </blockquote>
          <p class="kosm-quote-note v3-caption">Косметология в клинике работает не как набор отдельных инъекций, а как часть общей эстетической стратегии.</p>
        </div>
      </div>
    </section>

    <!-- Procedures by category -->
    {categories.map((catKey) => {
      const procs = kosmProcs.filter((p) => p.category === catKey);
      const meta = categoryMeta[catKey];
      return (
        <section class="v3-kosm-cat v3-surface-cream" aria-labelledby={`cat-${catKey}-heading`}>
          <div class="v3-container v3-container-wide">
            <header class="cat-header" data-v3-stagger>
              <span class="v3-eyebrow">{meta.eyebrow}</span>
              <h2 id={`cat-${catKey}-heading`} class="v3-h2"><em>{meta.label}</em></h2>
            </header>
            <ul class="procs-grid" data-v3-stagger>
              {procs.map((p) => (
                <li class="proc-card">
                  <span class="proc-badge v3-eyebrow">{p.badge}</span>
                  <h3 class="proc-name v3-h3">{p.name}</h3>
                  <p class="proc-desc v3-body" set:html={p.desc}></p>
                  <ul class="proc-prices">
                    {p.prices.map((pr) => (
                      <li class="proc-price-row">
                        <span class="proc-price-label v3-caption">{pr.label}</span>
                        <span class="proc-price-val">{pr.value}</span>
                      </li>
                    ))}
                  </ul>
                  <a href="#form" class="proc-cta v3-link">Записаться</a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    })}

    <!-- Cosmetologists -->
    {cosmetologists.length > 0 && (
      <section class="v3-kosm-doctors v3-surface-cream" aria-labelledby="cosm-doctors-heading">
        <div class="v3-container v3-container-wide">
          <header class="doctors-header" data-v3-stagger>
            <span class="v3-eyebrow">Специалист направления</span>
            <h2 id="cosm-doctors-heading" class="v3-display doctors-h2"><em>Anti-age врач-косметолог клиники</em></h2>
          </header>
          {cosmetologists.map((d) => (
            <div class="doctor-card" data-v3-reveal>
              <div class="dc-photo-wrap">
                {d.photo
                  ? <img src={d.photo} alt={d.name} loading="lazy" class="dc-photo-img" />
                  : <div class="dc-initials">{d.initials}</div>}
              </div>
              <div class="dc-body">
                <p class="v3-eyebrow dc-spec">{d.spec}</p>
                <h3 class="v3-display dc-name"><em>{d.name}</em></h3>
                <p class="v3-body dc-bio" set:html={d.short}></p>
                <hr class="dc-rule" />
                <div class="dc-consult-row">
                  <span class="v3-eyebrow dc-consult-label">Консультация</span>
                  <span class="dc-price">{d.priceMain}</span>
                </div>
                <hr class="dc-rule" />
                <div class="dc-actions">
                  <a href="#form" class="v3-btn v3-btn-primary">Записаться</a>
                  <a href={`/doctors/${d.slug}`} class="dc-more-link">Подробнее о враче</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <FAQ
      eyebrow="Косметология"
      heading="Частые вопросы"
      items={faqItems}
    />

    <FinalCTA
      heading="Записаться<br />к косметологу"
      lead="Первичная консультация от 2 000 ₽. Врач оценит состояние кожи и подберёт процедуры под ваши цели."
    />
  </main>
  <Footer />
</V3Layout>

<style>
  .v3-kosm-quote {
    padding-top: var(--v3-gap-medium);
    padding-bottom: var(--v3-gap-medium);
  }
  .kosm-quote-shell {
    max-width: 64rem;
    padding-block: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .kosm-quote-kicker {
    color: var(--v3-ink-muted);
  }
  .kosm-quote-text {
    margin: 0;
    max-width: 22ch;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(2rem, 4.2vw, 4rem);
    line-height: 1.06;
    color: var(--v3-ink);
    text-wrap: balance;
  }
  .kosm-quote-note {
    max-width: 56ch;
    margin: 0;
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
    font-family: var(--v3-font-body);
    font-size: 0.875rem;
  }
  .v3-kosm-cat {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .cat-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .procs-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--v3-border-hair);
    border-left: 1px solid var(--v3-border-hair);
  }
  .proc-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--v3-cream);
    border-right: 1px solid var(--v3-border-hair);
    border-bottom: 1px solid var(--v3-border-hair);
  }
  .proc-badge { color: var(--v3-ink-muted); }
  .proc-name { color: var(--v3-ink); }
  .proc-desc { margin: 0; font-size: 0.9375rem; color: var(--v3-ink-secondary); flex: 1; }
  .proc-prices {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.875rem 0 0;
    border-top: 1px solid var(--v3-border-hair);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .proc-price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }
  .proc-price-label { color: var(--v3-ink-muted); text-transform: none; letter-spacing: 0.005em; flex: 1; }
  .proc-price-val {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: 1rem;
    color: var(--v3-champagne-deep);
    white-space: nowrap;
  }
  .proc-cta {
    font-size: 0.9375rem;
    margin-top: 0.25rem;
    align-self: flex-start;
  }

  /* Doctors */
  .v3-kosm-doctors {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .doctors-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-medium, 3rem);
  }
  .doctors-h2 { margin: 0; }

  /* Doctor card */
  .doctor-card {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    background: var(--v3-sand);
  }
  .dc-photo-wrap {
    position: relative;
    background: var(--v3-ink);
    overflow: hidden;
    aspect-ratio: 1/1;
    border-radius: 50%;
    margin: clamp(1rem, 2.5vw, 1.5rem);
  }
  .dc-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .dc-initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: clamp(4rem, 8vw, 8rem);
    color: rgba(255, 254, 242, 0.18);
    letter-spacing: 0.04em;
  }
  .dc-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(2rem, 4vw, 3.5rem);
    justify-content: center;
  }
  .dc-spec { color: var(--v3-champagne-deep); margin: 0; }
  .dc-name { margin: 0; line-height: 1.05; color: var(--v3-ink); }
  .dc-bio { margin: 0; color: var(--v3-ink-secondary); max-width: 52ch; }
  .dc-rule {
    border: none;
    border-top: 1px solid var(--v3-border-hair);
    margin: 0;
  }
  .dc-consult-row {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }
  .dc-consult-label { color: var(--v3-ink-muted); }
  .dc-price {
    font-family: var(--v3-font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--v3-champagne-deep);
  }
  .dc-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .dc-more-link {
    font-family: var(--v3-font-body);
    font-size: 0.9375rem;
    color: var(--v3-ink);
    text-decoration: underline;
    text-decoration-color: var(--v3-border-hair);
    text-underline-offset: 3px;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .dc-more-link:hover { color: var(--v3-champagne-deep); text-decoration-color: var(--v3-champagne-soft); }

  @media (max-width: 1024px) {
    .kosm-quote-text { max-width: 100%; }
    .procs-grid { grid-template-columns: repeat(2, 1fr); }
    .doctor-card { grid-template-columns: 1fr; }
    .dc-photo-wrap { max-height: 26rem; }
  }
  @media (max-width: 560px) {
    .kosm-quote-shell { gap: 0.875rem; }
    .procs-grid { grid-template-columns: 1fr; }
    .dc-photo-wrap { max-height: none; margin: 1rem; }
  }
</style>
