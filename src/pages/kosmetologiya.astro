---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/site/sections/Navigation.astro';
import PageHero from '../components/site/sections/PageHero.astro';
import PageLeadMagnet from '../components/site/sections/PageLeadMagnet.astro';
import FinalCTA from '../components/site/sections/FinalCTA.astro';
import FAQ from '../components/site/sections/FAQ.astro';
import Footer from '../components/site/sections/Footer.astro';
import { kosmProcs } from '../data/kosmetologiya';
import { doctors } from '../data/doctors';
import { formatCurrencyPlainText, formatTypographyHtml } from '../lib/formatText';

const cosmetologists = doctors.filter((d) => d.tags.includes('cosmetology'));

const categoryMeta = {
  injection: { label: 'Инъекционная косметология', eyebrow: 'Инъекции' },
  hardware: { label: 'Аппаратная косметология', eyebrow: 'Аппаратная' },
  therapy: { label: 'Терапевтические процедуры', eyebrow: 'Терапия' },
};

const categories = ['injection', 'hardware', 'therapy'] as const;

const faqItems = [
  {
    q: 'Сколько стоит первичная консультация?',
    a: 'У косметолога — от <strong>2 000 ₽</strong>. У хирурга — от <strong>5 000 ₽</strong>.',
    open: true,
  },
  {
    q: 'Есть ли противопоказания к косметологическим процедурам?',
    a: 'Да. Они зависят от состояния кожи, здоровья, беременности, лактации, хронических заболеваний и препаратов, которые вы принимаете. Врач уточнит ограничения на консультации.',
  },
  {
    q: 'Через сколько дней виден результат после ботокса?',
    a: 'Первый эффект появляется через 3–5 дней, окончательный — через 10–14 дней. Держится 4–6 месяцев в зависимости от препарата и индивидуальных особенностей.',
  },
  {
    q: 'Можно ли сочетать косметологию с пластической операцией?',
    a: 'Да, но порядок определяет врач. Иногда косметология помогает подготовить кожу до операции, иногда подключается на этапе восстановления — по назначению хирурга.',
  },
  {
    q: 'Как проходит первичная консультация косметолога?',
    a: 'Врач смотрит кожу, спрашивает про домашний уход и прошлые процедуры, уточняет ограничения и предлагает понятный план.',
  },
  {
    q: 'Нужна ли реабилитация после косметологии?',
    a: 'Зависит от процедуры. После инъекций и аппаратных методик врач может временно ограничить спорт, баню, солнце и часть домашнего ухода.',
  },
];
---

<SiteLayout
  title="Косметология в Казани: инъекции и лазер | The Platinental"
  description="Инъекционная, аппаратная и терапевтическая косметология в клинике The Platinental Казань. Ботулотоксин, филлеры, лазер CO₂, биоревитализация."
>
  <Navigation />
  <main id="main">
    <PageHero
      pageMarker="02 / 04"
      pageMarkerLabel="Услуги"
      eyebrow="Косметология"
      h1="Косметология в Казани — клиника The Platinental"
      lead="Самостоятельное направление и часть хирургического вмешательства: подготовка кожи до операции, восстановление после пластики, инъекционные, аппаратные и уходовые процедуры."
      ctaPrimary={{
        label: 'Записаться на консультацию',
        href: '#form',
        bookingTitle: 'Запишем к врачу-косметологу',
        bookingLead: 'Оставьте телефон — администратор свяжется в рабочее время и подберёт удобное время консультации.',
        bookingPlaceholder: 'Что беспокоит: кожа, мимика, пигментация, восстановление или конкретная процедура',
      }}
      ctaSecondary={{ label: 'Цены', href: '/prices' }}
      metaLabel="На консультации разберём:"
      metaPlacement="cta"
      ctaPlacement="after-meta"
      meta={[
        { num: '•', label: 'состояние кожи и мимики' },
        { num: '?', label: 'какие процедуры подойдут сейчас' },
        { num: '—', label: 'курс, интервалы и восстановление' },
        { num: '+', label: 'совместимость с хирургией' },
      ]}
    />
    <!-- Procedures by category -->
    {categories.map((catKey) => {
      const procs = kosmProcs.filter((p) => p.category === catKey);
      const meta = categoryMeta[catKey];
      return (
        <section class="v3-kosm-cat v3-surface-cream" aria-labelledby={`cat-${catKey}-heading`}>
          <div class="v3-container v3-container-wide">
            <header class="cat-header" data-v3-stagger>
              <span class="v3-eyebrow">{meta.eyebrow}</span>
              <h2 id={`cat-${catKey}-heading`} class="v3-h2"><em>{meta.label}</em></h2>
            </header>
            <ul class="procs-grid" data-v3-stagger>
              {procs.map((p) => (
                <li class="proc-card">
                  <span class="proc-badge v3-eyebrow">{p.badge}</span>
                  <h3 class="proc-name v3-h3">{p.name}</h3>
                  <p class="proc-desc v3-body" set:html={formatTypographyHtml(p.desc)}></p>
                  <ul class="proc-prices">
                    {p.prices.map((pr) => (
                      <li class="proc-price-row">
                        <span class="proc-price-label v3-caption">{pr.label}</span>
                        <span class="proc-price-val" set:html={formatCurrencyPlainText(pr.value)}></span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
            <div class="category-cta" data-v3-reveal>
              <a
                href="#form"
                class="v3-btn v3-btn-primary"
                data-booking-custom-title="Запишем к врачу-косметологу"
                data-booking-custom-lead="Оставьте телефон — администратор свяжется в рабочее время и подберёт удобное время консультации."
                data-booking-custom-placeholder="Какая процедура или задача вас интересует"
              >Записаться к косметологу</a>
            </div>
          </div>
        </section>
      );
    })}

    <!-- Cosmetologists -->
    {cosmetologists.length > 0 && (
      <section class="v3-kosm-doctors v3-surface-cream" aria-labelledby="cosm-doctors-heading">
        <div class="v3-container v3-container-wide">
          <header class="doctors-header" data-v3-stagger>
            <span class="v3-eyebrow">Специалист направления</span>
            <h2 id="cosm-doctors-heading" class="v3-display doctors-h2"><em>Врач-косметолог клиники</em></h2>
          </header>
          {cosmetologists.map((d) => (
            <div class="doctor-card" data-v3-reveal>
              <div class="dc-photo-wrap">
                {d.photo
                  ? <img
                      src={d.photo}
                      alt={d.name}
                      loading="lazy"
                      class="dc-photo-img"
                      style={`--doctor-photo-scale:${d.photoFrame?.scale ?? 1.1}; --doctor-photo-x:${d.photoFrame?.x ?? '0%'}; --doctor-photo-y:${d.photoFrame?.y ?? '-2%'};`}
                    />
                  : <div class="dc-initials">{d.initials}</div>}
              </div>
              <div class="dc-body">
                <p class="v3-eyebrow dc-spec">{d.spec}</p>
                <h3 class="v3-display dc-name"><em>{d.name}</em></h3>
                <p class="v3-body dc-bio" set:html={formatTypographyHtml(d.short)}></p>
                <hr class="dc-rule" />
                <div class="dc-consult-row">
                  <span class="v3-eyebrow dc-consult-label">Консультация</span>
                  <span class="dc-price" set:html={formatCurrencyPlainText(d.priceMain)}></span>
                </div>
                <hr class="dc-rule" />
                <div class="dc-actions">
                  <a href="#form" class="v3-btn v3-btn-primary">Записаться</a>
                  <a href={`/doctors/${d.slug}`} class="dc-more-link">Подробнее о враче</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <PageLeadMagnet
      eyebrow="План процедур"
      heading="Персональный план<br />косметологических процедур"
      lead="На консультации врач объясняет, какие процедуры уместны сейчас, где нужен курс, какие интервалы соблюдать и как поддерживать результат домашним уходом."
      items={[
        { mark: '•', title: 'Зона', text: 'лицо, шея, веки, качество кожи или мимические морщины' },
        { mark: '—', title: 'Ритм', text: 'сколько визитов потребуется и какие интервалы разумны' },
        { mark: '+', title: 'Домашний уход', text: 'что поддержит результат между процедурами' },
      ]}
      ctaPrimary={{
        label: 'Получить план',
        href: '#form',
        bookingTitle: 'Составим план с косметологом',
        bookingLead: 'Оставьте телефон — администратор свяжется в рабочее время и запишет на консультацию к врачу-косметологу.',
        bookingPlaceholder: 'Что беспокоит: качество кожи, мимика, пигментация, восстановление после процедур',
      }}
      ctaSecondary={{ label: 'Полный прайс', href: '/prices' }}
      surface="cream"
    />

    <FAQ
      eyebrow="Косметология"
      heading="Частые вопросы"
      items={faqItems}
    />

    <FinalCTA
      heading="Записаться<br />к косметологу"
      lead="Первичная консультация от 2 000 ₽. Врач оценит состояние кожи и подберёт процедуры под ваши цели."
    />
  </main>
  <Footer />
</SiteLayout>

<style>
  .v3-kosm-cat {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .cat-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .procs-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--v3-border-hair);
    border-left: 1px solid var(--v3-border-hair);
  }
  .proc-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--v3-cream);
    border-right: 1px solid var(--v3-border-hair);
    border-bottom: 1px solid var(--v3-border-hair);
  }
  .proc-badge { color: var(--v3-ink-muted); }
  .proc-name { color: var(--v3-ink); }
  .proc-desc { margin: 0; font-size: 0.9375rem; color: var(--v3-ink-secondary); flex: 1; }
  .proc-prices {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.875rem 0 0;
    border-top: 1px solid var(--v3-border-hair);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .proc-price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }
  .proc-price-label { color: var(--v3-ink-muted); text-transform: none; letter-spacing: 0.005em; flex: 1; }
  .proc-price-val {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: 1rem;
    color: var(--v3-champagne-deep);
    white-space: nowrap;
  }
  .category-cta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  /* Doctors */
  .v3-kosm-doctors {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .doctors-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-medium, 3rem);
  }
  .doctors-h2 { margin: 0; }

  /* Doctor card */
  .doctor-card {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    background: var(--v3-sand);
    border-radius: var(--v3-radius-xl);
    overflow: hidden;
    border: 1px solid var(--v3-border-soft);
    box-shadow: var(--v3-shadow-sm);
  }
  .dc-photo-wrap {
    position: relative;
    background: var(--v3-ink);
    overflow: hidden;
    aspect-ratio: 1/1;
    border-radius: var(--v3-radius-lg);
    margin: clamp(1rem, 2.5vw, 1.5rem);
  }
  .dc-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transform: translate(var(--doctor-photo-x, 0%), var(--doctor-photo-y, -2%)) scale(var(--doctor-photo-scale, 1.1));
    transform-origin: center top;
  }
  .dc-initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: clamp(4rem, 8vw, 8rem);
    color: rgba(251, 248, 244, 0.18);
    letter-spacing: 0.04em;
  }
  .dc-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(2rem, 4vw, 3.5rem);
    justify-content: center;
  }
  .dc-spec { color: var(--v3-champagne-deep); margin: 0; }
  .dc-name { margin: 0; line-height: 1.05; color: var(--v3-ink); }
  .dc-bio { margin: 0; color: var(--v3-ink-secondary); max-width: 52ch; }
  .dc-rule {
    border: none;
    border-top: 1px solid var(--v3-border-hair);
    margin: 0;
  }
  .dc-consult-row {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }
  .dc-consult-label { color: var(--v3-ink-muted); }
  .dc-price {
    font-family: var(--v3-font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--v3-champagne-deep);
  }
  .dc-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .dc-more-link {
    font-family: var(--v3-font-body);
    font-size: 0.9375rem;
    color: var(--v3-ink);
    text-decoration: underline;
    text-decoration-color: var(--v3-border-hair);
    text-underline-offset: 3px;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .dc-more-link:hover { color: var(--v3-champagne-deep); text-decoration-color: var(--v3-champagne-soft); }

  @media (max-width: 1024px) {
    .procs-grid { grid-template-columns: 1fr; }
    .doctor-card { grid-template-columns: 1fr; }
    .dc-photo-wrap { max-height: 26rem; }
  }
  @media (max-width: 560px) {
    .category-cta { align-items: stretch; }
    .category-cta .v3-link { justify-content: center; }
    .dc-photo-wrap { max-height: none; margin: 1rem; }
  }
</style>
