---
interface FAQItem {
  q: string;
  a: string;
  open?: boolean;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  items?: FAQItem[];
}

const defaultItems: FAQItem[] = [
  {
    q: 'Сколько стоит первичная консультация?',
    a: 'У косметолога — от <strong>2 000 ₽</strong>. У хирурга — от <strong>5 000 ₽</strong>.',
    open: true,
  },
  {
    q: 'Есть ли противопоказания к операциям?',
    a: 'Да. Часть — общие для любой хирургии: беременность, лактация, онкология, нарушения свёртываемости крови, тяжёлые хронические заболевания. Часть — индивидуальные: их хирург видит только на очной консультации.',
  },
  {
    q: 'Через сколько дней виден результат после ботокса?',
    a: 'Первый эффект появляется через 3–5 дней, окончательный — через 10–14 дней. Держится 4–6 месяцев в зависимости от препарата и индивидуальных особенностей.',
  },
  {
    q: 'Вы работаете с мужчинами?',
    a: 'Каждый пятый пациент — мужчина. Чаще всего приходят с носом, веками, подбородком и коррекцией гинекомастии. У мужской эстетики своё правило: результат не должен читаться как вмешательство — хирурги работают именно в этом ключе.',
  },
  {
    q: 'Как проходит первичная консультация хирурга?',
    a: 'Хирург осматривает, замеряет, фотографирует, подбирает методику — и отвечает на все вопросы без спешки.',
  },
  {
    q: 'Как долго длится реабилитация?',
    a: 'Зависит от операции:<br />— Блефаропластика — 7–14 дней<br />— Ринопластика — 2–3 недели<br />— Маммопластика — 2–4 недели ограничений<br />— SMAS-лифтинг — 3–4 недели<br /><br />Точные сроки хирург назовёт на консультации.',
  },
];

const {
  eyebrow = 'Вопросы',
  heading = 'Вопросы и ответы',
  items = defaultItems,
} = Astro.props;

const faqs = items;
---

<section class="v3-faq v3-surface-cream" aria-labelledby="faq-heading">
  <div class="v3-container v3-container-default">
    <header class="faq-header" data-v3-reveal>
      <span class="v3-eyebrow">{eyebrow}</span>
      <h2 id="faq-heading" class="v3-h2"><em>{heading}</em></h2>
    </header>

    <ol class="faq-list" data-v3-reveal>
      {faqs.map((f, i) => (
        <li class="faq-item">
          <details open={f.open}>
            <summary>
              <span class="faq-num v3-eyebrow">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-q">{f.q}</span>
              <span class="faq-marker" aria-hidden="true"></span>
            </summary>
            <div class="faq-a v3-body" set:html={f.a}></div>
          </details>
        </li>
      ))}
    </ol>

    <p class="faq-disclaimer v3-caption">
      Имеются противопоказания. Необходима консультация специалиста.
    </p>
  </div>
</section>

<style>
  .v3-faq {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .faq-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .faq-list { list-style: none; margin: 0; padding: 0; }
  .faq-item {
    border-top: 1px solid var(--v3-border-hair);
  }
  .faq-item:last-child { border-bottom: 1px solid var(--v3-border-hair); }
  .faq-item details { padding: 0; }
  .faq-item summary {
    display: grid;
    grid-template-columns: 3rem 1fr 2rem;
    gap: 1rem;
    align-items: baseline;
    padding-block: clamp(1.25rem, 2vw, 1.75rem);
    cursor: pointer;
    list-style: none;
    transition: background var(--v3-duration-fast) var(--v3-ease-out);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { background: var(--v3-cream-alt); }
  .faq-num { color: var(--v3-ink-muted); padding-top: 0.25rem; }
  .faq-q {
    font-family: var(--v3-font-body);
    font-weight: 400;
    font-size: clamp(1rem, 1.4vw, 1.1875rem);
    line-height: 1.4;
    color: var(--v3-ink);
  }
  .faq-marker {
    width: 1rem;
    height: 1rem;
    border-bottom: 1px solid var(--v3-ink);
    border-right: 1px solid var(--v3-ink);
    transform: rotate(45deg) translate(-4px, -4px);
    transition: transform var(--v3-duration-base) var(--v3-ease-out);
  }
  .faq-item details[open] .faq-marker {
    transform: rotate(225deg) translate(-4px, -4px);
  }
  .faq-a {
    padding: 0.5rem 0 1.5rem 4rem;
    max-width: 64ch;
  }
  .faq-disclaimer {
    margin-top: 2rem;
    text-align: center;
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
    font-family: var(--v3-font-body);
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .faq-item summary { grid-template-columns: 2rem 1fr 1.5rem; gap: 0.75rem; }
    .faq-a { padding-left: 2.75rem; }
  }
</style>
