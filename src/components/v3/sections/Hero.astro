---
import { Image } from 'astro:assets';
import heroSurgicalPlanning from '../../../assets/photos/hero-rhinoplasty-nose-editorial.png';
---

<section class="v3-hero v3-surface-cream" aria-labelledby="hero-heading">
  <div class="v3-container v3-container-wide hero-grid">
    <div class="hero-text" data-v3-reveal>
      <span class="v3-eyebrow">The Platinental · Казань</span>

      <h1 id="hero-heading" class="v3-display hero-h1">
        Клиника<br />
        пластической хирургии<br />
        и косметологии<br />
        <span class="hero-h1-loc">в Казани</span>
      </h1>

      <p class="v3-lead hero-lead">
        Интеллигентная гармонизация внешности — без избыточности и шаблонов,
        через применение авторских методик.
      </p>

      <div class="hero-cta">
        <a href="#form" class="v3-btn v3-btn-primary">Записаться на консультацию</a>
        <a href="/prices" class="v3-link cta-secondary">Узнать стоимость</a>
      </div>
    </div>

    <div class="hero-image" data-v3-reveal>
      <div class="hero-image-wrap">
        <Image
          src={heroSurgicalPlanning}
          alt="Планирование пластической операции: эскиз профиля, замеры и рука хирурга"
          width={1003}
          height={1568}
          loading="eager"
          fetchpriority="high"
          class="hero-image-asset"
        />
      </div>
    </div>
  </div>

  <div class="v3-container v3-container-wide hero-stats" data-v3-reveal>
    <hr class="v3-hairline" />
    <ul class="stats-list">
      <li class="stat-item">Деликатная гармонизация</li>
      <li class="stat-item">Исключительная квалификация и опыт</li>
      <li class="stat-item">С 2011 года в Казани</li>
    </ul>
  </div>
</section>

<style>
  .v3-hero {
    padding-top: clamp(1.5rem, 4vh, 3.5rem);
    padding-bottom: var(--v3-gap-deep);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(2rem, 6vh, 4rem);
  }
  .hero-text { display: flex; flex-direction: column; gap: var(--v3-gap-h1-lead); max-width: var(--v3-hero-text-max); }
  .hero-text .v3-eyebrow { margin-bottom: var(--v3-gap-eyebrow-h1); }
  .hero-h1-loc { color: var(--v3-champagne-deep); }
  .hero-lead { max-width: 38ch; }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .cta-secondary { font-size: 0.9375rem; }
  .hero-image {
    max-width: 43rem;
    margin-left: auto;
    width: 100%;
    display: flex;
    justify-content: flex-end;
    padding-right: clamp(0.25rem, 1vw, 0.875rem);
    align-self: end;
  }
  .hero-image-wrap {
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 41rem;
    overflow: visible;
    animation: heroImageFloat 7.2s ease-in-out 1.1s infinite;
  }
  .hero-image-asset {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    display: block;
    transform: translateX(clamp(0rem, 0.8vw, 0.6rem)) translateY(clamp(0.65rem, 1.4vw, 1.15rem)) scale(1.11);
    transform-origin: right center;
    animation: heroImageReveal 1.2s var(--v3-ease-out) 0.15s both;
  }
  .hero-stats {
    margin-top: var(--v3-gap-medium);
  }
  .stats-list {
    list-style: none;
    padding: 1.5rem 0 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.875rem 0;
  }
  .stat-item {
    position: relative;
    padding-inline: clamp(1rem, 2vw, 1.75rem);
    font-family: var(--v3-font-body);
    font-size: clamp(0.9rem, 1vw, 0.98rem);
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--v3-ink);
    white-space: nowrap;
  }
  .stat-item:first-child {
    padding-left: 0;
  }
  .stat-item:last-child {
    padding-right: 0;
  }
  .stat-item + .stat-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 9999px;
    background: var(--v3-champagne);
    transform: translateY(-50%);
    opacity: 0.9;
  }

  @keyframes heroImageReveal {
    from {
      opacity: 0;
      transform: translateX(clamp(1rem, 2vw, 1.5rem)) translateY(clamp(1.25rem, 2vw, 1.75rem)) scale(1.06);
    }
    to {
      opacity: 1;
      transform: translateX(clamp(0rem, 0.8vw, 0.6rem)) translateY(clamp(0.65rem, 1.4vw, 1.15rem)) scale(1.11);
    }
  }

  @keyframes heroImageFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.5rem);
    }
  }

  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-image {
      max-width: 35rem;
      margin-inline: 0;
      padding-right: 0;
      align-self: start;
    }
    .hero-image-wrap { max-width: 33rem; }
    .hero-image-asset { transform: translateX(clamp(0rem, 0.5vw, 0.25rem)) translateY(0.4rem) scale(1.05); }
  }
  @media (max-width: 560px) {
    .v3-hero {
      padding-bottom: var(--v3-gap-medium);
    }
    .hero-grid {
      gap: 2rem;
      padding-top: 1rem;
    }
    .hero-text {
      gap: 1rem;
    }
    .hero-lead {
      max-width: none;
      font-size: 1rem;
    }
    .hero-stats {
      margin-top: var(--v3-gap-small);
    }
    .stats-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding-top: 1rem;
    }
    .stat-item {
      padding-left: 1rem;
      white-space: normal;
    }
    .stat-item:first-child {
      padding-left: 1rem;
    }
    .stat-item::before,
    .stat-item + .stat-item::before {
      left: 0;
      top: 0.72em;
      transform: none;
    }
    .hero-cta { gap: 0.875rem; }
    .hero-cta .v3-btn {
      width: 100%;
      justify-content: center;
    }
    .cta-secondary {
      margin-top: 0.125rem;
    }
    .hero-h1 { font-size: clamp(1.625rem, 7.2vw, 2rem); }
    .hero-image {
      max-width: 100%;
      width: 100%;
      justify-content: flex-start;
      padding-right: 0;
    }
    .hero-image-wrap {
      max-width: none;
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
    }
    .hero-image-asset {
      display: block;
      width: 100%;
      max-width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      transform: none;
      transform-origin: center center;
    }
    .stat-item::before {
      content: '';
      position: absolute;
      width: 0.3125rem;
      height: 0.3125rem;
      border-radius: 9999px;
      background: var(--v3-champagne);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image-wrap,
    .hero-image-asset {
      animation: none;
    }
  }
</style>
