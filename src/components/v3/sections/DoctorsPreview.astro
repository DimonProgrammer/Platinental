---
import { doctors } from '../../../data/doctors';

// Превью на главной — берём первых 4 хирургов (без косметолога Грицай) из единого источника doctors.ts.
const featured = doctors.filter((d) => !d.tags.includes('cosmetology')).slice(0, 4);
---

<section class="v3-doctors v3-surface-sand" aria-labelledby="doctors-heading">
  <div class="v3-container v3-container-wide">
    <header class="doctors-header" data-v3-stagger>
      <span class="v3-eyebrow">Команда</span>
      <h2 id="doctors-heading" class="v3-h2"><em>Врачи клиники</em></h2>
    </header>

    <ol class="doctors-grid" data-v3-stagger>
      {featured.map((d) => (
        <li class="doctor">
          <a class="doctor-overlay" href={`/doctors/${d.slug}`} aria-label={`Подробнее о враче — ${d.name}`}></a>

          <div class="doctor-image v3-photo-film">
            {d.photo
              ? <img src={d.photo} alt={d.name} width="400" height="400" loading="lazy" />
              : <span class="doctor-initials" aria-hidden="true">{d.initials}</span>
            }
          </div>
          <div class="doctor-info">
            <span class="v3-eyebrow doctor-spec">{d.spec}</span>
            <h3 class="doctor-name">
              <em>{d.name}</em>
            </h3>
            <p class="v3-body doctor-note" set:html={d.short}></p>
            <div class="doctor-meta">
              <span class="v3-caption doctor-price">Консультация {d.priceMain.replace(/^Первичная\s*/i, 'от ')}</span>
              <button type="button" class="v3-link doctor-cta" data-booking-open data-doctor={d.nameBtn}>
                Записаться <span aria-hidden="true">→</span>
              </button>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <footer class="doctors-footer" data-v3-reveal>
      <p class="v3-body doctors-also">
        Также в&nbsp;клинике: Марданова Д.М., Макеенко Н.В., Бречко М.А. (CO₂-лазер, безоперационная блефаропластика), Грицай О.А. (косметолог)
      </p>
      <a href="/doctors" class="v3-link">Показать всех врачей →</a>
    </footer>
  </div>
</section>

<script>
  function initDoctorsPreviewCTA() {
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-booking-open]');
    btns.forEach((b) => {
      if (b.dataset.bookingBound === '1') return;
      b.dataset.bookingBound = '1';
      b.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const doctor = b.getAttribute('data-doctor') ?? undefined;
        window.dispatchEvent(new CustomEvent('open-booking', { detail: { doctor } }));
      });
    });
  }
  if (document.readyState !== 'loading') initDoctorsPreviewCTA();
  else document.addEventListener('DOMContentLoaded', initDoctorsPreviewCTA);
  document.addEventListener('astro:page-load', initDoctorsPreviewCTA);
</script>

<style>
  .v3-doctors {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .doctors-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }

  .doctors-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 4vw, 4rem) clamp(2rem, 5vw, 5rem);
  }
  .doctor {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    align-items: start;
    transition: transform var(--v3-duration-fast) var(--v3-ease-out);
  }
  /* Невидимый клик-оверлей поверх всего контента карточки. */
  .doctor-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    text-indent: -9999px;
    overflow: hidden;
  }
  .doctor-overlay:focus-visible {
    outline: 2px solid var(--v3-champagne);
    outline-offset: 4px;
  }
  /* Контент под оверлеем не должен перехватывать клики, иначе текст-выделения мешают.
     Изображение и текст всё равно показывают курсор-pointer от overlay. */
  .doctor-image,
  .doctor-info > :not(.doctor-meta),
  .doctor-meta > :not(.doctor-cta) {
    pointer-events: none;
  }
  .doctor:hover .doctor-image img {
    transform: scale(1.03);
  }
  .doctor:hover .doctor-name {
    color: var(--v3-champagne-deep);
  }

  .doctor-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: var(--v3-cream);
    border-radius: 50%;
  }
  .doctor-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s var(--v3-ease-out);
  }
  .doctor-initials {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-weight: 500;
    font-size: 3rem;
    color: var(--v3-ink-muted);
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .doctor-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }
  .doctor-spec { color: var(--v3-ink-muted); }
  .doctor-name {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
    color: var(--v3-ink);
    margin: 0;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .doctor-note {
    color: var(--v3-ink-secondary);
    max-width: 38ch;
  }
  .doctor-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--v3-border-soft);
    flex-wrap: wrap;
  }
  .doctor-price {
    color: var(--v3-ink-secondary);
    text-transform: none;
    letter-spacing: 0.005em;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: 0.9375rem;
  }
  .doctor-cta {
    position: relative;
    z-index: 4;
    background: transparent;
    border: 0;
    padding: 0.25rem 0;
    cursor: pointer;
    font: inherit;
    color: inherit;
    pointer-events: auto;
  }

  .doctors-footer {
    margin-top: var(--v3-gap-small);
    padding-top: 1.25rem;
    border-top: 1px solid var(--v3-border-soft);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .doctors-grid { grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); }
  }
  @media (max-width: 680px) {
    .doctors-grid { grid-template-columns: 1fr; }
    .doctor { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 1.25rem; }
  }
  @media (max-width: 440px) {
    .doctor { grid-template-columns: 1fr; gap: 0.875rem; }
    .doctor-image { max-width: 16rem; }
  }
</style>
