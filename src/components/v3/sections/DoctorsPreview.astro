---
import ImagePlaceholder from '../ImagePlaceholder.astro';

const doctors = [
  {
    slot: 'D1',
    initials: 'ММ',
    name: 'Мелоян Мхитар Мисакович',
    spec: 'RHINOPLASTY · РИНОПЛАСТИКА',
    note: '40 лет хирургической практики. Обучение в США, Чехии, Армении.',
    price: 'Консультация от 7 000 ₽',
    cta: { label: 'Записаться', href: '/v3/doctors/meloyan/' },
  },
  {
    slot: 'D2',
    initials: 'РТ',
    name: 'Тулатова Регина Тимуровна',
    spec: 'FACE-PRESERVING SURGERY · ДЕЛИКАТНАЯ ХИРУРГИЯ',
    note: 'Круговая блефаропластика, височный лифтинг. Естественный результат.',
    price: 'Консультация от 7 000 ₽',
    cta: { label: 'Записаться', href: '/v3/doctors/tulatova/' },
  },
  {
    slot: 'D3',
    initials: 'ВМ',
    name: 'Мамедов Вахид Аждарович',
    spec: 'ЧЕЛЮСТНО-ЛИЦЕВАЯ ХИРУРГИЯ',
    note: 'Сложные реконструктивные операции, ортогнатическая хирургия.',
    price: 'Консультация от 10 000 ₽',
    cta: { label: 'Записаться', href: '/v3/doctors/mamedov/' },
  },
  {
    slot: 'D4',
    initials: 'МВ',
    name: 'Васильев Максим Николаевич',
    spec: 'К.М.Н. · ПЛАСТИЧЕСКИЙ ХИРУРГ',
    note: 'Отопластика, контурная пластика лица, эстетическая хирургия.',
    price: 'Консультация от 7 000 ₽',
    cta: { label: 'Записаться', href: '/v3/doctors/vasilev/' },
  },
];
---

<section class="v3-doctors v3-surface-sand" aria-labelledby="doctors-heading">
  <div class="v3-container v3-container-wide">
    <header class="doctors-header" data-v3-reveal>
      <span class="v3-eyebrow">Хирурги клиники</span>
      <h2 id="doctors-heading" class="v3-h2"><em>Команда</em></h2>
    </header>

    <ol class="doctors-grid">
      {doctors.map((d, i) => (
        <li class="doctor" data-v3-reveal>
          <div class="doctor-image">
            <ImagePlaceholder
              slot={d.slot}
              description={`Портрет: ${d.name}, 3/4, normalized`}
              ratio="3/4"
              tone="cream"
              source="Track B · нормализация с kzn.platinental.ru"
            />
            <span class="doctor-initials" aria-hidden="true">{d.initials}</span>
          </div>
          <div class="doctor-info">
            <span class="v3-eyebrow doctor-spec">{d.spec}</span>
            <h3 class="doctor-name">
              <em>{d.name}</em>
            </h3>
            <p class="v3-body doctor-note">{d.note}</p>
            <div class="doctor-meta">
              <span class="v3-caption doctor-price">{d.price}</span>
              <a href={d.cta.href} class="v3-link doctor-cta">{d.cta.label} →</a>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <footer class="doctors-footer" data-v3-reveal>
      <p class="v3-body more">
        Также в клинике принимают:
        <em>Марданова Д.&nbsp;М.</em>,
        <em>Макеенко Н.&nbsp;В.</em>,
        <em>Бречко М.&nbsp;А.</em> (CO₂-лазер, безоперационная блефаропластика),
        <em>Грицай О.&nbsp;А.</em> (косметолог).
      </p>
      <a href="/v3/doctors" class="v3-link">Все врачи команды →</a>
    </footer>
  </div>
</section>

<style>
  .v3-doctors {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .doctors-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }

  .doctors-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 4vw, 4rem) clamp(2rem, 5vw, 5rem);
  }
  .doctor {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    align-items: start;
  }
  .doctor-image {
    position: relative;
    width: 100%;
  }
  .doctor-initials {
    position: absolute;
    inset: auto auto 0.75rem 0.75rem;
    font-family: var(--v3-font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 2rem;
    color: var(--v3-ink);
    background: rgba(255, 254, 242, 0.88);
    padding: 0.1rem 0.6rem;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .doctor-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }
  .doctor-spec { color: var(--v3-ink-muted); }
  .doctor-name {
    font-family: var(--v3-font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
    color: var(--v3-ink);
    margin: 0;
  }
  .doctor-note {
    color: var(--v3-ink-secondary);
    max-width: 38ch;
  }
  .doctor-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--v3-border-soft);
    flex-wrap: wrap;
  }
  .doctor-price {
    color: var(--v3-ink-secondary);
    text-transform: none;
    letter-spacing: 0.005em;
    font-family: var(--v3-font-display);
    font-style: italic;
    font-size: 0.9375rem;
  }

  .doctors-footer {
    margin-top: var(--v3-gap-small);
    padding-top: 1.25rem;
    border-top: 1px solid var(--v3-border-soft);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .more { max-width: 60ch; }
  .more em { font-style: italic; }

  @media (max-width: 1024px) {
    .doctors-grid { grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); }
  }
  @media (max-width: 680px) {
    .doctors-grid { grid-template-columns: 1fr; }
    .doctor { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 1.25rem; }
  }
  @media (max-width: 440px) {
    .doctor { grid-template-columns: 1fr; gap: 0.875rem; }
    .doctor-image { max-width: 16rem; }
  }
</style>
