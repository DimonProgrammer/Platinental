---
const links = [
  { label: 'Пластика', href: '/v3/plastika' },
  { label: 'Косметология', href: '/v3/kosmetologiya' },
  { label: 'Космецевтика', href: '/v3/kosmecevtika' },
  { label: 'Врачи', href: '/v3/doctors' },
  { label: 'О клинике', href: '/v3/about' },
];

const phone = '+7 843 223-66-66';
const phoneHref = 'tel:+78432236666';
const whatsapp = 'https://wa.me/78432236666';
---

<header class="v3-nav" data-v3-nav>
  <div class="v3-container v3-container-wide nav-inner">

    <!-- Logo (left) -->
    <a href="/v3/" class="nav-logo" aria-label="Platinental — на главную">
      <span class="logo-text">Platinental</span>
    </a>

    <!-- Nav links (center, desktop only) -->
    <nav class="nav-links-wrap" aria-label="Главная навигация">
      <ul class="nav-links">
        {links.map((l) => (
          <li><a href={l.href} class="nav-link">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Utility (right) -->
    <div class="nav-utility">
      <!-- Phone visible on desktop -->
      <a href={phoneHref} class="nav-phone" aria-label="Позвонить в клинику">{phone}</a>

      <!-- CTA always visible -->
      <a href="#form" class="v3-btn v3-btn-primary nav-cta">Записаться</a>

      <!-- Phone icon — mobile only -->
      <a href={phoneHref} class="nav-phone-icon" aria-label="Позвонить">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4.5 2C4.5 2 3 2 3 3.5C3 5 3.5 8.5 7.5 12.5C11.5 16.5 15 17 16.5 17C18 17 18 15.5 18 15.5L18 13C18 13 18 12 17 12C16 12 14.5 11.5 14 11C13.5 10.5 12.5 9.5 12 9.5C11.5 9.5 11 10 10.5 10.5C10 11 9 10 8 9C7 8 6 7 6.5 6.5C7 6 7.5 5.5 7.5 5C7.5 4.5 6.5 3 6 2.5C5.5 2 4.5 2 4.5 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Hamburger — mobile only -->
      <button class="nav-burger" id="nav-burger" aria-label="Открыть меню" aria-expanded="false" aria-controls="nav-overlay">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile overlay -->
<div class="nav-overlay" id="nav-overlay" role="dialog" aria-modal="true" aria-label="Навигация">
  <div class="overlay-header">
    <a href="/v3/" class="overlay-logo" aria-label="На главную">
      <span class="logo-text">Platinental</span>
    </a>
    <button class="overlay-close" id="nav-close" aria-label="Закрыть меню">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <line x1="5" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="19" y1="5" x2="5" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav class="overlay-nav" aria-label="Мобильная навигация">
    <ul class="overlay-links">
      {links.map((l) => (
        <li>
          <a href={l.href} class="overlay-link">{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="overlay-contacts">
    <hr class="v3-hairline" />
    <a href={phoneHref} class="overlay-phone">{phone}</a>
    <a href={whatsapp} class="overlay-whatsapp" target="_blank" rel="noopener noreferrer">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M10 1.5C5.306 1.5 1.5 5.306 1.5 10C1.5 11.524 1.916 12.953 2.641 14.178L1.5 18.5L5.952 17.383C7.138 18.048 8.524 18.5 10 18.5C14.694 18.5 18.5 14.694 18.5 10C18.5 5.306 14.694 1.5 10 1.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M7.5 8C7.5 8 7 10.5 10 12.5C12.5 14.5 13.5 13 13.5 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      Написать в WhatsApp
    </a>
    <a href="#form" class="v3-btn v3-btn-primary overlay-cta">Записаться на консультацию</a>
  </div>
</div>

<style>
  /* ── Nav bar ───────────────────────────────────────────────────── */
  .v3-nav {
    position: sticky;
    top: 0;
    z-index: var(--v3-z-nav);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background 0.3s ease-out, border-color 0.3s ease-out,
                backdrop-filter 0.3s ease-out;
  }
  .v3-nav.is-scrolled {
    background: rgba(255, 254, 242, 0.95);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--v3-border-hair);
  }
  .nav-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 1.25rem;
    transition: padding-block 0.3s ease-out;
  }
  .v3-nav.is-scrolled .nav-inner {
    padding-block: 0.875rem;
  }

  /* ── Logo ──────────────────────────────────────────────────────── */
  .nav-logo {
    text-decoration: none;
    color: var(--v3-ink);
    flex-shrink: 0;
  }
  .logo-text {
    font-family: var(--v3-font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.375rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  /* ── Nav links ─────────────────────────────────────────────────── */
  .nav-links-wrap {
    display: flex;
    justify-content: center;
  }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    font-family: var(--v3-font-body);
    font-size: 0.9375rem;
    color: var(--v3-ink);
    text-decoration: none;
    letter-spacing: 0.01em;
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
    transition: color var(--v3-duration-fast) var(--v3-ease-out),
                border-color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .nav-link:hover {
    color: var(--v3-champagne-deep);
    border-bottom-color: var(--v3-champagne-deep);
  }

  /* ── Utility ───────────────────────────────────────────────────── */
  .nav-utility {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    flex-shrink: 0;
  }
  .nav-phone {
    font-family: var(--v3-font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--v3-ink);
    text-decoration: none;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .nav-phone:hover { color: var(--v3-champagne-deep); }

  .nav-cta {
    padding: 0.5rem 1.125rem;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  /* Phone icon (mobile only) */
  .nav-phone-icon {
    display: none;
    color: var(--v3-ink);
    padding: 0.25rem;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .nav-phone-icon:hover { color: var(--v3-champagne-deep); }

  /* Hamburger */
  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 28px;
    height: 28px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--v3-ink);
  }
  .burger-line {
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--v3-duration-base) var(--v3-ease-out),
                opacity var(--v3-duration-base) var(--v3-ease-out);
    transform-origin: center;
  }
  .nav-burger[aria-expanded="true"] .burger-line:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .nav-burger[aria-expanded="true"] .burger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-burger[aria-expanded="true"] .burger-line:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ── Mobile overlay ───────────────────────────────────────────── */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--v3-z-overlay);
    background: var(--v3-cream);
    display: flex;
    flex-direction: column;
    padding: 0 var(--v3-gutter) 2rem;
    overflow-y: auto;
    /* hidden state */
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity var(--v3-duration-base) var(--v3-ease-out),
                transform var(--v3-duration-base) var(--v3-ease-out);
  }
  .nav-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .overlay-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--v3-border-hair);
    margin-bottom: 2.5rem;
  }
  .overlay-logo {
    text-decoration: none;
    color: var(--v3-ink);
  }
  .overlay-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--v3-ink);
    padding: 0;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .overlay-close:hover { color: var(--v3-champagne-deep); }

  .overlay-nav { flex: 1; }
  .overlay-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .overlay-link {
    display: block;
    font-family: var(--v3-font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 8vw, 3rem);
    line-height: 1.2;
    color: var(--v3-ink);
    text-decoration: none;
    padding-block: 0.375rem;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .overlay-link:hover { color: var(--v3-champagne-deep); }

  .overlay-contacts {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 1.5rem;
  }
  .overlay-contacts .v3-hairline { margin-bottom: 0.25rem; }
  .overlay-phone {
    font-family: var(--v3-font-body);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--v3-ink);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .overlay-phone:hover { color: var(--v3-champagne-deep); }

  .overlay-whatsapp {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--v3-font-body);
    font-size: 1rem;
    color: var(--v3-ink-secondary);
    text-decoration: none;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .overlay-whatsapp:hover { color: var(--v3-ink); }

  .overlay-cta {
    display: block;
    text-align: center;
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
  }

  /* ── Responsive breakpoints ────────────────────────────────────── */
  @media (max-width: 1023px) {
    .nav-links-wrap { display: none; }
    .nav-phone { display: none; }
    .nav-phone-icon { display: flex; }
    .nav-burger { display: flex; }
    .nav-inner { grid-template-columns: auto 1fr auto; }
  }

  @media (max-width: 400px) {
    .nav-cta { display: none; }
  }
</style>

<script>
  const burger = document.getElementById('nav-burger') as HTMLButtonElement;
  const overlay = document.getElementById('nav-overlay') as HTMLElement;
  const closeBtn = document.getElementById('nav-close') as HTMLButtonElement;

  function openMenu() {
    overlay.classList.add('is-open');
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    overlay.classList.remove('is-open');
    burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  burger?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  overlay?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', closeMenu);
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeMenu();
  });

  // Transparent → solid nav on scroll
  const nav = document.querySelector('.v3-nav') as HTMLElement;
  let isScrolled = false;
  window.addEventListener('scroll', () => {
    const shouldScroll = window.scrollY > 80;
    if (shouldScroll !== isScrolled) {
      isScrolled = shouldScroll;
      nav?.classList.toggle('is-scrolled', isScrolled);
    }
  }, { passive: true });
</script>
