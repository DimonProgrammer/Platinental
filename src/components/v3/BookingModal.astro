---
// Глобальная модалка записи. Открывается событием:
//   window.dispatchEvent(new CustomEvent('open-booking', { detail: { doctor?: 'slug', preset?: 'Тема' } }))
// Подключена один раз в V3Layout — доступна со всех страниц.

const whatsapp = 'https://wa.me/78432236666';
const telegram = 'https://t.me/platinental_kazan';
const maxLink = 'https://max.ru';
---

<div class="booking" data-booking hidden role="dialog" aria-modal="true" aria-labelledby="booking-title">
  <button type="button" class="booking-backdrop" aria-label="Закрыть" data-booking-close></button>

  <div class="booking-panel" role="document">
    <button type="button" class="booking-close" aria-label="Закрыть" data-booking-close>
      <span aria-hidden="true">×</span>
    </button>

    <header class="booking-header">
      <span class="v3-eyebrow">Быстрая связь с клиникой</span>
      <h2 id="booking-title" class="v3-h3 booking-title">
        <em data-booking-title>Подберём врача и удобное время</em>
      </h2>
      <p class="v3-body booking-lead">
        Оставьте телефон — администратор перезвонит в течение 2 часов,
        сориентирует по консультации, стоимости и поможет выбрать врача.
      </p>
    </header>

    <form class="booking-form" data-booking-form>
      <input type="hidden" name="doctor" data-booking-doctor />

      <label class="field">
        <span class="field-label v3-eyebrow">Имя</span>
        <input type="text" name="name" required autocomplete="name" placeholder="Как к вам обращаться" />
      </label>

      <label class="field">
        <span class="field-label v3-eyebrow">Телефон</span>
        <input type="tel" name="phone" required autocomplete="tel" inputmode="tel" placeholder="+7 ___ ___ ____" />
      </label>

      <label class="field">
        <span class="field-label v3-eyebrow">Сообщение (опционально)</span>
        <textarea name="message" rows="3" placeholder="Что интересует, какие операции рассматриваете"></textarea>
      </label>

      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span class="consent-text">
          Я согласен(а) на обработку персональных данных в соответствии с
          <a href="/privacy" class="v3-link">152-ФЗ</a>.
        </span>
      </label>

      <button type="submit" class="v3-btn v3-btn-primary booking-submit">
        Отправить заявку <span aria-hidden="true">→</span>
      </button>

      <div class="booking-direct">
        <p class="v3-caption booking-direct-label">Если удобнее, напишите нам сразу</p>
        <div class="booking-direct-links">
          <a href={whatsapp} class="booking-direct-link" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href={telegram} class="booking-direct-link" target="_blank" rel="noopener noreferrer">Telegram</a>
          <a href={maxLink} class="booking-direct-link" target="_blank" rel="noopener noreferrer">Max</a>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  function initBooking() {
    const root = document.querySelector<HTMLElement>('[data-booking]');
    if (!root) return;

    const titleEl = root.querySelector<HTMLElement>('[data-booking-title]');
    const doctorInput = root.querySelector<HTMLInputElement>('[data-booking-doctor]');
    const form = root.querySelector<HTMLFormElement>('[data-booking-form]');
    const closeBtns = root.querySelectorAll<HTMLElement>('[data-booking-close]');

    let lastFocus: HTMLElement | null = null;

    const open = (detail?: { doctor?: string; preset?: string }) => {
      lastFocus = document.activeElement as HTMLElement;
      if (titleEl) {
        titleEl.textContent = detail?.preset
          ? `Консультация по направлению «${detail.preset}»`
          : detail?.doctor
            ? `Подберём время ${detail.doctor}`
            : 'Подберём врача и удобное время';
      }
      if (doctorInput) doctorInput.value = detail?.doctor ?? '';
      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      const firstField = root.querySelector<HTMLInputElement>('input[name="name"]');
      window.requestAnimationFrame(() => firstField?.focus());
    };

    const close = () => {
      root.hidden = true;
      document.documentElement.style.overflow = '';
      lastFocus?.focus();
    };

    window.addEventListener('open-booking', (e) => {
      const detail = (e as CustomEvent).detail;
      open(detail);
    });

    // Унифицируем CTA: любые ссылки на #form открывают модалку записи.
    document.querySelectorAll<HTMLAnchorElement>('a[href="#form"]').forEach((link) => {
      if (link.dataset.bookingBound === '1') return;
      link.dataset.bookingBound = '1';
      link.addEventListener('click', (e) => {
        e.preventDefault();
        open();
      });
    });

    closeBtns.forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (!root.hidden && e.key === 'Escape') close();
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      // TODO: подключить к бэкенду / WhatsApp-боту.
      // Пока — успех + закрытие.
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Заявка отправлена ✓';
      }
      window.setTimeout(() => {
        form.reset();
        if (submit) {
          submit.disabled = false;
          submit.innerHTML = 'Отправить заявку <span aria-hidden="true">→</span>';
        }
        close();
      }, 1500);
    });
  }

  if (document.readyState !== 'loading') initBooking();
  else document.addEventListener('DOMContentLoaded', initBooking);
  document.addEventListener('astro:page-load', initBooking);
</script>

<style>
  .booking[hidden] { display: none; }
  .booking {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .booking-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.55);
    border: 0;
    padding: 0;
    cursor: pointer;
    animation: bk-fade 240ms var(--v3-ease-out, ease-out);
  }
  @keyframes bk-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .booking-panel {
    position: relative;
    background: var(--v3-cream);
    width: 100%;
    max-width: 32rem;
    max-height: 90vh;
    overflow-y: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 -20px 60px rgba(10, 10, 10, 0.18);
    animation: bk-slide 320ms var(--v3-ease-out, ease-out);
  }
  @keyframes bk-slide {
    from { transform: translateY(40px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @media (min-width: 720px) {
    .booking { align-items: center; }
    .booking-panel {
      border-radius: 4px;
      animation-name: bk-pop;
    }
    @keyframes bk-pop {
      from { transform: scale(0.96); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
  }
  .booking-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--v3-ink-muted);
    font-size: 1.75rem;
    line-height: 1;
    transition: color var(--v3-duration-fast, 160ms) var(--v3-ease-out, ease-out);
  }
  .booking-close:hover { color: var(--v3-ink); }

  .booking-header {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 1.5rem;
    padding-right: 2rem;
  }
  .booking-title {
    margin: 0;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    line-height: 1.2;
    color: var(--v3-ink);
  }
  .booking-title em { font-style: normal; }
  .booking-lead { color: var(--v3-ink-secondary); margin: 0; font-size: 0.9375rem; }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .field { display: flex; flex-direction: column; gap: 0.4rem; }
  .field-label { color: var(--v3-ink-muted); }
  .field input,
  .field textarea {
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--v3-border-soft, rgba(10, 10, 10, 0.16));
    padding: 0.75rem 0;
    min-height: 44px;
    color: var(--v3-ink);
    font-family: var(--v3-font-body);
    font-size: 16px;
    line-height: 1.4;
    transition: border-color var(--v3-duration-fast, 160ms) var(--v3-ease-out, ease-out);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--v3-champagne, #C4A882);
  }
  .field input::placeholder,
  .field textarea::placeholder { color: var(--v3-ink-muted); }
  .field textarea { resize: vertical; min-height: 4.5rem; }

  .consent {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    color: var(--v3-ink-secondary);
    font-size: 0.8125rem;
    line-height: 1.45;
    cursor: pointer;
  }
  .consent-text { padding-top: 0.0625rem; }
  .consent input {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin: 0;
    accent-color: var(--v3-champagne, #C4A882);
    cursor: pointer;
  }

  .booking-submit { align-self: stretch; margin-top: 0.25rem; }

  .booking-direct {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--v3-border-soft, rgba(10, 10, 10, 0.16));
  }
  .booking-direct-label {
    margin: 0;
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.01em;
  }
  .booking-direct-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .booking-direct-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    border: 1px solid var(--v3-border-soft, rgba(10, 10, 10, 0.16));
    border-radius: 999px;
    color: var(--v3-ink);
    text-decoration: none;
    font-family: var(--v3-font-body);
    font-size: 0.9375rem;
    transition:
      border-color var(--v3-duration-fast, 160ms) var(--v3-ease-out, ease-out),
      color var(--v3-duration-fast, 160ms) var(--v3-ease-out, ease-out),
      background-color var(--v3-duration-fast, 160ms) var(--v3-ease-out, ease-out);
  }
  .booking-direct-link:hover,
  .booking-direct-link:focus-visible {
    color: var(--v3-champagne-deep, #9e7f59);
    border-color: var(--v3-champagne, #C4A882);
    background: rgba(196, 168, 130, 0.08);
    outline: none;
  }

  @media (max-width: 560px) {
    .booking-direct-links {
      display: grid;
      grid-template-columns: 1fr;
    }
    .booking-direct-link {
      width: 100%;
    }
  }
</style>
