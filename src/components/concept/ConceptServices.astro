---
const services = [
  {
    n: '01',
    title: 'Пластическая хирургия',
    text: 'Мы&nbsp;не&nbsp;делаем «бразильские» ягодицы и&nbsp;не&nbsp;«увеличиваем» грудь. Мы&nbsp;предлагаем индивидуальный дизайн форм, которые органично вписываются в&nbsp;исходные параметры&nbsp;— никакого «сделанного» эффекта. 27&nbsp;видов операций.',
    link: 'Все операции',
    href: '/plastika',
  },
  {
    n: '02',
    title: 'Косметология',
    text: 'Ботулотоксины, контурная пластика, CO₂-лазер, HELEO4. Врач-косметолог работает в&nbsp;связке с&nbsp;хирургом&nbsp;— составляет единый план, а&nbsp;не&nbsp;набор разрозненных процедур.',
    link: 'Все процедуры',
    href: '/kosmetologiya',
  },
  {
    n: '03',
    title: 'Космецевтика',
    text: 'Профессиональная косметика под&nbsp;конкретную задачу: реабилитация после операции, поддержание результата, ежедневный уход. Индивидуальный подбор со&nbsp;специалистом.',
    link: 'Каталог',
    href: '/kosmecevtika',
  },
];
---

<section class="cs">
  <div class="cs__inner">

    <div class="cs__meta">
      <span class="cs__label">Направления</span>
    </div>

    <div class="cs__content">
      {services.map((s) => (
        <div class="cs__row">
          <div class="cs__row-left">
            <span class="cs__n font-display">{s.n}</span>
            <h3 class="cs__title font-display">{s.title}</h3>
          </div>
          <div class="cs__row-right">
            <p class="cs__text" set:html={s.text} />
            <a href={s.href} class="cs__link">{s.link}&nbsp;→</a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .cs {
    background: var(--surface-page);
    padding: var(--space-32) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 1024px) { .cs { padding: var(--space-40) 0; } }

  .cs__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 768px) { .cs__inner { padding: 0 32px; } }

  @media (min-width: 960px) {
    .cs__inner {
      grid-template-columns: minmax(160px, 22%) 1fr;
      gap: var(--space-16);
      padding: 0 48px;
    }
  }

  /* Meta */
  .cs__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cs__label {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Rows */
  .cs__content {
    display: flex;
    flex-direction: column;
  }

  .cs__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border-subtle);
  }

  .cs__row:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .cs__row {
      grid-template-columns: minmax(200px, 38%) 1fr;
      gap: var(--space-10);
      align-items: start;
    }
  }

  .cs__row-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cs__n {
    font-size: var(--text-caption);
    font-weight: 300;
    font-style: italic;
    color: var(--text-muted);
    line-height: 1;
  }

  .cs__title {
    font-size: var(--text-h4);
    font-weight: 400;
    font-style: italic;
    line-height: 1.1;
    letter-spacing: var(--tracking-heading);
    color: var(--text-primary);
    margin: 0;
  }

  .cs__row-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: 4px;
  }

  .cs__text {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
  }

  .cs__link {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-hover);
    text-decoration: none;
    align-self: flex-start;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .cs__link:hover { color: var(--text-primary); }
</style>
