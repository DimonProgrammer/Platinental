---
const procedures = [
  { name: 'Ринопластика',       price: 'от 200 000 ₽' },
  { name: 'Маммопластика',      price: 'от 450 000 ₽' },
  { name: 'Блефаропластика',    price: 'от 60 000 ₽'  },
  { name: 'SMAS-лифтинг',       price: 'от 400 000 ₽' },
  { name: 'Абдоминопластика',   price: 'от 250 000 ₽' },
  { name: 'Ботокс',             price: 'от 150 ₽/ед.' },
];
---

<section class="ch">
  <div class="ch__inner">

    <div class="ch__left">
      <span class="ch__eyebrow">Platinental&nbsp;· Казань</span>
      <h1 class="ch__title font-display">
        Клиника<br />
        пластической<br />
        хирургии<br />
        и&nbsp;косметологии
      </h1>
      <p class="ch__sub">
        Интеллигентная гармонизация внешности&nbsp;— без&nbsp;избыточности и&nbsp;шаблонов, через авторские методики наших хирургов.
      </p>
      <div class="ch__actions">
        <a href="/#form" class="ch__btn ch__btn--primary">Записаться на&nbsp;консультацию</a>
        <a href="/prices" class="ch__btn ch__btn--link">Узнать стоимость&nbsp;→</a>
      </div>
    </div>

    <div class="ch__right">
      <div class="ch__list-label">Популярные направления</div>
      <ul class="ch__list">
        {procedures.map((p) => (
          <li class="ch__item">
            <span class="ch__item-name">{p.name}</span>
            <span class="ch__item-price">{p.price}</span>
          </li>
        ))}
      </ul>
      <div class="ch__stats">
        <div class="ch__stat">
          <span class="ch__stat-n font-display">15+</span>
          <span class="ch__stat-l">лет опыта хирургов</span>
        </div>
        <div class="ch__stat">
          <span class="ch__stat-n font-display">27</span>
          <span class="ch__stat-l">видов операций</span>
        </div>
        <div class="ch__stat">
          <span class="ch__stat-n font-display">2011</span>
          <span class="ch__stat-l">год основания</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .ch {
    background: var(--surface-page);
    padding-top: calc(var(--nav-height) + var(--space-16));
    padding-bottom: var(--space-32);
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 1024px) {
    .ch { padding-bottom: var(--space-40); }
  }

  .ch__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
  }

  @media (min-width: 768px) { .ch__inner { padding: 0 32px; } }

  @media (min-width: 960px) {
    .ch__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-24);
      align-items: start;
      padding: 0 48px;
    }
  }

  /* Left */
  .ch__eyebrow {
    display: block;
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-hover);
    margin-bottom: var(--space-8);
  }

  .ch__title {
    font-size: clamp(2.5rem, 4vw, 4.5rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 var(--space-8);
  }

  .ch__sub {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 40ch;
    margin: 0 0 var(--space-10);
  }

  .ch__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  .ch__btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .ch__btn--primary {
    padding: 13px var(--space-8);
    background: var(--color-ink-900);
    color: var(--color-cream-50);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .ch__btn--primary:hover {
    background: var(--color-ink-700);
  }

  .ch__btn--link {
    font-size: var(--text-ui);
    color: var(--text-muted);
    padding: 13px 0;
  }

  .ch__btn--link:hover { color: var(--text-primary); }

  /* Right */
  .ch__right {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 960px) {
    .ch__right {
      padding-top: var(--space-12);
      border-left: 1px solid var(--border-subtle);
      padding-left: var(--space-12);
    }
  }

  .ch__list-label {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .ch__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ch__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .ch__item-name {
    font-size: var(--text-ui);
    color: var(--text-primary);
    font-weight: 400;
  }

  .ch__item-price {
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  /* Stats */
  .ch__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .ch__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .ch__stat-n {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text-primary);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .ch__stat-l {
    font-size: var(--text-caption);
    color: var(--text-muted);
    line-height: 1.4;
  }
</style>
