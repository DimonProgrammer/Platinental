---
const procedures = [
  { name: 'Ринопластика',         cat: 'Пластика лица',   price: 'от 200 000 ₽',  href: '/plastika#rinoplastika' },
  { name: 'Маммопластика',        cat: 'Пластика тела',   price: 'от 450 000 ₽',  href: '/plastika#mammoplastika' },
  { name: 'Блефаропластика',      cat: 'Пластика лица',   price: 'от 60 000 ₽',   href: '/plastika#blefaroplastika' },
  { name: 'SMAS-лифтинг',         cat: 'Пластика лица',   price: 'от 400 000 ₽',  href: '/plastika#smas' },
  { name: 'Абдоминопластика',     cat: 'Пластика тела',   price: 'от 250 000 ₽',  href: '/plastika#abdominoplastika' },
  { name: 'Ботокс',               cat: 'Косметология',    price: 'от 150 ₽/ед.',  href: '/kosmetologiya#botox' },
  { name: 'Контурная пластика',   cat: 'Косметология',    price: 'от 22 000 ₽',   href: '/kosmetologiya#kontur' },
];
---

<section class="cp">
  <div class="cp__split">

    <div class="cp__left">
      <div class="cp__left-inner">
        <span class="cp__ref">§003</span>
        <blockquote class="cp__quote font-display">
          <p>Индивидуальный<br />дизайн форм&nbsp;—<br />никакого<br />«сделанного»<br />эффекта.</p>
        </blockquote>
        <a href="/plastika" class="cp__all">Все операции →</a>
      </div>
    </div>

    <div class="cp__right">
      <div class="cp__right-inner">

        <div class="cp__right-head">
          <span class="cp__right-label">Популярные направления</span>
        </div>

        <ol class="cp__list">
          {procedures.map((p, i) => (
            <li class="cp__item">
              <a href={p.href} class="cp__row">
                <span class="cp__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="cp__name">{p.name}</span>
                <span class="cp__cat">{p.cat}</span>
                <span class="cp__price">{p.price}</span>
              </a>
            </li>
          ))}
        </ol>

        <div class="cp__foot">
          <a href="/prices" class="cp__prices-link">Полный прайс-лист</a>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .cp {
    background: var(--color-ink-900);
  }

  /* Split */
  .cp__split {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 60vh;
  }

  @media (min-width: 900px) {
    .cp__split {
      grid-template-columns: 2fr 3fr;
      min-height: 80vh;
    }
  }

  /* Left panel — ink */
  .cp__left {
    background: var(--color-ink-900);
    border-right: 1px solid var(--border-inverse);
    display: flex;
    align-items: stretch;
  }

  .cp__left-inner {
    max-width: var(--container-max);
    margin-left: auto;
    padding: var(--space-16) 20px var(--space-16) 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
  }

  @media (min-width: 768px) {
    .cp__left-inner { padding: var(--space-20) 32px var(--space-20) 32px; }
  }
  @media (min-width: 1200px) {
    .cp__left-inner { padding: var(--space-24) 48px var(--space-24) 48px; }
  }

  .cp__ref {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--accent);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: var(--space-12);
  }

  .cp__quote {
    flex: 1;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    border: none;
  }

  .cp__quote p {
    font-size: clamp(1.75rem, 3.5vw, 3.25rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-cream-50);
    margin: 0;
  }

  .cp__all {
    display: inline-block;
    margin-top: var(--space-12);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .cp__all:hover { color: var(--color-champagne-400); }

  /* Right panel — cream */
  .cp__right {
    background: var(--color-cream-50);
    display: flex;
    align-items: stretch;
  }

  .cp__right-inner {
    padding: var(--space-16) 20px;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .cp__right-inner { padding: var(--space-20) 32px; }
  }
  @media (min-width: 1200px) {
    .cp__right-inner { padding: var(--space-24) 48px; }
  }

  .cp__right-head {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-5);
    margin-bottom: 0;
  }

  .cp__right-label {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* List */
  .cp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .cp__item {
    border-bottom: 1px solid var(--border-subtle);
  }

  .cp__row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-4);
    row-gap: 2px;
    padding: var(--space-5) 0;
    text-decoration: none;
    color: inherit;
    transition: padding-left var(--duration-base) var(--ease-out);
  }

  .cp__row:hover { padding-left: var(--space-2); }

  @media (min-width: 640px) {
    .cp__row {
      grid-template-columns: 2.5rem 1fr 1fr auto;
      grid-template-rows: auto;
      align-items: center;
    }
  }

  .cp__num {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    align-self: center;
    grid-row: 1 / 3;
  }

  @media (min-width: 640px) {
    .cp__num { grid-row: auto; }
  }

  .cp__name {
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: var(--tracking-heading);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .cp__row:hover .cp__name { color: var(--accent-hover); }

  .cp__cat {
    font-size: var(--text-caption);
    color: var(--text-muted);
    grid-column: 2;
  }

  @media (min-width: 640px) {
    .cp__cat { grid-column: auto; }
  }

  .cp__price {
    display: none;
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  @media (min-width: 640px) {
    .cp__price { display: block; }
  }

  /* Footer */
  .cp__foot {
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    margin-top: var(--space-6);
  }

  .cp__prices-link {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-hover);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .cp__prices-link:hover { color: var(--text-primary); }
</style>
