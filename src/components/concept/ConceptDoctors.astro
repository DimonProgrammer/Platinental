---
const doctors = [
  {
    slug: 'meloyan',
    initials: 'ММ',
    spec: 'Ринопластика',
    name: 'Мелоян Мхитар Мисакович',
    note: '40 лет хирургической практики, обучение в&nbsp;США, Чехии, Армении',
    price: 'Консультация от 7&nbsp;000&nbsp;₽',
  },
  {
    slug: 'tulatova',
    initials: 'РТ',
    spec: 'Face Preserving Surgery',
    name: 'Тулатова Регина Тимуровна',
    note: 'Деликатная хирургия лица с&nbsp;максимальным сохранением естественных черт',
    price: 'Консультация от 7&nbsp;000&nbsp;₽',
  },
  {
    slug: 'mamedov',
    initials: 'ВМ',
    spec: 'Челюстно-лицевая хирургия',
    name: 'Мамедов Вахид Аждарович',
    note: 'Единственный в&nbsp;клинике специалист по&nbsp;вторичным операциям 2&nbsp;категории сложности',
    price: 'Консультация от 10&nbsp;000&nbsp;₽',
  },
  {
    slug: 'vasilev',
    initials: 'МВ',
    spec: 'К.М.Н. · Пластический хирург',
    name: 'Васильев Максим Николаевич',
    note: 'Маммопластика, контурирование тела, блефаропластика',
    price: 'Консультация от 7&nbsp;000&nbsp;₽',
  },
];
---

<section class="cd">
  <div class="cd__inner">

    <div class="cd__meta">
      <span class="cd__label">Врачи</span>
      <a href="/doctors" class="cd__all">Все&nbsp;врачи&nbsp;→</a>
    </div>

    <div class="cd__content">
      {doctors.map((d) => (
        <a href={`/doctors/${d.slug}/`} class="cd__row">
          <div class="cd__row-left">
            <span class="cd__initials font-display">{d.initials}</span>
            <div class="cd__info">
              <span class="cd__spec">{d.spec}</span>
              <span class="cd__name">{d.name}</span>
            </div>
          </div>
          <div class="cd__row-right">
            <p class="cd__note" set:html={d.note} />
            <span class="cd__price">{d.price}</span>
          </div>
          <span class="cd__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .cd {
    background: var(--surface-page);
    padding: var(--space-32) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 1024px) { .cd { padding: var(--space-40) 0; } }

  .cd__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 768px) { .cd__inner { padding: 0 32px; } }

  @media (min-width: 960px) {
    .cd__inner {
      grid-template-columns: minmax(160px, 22%) 1fr;
      gap: var(--space-16);
      padding: 0 48px;
    }
  }

  /* Meta */
  .cd__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cd__label {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cd__all {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-hover);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    align-self: flex-start;
  }

  .cd__all:hover { color: var(--text-primary); }

  /* Rows */
  .cd__content {
    display: flex;
    flex-direction: column;
  }

  .cd__row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto;
    gap: var(--space-5) var(--space-6);
    padding: var(--space-7) 0;
    border-top: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
    transition: padding-left var(--duration-base) var(--ease-out);
    align-items: center;
  }

  .cd__row:last-child { border-bottom: 1px solid var(--border-subtle); }

  .cd__row:hover { padding-left: var(--space-2); }

  @media (min-width: 640px) {
    .cd__row {
      grid-template-columns: minmax(220px, 42%) 1fr auto;
      align-items: center;
    }
  }

  .cd__row-left {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .cd__initials {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text-muted);
    letter-spacing: -0.02em;
    line-height: 1;
    flex-shrink: 0;
    width: 2.5rem;
  }

  .cd__info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .cd__spec {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-hover);
  }

  .cd__name {
    font-size: var(--text-ui);
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .cd__row-right {
    display: none;
    flex-direction: column;
    gap: var(--space-1);
  }

  @media (min-width: 640px) {
    .cd__row-right { display: flex; }
  }

  .cd__note {
    font-size: var(--text-caption);
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .cd__price {
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-secondary);
  }

  .cd__arrow {
    font-size: var(--text-ui);
    color: var(--text-muted);
    transition: transform var(--duration-base) var(--ease-out), color var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .cd__row:hover .cd__arrow {
    transform: translateX(4px);
    color: var(--accent-hover);
  }
</style>
