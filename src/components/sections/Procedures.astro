---
import SectionHeader from '../primitives/SectionHeader.astro';
import Button from '../primitives/Button.astro';

const procedures = [
  {
    category: 'Пластика лица',
    name: 'Ринопластика',
    price: 'от 200 000 ₽',
    desc: 'Проектируется по&nbsp;замерам лица&nbsp;— результат органично впишется в&nbsp;вашу внешность.',
    href: '/plastika#rinoplastika',
  },
  {
    category: 'Пластика тела',
    name: 'Маммопластика',
    price: 'от 450 000 ₽',
    desc: 'Индивидуальный дизайн молочной железы, подбор протеза.',
    href: '/plastika#mammoplastika',
  },
  {
    category: 'Пластика лица',
    name: 'Блефаропластика',
    price: 'от 60 000 ₽',
    desc: 'Верхних и&nbsp;нижних век. Лазерная и&nbsp;хирургическая методика.',
    href: '/plastika#blefaroplastika',
  },
  {
    category: 'Косметология',
    name: 'Ботулотоксины',
    price: 'от 150 ₽ / ед.',
    desc: 'Диспорт, Миотокс, Ксеомин. Эффект через&nbsp;3–14&nbsp;дней, длится 4–6&nbsp;месяцев.',
    href: '/kosmetologiya#botulotoxin',
  },
  {
    category: 'Косметология',
    name: 'Контурная пластика',
    price: 'от 22 000 ₽',
    desc: 'Белотеро, Радиесс, Скульптра. Многоуровневые техники.',
    href: '/kosmetologiya#kontur',
  },
  {
    category: 'Пластика тела',
    name: 'Абдоминопластика',
    price: 'от 250 000 ₽',
    desc: 'Мини- и&nbsp;полная абдоминопластика. Коррекция живота, талии, нависающего фартука.',
    href: '/plastika#abdominoplastika',
  },
];
---

<section class="procedures" aria-label="Популярные процедуры">
  <div class="procedures__inner">
    <div class="procedures__head">
      <SectionHeader title="Чаще всего выбирают" />
      <Button href="/plastika" variant="link" arrow={true}>Все процедуры</Button>
    </div>

    <div class="procedures__grid">
      {procedures.map((p, i) => (
        <article class="procedure" data-reveal style={`transition-delay: ${i * 80}ms`}>
          <div class="procedure__body">
            <span class="procedure__cat">{p.category}</span>
            <h3 class="procedure__name font-display">{p.name}</h3>
            <div class="procedure__price font-display">{p.price}</div>
            <p class="procedure__desc" set:html={p.desc} />
            <Button href={p.href} variant="link" arrow={true} class="procedure__link">Подробнее</Button>
          </div>
        </article>
      ))}
    </div>

    <p class="procedures__disclaimer">
      Цены носят информационный характер и&nbsp;не&nbsp;являются публичной офертой. Точная стоимость определяется врачом на&nbsp;консультации.
    </p>
  </div>
</section>

<style>
  .procedures {
    background: var(--surface-page);
    padding: var(--space-32) 0;
  }

  @media (min-width: 1024px) { .procedures { padding: var(--space-40) 0; } }

  .procedures__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 768px) { .procedures__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .procedures__inner { padding: 0 48px; } }

  .procedures__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .procedures__head :global(.section-header) {
    margin-bottom: 0;
  }

  .procedures__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 560px) { .procedures__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .procedures__grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); } }

  .procedure {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-top: 2px solid var(--accent);
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }

  .procedure:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-sm);
  }

  .procedure__body {
    padding: 28px 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .procedure__cat {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .procedure__name {
    font-size: var(--text-h5);
    font-weight: 400;
    color: var(--text-primary);
    letter-spacing: var(--tracking-heading);
    line-height: 1.15;
  }

  .procedure__price {
    font-size: var(--text-h5);
    font-weight: 300;
    font-style: normal;
    color: var(--accent-hover);
    letter-spacing: 0;
  }

  .procedure__desc {
    font-size: var(--text-ui);
    line-height: 1.55;
    color: var(--text-muted);
    flex: 1;
  }

  .procedure__link {
    margin-top: var(--space-2);
    align-self: flex-start;
  }

  .procedures__disclaimer {
    margin-top: var(--space-10);
    font-size: var(--text-caption);
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 64ch;
  }
</style>
