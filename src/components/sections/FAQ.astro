---
import SectionHeader from '../primitives/SectionHeader.astro';

const faqs = [
  {
    q: 'Сколько стоит первичная консультация?',
    a: 'У&nbsp;косметолога&nbsp;— от&nbsp;2 000&nbsp;₽. У&nbsp;хирурга&nbsp;— от&nbsp;5 000&nbsp;₽.',
    open: true,
  },
  {
    q: 'Есть ли противопоказания к операциям?',
    a: 'Да. Часть&nbsp;— общие для&nbsp;любой хирургии: беременность, лактация, онкология, нарушения свёртываемости крови, тяжёлые хронические заболевания. Часть&nbsp;— индивидуальные: их&nbsp;хирург видит только на&nbsp;очной консультации.',
  },
  {
    q: 'Через сколько дней виден результат после ботулотоксина?',
    a: 'Первый эффект появляется через 3–5&nbsp;дней, окончательный&nbsp;— через 10–14&nbsp;дней. Держится 4–6&nbsp;месяцев в&nbsp;зависимости от&nbsp;препарата и&nbsp;индивидуальных особенностей.',
  },
  {
    q: 'Вы работаете с мужчинами?',
    a: 'Каждый пятый пациент&nbsp;— мужчина. Чаще всего приходят с&nbsp;носом, веками, подбородком и&nbsp;коррекцией гинекомастии. У&nbsp;мужской эстетики своё правило: результат не&nbsp;должен читаться как вмешательство&nbsp;— хирурги работают именно в&nbsp;этом ключе.',
  },
  {
    q: 'Как проходит первичная консультация хирурга?',
    a: 'Хирург осматривает, замеряет, фотографирует, подбирает методику&nbsp;— и&nbsp;отвечает на&nbsp;все вопросы без&nbsp;спешки.',
  },
  {
    q: 'Как долго длится реабилитация?',
    a: 'Зависит от&nbsp;операции. Блефаропластика&nbsp;— 7–14&nbsp;дней. Ринопластика&nbsp;— 2–3&nbsp;недели. Маммопластика&nbsp;— 2–4&nbsp;недели ограничений. SMAS-лифтинг&nbsp;— 3–4&nbsp;недели. Точные сроки хирург назовёт на&nbsp;консультации.',
  },
];
---

<section class="faq" aria-label="Вопросы и ответы">
  <div class="faq__inner">
    <SectionHeader title="Вопросы и&nbsp;ответы" />

    <div class="faq__list">
      {faqs.map((item, i) => (
        <details class="faq__item" open={item.open} data-reveal style={`transition-delay: ${i * 60}ms`}>
          <summary class="faq__q font-display">
            <span set:html={item.q} />
            <span class="faq__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
              </svg>
            </span>
          </summary>
          <p class="faq__a" set:html={item.a} />
        </details>
      ))}
    </div>

    <p class="faq__disclaimer">
      Имеются противопоказания. Необходима консультация специалиста.
    </p>
  </div>
</section>

<style>
  .faq {
    background: var(--surface-alt);
    padding: var(--space-32) 0;
  }

  @media (min-width: 1024px) { .faq { padding: var(--space-40) 0; } }

  .faq__inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 768px) { .faq__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .faq__inner { padding: 0 48px; } }

  .faq__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-subtle);
  }

  .faq__item {
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-5) 0;
  }

  .faq__item[open] .faq__icon svg {
    transform: rotate(45deg);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    font-size: var(--text-h5);
    font-weight: 400;
    color: var(--text-primary);
    letter-spacing: var(--tracking-heading);
    line-height: 1.25;
    cursor: pointer;
    list-style: none;
    padding: var(--space-2) 0;
    text-wrap: balance;
  }

  .faq__q::-webkit-details-marker { display: none; }

  .faq__icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    color: var(--accent-hover);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .faq__icon svg {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .faq__a {
    font-size: var(--text-ui);
    line-height: 1.65;
    color: var(--text-muted);
    margin-top: var(--space-4);
    max-width: 72ch;
  }

  .faq__disclaimer {
    margin-top: var(--space-10);
    font-size: var(--text-caption);
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
