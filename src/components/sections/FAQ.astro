---
import SectionHeader from '../primitives/SectionHeader.astro';

const faqs = [
  {
    q: 'Сколько стоит первичная консультация?',
    a: 'У косметолога — от 2 000 ₽. У хирурга — от 5 000 ₽.',
    open: true,
  },
  {
    q: 'Есть ли противопоказания к операциям?',
    a: 'Да. Часть — общие для любой хирургии: беременность, лактация, онкология, нарушения свёртываемости крови, тяжёлые хронические заболевания. Часть — индивидуальные: их хирург видит только на очной консультации.',
  },
  {
    q: 'Через сколько дней виден результат после ботулотоксина?',
    a: 'Первый эффект появляется через 3–5 дней, окончательный — через 10–14 дней. Держится 4–6 месяцев в зависимости от препарата и индивидуальных особенностей.',
  },
  {
    q: 'Вы работаете с мужчинами?',
    a: 'Каждый пятый пациент — мужчина. Чаще всего приходят с носом, веками, подбородком и коррекцией гинекомастии. У мужской эстетики своё правило: результат не должен читаться как вмешательство — хирурги работают именно в этом ключе.',
  },
  {
    q: 'Как проходит первичная консультация хирурга?',
    a: 'Хирург осматривает, замеряет, фотографирует, подбирает методику — и отвечает на все вопросы без спешки.',
  },
  {
    q: 'Как долго длится реабилитация?',
    a: 'Зависит от операции. Блефаропластика — 7–14 дней. Ринопластика — 2–3 недели. Маммопластика — 2–4 недели ограничений. SMAS-лифтинг — 3–4 недели. Точные сроки хирург назовёт на консультации.',
  },
];
---

<section class="faq" aria-label="Вопросы и ответы">
  <div class="faq__inner">
    <SectionHeader title="Вопросы и ответы" />

    <div class="faq__list">
      {faqs.map((item, i) => (
        <details class="faq__item" open={item.open} data-reveal style={`transition-delay: ${i * 60}ms`}>
          <summary class="faq__q font-display">
            <span set:html={item.q} />
            <span class="faq__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
              </svg>
            </span>
          </summary>
          <p class="faq__a" set:html={item.a} />
        </details>
      ))}
    </div>

    <p class="faq__disclaimer">
      Имеются противопоказания. Необходима консультация специалиста.
    </p>
  </div>
</section>

<style>
  .faq {
    background: var(--surface-alt);
    padding: var(--space-32) 0;
  }

  @media (min-width: 1024px) { .faq { padding: var(--space-40) 0; } }

  .faq__inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 768px) { .faq__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .faq__inner { padding: 0 48px; } }

  .faq__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-subtle);
  }

  .faq__item {
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-5) 0;
  }

  .faq__item[open] .faq__icon svg {
    transform: rotate(45deg);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    font-size: var(--text-h5);
    font-weight: 400;
    color: var(--text-primary);
    letter-spacing: var(--tracking-heading);
    line-height: 1.25;
    cursor: pointer;
    list-style: none;
    padding: var(--space-2) 0;
    text-wrap: balance;
  }

  .faq__q::-webkit-details-marker { display: none; }

  .faq__icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    color: var(--accent-hover);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .faq__icon svg {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .faq__a {
    font-size: var(--text-ui);
    line-height: 1.65;
    color: var(--text-muted);
    margin-top: var(--space-4);
    max-width: 72ch;
  }
  .faq__a :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }
  .faq__a :global(a:hover) {
    color: inherit;
  }

  .faq__disclaimer {
    margin-top: var(--space-10);
    font-size: var(--text-caption);
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
