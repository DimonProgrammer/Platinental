---
import Button from '../primitives/Button.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Full-bleed cinematic canvas (4 layers: warm dark gradient, champagne hotspot, film grain, vignette) -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__bg-layer hero__bg-layer--base"></div>
    <div class="hero__bg-layer hero__bg-layer--hotspot"></div>
    <div class="hero__bg-layer hero__bg-layer--grain"></div>
    <div class="hero__bg-layer hero__bg-layer--vignette"></div>
  </div>

  <div class="hero__grid">
    <div class="hero__copy" data-reveal>
      <span class="hero__eyebrow">Platinental&nbsp;· Казань</span>

      <h1 id="hero-title" class="hero__title">
        Клиника пластической хирургии и&nbsp;косметологии в&nbsp;Казани
      </h1>

      <p class="hero__sub">
        Интеллигентная гармонизация внешности&nbsp;— без&nbsp;избыточности и&nbsp;шаблонов, через&nbsp;авторские методики наших&nbsp;хирургов.
      </p>

      <div class="hero__actions">
        <Button href="#form" variant="inverse" size="lg">Записаться на&nbsp;консультацию</Button>
        <Button href="/prices" variant="ghost" size="lg">Узнать стоимость&nbsp;→</Button>
      </div>
    </div>

    <aside class="hero__ba" data-reveal data-ba-root aria-label="Примеры результатов">
      <div class="hero__ba-slider" data-ba-slider>
        <div class="hero__ba-slides" data-ba-slides>
          <div class="hero__ba-slide is-active" data-ba-slide data-procedure="Ринопластика" data-note="Результат через 3 месяца">
            <div class="hero__ba-before ba-s1-before" aria-hidden="true"></div>
            <div class="hero__ba-after ba-s1-after" data-ba-after aria-hidden="true"></div>
          </div>
          <div class="hero__ba-slide" data-ba-slide data-procedure="Блефаропластика" data-note="Верхние и нижние веки, через 2 недели">
            <div class="hero__ba-before ba-s2-before" aria-hidden="true"></div>
            <div class="hero__ba-after ba-s2-after" data-ba-after aria-hidden="true"></div>
          </div>
          <div class="hero__ba-slide" data-ba-slide data-procedure="Маммопластика" data-note="Индивидуальный дизайн, через 6 недель">
            <div class="hero__ba-before ba-s3-before" aria-hidden="true"></div>
            <div class="hero__ba-after ba-s3-after" data-ba-after aria-hidden="true"></div>
          </div>
          <div class="hero__ba-slide" data-ba-slide data-procedure="SMAS-лифтинг" data-note="Натуральный результат, через 1 месяц">
            <div class="hero__ba-before ba-s4-before" aria-hidden="true"></div>
            <div class="hero__ba-after ba-s4-after" data-ba-after aria-hidden="true"></div>
          </div>
        </div>

        <span class="hero__ba-tag" aria-hidden="true">До</span>
        <span class="hero__ba-tag hero__ba-tag--after" aria-hidden="true">После</span>

        <div class="hero__ba-handle" data-ba-handle aria-hidden="true">
          <div class="hero__ba-line"></div>
          <button class="hero__ba-btn" aria-label="Перетащить для сравнения">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M7 5l-4 5 4 5M13 5l4 5-4 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="hero__ba-line"></div>
        </div>
      </div>

      <div class="hero__ba-footer">
        <div class="hero__ba-caption">
          <span class="hero__ba-procedure" data-ba-procedure>Ринопластика</span>
          <span class="hero__ba-note" data-ba-note>Результат через 3 месяца. С согласия пациента.</span>
        </div>
        <div class="hero__ba-nav" aria-label="Переключить кейс">
          <button class="hero__ba-nav-btn" data-ba-prev aria-label="Предыдущий">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="hero__ba-dots" data-ba-dots aria-hidden="true">
            <span class="hero__ba-dot is-active"></span>
            <span class="hero__ba-dot"></span>
            <span class="hero__ba-dot"></span>
            <span class="hero__ba-dot"></span>
          </div>
          <button class="hero__ba-nav-btn" data-ba-next aria-label="Следующий">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </aside>
  </div>

  <div class="hero__stats">
    <div class="hero__stats-inner">
      <div class="hero__stat">
        <span class="hero__stat-dot" aria-hidden="true"></span>
        <span class="hero__stat-text">Деликатная гармонизация</span>
      </div>
      <span class="hero__stat-divider" aria-hidden="true"></span>
      <div class="hero__stat hero__stat--tooltip">
        <span class="hero__stat-dot" aria-hidden="true"></span>
        <button class="hero__stat-text hero__stat-trigger" aria-describedby="asps-tooltip">
          Аккредитация ASPS, ISAPS
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <circle cx="6" cy="6" r="5.5" stroke="currentColor" stroke-opacity="0.45"/>
            <path d="M6 5.5v3M6 3.8v.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </button>
        <div class="hero__tooltip" id="asps-tooltip" role="tooltip">
          <p><strong>ASPS</strong> — Американское общество пластических хирургов. <strong>ISAPS</strong> — Международное общество эстетической пластической хирургии.</p>
          <p>Членство подтверждает квалификацию хирурга на&nbsp;международном уровне и&nbsp;соответствие стандартам безопасности.</p>
        </div>
      </div>
      <span class="hero__stat-divider" aria-hidden="true"></span>
      <div class="hero__stat">
        <span class="hero__stat-dot" aria-hidden="true"></span>
        <span class="hero__stat-text">С&nbsp;2011 в&nbsp;Казани</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Hero: dark cinematic canvas (Aesop × ShowcaseMD) ──────────── */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--text-inverse);
    background: var(--color-ink-900);
    padding: calc(var(--nav-height-mobile) + var(--space-12)) 0 0;
  }
  @media (min-width: 768px) {
    .hero { padding: calc(var(--nav-height) + var(--space-12)) 0 0; }
  }

  /* ── Layered background ────────────────────────────────────────── */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__bg-layer { position: absolute; inset: 0; }

  .hero__bg-layer--base {
    background: var(--color-ink-900);
  }
  .hero__bg-layer--hotspot {
    background:
      radial-gradient(52% 58% at 82% 22%, rgba(196, 168, 130, 0.18) 0%, transparent 68%),
      radial-gradient(40% 46% at 8% 88%, rgba(196, 168, 130, 0.08) 0%, transparent 72%);
    mix-blend-mode: screen;
  }
  .hero__bg-layer--grain { display: none; }
  .hero__bg-layer--vignette {
    background:
      linear-gradient(180deg, rgba(10, 10, 10, 0.3) 0%, transparent 22%, transparent 62%, rgba(10, 10, 10, 0.5) 100%);
  }

  /* ── Main grid: copy + B/A slider ──────────────────────────────── */
  .hero__grid {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px var(--space-16);
    display: grid;
    gap: var(--space-12);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 768px) { .hero__grid { padding: 0 32px var(--space-16); } }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-16);
      align-items: center;
    }
  }
  @media (min-width: 1200px) { .hero__grid { padding: 0 48px var(--space-20); } }

  /* ── Eyebrow ───────────────────────────────────────────────────── */
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-8);
  }
  .hero__eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--accent);
    opacity: 0.6;
  }

  /* ── H1: Cormorant Garamond italic 400, editorial scale ────────── */
  .hero__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--text-inverse);
    margin-bottom: var(--space-8);
    max-width: 20ch;
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: keep-all;
    hyphens: none;
  }

  .hero__sub {
    font-family: var(--font-body);
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--text-inverse-muted);
    max-width: 46ch;
    margin-bottom: var(--space-10);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
  }

  /* Ghost button on dark hero — muted cream → champagne on hover */
  .hero__actions :global(.btn--ghost) {
    color: rgba(255, 253, 248, 0.85);
  }
  .hero__actions :global(.btn--ghost:hover) {
    color: var(--accent);
  }
  .hero__actions :global(.btn--ghost .btn__label::after) {
    background: currentColor;
    opacity: 0.35;
  }

  /* ── B/A slider ────────────────────────────────────────────────── */
  .hero__ba {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    user-select: none;
  }

  .hero__ba-slider {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 3 / 2;
    cursor: col-resize;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    max-height: 48vh;
    border: 1px solid rgba(255, 253, 248, 0.08);
  }

  @media (min-width: 1024px) {
    .hero__ba-slider {
      aspect-ratio: 4 / 3;
      max-height: none;
    }
  }

  .hero__ba-slides { position: absolute; inset: 0; }

  .hero__ba-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 480ms var(--ease-out);
    pointer-events: none;
  }
  .hero__ba-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero__ba-before,
  .hero__ba-after { position: absolute; inset: 0; }

  /* Solid placeholder per slide — before darker, after slightly lighter */
  .ba-s1-before, .ba-s2-before, .ba-s3-before, .ba-s4-before { background: var(--color-ink-900); }
  .ba-s1-after,  .ba-s2-after,  .ba-s3-after,  .ba-s4-after  { background: var(--color-ink-700); }

  .hero__ba-after { clip-path: inset(0 50% 0 0); }

  .hero__ba-tag {
    position: absolute;
    z-index: 5;
    top: var(--space-4);
    left: var(--space-4);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 253, 248, 0.9);
    background: rgba(10, 8, 7, 0.5);
    padding: 4px 10px;
    border-radius: 99px;
    backdrop-filter: blur(6px);
    pointer-events: none;
  }
  .hero__ba-tag--after {
    left: auto;
    right: var(--space-4);
  }

  /* Handle (drag divider) */
  .hero__ba-handle {
    position: absolute;
    top: 0; bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 2px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 10;
    pointer-events: none;
  }
  .hero__ba-line {
    flex: 1;
    width: 2px;
    background: rgba(255, 253, 248, 0.85);
  }
  .hero__ba-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-cream-50);
    color: var(--color-ink-900);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    cursor: col-resize;
    pointer-events: all;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .hero__ba-slider:active .hero__ba-btn { transform: scale(0.92); }

  /* Footer under slider */
  .hero__ba-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .hero__ba-caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hero__ba-procedure {
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: 700;
    color: var(--text-inverse);
    letter-spacing: -0.01em;
    line-height: 1.1;
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .hero__ba-note {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    color: var(--text-inverse-muted);
    line-height: 1.4;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .hero__ba-nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }
  .hero__ba-nav-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(255, 253, 248, 0.22);
    color: rgba(255, 253, 248, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .hero__ba-nav-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--color-ink-900);
  }

  .hero__ba-dots {
    display: flex;
    gap: 5px;
    align-items: center;
  }
  .hero__ba-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 253, 248, 0.25);
    transition:
      background-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }
  .hero__ba-dot.is-active {
    background: var(--accent);
    transform: scale(1.3);
  }

  /* ── Stats strip (bottom band) ─────────────────────────────────── */
  .hero__stats {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(255, 253, 248, 0.08);
    background: rgba(10, 8, 7, 0.55);
    backdrop-filter: blur(12px);
  }
  .hero__stats-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-5) 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }
  @media (min-width: 768px) { .hero__stats-inner { padding: var(--space-5) 32px; } }
  @media (min-width: 1200px) { .hero__stats-inner { padding: var(--space-5) 48px; } }

  .hero__stat {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-8);
    flex: 1;
    justify-content: center;
  }
  .hero__stat-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
  .hero__stat-text,
  .hero__stat-trigger {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 253, 248, 0.75);
    background: none;
    border: none;
    padding: 0;
    cursor: default;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
  }
  .hero__stat-trigger { cursor: help; }

  .hero__stat--tooltip { position: relative; }

  .hero__tooltip {
    display: none;
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-cream-50);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    line-height: 1.55;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-sm);
    width: 280px;
    box-shadow: var(--shadow-lg);
    z-index: 10;
    pointer-events: none;
  }
  .hero__tooltip p { margin-bottom: var(--space-2); }
  .hero__tooltip p:last-child { margin-bottom: 0; }
  .hero__tooltip strong { color: var(--accent-hover); }

  .hero__tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--color-cream-50);
  }

  .hero__stat--tooltip:hover .hero__tooltip,
  .hero__stat--tooltip:focus-within .hero__tooltip {
    display: block;
  }

  .hero__stat-divider {
    width: 1px;
    align-self: stretch;
    background: rgba(255, 253, 248, 0.1);
    display: none;
  }
  @media (min-width: 768px) { .hero__stat-divider { display: block; } }
</style>

<script>
  const root = document.querySelector('[data-ba-root]') as HTMLElement | null;
  if (!root) throw new Error('ba-root not found');

  const slider   = root.querySelector('[data-ba-slider]') as HTMLElement;
  const handle   = root.querySelector('[data-ba-handle]') as HTMLElement;
  const slides   = Array.from(root.querySelectorAll('[data-ba-slide]')) as HTMLElement[];
  const dots     = Array.from(root.querySelectorAll('[data-ba-dots] .hero__ba-dot')) as HTMLElement[];
  const prevBtn  = root.querySelector('[data-ba-prev]') as HTMLButtonElement;
  const nextBtn  = root.querySelector('[data-ba-next]') as HTMLButtonElement;
  const procEl   = root.querySelector('[data-ba-procedure]') as HTMLElement;
  const noteEl   = root.querySelector('[data-ba-note]') as HTMLElement;

  let current = 0;
  let dragging = false;
  let autoTimer: ReturnType<typeof setInterval>;
  const INTERVAL = 4500;

  const getAfter = (slide: HTMLElement) =>
    slide.querySelector('[data-ba-after]') as HTMLElement | null;

  const setHandlePos = (pct: number) => {
    const after = getAfter(slides[current]);
    if (!after) return;
    const clamped = Math.max(4, Math.min(96, pct));
    after.style.clipPath = `inset(0 ${100 - clamped}% 0 0)`;
    handle.style.left = `${clamped}%`;
  };

  const goTo = (idx: number) => {
    slides[current].classList.remove('is-active');
    dots[current]?.classList.remove('is-active');
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    dots[current]?.classList.add('is-active');
    handle.style.left = '50%';
    const after = getAfter(slides[current]);
    if (after) after.style.clipPath = 'inset(0 50% 0 0)';
    const proc = slides[current].dataset.procedure ?? '';
    const note = slides[current].dataset.note ?? '';
    procEl.style.opacity = '0';
    noteEl.style.opacity = '0';
    setTimeout(() => {
      procEl.textContent = proc;
      noteEl.textContent = note + '. С согласия пациента.';
      procEl.style.opacity = '1';
      noteEl.style.opacity = '1';
    }, 160);
  };

  const startAuto = () => {
    clearInterval(autoTimer);
    autoTimer = setInterval(() => { if (!dragging) goTo(current + 1); }, INTERVAL);
  };

  goTo(0);
  startAuto();

  prevBtn.addEventListener('click', () => { goTo(current - 1); startAuto(); });
  nextBtn.addEventListener('click', () => { goTo(current + 1); startAuto(); });

  const onDragStart = (clientX: number) => {
    dragging = true;
    setHandlePos(((clientX - slider.getBoundingClientRect().left) / slider.offsetWidth) * 100);
  };
  const onDragMove = (clientX: number) => {
    if (!dragging) return;
    setHandlePos(((clientX - slider.getBoundingClientRect().left) / slider.offsetWidth) * 100);
  };
  const onDragEnd = () => { dragging = false; };

  slider.addEventListener('mousedown',  (e) => onDragStart((e as MouseEvent).clientX));
  slider.addEventListener('touchstart', (e) => onDragStart((e as TouchEvent).touches[0].clientX), { passive: true });
  window.addEventListener('mousemove',  (e) => onDragMove((e as MouseEvent).clientX));
  window.addEventListener('touchmove',  (e) => onDragMove((e as TouchEvent).touches[0].clientX), { passive: true });
  window.addEventListener('mouseup',    onDragEnd);
  window.addEventListener('touchend',   onDragEnd);

  root.addEventListener('mouseenter', () => clearInterval(autoTimer));
  root.addEventListener('mouseleave', startAuto);
</script>
