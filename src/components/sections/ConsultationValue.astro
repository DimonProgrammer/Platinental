---
import Button from '../primitives/Button.astro';
---

<section class="cv" aria-label="Консультация хирурга">
  <div class="cv__inner" data-reveal>
    <h2 class="cv__title font-display">Консультация хирурга</h2>
    <p class="cv__body">
      На&nbsp;приёме хирург осматривает, замеряет пропорции, делает фото в&nbsp;нужных ракурсах и&nbsp;показывает похожие случаи из&nbsp;своей практики. Вы&nbsp;уходите с&nbsp;пониманием, что&nbsp;возможно и&nbsp;что&nbsp;разумно.
    </p>
    <p class="cv__price font-display">от 5 000 ₽</p>
    <div class="cv__actions">
      <Button href="#form" variant="primary" size="lg">Записаться на&nbsp;консультацию</Button>
      <p class="cv__messengers">
        <a href="https://wa.me/78432236666" target="_blank" rel="noopener">WhatsApp</a>&ensp;·&ensp;<a href="https://max.ru/" target="_blank" rel="noopener">Max</a>&ensp;·&ensp;<a href="https://t.me/platinental_kazan" target="_blank" rel="noopener">Telegram</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cv {
    background: var(--surface-page);
    padding: var(--space-16) 0 var(--space-24);
  }

  @media (min-width: 1024px) { .cv { padding: var(--space-20) 0 var(--space-32); } }

  .cv__inner {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: center;
  }

  .cv__title {
    font-size: var(--text-h3);
    font-weight: 400;
    color: var(--text-primary);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    text-wrap: balance;
  }

  .cv__body {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 54ch;
  }

  .cv__price {
    font-size: var(--text-h4);
    font-weight: 300;
    color: var(--accent-hover);
    letter-spacing: 0;
  }

  .cv__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .cv__messengers {
    font-size: var(--text-ui);
    color: var(--text-muted);
  }

  .cv__messengers a {
    color: var(--text-primary);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .cv__messengers a:hover {
    color: var(--accent-hover);
    border-bottom-color: var(--accent);
  }
</style>
