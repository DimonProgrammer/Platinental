---
import SectionHeader from '../primitives/SectionHeader.astro';
import Button from '../primitives/Button.astro';

const doctors = [
  {
    spec: 'RHINOPLASTY / РИНОПЛАСТИКА',
    name: 'Мелоян Мхитар Мисакович',
    price: 'Консультация от 7 000 ₽',
    note: '40 лет хирургической практики, обучение в&nbsp;США, Чехии, Армении',
    cta: 'Записаться к&nbsp;Мелояну',
    href: '/doctors/meloyan/',
    initials: 'ММ',
    tone: 'a',
  },
  {
    spec: 'FACE PRESERVING SURGERY / ДЕЛИКАТНАЯ ХИРУРГИЯ',
    name: 'Тулатова Регина Тимуровна',
    price: 'Консультация от 7 000 ₽',
    cta: 'Записаться к&nbsp;Тулатовой',
    href: '/doctors/tulatova/',
    initials: 'РТ',
    tone: 'b',
  },
  {
    spec: 'ЧЕЛЮСТНО-ЛИЦЕВАЯ ХИРУРГИЯ',
    name: 'Мамедов Вахид Аждарович',
    price: 'Консультация от 10 000 ₽',
    cta: 'Записаться к&nbsp;Мамедову',
    href: '/doctors/mamedov/',
    initials: 'ВМ',
    tone: 'c',
  },
  {
    spec: 'К.М.Н. / ПЛАСТИЧЕСКИЙ ХИРУРГ',
    name: 'Васильев Максим Николаевич',
    price: 'Консультация от 7 000 ₽',
    cta: 'Записаться к&nbsp;Васильеву',
    href: '/doctors/vasilev/',
    initials: 'МВ',
    tone: 'd',
  },
];
---

<section class="doctors" id="doctors" aria-label="Врачи клиники">
  <div class="doctors__inner">
    <div class="doctors__head">
      <SectionHeader title="Врачи клиники" />
      <Button href="/doctors" variant="link" arrow={true}>Все врачи</Button>
    </div>

    <div class="doctors__grid">
      {doctors.map((d, i) => (
        <article class="doctor" data-reveal style={`transition-delay: ${i * 90}ms`}>
          <div class={`doctor__portrait doctor__portrait--${d.tone}`} aria-hidden="true">
            <span class="doctor__initials font-display">{d.initials}</span>
            <span class="doctor__placeholder-note">фото&nbsp;врача</span>
          </div>
          <div class="doctor__body">
            <span class="doctor__spec">{d.spec}</span>
            <h3 class="doctor__name font-display">{d.name}</h3>
            <div class="doctor__price">{d.price}</div>
            {d.note && <p class="doctor__note" set:html={d.note} />}
            <Button href={d.href} variant="secondary" size="sm" fullWidth={true} class="doctor__cta">
              <span set:html={d.cta} />
            </Button>
          </div>
        </article>
      ))}
    </div>

    <div class="doctors__footer">
      <p class="doctors__also">
        Также в&nbsp;клинике: Марданова Д.М., Макеенко Н.В., Бречко М.А. (CO₂-лазер, безоперационная блефаропластика), Грицай&nbsp;О.А. (косметолог)
      </p>
      <Button href="/doctors" variant="secondary" size="md">Показать всех врачей</Button>
    </div>
  </div>
</section>

<style>
  .doctors {
    background: var(--surface-page);
    padding: var(--space-32) 0;
  }

  @media (min-width: 1024px) { .doctors { padding: var(--space-40) 0; } }

  .doctors__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 768px) { .doctors__inner { padding: 0 32px; } }
  @media (min-width: 1200px) { .doctors__inner { padding: 0 48px; } }

  .doctors__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .doctors__head :global(.section-header) {
    margin-bottom: 0;
  }

  .doctors__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 560px) { .doctors__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .doctors__grid { grid-template-columns: repeat(4, 1fr); gap: var(--space-5); } }

  .doctor {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .doctor__portrait {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-md);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .doctor:hover .doctor__portrait { transform: translateY(-4px); }

  .doctor__portrait--a { background: var(--color-ink-900); }
  .doctor__portrait--b { background: var(--color-ink-700); }
  .doctor__portrait--c { background: var(--color-ink-900); }
  .doctor__portrait--d { background: var(--color-ink-700); }

  .doctor__initials {
    font-size: 80px;
    font-weight: 300;
    font-style: normal;
    color: rgba(255, 253, 248, 0.92);
    letter-spacing: -0.02em;
    line-height: 1;
    z-index: 1;
  }

  .doctor__placeholder-note {
    position: absolute;
    bottom: 12px;
    left: 14px;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 253, 248, 0.45);
    z-index: 1;
  }

  .doctor__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .doctor__spec {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-hover);
    margin-bottom: var(--space-2);
  }

  .doctor__name {
    font-size: var(--text-h5);
    font-weight: 400;
    line-height: 1.15;
    color: var(--text-primary);
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
  }

  .doctor__price {
    font-size: var(--text-ui);
    color: var(--text-muted);
    margin-top: var(--space-1);
  }

  .doctor__note {
    font-size: var(--text-caption);
    line-height: 1.45;
    color: var(--text-muted);
  }

  .doctor__cta {
    margin-top: var(--space-3);
  }

  .doctors__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-12);
    padding-top: var(--space-10);
    border-top: 1px solid var(--border-subtle);
    align-items: flex-start;
  }

  .doctors__also {
    font-size: var(--text-ui);
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 80ch;
  }

</style>
