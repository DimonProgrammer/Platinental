---
interface Props {
  as?: string;
  size?: 'sm' | 'md' | 'lg' | 'full';
  class?: string;
}

const props = Astro.props as Props;
const { as: Tag = 'div', size = 'lg', class: className = '' } = props;

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  sm: 'max-w-[720px]',
  md: 'max-w-[960px]',
  lg: 'max-w-[1280px]',
  full: 'max-w-none',
};
const sizeClass = sizeClasses[size];
---

<Tag class:list={['mx-auto w-full px-5 sm:px-8 lg:px-12', sizeClass, className]}>
  <slot />
</Tag>
