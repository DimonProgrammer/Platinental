---
import Button from '../primitives/Button.astro';

const services = [
  { href: '/plastika', label: 'Пластическая хирургия', desc: '27 видов операций' },
  { href: '/kosmetologiya', label: 'Косметология', desc: 'Ботокс, лазер, контурная пластика' },
  { href: '/kosmecevtika', label: 'Космецевтика', desc: 'Профессиональный уход' },
];

const navItems = [
  { href: '/doctors', label: 'Врачи' },
  { href: '/prices', label: 'Цены' },
  { href: '/about', label: 'О клинике' },
  { href: '/contacts', label: 'Контакты' },
];
---

<header class="nav" id="site-nav" data-nav>
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="Platinental — на главную">
      <img src="/logo.svg" alt="Platinental" class="nav__logo" width="140" height="30" />
    </a>

    <nav class="nav__menu" aria-label="Основная навигация">
      <ul>
        <li class="nav__dropdown-wrap">
          <button class="nav__dropdown-trigger" aria-expanded="false" aria-haspopup="true">
            Услуги
            <svg class="nav__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="nav__dropdown" role="menu">
            {services.map((s) => (
              <a href={s.href} class="nav__dropdown-item" role="menuitem">
                <span class="nav__dropdown-label">{s.label}</span>
                <span class="nav__dropdown-desc">{s.desc}</span>
              </a>
            ))}
          </div>
        </li>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav__actions">
      <div class="nav__reviews">
        <a href="https://yandex.com/maps/-/CPv-6-iq" class="nav__review-badge" target="_blank" rel="noopener" title="Отзывы на Яндекс.Картах">
          <span class="nav__review-platform">Яндекс</span>
        </a>
        <a href="https://2gis.ru/kazan/firm/2956015537227284/tab/reviews" class="nav__review-badge" target="_blank" rel="noopener" title="Отзывы на 2ГИС">
          <span class="nav__review-platform">2ГИС</span>
        </a>
      </div>
      <a href="tel:+78432236666" class="nav__phone">+7 843 223-66-66</a>
      <div class="nav__socials">
        <a href="https://t.me/platinental_kazan" class="nav__social-link" target="_blank" rel="noopener" aria-label="Telegram">TG</a>
        <a href="https://max.ru" class="nav__social-link" target="_blank" rel="noopener" aria-label="MAX">MAX</a>
      </div>
      <Button href="#consult" variant="primary" size="sm">Консультация</Button>
    </div>

    <button class="nav__burger" aria-label="Открыть меню" aria-expanded="false" data-burger>
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Мобильное меню -->
  <div class="nav__mobile" data-mobile-menu aria-hidden="true">
    <ul>
      <li class="nav__mobile-group">
        <span class="nav__mobile-group-label">Услуги</span>
        <ul class="nav__mobile-sub">
          {services.map((s) => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </li>
      {navItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    <div class="nav__mobile-reviews">
      <a href="https://yandex.com/maps/-/CPv-6-iq" class="nav__review-badge" target="_blank" rel="noopener">
        <span class="nav__review-platform">Яндекс.Карты</span>
      </a>
      <a href="https://2gis.ru/kazan/firm/2956015537227284/tab/reviews" class="nav__review-badge" target="_blank" rel="noopener">
        <span class="nav__review-platform">2ГИС</span>
      </a>
    </div>
    <div class="nav__mobile-actions">
      <a href="tel:+78432236666" class="nav__phone">+7 843 223-66-66</a>
      <Button href="#consult" variant="primary" size="md">Записаться на консультацию</Button>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector('[data-nav]') as HTMLElement | null;
  const burger = document.querySelector('[data-burger]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  const trigger = document.querySelector('.nav__dropdown-trigger') as HTMLButtonElement | null;
  const dropdown = document.querySelector('.nav__dropdown') as HTMLElement | null;

  if (nav) {
    const onScroll = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > 24);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (trigger && dropdown) {
    const open = () => { trigger.setAttribute('aria-expanded', 'true'); };
    const close = () => { trigger.setAttribute('aria-expanded', 'false'); };

    trigger.closest('.nav__dropdown-wrap')?.addEventListener('mouseenter', open);
    trigger.closest('.nav__dropdown-wrap')?.addEventListener('mouseleave', close);
    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      isOpen ? close() : open();
    });

    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    dropdown.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  }

  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      menu.setAttribute('aria-hidden', String(open));
      document.body.classList.toggle('nav-open', !open);
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        burger.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('nav-open');
      });
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--nav-height-mobile);
    transition: background-color var(--duration-base) var(--ease-out),
                backdrop-filter var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  @media (min-width: 768px) {
    .nav {
      height: var(--nav-height);
    }
  }

  .nav.is-scrolled {
    background: var(--glass-bg-scrolled);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom-color: var(--border-subtle);
  }

  .nav__inner {
    height: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .nav__inner {
      padding: 0 32px;
    }
  }

  @media (min-width: 1200px) {
    .nav__inner {
      padding: 0 48px;
    }
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .nav__logo {
    display: block;
    height: 28px;
    width: auto;
  }

  .nav__suffix {
    font-size: var(--text-caption);
    color: var(--text-muted);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .nav__reviews {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav__review-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--surface-alt);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    padding: 5px 10px;
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }

  .nav__review-badge:hover {
    background: var(--surface-raised);
    border-color: var(--border-soft);
  }

  .nav__review-star {
    color: var(--accent);
    font-size: 11px;
    line-height: 1;
  }

  .nav__review-score {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }

  .nav__review-platform {
    font-size: 10px;
    color: var(--text-muted);
    line-height: 1;
  }

  .nav__socials {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav__social-link {
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav__social-link:hover {
    color: var(--text-primary);
  }

  .nav__menu {
    display: none;
    flex: 1;
  }

  @media (min-width: 1100px) {
    .nav__menu {
      display: flex;
      justify-content: center;
    }
  }

  .nav__menu ul {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    height: 100%;
  }

  .nav__menu li {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .nav__menu a {
    font-size: var(--text-caption);
    font-weight: 400;
    color: var(--text-primary);
    padding: var(--space-2) 0;
    transition: color var(--duration-fast) var(--ease-out);
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav__menu a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav__menu a:hover::after,
  .nav__menu a:focus-visible::after {
    transform: scaleX(1);
  }

  /* Dropdown */
  .nav__dropdown-wrap {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .nav__dropdown-trigger {
    font-size: var(--text-caption);
    font-weight: 400;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: var(--space-2) 0;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
    position: relative;
  }

  .nav__dropdown-trigger::after {
    content: '';
    position: absolute;
    left: 0;
    right: 18px;
    bottom: 2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav__dropdown-wrap:hover .nav__dropdown-trigger::after,
  .nav__dropdown-trigger[aria-expanded='true']::after {
    transform: scaleX(1);
  }

  .nav__chevron {
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
    color: var(--text-muted);
  }

  .nav__dropdown-trigger[aria-expanded='true'] .nav__chevron {
    transform: rotate(180deg);
  }

  .nav__dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: 260px;
    background: var(--surface-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 32px rgba(10, 10, 10, 0.10);
    padding: var(--space-2);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out),
                visibility var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
    transform: translateX(-50%) translateY(-6px);
  }

  .nav__dropdown-trigger[aria-expanded='true'] ~ .nav__dropdown,
  .nav__dropdown-wrap:hover .nav__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav__dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    border-radius: calc(var(--radius-md) - 4px);
    transition: background var(--duration-fast) var(--ease-out);
  }

  .nav__dropdown-item:hover {
    background: var(--surface-alt);
  }

  .nav__dropdown-item::after { display: none; }

  .nav__dropdown-label {
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--text-primary);
  }

  .nav__dropdown-desc {
    font-size: var(--text-caption);
    color: var(--text-muted);
  }

  /* Mobile submenu */
  .nav__mobile-group-label {
    display: block;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    padding: var(--space-3) 0 var(--space-1);
  }

  .nav__mobile-sub {
    padding-left: var(--space-4);
  }

  .nav__mobile-sub a {
    font-size: var(--text-h5) !important;
  }

  .nav__actions {
    display: none;
    align-items: center;
    gap: var(--space-5);
    margin-left: auto;
    flex-shrink: 0;
  }

  @media (min-width: 1100px) {
    .nav__actions {
      display: flex;
    }
  }

  .nav__phone {
    font-size: var(--text-ui);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav__phone:hover {
    color: var(--accent-hover);
  }

  .nav__burger {
    margin-left: auto;
    width: 44px;
    height: 44px;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 0 10px;
  }

  @media (min-width: 1100px) {
    .nav__burger {
      display: none;
    }
  }

  .nav__burger span {
    display: block;
    height: 1.5px;
    background: var(--text-primary);
    transition: transform var(--duration-base) var(--ease-out),
                opacity var(--duration-fast) var(--ease-out);
    transform-origin: center;
  }

  .nav__burger span:nth-child(1) { width: 22px; margin-left: auto; }
  .nav__burger span:nth-child(2) { width: 22px; margin-left: auto; }
  .nav__burger span:nth-child(3) { width: 16px; margin-left: auto; }

  .nav__burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
    width: 22px;
  }
  .nav__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .nav__burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
    width: 22px;
  }

  .nav__mobile {
    position: fixed;
    inset: var(--nav-height-mobile) 0 0 0;
    background: var(--surface-page);
    padding: var(--space-10) 20px var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform var(--duration-base) var(--ease-out);
    visibility: hidden;
  }

  .nav__mobile[aria-hidden='false'] {
    transform: none;
    visibility: visible;
  }

  @media (min-width: 1100px) {
    .nav__mobile { display: none; }
  }

  .nav__mobile ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav__mobile a {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-h4);
    color: var(--text-primary);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    letter-spacing: var(--tracking-heading);
  }

  .nav__mobile-reviews {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .nav__mobile-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: auto;
  }

  :global(body.nav-open) {
    overflow: hidden;
  }

  /* ── Dark-hero override: белый nav пока не прокручено ─────────── */
  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__menu a,
  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__dropdown-trigger,
  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__phone,
  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__social-link {
    color: rgba(255, 255, 255, 0.85);
  }

  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__menu a:hover,
  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__dropdown-trigger:hover,
  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__phone:hover,
  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__social-link:hover {
    color: var(--accent);
  }

  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__chevron {
    color: rgba(255, 255, 255, 0.55);
  }

  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__review-badge {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
  }

  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__review-platform {
    color: rgba(255, 255, 255, 0.6);
  }

  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__logo {
    filter: brightness(0) invert(1);
  }

  :global([data-dark-hero]) .nav:not(.is-scrolled) .nav__burger span {
    background: rgba(255, 255, 255, 0.85);
  }
</style>
