---
import { Image } from 'astro:assets';
import heroWarmProfile from '../../../assets/photos/home-hero-warm-profile.png';
---

<section class="v3-hero v3-surface-cream" aria-labelledby="hero-heading">
  <div class="v3-container v3-container-wide hero-grid">
    <div class="hero-text" data-v3-reveal>
      <span class="v3-eyebrow">The Platinental · Казань</span>

      <h1 id="hero-heading" class="v3-display hero-h1">
        Клиника<br />
        пластической хирургии<br />
        и косметологии<br />
        <span class="hero-h1-loc">в Казани</span>
      </h1>

      <p class="v3-lead hero-lead">
        Команда врачей с сильной профессиональной подготовкой, опытом
        и репутацией. Работаем со сложными эстетическими и функциональными
        задачами, сохраняя фокус на гармонии пропорций
        и индивидуальности пациента.
      </p>

      <div class="hero-cta">
        <a href="#form" class="v3-btn v3-btn-primary">Записаться на консультацию</a>
        <a href="/prices" class="v3-link v3-link-action cta-secondary">Узнать стоимость</a>
      </div>
    </div>

    <div class="hero-image" data-v3-reveal>
      <div class="hero-image-wrap">
        <Image
          src={heroWarmProfile}
          alt="Портрет в тёплом свете с акцентом на профиль, линию подбородка и шеи"
          width={864}
          height={1080}
          loading="eager"
          fetchpriority="high"
          class="hero-image-asset"
        />
      </div>
    </div>
  </div>

  <div class="v3-container v3-container-wide hero-stats" data-v3-reveal>
    <ul class="stats-list">
	      <li class="stat-item">С 2011 года в Казани</li>
		      <li class="stat-item">Уникальные методики, собственные патенты</li>
	      <li class="stat-item">Лицензия ЛО-16-01-003022</li>
    </ul>
  </div>
</section>

<style>
  .v3-hero {
    padding-top: clamp(1rem, 2.5vh, 2rem);
    padding-bottom: clamp(1.5rem, 3vh, 2.75rem);
    overflow-x: clip;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(1.25rem, 3.5vh, 2.5rem);
  }
  .hero-text { display: flex; flex-direction: column; gap: var(--v3-gap-h1-lead); max-width: var(--v3-hero-text-max); }
  .hero-text .v3-eyebrow {
    margin-bottom: var(--v3-gap-eyebrow-h1);
    align-self: flex-start;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--v3-border-soft);
    border-radius: var(--v3-radius-pill);
    background: var(--v3-surface-card);
  }
  .hero-h1-loc { color: var(--v3-champagne-deep); }
  .hero-lead { max-width: 38ch; }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .cta-secondary { font-size: 0.9375rem; }
  .hero-image {
    max-width: 36rem;
    margin-left: auto;
    width: 100%;
    display: flex;
    justify-content: flex-end;
    padding-right: clamp(0.25rem, 1vw, 0.875rem);
    align-self: end;
  }
  .hero-image-wrap {
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 34rem;
    overflow: hidden;
    border-radius: var(--v3-radius-xl);
    border: 1px solid var(--v3-border-soft);
    background: var(--v3-surface-card);
    box-shadow: var(--v3-shadow-sm);
    animation: heroImageFloat 7.2s ease-in-out 1.1s infinite;
  }
  .hero-image-asset {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    transform: scale(1);
    transform-origin: center center;
    animation: heroImageReveal 1.2s var(--v3-ease-out) 0.15s both;
  }
  .hero-stats {
    margin-top: clamp(1.25rem, 3vh, 2rem);
  }
  .stats-list {
    list-style: none;
    padding: 1rem 1.5rem;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.875rem 1rem;
    border: 1px solid var(--v3-border-hair);
    border-radius: var(--v3-radius-xl);
    background: color-mix(in srgb, var(--v3-surface-card) 92%, transparent);
    box-shadow: var(--v3-shadow-sm);
  }
  .stat-item {
    position: relative;
    padding-left: clamp(1rem, 2vw, 1.2rem);
    padding-right: clamp(0.25rem, 1vw, 0.5rem);
    font-family: var(--v3-font-body);
    font-size: clamp(0.9rem, 1vw, 0.98rem);
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--v3-ink);
    white-space: nowrap;
  }
  .stat-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 9999px;
    background: var(--v3-champagne);
    transform: translateY(-50%);
    opacity: 0.9;
  }

  @keyframes heroImageReveal {
    from {
      opacity: 0;
      transform: scale(1.17);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes heroImageFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.5rem);
    }
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.74fr);
      gap: clamp(2rem, 4vw, 3rem);
      align-items: center;
    }
    .hero-text {
      max-width: 38rem;
    }
    .hero-image {
      max-width: 28rem;
      margin-left: auto;
      padding-right: 0;
      align-self: center;
    }
    .hero-image-wrap { max-width: 28rem; }
    .hero-image-asset { transform: scale(1); }
  }
  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-text { max-width: var(--v3-hero-text-max); }
    .hero-image {
      max-width: 33rem;
      margin-inline: 0;
      align-self: start;
    }
    .hero-image-wrap { max-width: 33rem; }
  }
  @media (max-width: 560px) {
    .v3-hero {
      padding-top: 0.5rem;
      padding-bottom: 2rem;
    }
    .hero-grid {
      gap: 1.25rem;
      padding-top: 0.5rem;
    }
    .hero-text {
      gap: 1rem;
    }
    .hero-lead {
      max-width: none;
      font-size: 1rem;
    }
    .hero-stats {
      margin-top: 1.25rem;
    }
    .stats-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .stat-item {
      padding-left: 1rem;
      white-space: normal;
    }
    .stat-item::before,
    .stat-item + .stat-item::before {
      left: 0;
      top: 0.72em;
      transform: none;
    }
    .hero-cta { gap: 0.875rem; }
    .hero-cta .v3-btn {
      width: 100%;
      justify-content: center;
    }
    .cta-secondary {
      margin-top: 0.125rem;
    }
    .hero-h1 { font-size: clamp(2.125rem, 9.4vw, 2.625rem); }
    .hero-image {
      max-width: 100%;
      width: 100%;
      justify-content: flex-start;
      padding-right: 0;
    }
    .hero-image-wrap {
      max-width: none;
      width: min(100%, calc(100vw - (var(--v3-gutter) * 2)));
      aspect-ratio: 4 / 3;
      overflow: hidden;
    }
    .hero-image-asset {
      display: block;
      width: 100%;
      max-width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      transform: scale(1);
      transform-origin: center center;
    }
    .stat-item::before {
      content: '';
      position: absolute;
      width: 0.3125rem;
      height: 0.3125rem;
      border-radius: 9999px;
      background: var(--v3-champagne);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image-wrap,
    .hero-image-asset {
      animation: none;
    }
  }
</style>
