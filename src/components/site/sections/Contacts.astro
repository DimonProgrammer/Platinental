---
import { formatTypographyHtml } from '../../../lib/formatText';

const mapLat = '55.795720635738';
const mapLon = '49.128799438477';
const mapAddress = 'Казань, ул. Карла Маркса, 48, корп. 1';
const mapWidgetSrc = `https://yandex.ru/map-widget/v1/?ll=${mapLon}%2C${mapLat}&mode=search&ol=geo&ouri=ymapsbm1%3A%2F%2Fgeo%3Fdata%3DCgozODkyNjQyNzkxEknQoNC-0YHRgdC40Y8sINCa0LDQt9Cw0L3RjCwg0YPQu9C40YbQsCDQmtCw0YDQutC70LAg0JzQsNGA0LrRgdCwLCA0OCDQutC-0YDQv9GD0YEgMSIKDbULVkIVwe1C&pt=${mapLon}%2C${mapLat}%2Cpm2rdm&z=17`;
const mapRouteHref = `https://yandex.ru/maps/?ll=${mapLon}%2C${mapLat}&mode=search&pt=${mapLon},${mapLat}&text=${encodeURIComponent(mapAddress)}&z=17`;

const fields = [
  { mark: '—', label: 'Адрес', value: 'ул. Карла Маркса, 48, корп. 1<br />Казань, 420015' },
  { mark: '+', label: 'Телефоны', value: '<a href="tel:+78432236666" class="v3-link">+7 (843) 223-66-66</a>' },
  {
    mark: '→',
    label: 'Мессенджеры',
    value: '<a href="https://t.me/platinental_kazan" class="v3-link">Telegram</a> · <a href="https://max.ru" class="v3-link">Max</a> · <a href="https://wa.me/78432236666" class="v3-link">WhatsApp</a> · <a href="https://instagram.com/platinental_kazan" class="v3-link">Instagram*</a>',
  },
  { mark: '•', label: 'Режим работы', value: 'Ежедневно 09:00–20:00<br />Без выходных' },
];
---

<section class="v3-contacts v3-surface-cream" aria-labelledby="contacts-heading">
  <div class="v3-container v3-container-wide contacts-grid">
    <div class="contacts-text" data-v3-stagger>
      <span class="v3-eyebrow">Контакты</span>
      <h2 id="contacts-heading" class="v3-h2"><em>Как нас найти</em></h2>

      <dl class="contacts-list" data-v3-stagger>
        {fields.map((f) => (
          <div class="contact-row">
            <span class="v3-minimark contact-mark" aria-hidden="true">{f.mark}</span>
            <dt class="v3-eyebrow contact-label">{f.label}</dt>
            <dd class="contact-value v3-body" set:html={formatTypographyHtml(f.value)}></dd>
          </div>
        ))}
      </dl>

      <p class="v3-caption ig-note">
        * Instagram принадлежит компании Meta, признанной экстремистской и запрещённой на территории РФ.
      </p>
    </div>

    <div class="contacts-map" data-v3-reveal aria-label="Карта расположения клиники">
      <div class="contacts-map-frame">
        <div class="map-placeholder" aria-hidden="true">
          <span class="map-placeholder-label v3-eyebrow">Яндекс.Карта</span>
          <span class="map-placeholder-point"></span>
        </div>
        <iframe
          title="Карта The Platinental Казань"
          class="map-embed"
          src={mapWidgetSrc}
          data-map-src={mapWidgetSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <a
        href={mapRouteHref}
        target="_blank"
        rel="noopener"
        class="map-route v3-btn v3-btn-ghost"
      >
        Открыть карту →
      </a>
    </div>
  </div>
</section>

<style>
  .v3-contacts {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .contacts-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .contacts-text {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-h1-lead);
    max-width: 36rem;
  }

  .contacts-list {
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .contact-row {
    display: grid;
    grid-template-columns: 1.55rem 10.75rem minmax(0, 1fr);
    gap: 0.875rem 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--v3-border-hair);
    align-items: baseline;
  }
  .contact-row:last-child { border-bottom: 1px solid var(--v3-border-hair); }
  .contact-label { color: var(--v3-ink-muted); }
  .contact-value {
    margin: 0;
    font-family: var(--v3-font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--v3-ink);
  }
  .ig-note { color: var(--v3-ink-muted); margin-top: 1rem; text-transform: none; letter-spacing: 0.005em; font-family: var(--v3-font-body); font-size: 0.8125rem; }

  .contacts-map {
    width: 100%;
    aspect-ratio: 4/5;
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
  }
  .contacts-map-frame {
    position: absolute;
    inset: 0;
    border: 1px solid var(--v3-border-hair);
    border-radius: inherit;
    background: var(--v3-sand);
    overflow: hidden;
  }
  .map-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.75rem;
    background:
      linear-gradient(rgba(26,31,42,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(26,31,42,0.05) 1px, transparent 1px),
      var(--v3-sand);
    background-size: 2.25rem 2.25rem, 2.25rem 2.25rem, auto;
    transition: opacity 240ms var(--v3-ease-out);
  }
  .map-placeholder-label {
    color: var(--v3-ink-muted);
  }
  .map-placeholder-point {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    background: var(--v3-champagne-deep);
    box-shadow: 0 0 0 0.75rem rgba(145, 114, 113, 0.18);
  }
  .map-embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    opacity: 0;
    transition: opacity 240ms var(--v3-ease-out);
  }
  .contacts-map.is-ready .map-embed {
    opacity: 1;
  }
  .contacts-map.is-ready .map-placeholder {
    opacity: 0;
    pointer-events: none;
  }
  .map-route {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    font-size: 0.875rem;
    padding-block: 0.6rem;
    min-height: 44px;
    text-align: center;
    background: var(--v3-cream);
    z-index: 2;
  }

  @media (max-width: 1024px) {
    .contacts-grid { grid-template-columns: 1fr; }
    .contact-row {
      grid-template-columns: 1.55rem minmax(0, 1fr);
      grid-template-areas:
        'mark label'
        'mark value';
      gap: 0.25rem 0.75rem;
    }
    .contact-mark { grid-area: mark; }
    .contact-label { grid-area: label; }
    .contact-value { grid-area: value; }
  }
  @media (max-width: 560px) {
    .map-route {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      padding: 0.7rem 0.875rem;
      font-size: 0.8125rem;
      line-height: 1.2;
      white-space: normal;
    }
  }
</style>

<script is:inline>
  (() => {
    const initContactMaps = () => {
      document.querySelectorAll('.contacts-map').forEach((mapRoot) => {
        const frame = mapRoot.querySelector('.map-embed');
        if (!(mapRoot instanceof HTMLElement) || !(frame instanceof HTMLIFrameElement)) return;

        const markReady = () => mapRoot.classList.add('is-ready');
        if (frame.dataset.mapBound !== '1') {
          frame.dataset.mapBound = '1';
          frame.addEventListener('load', markReady);
        }
        if (frame.src) window.setTimeout(markReady, 900);
        if (!frame.src && frame.dataset.mapSrc) frame.src = frame.dataset.mapSrc;
      });
    };

    if (document.readyState !== 'loading') initContactMaps();
    else document.addEventListener('DOMContentLoaded', initContactMaps);
    document.addEventListener('astro:page-load', initContactMaps);
  })();
</script>
