---
---

<section class="v3-quote v3-surface-ink" aria-label="Принцип клиники" data-quote-bridge>
  <div class="quote-orbit" aria-hidden="true"></div>
  <div class="quote-inner v3-container v3-container-wide">
    <div class="quote-copy">
      <p class="quote-kicker-row">
        <span class="v3-minimark" aria-hidden="true">•</span>
        <span class="quote-kicker v3-eyebrow">Принцип</span>
      </p>

      <blockquote class="quote-text v3-display" data-quote-heading>
        <em>
          Сначала анатомия и пропорции.
          Потом — план операции или процедуры
        </em>
      </blockquote>

    </div>

    <figure class="quote-media" data-v3-reveal>
      <div class="quote-photo-frame">
        <img
          src="/quote/iskornev-portrait-2026.png"
          alt="Портрет Андрея Александровича Искорнева"
          class="quote-photo"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="quote-caption">
        <span class="quote-caption-name">Андрей Александрович Искорнев</span>
        <span class="quote-caption-role">Пластический хирург · основатель The Platinental Москва · один из учредителей The Platinental Казань · учредитель и главный специалист клиники MESOBAR (Лос-Анджелес)</span>
        <span class="quote-caption-role">Соавтор трёх зарегистрированных патентов</span>
        <div class="quote-actions">
          <button type="button" class="quote-cta quote-cta-primary" data-booking-open data-doctor="на консультацию Андрея Искорнева">
            Консультация <span aria-hidden="true">→</span>
          </button>
          <a href="/doctors/iskornev" class="quote-cta quote-cta-secondary">Подробнее</a>
        </div>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  function initQuoteBridgeCTA() {
    document.querySelectorAll<HTMLButtonElement>('[data-booking-open][data-doctor]').forEach((button) => {
      if (button.dataset.bookingBound === '1') return;
      button.dataset.bookingBound = '1';
      button.addEventListener('click', (event) => {
        event.preventDefault();
        const doctor = button.getAttribute('data-doctor') ?? undefined;
        window.dispatchEvent(new CustomEvent('open-booking', { detail: { doctor } }));
      });
    });
  }

  if (document.readyState !== 'loading') initQuoteBridgeCTA();
  else document.addEventListener('DOMContentLoaded', initQuoteBridgeCTA);
  document.addEventListener('astro:page-load', initQuoteBridgeCTA);
</script>

<style>
  .v3-quote {
    position: relative;
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    overflow: hidden;
  }
  .quote-orbit {
    position: absolute;
    inset: auto auto 8% 67%;
    width: clamp(18rem, 32vw, 34rem);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(251, 248, 244, 0.08);
    background:
      radial-gradient(circle at 50% 50%, rgba(145, 114, 113, 0.1) 0%, rgba(145, 114, 113, 0.04) 22%, rgba(145, 114, 113, 0) 68%);
    pointer-events: none;
    opacity: 0.9;
  }
  .quote-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(24rem, 0.78fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    min-height: clamp(30rem, 48vw, 42rem);
  }
  .quote-copy {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vw, 3rem);
    min-width: 0;
  }
  .quote-kicker {
    color: var(--v3-on-ink-muted);
    margin: 0;
  }
  .quote-kicker-row {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }
  .quote-text {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(2.2rem, 4.45vw, 4.05rem);
    line-height: 1.05;
    color: var(--v3-on-ink);
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  .quote-text .line {
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .quote-text .word {
    will-change: transform, opacity;
  }
  .hc-shell {
    position: relative;
    display: inline-block;
    padding-inline: 0.08em 0.14em;
    white-space: nowrap;
    --hc-reveal-scale: 0;
  }
  .hc-shell::before {
    content: '';
    position: absolute;
    inset: 0.12em 0 0.06em;
    background: linear-gradient(90deg, rgba(145, 114, 113, 0.22) 0%, rgba(145, 114, 113, 0.08) 100%);
    border-left: 1px solid rgba(145, 114, 113, 0.5);
    transform: scaleX(var(--hc-reveal-scale));
    transform-origin: left center;
  }
  .hc {
    position: relative;
    z-index: 1;
    font-style: normal;
    font-weight: 400;
    color: var(--v3-champagne);
    white-space: nowrap;
  }
  .hc sup {
    font-family: var(--v3-font-body);
    font-style: normal;
    font-size: 0.5em;
    vertical-align: super;
    margin-left: 0.05em;
  }
  .quote-footnote {
    color: var(--v3-on-ink-muted);
    max-width: 60ch;
    text-transform: none;
    letter-spacing: 0.005em;
    font-size: 0.875rem;
    font-family: var(--v3-font-body);
  }
  .quote-media {
    position: relative;
    margin: 0;
    justify-self: end;
    width: min(100%, 31rem);
    transform: translateY(0.25rem);
  }
  .quote-photo-frame {
    position: relative;
  }
  .quote-photo-frame::before {
    content: '';
    position: absolute;
    inset: -0.875rem 0.875rem 0.875rem -0.875rem;
    border: 1px solid rgba(251, 248, 244, 0.12);
    border-radius: calc(var(--v3-radius-xl) + 0.375rem);
    pointer-events: none;
  }
  .quote-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--v3-radius-xl);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.16);
  }
  .quote-caption {
    margin: 0;
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .quote-caption-name {
    color: var(--v3-on-ink);
    font-family: var(--v3-font-body);
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.35;
    letter-spacing: 0.01em;
  }
  .quote-caption-role {
    color: var(--v3-on-ink-muted);
    font-family: var(--v3-font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  .quote-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.9rem;
  }
  .quote-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.625rem 1rem;
    border: 1px solid rgba(251, 248, 244, 0.28);
    border-radius: var(--v3-radius-pill);
    font-family: var(--v3-font-body);
    font-size: 0.875rem;
    line-height: 1;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--v3-duration-fast) var(--v3-ease-out),
      background var(--v3-duration-fast) var(--v3-ease-out),
      border-color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .quote-cta-primary {
    background: var(--v3-on-ink);
    color: var(--v3-ink);
    border-color: var(--v3-on-ink);
  }
  .quote-cta-secondary {
    background: transparent;
    color: var(--v3-on-ink);
  }
  .quote-cta:hover,
  .quote-cta:focus-visible {
    background: var(--v3-on-ink);
    border-color: var(--v3-on-ink);
    color: #0a0a0a !important;
    outline: none;
    box-shadow: 0 0.75rem 1.75rem rgba(251, 248, 244, 0.16);
  }
  .quote-cta:hover *,
  .quote-cta:focus-visible * {
    color: #0a0a0a !important;
  }

  @media (max-width: 768px) {
    .v3-quote {
      padding-top: var(--v3-gap-medium);
      padding-bottom: var(--v3-gap-medium);
    }
    .quote-inner {
      grid-template-columns: 1fr;
      align-items: start;
      min-height: 0;
    }
    .quote-orbit {
      display: none;
    }
    .quote-media {
      width: min(100%, 20rem);
      justify-self: start;
      transform: none;
    }
    .quote-photo-frame::before {
      inset: -0.625rem 0.625rem 0.625rem -0.625rem;
    }
  }
</style>
