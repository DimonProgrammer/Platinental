---
import { formatCurrencyHtml } from '../../../lib/formatText';

interface FAQItem {
  q: string;
  a: string;
  open?: boolean;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  items?: FAQItem[];
}

const defaultItems: FAQItem[] = [
  {
    q: 'Сколько стоит первичная консультация?',
    a: 'У косметолога — <strong>2 000 ₽</strong>. У хирурга — от <strong>5 000 до 10 000 ₽</strong> в зависимости от специалиста.',
    open: true,
  },
  {
    q: 'Есть ли противопоказания к операциям?',
    a: 'Да. Противопоказания определяет хирург на очной консультации после осмотра и анализа анамнеза. Стандартные ограничения: беременность, лактация, онкология, нарушения свёртываемости крови, декомпенсированные хронические заболевания.',
  },
  {
    q: 'Через сколько дней виден результат после ботулинотерапии?',
    a: 'Первый эффект появляется через 3–5 дней, окончательный — через 10–14 дней. Держится 4–6 месяцев в зависимости от препарата и индивидуальных особенностей.',
  },
  {
    q: 'Вы работаете с мужчинами?',
    a: 'Да. Частые мужские запросы — ринопластика, коррекция гинекомастии, блефаропластика и подбородок. Врач учитывает мужскую анатомию и запрос на сдержанный результат.',
  },
  {
    q: 'Как проходит первичная консультация хирурга?',
    a: 'Осмотр, необходимые замеры, фотопротокол и обсуждение возможной тактики. Хирург объяснит ограничения и ответит на вопросы без давления.',
  },
  {
    q: 'Как долго длится реабилитация?',
    a: 'Зависит от операции. Блефаропластика — 7–14 дней. Ринопластика — 2–3 недели. Маммопластика — 2–4 недели ограничений. SMAS-лифтинг — 3–4 недели. Точные сроки хирург назовёт на консультации.',
  },
];

const {
  eyebrow = 'Вопросы',
  heading = 'Вопросы и ответы',
  items = defaultItems,
} = Astro.props;

const faqs = items;
---

<section class="v3-faq v3-surface-cream" aria-labelledby="faq-heading">
  <div class="v3-container v3-container-default">
    <header class="faq-header" data-v3-stagger>
      <span class="v3-eyebrow">{eyebrow}</span>
      <h2 id="faq-heading" class="v3-h2"><em>{heading}</em></h2>
    </header>

    <ol class="faq-list" data-v3-stagger>
      {faqs.map((f, i) => (
        <li class="faq-item">
          <details open={f.open}>
            <summary>
              <span class="faq-num v3-eyebrow">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-q">{f.q}</span>
              <span class="faq-marker" aria-hidden="true"></span>
            </summary>
            <div class="faq-a v3-body" set:html={formatCurrencyHtml(f.a)}></div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .v3-faq {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .faq-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
    margin-bottom: var(--v3-gap-small);
  }
  .faq-list { list-style: none; margin: 0; padding: 0; }
  .faq-item {
    border-top: 1px solid var(--v3-border-hair);
  }
  .faq-item:last-child { border-bottom: 1px solid var(--v3-border-hair); }
  .faq-item details { padding: 0; }
  .faq-item summary {
    display: grid;
    grid-template-columns: 3rem 1fr 2rem;
    gap: 1rem;
    align-items: baseline;
    padding-block: clamp(1.25rem, 2vw, 1.75rem);
    cursor: pointer;
    list-style: none;
    transition: background var(--v3-duration-fast) var(--v3-ease-out);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { background: var(--v3-cream-alt); }
  .faq-num { color: var(--v3-ink-muted); padding-top: 0.25rem; }
  .faq-q {
    font-family: var(--v3-font-body);
    font-weight: 400;
    font-size: clamp(1rem, 1.4vw, 1.1875rem);
    line-height: 1.4;
    color: var(--v3-ink);
  }
  .faq-marker {
    position: relative;
    width: 1.55rem;
    height: 1.55rem;
    justify-self: end;
    border: 1px solid var(--v3-border-soft);
    border-radius: 999px;
    transition: transform var(--v3-duration-base) var(--v3-ease-out);
  }
  .faq-marker::before,
  .faq-marker::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.65rem;
    height: 1px;
    background: var(--v3-ink-secondary);
    transform: translate(-50%, -50%);
    transition: transform var(--v3-duration-base) var(--v3-ease-out);
  }
  .faq-marker::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .faq-item details[open] .faq-marker {
    transform: none;
  }
  .faq-item details[open] .faq-marker::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .faq-a {
    padding: 0.5rem 0 1.5rem 4rem;
    max-width: 64ch;
  }
  .faq-a :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }
  .faq-a :global(a:hover) {
    color: inherit;
  }
  @media (max-width: 640px) {
    .faq-item summary { grid-template-columns: 2rem 1fr 1.5rem; gap: 0.75rem; }
    .faq-a { padding-left: 2.75rem; }
  }
</style>
