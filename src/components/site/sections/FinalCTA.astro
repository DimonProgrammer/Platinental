---
import { formatCurrencyHtml, formatTypographyHtml } from '../../../lib/formatText';

interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  submitLabel?: string;
}

const {
  eyebrow = 'Связь с клиникой',
  heading = 'Задайте вопрос<br />врачу',
  lead = 'Первая консультация — разговор без обязательств. Вы рассказываете о запросе, врач объясняет возможности. Приходите, поговорим.',
  submitLabel = 'Записаться на консультацию',
} = Astro.props;
---

<section id="form" class="v3-final v3-surface-ink" aria-labelledby="final-heading">
  <div class="v3-container v3-container-wide final-grid">
    <div class="final-text" data-v3-stagger>
      <span class="v3-eyebrow">{eyebrow}</span>
      <h2 id="final-heading" class="v3-h2 final-h2">
        <em set:html={formatTypographyHtml(heading)}></em>
      </h2>
      <p class="v3-lead final-lead" set:html={formatCurrencyHtml(lead)}></p>
      <p class="v3-small final-note">
        <span class="v3-minimark" aria-hidden="true">!</span>
        Отвечаем в рабочее время. Пн–Вс 9:00–20:00.
      </p>
      <ul class="final-channels" data-v3-stagger>
        <li><a href="tel:+78432236666" class="v3-link">+7 843 223-66-66</a></li>
        <li><a href="https://t.me/platinental_kazan" class="v3-link">Telegram</a></li>
        <li><a href="https://max.ru/u/f9LHodD0cOKLXxHeIK067LNPbNjsqlGF8qj74HK5vOo0CfBOPaTkNZmUAXI" class="v3-link">Max</a></li>
        <li><a href="https://wa.me/78432236666" class="v3-link">WhatsApp</a></li>
        <li><a href="https://instagram.com/platinental_kazan" class="v3-link">Instagram*</a></li>
      </ul>
      <p class="v3-caption instagram-note">
        * Instagram принадлежит компании Meta, признанной экстремистской и запрещённой на территории РФ.
      </p>
    </div>

    <form class="final-form" data-v3-stagger>
      <label class="field">
        <span class="field-label v3-eyebrow">Имя</span>
        <input
          type="text"
          name="name"
          required
          autocomplete="name"
          minlength="2"
          maxlength="60"
          pattern="[A-Za-zА-Яа-яЁё\\s\\-']{2,60}"
          placeholder="Как к вам обращаться"
        />
      </label>

      <label class="field">
        <span class="field-label v3-eyebrow">Телефон</span>
        <input
          type="tel"
          name="phone"
          required
          autocomplete="tel"
          inputmode="tel"
          maxlength="18"
          pattern="\\+7 \\([0-9]{3}\\) [0-9]{3}-[0-9]{2}-[0-9]{2}"
          placeholder="+7 (___) ___-__-__"
          data-phone-mask
        />
      </label>

      <label class="field">
        <span class="field-label v3-eyebrow">Опишите запрос (необязательно)</span>
        <textarea
          name="message"
          rows="4"
          maxlength="700"
          placeholder="Что интересует, какие операции рассматриваете, какие ожидания"
        ></textarea>
      </label>

      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span class="consent-text">
          Я согласен(а) на <a href="/consent" class="v3-link">обработку персональных данных</a>,
          ознакомлен(а) с <a href="/privacy" class="v3-link">политикой конфиденциальности</a>
          и <a href="/terms" class="v3-link">пользовательским соглашением</a>.
        </span>
      </label>

      <button type="submit" class="v3-btn v3-btn-primary final-submit">
        {submitLabel} <span aria-hidden="true">→</span>
      </button>
    </form>
  </div>
</section>

<script>
  function initFinalForms() {
    async function sendTelegramLead(payload: Record<string, unknown>) {
      const isVercelHost = window.location.hostname.endsWith('vercel.app');
      if (!isVercelHost) {
        fetch('/api/telegram-lead.php?store=1', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).catch(() => {});
      }

      const endpoints = isVercelHost
        ? ['/api/telegram-lead', '/api/telegram-lead.php']
        : [
            'https://platinental-kazan.vercel.app/api/telegram-lead',
            '/api/telegram-lead',
            '/api/telegram-lead.php',
          ];

      for (const endpoint of endpoints) {
        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (response.ok) return;
        } catch {}
      }

      throw new Error('telegram_lead_failed');
    }

    document.querySelectorAll<HTMLFormElement>('.final-form').forEach((form) => {
      if (form.dataset.finalBound === '1') return;
      form.dataset.finalBound = '1';
      const showResult = (status: 'success' | 'fallback') => {
        window.dispatchEvent(new CustomEvent('lead-notice', { detail: { status } }));
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const formData = new FormData(form);
        const name = String(formData.get('name') ?? '').trim();
        const phone = String(formData.get('phone') ?? '').trim();
        const message = String(formData.get('message') ?? '').trim();
        const consent = Boolean(formData.get('consent'));
        window.platinentalReachGoal?.('form_submit_consultation', { form: 'final_cta' });
        if (submit) {
          submit.dataset.defaultLabel = submit.textContent?.replace(/→/g, '').trim() || 'Отправить заявку';
          submit.disabled = true;
          submit.textContent = 'Отправляем заявку...';
        }

        try {
          await sendTelegramLead({
            source: 'Общая консультация',
            name,
            phone,
            message,
            consent,
            page: `${window.location.pathname}${window.location.search}`,
          });
          form.reset();
          showResult('success');
        } catch (error) {
          console.error('Telegram lead submit failed', error);
          showResult('fallback');
        } finally {
          window.setTimeout(() => {
            if (submit) {
              submit.disabled = false;
              submit.innerHTML = `${submit.dataset.defaultLabel ?? 'Отправить заявку'} <span aria-hidden="true">→</span>`;
            }
          }, 1600);
        }
      });
    });
  }

  if (document.readyState !== 'loading') initFinalForms();
  else document.addEventListener('DOMContentLoaded', initFinalForms);
  document.addEventListener('astro:page-load', initFinalForms);
</script>

<style>
  .v3-final {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }
  .final-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .final-text {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-h1-lead);
    max-width: 38rem;
  }
  .final-text .v3-eyebrow { margin-bottom: 0; color: var(--v3-on-ink-muted); }
  .final-h2 {
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    color: var(--v3-on-ink);
  }
  .final-lead { color: var(--v3-on-ink-secondary); max-width: 42ch; }
  .final-note { color: var(--v3-on-ink-muted); }
  .final-note {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .final-channels {
    list-style: none;
    margin: 0;
    padding: 1.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid var(--v3-border-on-ink);
  }
  .final-channels li {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }
  .final-channels li::before {
    content: '—';
    color: var(--v3-champagne);
  }
  .instagram-note {
    max-width: 34rem;
    margin: -0.5rem 0 0;
    color: var(--v3-on-ink-muted);
    text-transform: none;
    letter-spacing: 0.005em;
    font-family: var(--v3-font-body);
    font-size: 0.75rem;
    line-height: 1.45;
  }
  .final-channels a {
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: 1.25rem;
  }

  .final-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .field-label { color: var(--v3-on-ink-muted); }
  .field input,
  .field textarea {
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--v3-border-on-ink);
    padding: 0.875rem 0;
    min-height: 48px;
    color: var(--v3-on-ink);
    font-family: var(--v3-font-body);
    font-size: 16px; /* iOS не зумит при фокусе ≥ 16px */
    line-height: 1.5;
    transition: border-color var(--v3-duration-fast) var(--v3-ease-out);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--v3-champagne);
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--v3-on-ink-muted);
  }
  .field textarea {
    resize: vertical;
    min-height: 6rem;
  }
  .consent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    color: var(--v3-on-ink-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    cursor: pointer;
    padding-block: 0.25rem; /* увеличить tap-зону на label */
  }
  .consent-text { padding-top: 0.125rem; }
  .consent-text .v3-link {
    display: inline;
    min-height: 0;
    padding: 0 0 0.12em;
    line-height: inherit;
    vertical-align: baseline;
    background-position: 0 100%;
  }
  .consent-text .v3-link::after {
    bottom: 0;
  }
  .consent input {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin: 0;
    accent-color: var(--v3-champagne);
    cursor: pointer;
  }
  .final-submit {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  @media (max-width: 1024px) {
    .final-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .v3-final {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
    .final-grid {
      gap: 2.25rem;
    }
    .final-text {
      gap: 1rem;
    }
    .final-text .v3-eyebrow,
    .final-note,
    .instagram-note,
    .field-label {
      color: color-mix(in srgb, var(--v3-on-ink) 84%, transparent);
    }
    .final-h2 {
      font-size: clamp(2rem, 10vw, 2.75rem);
    }
    .final-lead,
    .consent {
      color: color-mix(in srgb, var(--v3-on-ink) 92%, transparent);
    }
    .final-channels {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-top: 1rem;
    }
    .final-channels li::before {
      content: none;
    }
    .final-channels a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem 0.875rem;
      border: 1px solid color-mix(in srgb, var(--v3-on-ink) 22%, transparent);
      border-radius: var(--v3-radius-pill);
      color: var(--v3-on-ink);
      font-family: var(--v3-font-body);
      font-size: 0.9375rem;
    }
    .final-form {
      gap: 1.125rem;
    }
    .field input::placeholder,
    .field textarea::placeholder {
      color: color-mix(in srgb, var(--v3-on-ink) 74%, transparent);
    }
    .consent {
      min-height: 44px;
      padding-block: 0.375rem;
      font-size: 0.75rem;
      line-height: 1.42;
    }
    .consent input {
      width: 24px;
      height: 24px;
      margin-top: 0.125rem;
    }
    .final-submit {
      width: 100%;
      min-height: 52px;
      justify-content: center;
      align-self: stretch;
    }
  }
</style>
