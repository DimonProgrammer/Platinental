---
---

<section
  class="v3-quiz-modal"
  id="consultation-quiz"
  data-quiz-modal
  role="dialog"
  aria-modal="true"
  aria-labelledby="quiz-heading"
  hidden
>
  <button class="quiz-backdrop" type="button" data-quiz-close aria-label="Закрыть навигатор консультации"></button>
  <div class="quiz-modal-panel" role="document" data-lenis-prevent data-lenis-prevent-wheel data-lenis-prevent-touch>
    <button class="quiz-close" type="button" data-quiz-close aria-label="Закрыть">
      <span aria-hidden="true">×</span>
    </button>

    <div class="quiz-layout">
      <div class="quiz-copy">
        <span class="v3-eyebrow">Опросник перед консультацией</span>
        <h2 id="quiz-heading" class="v3-h2 quiz-heading">
          <em>Навигатор консультации</em>
        </h2>
        <p class="v3-lead quiz-lead">
          Короткий опрос перед записью: зона, сроки, ожидания и вопросы для врача.
        </p>

        <div class="quiz-principles" aria-label="Что даст опросник">
          <div class="quiz-principle">
            <span class="quiz-principle-mark" aria-hidden="true">?</span>
            <span>01</span>
            <p>Опишете, что беспокоит, без медицинских терминов.</p>
          </div>
          <div class="quiz-principle">
            <span class="quiz-principle-mark" aria-hidden="true">✓</span>
            <span>02</span>
            <p>Получите список того, что подготовить к визиту.</p>
          </div>
          <div class="quiz-principle">
            <span class="quiz-principle-mark" aria-hidden="true">→</span>
            <span>03</span>
            <p>Сможете отправить ответы администратору.</p>
          </div>
        </div>
      </div>

      <div class="quiz-shell" data-consultation-quiz>
      <div class="quiz-step" data-quiz-step>
        <div class="quiz-topline">
          <span class="v3-caption" data-quiz-count>Вопрос 1 из 5</span>
          <span class="v3-caption" data-quiz-percent>20%</span>
        </div>
        <div class="quiz-progress" aria-hidden="true">
          <span data-quiz-progress></span>
        </div>

        <div class="quiz-question">
          <h3 class="v3-h3" data-quiz-question></h3>
          <p class="v3-body" data-quiz-helper></p>
        </div>

        <div class="quiz-options" data-quiz-options></div>

        <aside class="quiz-learning" aria-label="Полезная подсказка">
          <span class="v3-eyebrow">Полезно знать</span>
          <p class="v3-body" data-quiz-lesson></p>
          <ul data-quiz-checklist></ul>
        </aside>

        <div class="quiz-controls">
          <button type="button" class="quiz-nav quiz-nav-secondary" data-quiz-back disabled>
            Назад
          </button>
          <button type="button" class="v3-btn v3-btn-primary" data-quiz-next disabled>
            Далее <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>

      <div class="quiz-result" data-quiz-result hidden>
        <span class="v3-eyebrow">Предварительный план</span>
        <h3 class="v3-h3 quiz-result-title">
          Ответы готовы к передаче администратору
        </h3>
        <p class="v3-body" data-quiz-result-lead></p>
        <ul class="quiz-result-list" data-quiz-result-list></ul>

        <form class="quiz-contact-form" data-quiz-contact-form>
          <label class="quiz-field">
            <span class="v3-eyebrow">Имя</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              minlength="2"
              maxlength="60"
              pattern="[A-Za-zА-Яа-яЁё\\s\\-']{2,60}"
              placeholder="Как к вам обращаться"
            />
          </label>

          <label class="quiz-field">
            <span class="v3-eyebrow">Телефон</span>
            <input
              type="tel"
              name="phone"
              required
              autocomplete="tel"
              inputmode="tel"
              maxlength="18"
              pattern="\\+7 \\([0-9]{3}\\) [0-9]{3}-[0-9]{2}-[0-9]{2}"
              placeholder="+7 (___) ___-__-__"
              data-phone-mask
            />
          </label>

          <label class="quiz-consent">
            <input type="checkbox" name="consent" required />
            <span>
              Я согласен(а) на <a href="/consent" class="v3-link">обработку персональных данных</a>.
            </span>
          </label>

          <label class="quiz-consent">
            <input type="checkbox" name="legalConsent" required />
            <span>
              Я ознакомлен(а) с <a href="/privacy" class="v3-link">политикой конфиденциальности</a>
              и <a href="/terms" class="v3-link">пользовательским соглашением</a>.
            </span>
          </label>

          <button type="submit" class="v3-btn v3-btn-primary">
            Передать ответы администратору <span aria-hidden="true">→</span>
          </button>
        </form>

        <p class="v3-caption quiz-disclaimer">
          Итоговые медицинские рекомендации врач даст после осмотра.
        </p>

        <button type="button" class="quiz-restart" data-quiz-restart>
          Пройти ещё раз
        </button>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  type QuizOption = {
    label: string;
    value: string;
  };

  type QuizStep = {
    question: string;
    helper: string;
    lesson: string;
    checklist: string[];
    options: QuizOption[];
  };

  const quizSteps: QuizStep[] = [
    {
      question: 'Что хотите обсудить с врачом?',
      helper: 'Выберите зону или ситуацию, которая сейчас беспокоит.',
      lesson: 'На консультации можно говорить простыми словами: что изменилось, что мешает и какого результата вы ждёте. Врач предложит возможные варианты после осмотра.',
      checklist: ['Отметьте зону, которая беспокоит чаще всего.', 'Если есть фото в разные периоды, покажите их врачу.'],
      options: [
        { label: 'Лицо, веки, овал или шея', value: 'face' },
        { label: 'Грудь, живот или контуры тела', value: 'body' },
        { label: 'Кожа, качество, тонус', value: 'skin' },
        { label: 'Пока не понимаю, нужен взгляд врача', value: 'unknown' },
      ],
    },
    {
      question: 'Насколько понятна задача?',
      helper: 'Так администратор подберёт подходящий формат консультации.',
      lesson: 'Если вы не знаете название процедуры, это нормально. Достаточно описать зону, прошлый опыт и желаемые изменения.',
      checklist: ['Подготовьте 2-3 своих фото в спокойном свете.', 'Запишите, что хочется сохранить неизменным.'],
      options: [
        { label: 'Есть конкретная зона и вопросы', value: 'specific' },
        { label: 'Есть примеры результата, но нет уверенности', value: 'references' },
        { label: 'Хочу сравнить несколько вариантов', value: 'compare' },
        { label: 'Нужна вторая точка зрения', value: 'second-opinion' },
      ],
    },
    {
      question: 'Есть ли важные сроки?',
      helper: 'Сроки влияют на план, восстановление и очередность этапов.',
      lesson: 'Не все эстетические задачи стоит привязывать к событию. Иногда безопаснее спланировать этапы и оставить запас на восстановление.',
      checklist: ['Сообщите врачу о поездках, событиях и рабочем графике.', 'Уточните, какой срок восстановления для вас неприемлем.'],
      options: [
        { label: 'Хочу успеть к событию', value: 'event' },
        { label: 'Готов(а) планировать спокойно', value: 'calm' },
        { label: 'Нужен вариант без долгого восстановления', value: 'low-downtime' },
        { label: 'Пока сроков нет', value: 'no-deadline' },
      ],
    },
    {
      question: 'Какой формат решения вам ближе?',
      helper: 'Ответ не фиксирует выбор. Он помогает врачу объяснить варианты понятнее.',
      lesson: 'Иногда лучший план начинается с косметологии, иногда с хирургии, а иногда с отказа от лишнего вмешательства.',
      checklist: ['Не скрывайте прошлые процедуры и операции.', 'Скажите, готовы ли вы к этапному плану.'],
      options: [
        { label: 'Сначала хочу мягкий косметологический путь', value: 'cosmetology-first' },
        { label: 'Рассматриваю хирургическое решение', value: 'surgery' },
        { label: 'Хочу сравнить хирургию и косметологию', value: 'compare-format' },
        { label: 'Не знаю, что мне подходит', value: 'format-unknown' },
      ],
    },
    {
      question: 'Как вы хотите описать желаемый результат?',
      helper: 'Так врачу проще отличить натуральную коррекцию от заметного изменения.',
      lesson: 'Результат полезно описывать словами про ощущение: свежее, мягче, собраннее, естественнее. Врач переведёт это в медицинский план.',
      checklist: ['Сформулируйте “что должно остаться моим”.', 'Отдельно отметьте страхи: заметность, боль, восстановление, стоимость.'],
      options: [
        { label: 'Натурально, чтобы никто не понял', value: 'natural' },
        { label: 'Заметная, но гармоничная коррекция', value: 'visible' },
        { label: 'Хочу убрать возрастные изменения', value: 'age' },
        { label: 'Хочу восстановить форму после изменений', value: 'restore' },
      ],
    },
  ];

  function initConsultationQuiz() {
    const modal = document.querySelector<HTMLElement>('[data-quiz-modal]');
    const root = document.querySelector<HTMLElement>('[data-consultation-quiz]');
    if (!root || root.dataset.quizBound === '1') return;
    root.dataset.quizBound = '1';

    const closeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-quiz-close]'));
    const openButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-quiz-open]'));
    const panel = modal?.querySelector<HTMLElement>('.quiz-modal-panel');
    const stepView = root.querySelector<HTMLElement>('[data-quiz-step]');
    const resultView = root.querySelector<HTMLElement>('[data-quiz-result]');
    const countEl = root.querySelector<HTMLElement>('[data-quiz-count]');
    const percentEl = root.querySelector<HTMLElement>('[data-quiz-percent]');
    const progressEl = root.querySelector<HTMLElement>('[data-quiz-progress]');
    const questionEl = root.querySelector<HTMLElement>('[data-quiz-question]');
    const helperEl = root.querySelector<HTMLElement>('[data-quiz-helper]');
    const optionsEl = root.querySelector<HTMLElement>('[data-quiz-options]');
    const lessonEl = root.querySelector<HTMLElement>('[data-quiz-lesson]');
    const checklistEl = root.querySelector<HTMLElement>('[data-quiz-checklist]');
    const backBtn = root.querySelector<HTMLButtonElement>('[data-quiz-back]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-quiz-next]');
    const restartBtn = root.querySelector<HTMLButtonElement>('[data-quiz-restart]');
    const resultForm = root.querySelector<HTMLFormElement>('[data-quiz-contact-form]');
    const resultLead = root.querySelector<HTMLElement>('[data-quiz-result-lead]');
    const resultList = root.querySelector<HTMLElement>('[data-quiz-result-list]');

    let current = 0;
    const answers: Array<QuizOption | null> = Array(quizSteps.length).fill(null);
    let lastFocus: HTMLElement | null = null;
    const sessionKey = 'platinental_quiz_shown_session';
    const dismissKey = 'platinental_quiz_dismissed_until';
    const cookieConsentKey = 'platinental_cookie_consent_v1';
    const dismissedUntil = () => Number(window.localStorage.getItem(dismissKey) ?? '0');
    const hasCookieChoice = () => {
      try {
        const value = window.localStorage.getItem(cookieConsentKey);
        return value === 'all' || value === 'essential';
      } catch {
        return false;
      }
    };

    async function sendTelegramLead(payload: Record<string, unknown>) {
      const isVercelHost = window.location.hostname.endsWith('vercel.app');
      if (!isVercelHost) {
        fetch('/api/telegram-lead.php?store=1', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).catch(() => {});
      }

      const endpoints = isVercelHost
        ? ['/api/telegram-lead', '/api/telegram-lead.php']
        : [
            'https://platinental-kazan.vercel.app/api/telegram-lead',
            '/api/telegram-lead',
            '/api/telegram-lead.php',
          ];

      for (const endpoint of endpoints) {
        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (response.ok) return;
        } catch {}
      }

      throw new Error('telegram_lead_failed');
    }

    const scrollToQuiz = (target: HTMLElement | null = root) => {
      if (modal && !modal.hidden) {
        window.requestAnimationFrame(() => {
          panel?.scrollTo({ top: 0, behavior: 'smooth' });
        });
        return;
      }
      if (window.innerWidth > 760) return;
      window.requestAnimationFrame(() => {
        target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    };

    const openModal = (source = 'manual') => {
      if (!modal || !modal.hidden) return;
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      modal.hidden = false;
      modal.dataset.openSource = source;
      document.documentElement.classList.add('quiz-modal-lock');
      if (panel) panel.scrollTop = 0;
      window.sessionStorage.setItem(sessionKey, '1');
      window.requestAnimationFrame(() => {
        modal.querySelector<HTMLElement>('[data-quiz-close]')?.focus();
      });
    };

    const closeModal = (remember = true) => {
      if (!modal || modal.hidden) return;
      modal.hidden = true;
      document.documentElement.classList.remove('quiz-modal-lock');
      if (remember) {
        const sevenDays = 7 * 24 * 60 * 60 * 1000;
        window.localStorage.setItem(dismissKey, String(Date.now() + sevenDays));
      }
      lastFocus?.focus?.();
    };

    const render = () => {
      const step = quizSteps[current];
      const percent = Math.round(((current + 1) / quizSteps.length) * 100);

      if (countEl) countEl.textContent = `Вопрос ${current + 1} из ${quizSteps.length}`;
      if (percentEl) percentEl.textContent = `${percent}%`;
      if (progressEl) progressEl.style.width = `${percent}%`;
      if (questionEl) questionEl.textContent = step.question;
      if (helperEl) helperEl.textContent = step.helper;
      if (lessonEl) lessonEl.textContent = step.lesson;

      if (checklistEl) {
        checklistEl.textContent = '';
        step.checklist.forEach((item) => {
          const li = document.createElement('li');
          li.textContent = item;
          checklistEl.append(li);
        });
      }

      if (optionsEl) {
        optionsEl.textContent = '';
        step.options.forEach((option) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'quiz-option';
          button.textContent = option.label;
          button.dataset.value = option.value;
          button.setAttribute('aria-pressed', answers[current]?.value === option.value ? 'true' : 'false');
          button.addEventListener('click', () => {
            answers[current] = option;
            optionsEl.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach((b) => {
              b.setAttribute('aria-pressed', b.dataset.value === option.value ? 'true' : 'false');
            });
            if (nextBtn) nextBtn.disabled = false;
          });
          optionsEl.append(button);
        });
      }

      if (backBtn) backBtn.disabled = current === 0;
      if (nextBtn) {
        nextBtn.disabled = !answers[current];
        nextBtn.innerHTML = current === quizSteps.length - 1
          ? 'Собрать ответы <span aria-hidden="true">→</span>'
          : 'Далее <span aria-hidden="true">→</span>';
      }
    };

    const buildResult = () => {
      const selected = answers.filter(Boolean) as QuizOption[];
      const values = selected.map((answer) => answer.value);
      const isSurgery = values.includes('surgery') || values.includes('body');
      const isSkin = values.includes('skin') || values.includes('cosmetology-first');
      const isUnclear = values.includes('unknown') || values.includes('format-unknown');

      const route = isUnclear
        ? 'Начните с обзорной консультации: врач поможет понять, с чего начать и какие варианты уместны.'
        : isSurgery
          ? 'Вам подойдёт консультация хирурга с обсуждением сроков, восстановления и альтернатив.'
        : isSkin
            ? 'Логично начать с косметологического осмотра и плана по качеству кожи.'
            : 'Вам подойдёт консультация, где врач сравнит несколько спокойных вариантов.';

      const list = [
        'Администратор свяжется и обсудит ответы перед записью.',
        'Запишите сроки, события и ограничения по восстановлению.',
        'Медицинские рекомендации врач даст после осмотра.',
      ];

      if (resultLead) resultLead.textContent = `${route} Оставьте контакт — администратор получит ответы и свяжется в рабочее время.`;
      if (resultList) {
        resultList.textContent = '';
        list.forEach((item) => {
          const li = document.createElement('li');
          li.textContent = item;
          resultList.append(li);
        });
      }
      if (stepView) stepView.hidden = true;
      if (resultView) resultView.hidden = false;
      scrollToQuiz(resultView);
    };

    nextBtn?.addEventListener('click', () => {
      if (!answers[current]) return;
      if (current === quizSteps.length - 1) {
        buildResult();
        return;
      }
      current += 1;
      render();
      scrollToQuiz(stepView);
    });

    backBtn?.addEventListener('click', () => {
      if (current === 0) return;
      current -= 1;
      render();
      scrollToQuiz(stepView);
    });

    restartBtn?.addEventListener('click', () => {
      current = 0;
      answers.fill(null);
      if (stepView) stepView.hidden = false;
      if (resultView) resultView.hidden = true;
      render();
      scrollToQuiz(stepView);
    });

    resultForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = resultForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      const formData = new FormData(resultForm);
      const name = String(formData.get('name') ?? '').trim();
      const phone = String(formData.get('phone') ?? '').trim();
      const consent = Boolean(formData.get('consent'));
      const legalConsent = Boolean(formData.get('legalConsent'));
      const shortAnswers = quizSteps.map((step, index) => ({
        question: step.question,
        answer: answers[index]?.label ?? 'не выбрано',
      }));

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Отправляем заявку...';
      }
      window.platinentalReachGoal?.('form_submit_consultation', { form: 'consultation_quiz' });

      try {
        await sendTelegramLead({
          source: 'Навигатор консультации',
          name,
          phone,
          consent,
          legalConsent,
          answers: shortAnswers,
          page: `${window.location.pathname}${window.location.search}`,
        });
        resultForm.reset();
        closeModal(false);
        window.dispatchEvent(new CustomEvent('lead-notice', { detail: { status: 'success' } }));
      } catch (error) {
        console.error('Telegram lead submit failed', error);
        closeModal(false);
        window.dispatchEvent(new CustomEvent('lead-notice', { detail: { status: 'fallback' } }));
      } finally {
        window.setTimeout(() => {
          if (submit) {
            submit.disabled = false;
            submit.innerHTML = 'Передать ответы администратору <span aria-hidden="true">→</span>';
          }
        }, 1600);
      }
    });

    openButtons.forEach((button) => {
      if (button.dataset.quizOpenBound === '1') return;
      button.dataset.quizOpenBound = '1';
      button.addEventListener('click', (event) => {
        event.preventDefault();
        openModal('button');
      });
    });

    closeButtons.forEach((button) => {
      if (button.dataset.quizCloseBound === '1') return;
      button.dataset.quizCloseBound = '1';
      button.addEventListener('click', () => closeModal(true));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal && !modal.hidden) closeModal(true);
    });

    const openTimerModal = () => {
      if (!modal || window.location.pathname !== '/') return;
      if (window.sessionStorage.getItem(sessionKey) === '1') return;
      if (Date.now() < dismissedUntil()) return;
      if (document.hidden) return;
      if (!hasCookieChoice()) return;
      openModal('timer');
    };

    window.setTimeout(openTimerModal, 30000);
    document.addEventListener('platinental:cookie-consent-updated', openTimerModal);

    render();
  }

  if (document.readyState !== 'loading') initConsultationQuiz();
  else document.addEventListener('DOMContentLoaded', initConsultationQuiz);
  document.addEventListener('astro:page-load', initConsultationQuiz);
</script>

<style>
  .v3-quiz-modal[hidden] {
    display: none;
  }

  .v3-quiz-modal {
    position: fixed;
    inset: 0;
    z-index: calc(var(--v3-z-overlay) + 20);
    display: grid;
    place-items: center;
    padding: clamp(1rem, 3vw, 2rem);
    overflow: hidden;
  }

  :global(.quiz-modal-lock) {
    overflow: hidden;
  }

  .quiz-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: color-mix(in srgb, var(--v3-ink) 52%, transparent);
    cursor: pointer;
  }

  .quiz-modal-panel {
    position: relative;
    z-index: 1;
    width: min(72rem, 100%);
    max-height: min(calc(100dvh - clamp(2rem, 6vw, 4rem)), 54rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--v3-border-soft);
    border-radius: var(--v3-radius-xl);
    background: var(--v3-surface-card);
    box-shadow: 0 2rem 6rem color-mix(in srgb, var(--v3-ink) 24%, transparent);
  }

  .quiz-close {
    position: sticky;
    top: 0;
    z-index: 2;
    float: right;
