---
const doctors = [
  {
    slug: 'babayan',
    eyebrow: 'MIBRAR · Регенеративная медицина',
    name: 'Бабаян Арсен Викторович',
    degree: 'Д.М.Н., профессор',
    credential: 'Нейрохирург, травматолог-ортопед, д.м.н., профессор',
    body: 'Основатель метода MIBRAR. Регенеративный подход на стыке косметологии, пластической хирургии и ортопедии; основная специализация — позвоночник, суставы и последствия травм.',
    articleUrl: 'https://www.tatar-inform.ru/news/lecat-kletki-tela-a-ne-protez-kak-proryvnoi-metod-ortopedii-spasaet-iznosennye-sustavy-6017202',
    articleLabel: 'Интервью — Tatar-inform',
  },
  {
    slug: 'meloyan',
    eyebrow: 'Эстетическая и реконструктивная хирургия',
    name: 'Мелоян Мхитар Мисакович',
    degree: 'Пластический хирург',
    credential: 'Ринопластика, реконструктивная хирургия и миниинвазивная флебология',
    body: 'Широкая хирургическая база: эстетическая пластическая, челюстно-лицевая и сосудистая хирургия. Работает с формой, функцией и восстановлением в ринопластике, хирургии лица и молочных желёз.',
    articleUrl: null,
    articleLabel: null,
  },
];
---

<section class="v3-featured v3-surface-cream" aria-labelledby="featured-heading">
  <div class="v3-container v3-container-wide">
    <header class="featured-header" data-v3-stagger>
      <span class="v3-eyebrow">Врачи</span>
      <h2 id="featured-heading" class="v3-h2"><em>Признание и опыт</em></h2>
    </header>

    <div class="featured-grid" data-v3-stagger>
      {doctors.map((d) => (
        <article class="featured-card">
          <span class="featured-eyebrow v3-eyebrow">{d.eyebrow}</span>
          <div class="featured-credential">{d.credential}</div>
          <div class="featured-name-row">
            <span class="featured-name">{d.name}</span>
            <span class="featured-degree v3-caption">{d.degree}</span>
          </div>
          <p class="featured-body v3-body">{d.body}</p>
          <div class="featured-links">
            <a href={`/doctors/${d.slug}`} class="v3-btn v3-btn-ghost featured-btn">
              Страница врача
            </a>
            {d.articleUrl && (
              <a
                href={d.articleUrl}
                target="_blank"
                rel="noopener"
                class="v3-link featured-article-link"
              >
                {d.articleLabel}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .v3-featured {
    padding-top: var(--v3-gap-deep);
    padding-bottom: var(--v3-gap-deep);
  }

  .featured-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--v3-border-hair);
    border-bottom: 1px solid var(--v3-border-hair);
  }

  .featured-card:first-child {
    border-right: 1px solid var(--v3-border-hair);
    padding-left: 0;
  }

  .featured-card:last-child {
    padding-right: 0;
  }

  .featured-eyebrow {
    color: var(--v3-champagne-deep);
  }

  .featured-credential {
    font-family: var(--v3-font-display);
    font-weight: 300;
    font-size: clamp(1.375rem, 2.5vw, 2rem);
    line-height: 1.2;
    color: var(--v3-ink);
    max-width: 22ch;
  }

  .featured-name-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--v3-border-soft);
  }

  .featured-name {
    font-family: var(--v3-font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--v3-ink);
  }

  .featured-degree {
    color: var(--v3-ink-muted);
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .featured-body {
    color: var(--v3-ink-muted);
    max-width: 42ch;
    margin: 0;
  }

  .featured-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .featured-btn {
    font-size: 0.875rem;
    padding-block: 0.6rem;
  }

  .featured-article-link {
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .featured-card:first-child {
      border-right: none;
      border-bottom: none;
      padding-left: 0;
      padding-bottom: clamp(2rem, 4vw, 3rem);
    }

    .featured-card:last-child {
      padding-right: 0;
      padding-top: clamp(2rem, 4vw, 3rem);
    }
  }
</style>
