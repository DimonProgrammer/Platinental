---
import { doctors } from '../../../data/doctors';
import { formatTypographyHtml } from '../../../lib/formatText';
import type { Doctor } from '../../../data/doctors';

const babayan = doctors.find((d) => d.slug === 'babayan')!;
const featuredSlugs = ['meloyan', 'mamedov', 'vasilev'];
const featured = featuredSlugs
  .map((slug) => doctors.find((d) => d.slug === slug))
  .filter((doctor): doctor is Doctor => Boolean(doctor));

const homeDoctorCopy: Record<string, { spec: string; credential?: string; short: string }> = {
  babayan: {
    spec: 'НЕЙРОХИРУРГ · ТРАВМАТОЛОГ-ОРТОПЕД · Д.М.Н.',
    credential: 'Профессор · основатель метода MIBRAR',
    short: 'Работает с позвоночником, суставами, последствиями травм и сложными клиническими случаями. На консультации врач изучает снимки, диагноз и состояние тканей, затем объясняет, какой план восстановления возможен в конкретном случае.',
  },
  meloyan: {
    spec: 'ЭСТЕТИЧЕСКАЯ И РЕКОНСТРУКТИВНАЯ ХИРУРГИЯ',
    short: 'Эстетическая и реконструктивная пластическая хирургия. Основные направления — ринопластика, риносептопластика, эстетическая хирургия молочных желёз и реконструктивные задачи.',
  },
  mamedov: {
    spec: 'РИНОПЛАСТИКА · ХИРУРГИЯ ЛИЦА · ШЕИ И ВЕК',
    short: 'Работает с эстетической и функциональной хирургией лица: ринопластикой, риносептопластикой, операциями на лицевом скелете, веках и шее. В сложных случаях учитывает дыхание, анатомию и последствия предыдущих вмешательств.',
  },
  vasilev: {
    spec: 'К.М.Н. · ХИРУРГИЯ ЛИЦА · ГРУДИ И ТЕЛА',
    short: 'Кандидат медицинских наук, соавтор четырёх зарегистрированных патентов. Работает с пластикой лица, груди и тела',
  },
};

const babayanCopy = homeDoctorCopy.babayan;
const featuredCards = featured.map((doctor) => ({
  doctor,
  copy: homeDoctorCopy[doctor.slug],
}));
---

<section class="v3-doctors" aria-labelledby="doctors-heading">
  <div class="v3-surface-cream doctors-top">
    <div class="v3-container v3-container-wide">
      <header class="doctors-header" data-v3-stagger>
        <span class="v3-eyebrow">Команда</span>
        <h2 id="doctors-heading" class="v3-h2"><em>Врачи клиники</em></h2>
        <p class="doctors-proof v3-body">
          В команде клиники — хирурги с научной работой, авторскими разработками и зарегистрированными патентами. Подробности указаны на страницах конкретных врачей.
        </p>
      </header>
    </div>
  </div>

  <div class="v3-surface-cream babayan-wrap" data-v3-reveal>
    <div class="v3-container v3-container-wide">
      <article class="babayan-card">
        <a class="babayan-overlay" href={`/doctors/${babayan.slug}`} aria-label={`Подробнее — ${babayan.name}`}></a>
        <div class="babayan-photo-column">
          <div class="babayan-photo">
            {babayan.photo
              ? <img
                  src={babayan.photo}
                  alt={babayan.name}
                  loading="lazy"
                  class="babayan-img"
                  style={`--doctor-photo-scale:${babayan.photoFrame?.scale ?? 1.12}; --doctor-photo-x:${babayan.photoFrame?.x ?? '0%'}; --doctor-photo-y:${babayan.photoFrame?.y ?? '-3%'};`}
                />
              : <span class="babayan-initials">{babayan.initials}</span>}
          </div>
        </div>

        <div class="babayan-main">
          <h3 class="babayan-name"><em>{babayan.name}</em></h3>
          <p class="babayan-spec">{babayanCopy.spec}</p>

          <div class="babayan-accent">
            <span class="v3-minimark" aria-hidden="true">+</span>
            <p class="babayan-credential">
              <span>Профессор · </span>
              <span class="mibrar-credential">
                основатель метода MIBRAR
                <span class="mibrar-tooltip">
                  <button
                    type="button"
                    class="mibrar-tooltip-trigger"
                    aria-describedby="mibrar-tooltip"
                    aria-label="Что такое метод MIBRAR"
                  >
                    ?
                  </button>
                  <span id="mibrar-tooltip" class="mibrar-tooltip-content" role="tooltip">
                    MIBRAR — регенеративный метод, при котором через микроинвазивный доступ врач работает с зоной повреждения и использует собственные биоматериалы пациента для поддержки восстановления тканей.
                  </span>
                </span>
              </span>
            </p>
          </div>

          <p class="v3-body babayan-body" set:html={formatTypographyHtml(babayanCopy.short)}></p>

          <div class="babayan-actions">
            <button
              type="button"
              class="v3-btn v3-btn-primary"
              data-booking-open
              data-doctor={babayan.nameBtn}
            >
              Записаться к врачу
            </button>
            <a href={`/doctors/${babayan.slug}`} class="babayan-link">Подробнее о враче →</a>
          </div>
        </div>
      </article>
    </div>
  </div>

  <div class="v3-surface-cream rest-wrap">
    <div class="v3-container v3-container-wide">
      <ol class="doctors-grid" data-v3-stagger>
        {featuredCards.map(({ doctor: d, copy }) => (
          <li class="doctor">
            <a class="doctor-overlay" href={`/doctors/${d.slug}`} aria-label={`Подробнее — ${d.name}`}></a>

            <div class="doctor-image">
              {d.photo
                ? <img
                    src={d.photo}
                    alt={d.name}
                    width="400"
                    height="400"
                    loading="lazy"
                    style={`--doctor-photo-scale:${d.photoFrame?.scale ?? 1.12}; --doctor-photo-x:${d.photoFrame?.x ?? '0%'}; --doctor-photo-y:${d.photoFrame?.y ?? '-3%'};`}
                  />
                : <span class="doctor-initials" aria-hidden="true">{d.initials}</span>}
            </div>

            <div class="doctor-info">
              <div class="doctor-spec-row">
                <span class="v3-eyebrow doctor-spec">{copy?.spec ?? d.spec}</span>
              </div>
              <h3 class="doctor-name"><em>{d.name}</em></h3>
              <p class="v3-body doctor-note" set:html={formatTypographyHtml(copy?.short ?? d.short)}></p>
              <div class="doctor-meta">
                <button type="button" class="v3-link doctor-cta" data-booking-open data-doctor={d.nameBtn}>
                  Записаться <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <footer class="doctors-footer" data-v3-reveal>
        <a href="/doctors" class="v3-link">Показать всех врачей →</a>
      </footer>
    </div>
  </div>
</section>

<script>
  function initDoctorsPreviewCTA() {
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-booking-open]');
    btns.forEach((b) => {
      if (b.dataset.bookingBound === '1') return;
      b.dataset.bookingBound = '1';
      b.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const doctor = b.getAttribute('data-doctor') ?? undefined;
        window.dispatchEvent(new CustomEvent('open-booking', { detail: { doctor } }));
      });
    });
  }

  if (document.readyState !== 'loading') initDoctorsPreviewCTA();
  else document.addEventListener('DOMContentLoaded', initDoctorsPreviewCTA);
  document.addEventListener('astro:page-load', initDoctorsPreviewCTA);
</script>

<style>
  .v3-doctors {
    display: flex;
    flex-direction: column;
  }

  .doctors-top {
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .doctors-header {
    display: flex;
    flex-direction: column;
    gap: var(--v3-gap-eyebrow-h1);
  }

  .doctors-proof {
    max-width: 48rem;
    margin: 0;
    color: var(--v3-ink-secondary);
  }

  .babayan-wrap {
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .babayan-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(18rem, 25rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding: clamp(1.5rem, 2vw, 2rem);
    border: 1px solid var(--v3-border-soft);
    border-radius: var(--v3-radius-xl);
    background: var(--v3-surface-card);
    box-shadow: var(--v3-shadow-sm);
    transition: transform var(--v3-duration-fast) var(--v3-ease-out), background var(--v3-duration-fast) var(--v3-ease-out);
  }

  .babayan-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    text-indent: -9999px;
    overflow: hidden;
  }

  .babayan-overlay:focus-visible {
    outline: 2px solid var(--v3-champagne);
    outline-offset: 4px;
  }

  .babayan-card:hover {
    transform: translateY(-2px);
    background: var(--v3-surface-muted);
  }

  .babayan-card:hover .babayan-name {
    color: var(--v3-champagne-deep);
  }

  .babayan-photo-column {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .babayan-photo {
    width: clamp(16rem, 24vw, 22rem);
    max-width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--v3-radius-xl);
    background: linear-gradient(180deg, var(--v3-surface-muted), var(--v3-sand));
    border: 1px solid var(--v3-border-soft);
    box-shadow: var(--v3-shadow-md);
  }

  .babayan-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transform: translate(var(--doctor-photo-x, 0%), var(--doctor-photo-y, -3%)) scale(var(--doctor-photo-scale, 1.12));
    transform-origin: center top;
  }

  .babayan-initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--v3-font-display);
    font-style: italic;
    font-size: clamp(5rem, 10vw, 9rem);
    color: rgba(251, 248, 244, 0.16);
    letter-spacing: 0.03em;
  }

  .babayan-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .babayan-name {
    margin: 0;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    line-height: 1.05;
    color: var(--v3-ink);
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }

  .babayan-spec {
    margin: 0;
    font-family: var(--v3-font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--v3-ink-secondary);
  }

  .babayan-accent {
    display: grid;
    grid-template-columns: 1.55rem minmax(0, 1fr);
    gap: 0.875rem;
    align-items: start;
    align-self: flex-start;
    margin: 0.5rem 0;
    padding: 1rem 1.25rem 1rem 1rem;
    background: transparent;
    border-left: 2px solid var(--v3-champagne);
  }

  .babayan-credential {
    margin: 0;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(1.25rem, 1.8vw, 1.75rem);
    line-height: 1.15;
    color: var(--v3-ink);
    max-width: 22ch;
  }

  .mibrar-credential {
    display: inline;
  }

  .mibrar-tooltip {
    position: relative;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    margin-left: 0.25rem;
    font-family: var(--v3-font-body);
    font-style: normal;
  }

  .mibrar-tooltip-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    border: 1px solid var(--v3-border-soft);
    border-radius: 999px;
    background: var(--v3-surface-card);
    color: var(--v3-ink-muted);
    font: 600 0.75rem/1 var(--v3-font-body);
    cursor: help;
    box-shadow: 0 8px 20px rgba(79, 70, 61, 0.08);
    transition:
      border-color var(--v3-duration-fast) var(--v3-ease-out),
      color var(--v3-duration-fast) var(--v3-ease-out),
      background var(--v3-duration-fast) var(--v3-ease-out);
  }

  .mibrar-tooltip-trigger:hover,
  .mibrar-tooltip-trigger:focus-visible {
    border-color: var(--v3-champagne);
    background: var(--v3-surface-muted);
    color: var(--v3-ink);
    outline: none;
  }

  .mibrar-tooltip-content {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.75rem);
    z-index: 20;
    width: min(20rem, calc(100vw - 3rem));
    padding: 0.875rem 1rem;
    border: 1px solid var(--v3-border-soft);
    border-radius: var(--v3-radius-md);
    background: var(--v3-surface-card);
    box-shadow: var(--v3-shadow-md);
    color: var(--v3-ink-secondary);
    font: 400 0.875rem/1.55 var(--v3-font-body);
    letter-spacing: 0;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.25rem);
    transition:
      opacity var(--v3-duration-fast) var(--v3-ease-out),
      transform var(--v3-duration-fast) var(--v3-ease-out);
  }

  .mibrar-tooltip-content::after {
    content: "";
    position: absolute;
    left: 50%;
    top: -0.4rem;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--v3-surface-card);
    border-left: 1px solid var(--v3-border-soft);
    border-top: 1px solid var(--v3-border-soft);
    transform: translateX(-50%) rotate(45deg);
  }

  .mibrar-tooltip:hover .mibrar-tooltip-content,
  .mibrar-tooltip:focus-within .mibrar-tooltip-content {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .babayan-body {
    margin: 0;
    max-width: 58ch;
    color: var(--v3-ink-secondary);
  }

  .babayan-actions {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid var(--v3-border-soft);
  }

  .babayan-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--v3-ink);
    text-decoration: none;
    font-family: var(--v3-font-body);
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }

  .babayan-link:hover {
    color: var(--v3-champagne-deep);
  }

  .rest-wrap {
    padding-top: clamp(0.25rem, 1.5vw, 1rem);
    padding-bottom: var(--v3-gap-deep);
  }

  .doctors-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .doctor {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--v3-border-hair);
    border-radius: var(--v3-radius-xl);
    background: var(--v3-surface-card);
    box-shadow: var(--v3-shadow-sm);
    transition: transform var(--v3-duration-fast) var(--v3-ease-out), background var(--v3-duration-fast) var(--v3-ease-out);
  }

  .doctor-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    text-indent: -9999px;
    overflow: hidden;
  }

  .doctor-overlay:focus-visible {
    outline: 2px solid var(--v3-champagne);
    outline-offset: 4px;
  }

  .doctor-image,
  .doctor-info > :not(.doctor-meta),
  .doctor-meta > :not(.doctor-cta) {
    pointer-events: none;
  }

  .doctor:hover .doctor-name {
    color: var(--v3-champagne-deep);
  }
  .doctor:hover {
    transform: translateY(-2px);
    background: var(--v3-surface-muted);
  }

  .doctor-image {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--v3-radius-lg);
    background: linear-gradient(180deg, var(--v3-surface-muted), var(--v3-sand));
    flex: 0 0 auto;
    border: 1px solid var(--v3-border-soft);
  }

  .doctor-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transform: translate(var(--doctor-photo-x, 0%), var(--doctor-photo-y, -3%)) scale(var(--doctor-photo-scale, 1.12));
    transform-origin: center top;
  }

  .doctor-initials {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--v3-font-display);
    font-style: italic;
    font-size: 3rem;
    color: var(--v3-ink-muted);
  }

  .doctor-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  .doctor-spec {
    color: var(--v3-ink-muted);
  }

  .doctor-spec-row {
    display: flex;
    align-items: center;
  }

  .doctor-name {
    margin: 0;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(1.1875rem, 1.35vw, 1.5rem);
    line-height: 1.15;
    color: var(--v3-ink);
    transition: color var(--v3-duration-fast) var(--v3-ease-out);
  }

  .doctor-note {
    margin: 0;
    color: var(--v3-ink-secondary);
    font-size: 0.9375rem;
  }

  .doctor-meta {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--v3-border-soft);
  }

  .doctor-cta {
    position: relative;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    background: transparent;
    border: 0;
    padding: 0.5rem 0;
    cursor: pointer;
    font: inherit;
    color: inherit;
    pointer-events: auto;
  }

  .doctors-footer {
    margin-top: var(--v3-gap-small);
    padding-top: 1.25rem;
    border-top: 1px solid var(--v3-border-soft);
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 1100px) {
    .babayan-card {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      max-width: 48rem;
      margin-inline: auto;
    }

    .babayan-photo {
      width: min(18rem, 100%);
      margin-inline: auto;
    }

    .babayan-main {
      gap: 0.875rem;
    }
  }

  @media (max-width: 1024px) {
    .doctors-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (max-width: 768px) {
    .babayan-photo {
      width: min(17rem, calc(100vw - 4rem));
    }
  }

  @media (max-width: 600px) {
    .doctors-grid {
      grid-template-columns: 1fr;
    }

    .babayan-accent {
      padding: 0.875rem 1rem;
    }
  }
</style>
