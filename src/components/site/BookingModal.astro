---
// Глобальная модалка записи. Открывается событием:
//   window.dispatchEvent(new CustomEvent('open-booking', { detail: { doctor?: 'slug', preset?: 'Тема', message?: 'Текст' } }))
// Подключена один раз в SiteLayout — доступна со всех страниц.

---

<div class="booking" data-booking hidden role="dialog" aria-modal="true" aria-labelledby="booking-title">
  <button type="button" class="booking-backdrop" aria-label="Закрыть" data-booking-close></button>

  <div class="booking-panel" role="document" data-lenis-prevent data-lenis-prevent-wheel data-lenis-prevent-touch>
    <button type="button" class="booking-close" aria-label="Закрыть" data-booking-close>
      <span aria-hidden="true">×</span>
    </button>

    <header class="booking-header">
      <span class="v3-eyebrow">Быстрая связь с клиникой</span>
      <h2 id="booking-title" class="v3-h3 booking-title">
        <em data-booking-title>Свяжемся и уточним удобное время</em>
      </h2>
      <p class="v3-body booking-lead" data-booking-lead>
        Оставьте телефон — администратор свяжется в рабочее время,
        сориентирует по консультации, стоимости и ближайшим вариантам записи.
      </p>
    </header>

    <form class="booking-form" data-booking-form>
      <input type="hidden" name="doctor" data-booking-doctor />

      <label class="field">
        <span class="field-label v3-eyebrow">Имя</span>
        <input
          type="text"
          name="name"
          required
          autocomplete="name"
          minlength="2"
          maxlength="60"
          pattern="[A-Za-zА-Яа-яЁё\\s\\-']{2,60}"
          placeholder="Как к вам обращаться"
        />
      </label>

      <label class="field">
        <span class="field-label v3-eyebrow">Телефон</span>
        <input
          type="tel"
          name="phone"
          required
          autocomplete="tel"
          inputmode="tel"
          maxlength="18"
          pattern="\\+7 \\([0-9]{3}\\) [0-9]{3}-[0-9]{2}-[0-9]{2}"
          placeholder="+7 (___) ___-__-__"
          data-phone-mask
        />
      </label>

      <label class="field">
        <span class="field-label v3-eyebrow">Сообщение (опционально)</span>
        <textarea
          name="message"
          rows="3"
          maxlength="700"
          placeholder="Что интересует, какие операции рассматриваете"
        ></textarea>
      </label>

      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span class="consent-text">
          Я согласен(а) на <a href="/consent" class="v3-link">обработку персональных данных</a>.
        </span>
      </label>

      <label class="consent">
        <input type="checkbox" name="legalConsent" required />
        <span class="consent-text">
          Я ознакомлен(а) с <a href="/privacy" class="v3-link">политикой конфиденциальности</a>
          и <a href="/terms" class="v3-link">пользовательским соглашением</a>.
        </span>
      </label>

      <button type="submit" class="v3-btn v3-btn-primary booking-submit">
        Отправить заявку <span aria-hidden="true">→</span>
      </button>
      <div class="booking-messengers" aria-label="Связаться в мессенджере">
        <a href="https://t.me/platinental_kazan" class="v3-link" target="_blank" rel="noopener noreferrer">Telegram</a>
        <span aria-hidden="true">·</span>
        <a href="https://max.ru/u/f9LHodD0cOKLXxHeIK067LNPbNjsqlGF8qj74HK5vOo0CfBOPaTkNZmUAXI" class="v3-link" target="_blank" rel="noopener noreferrer">Max</a>
        <span aria-hidden="true">·</span>
        <a href="https://wa.me/78432236666" class="v3-link" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    </form>

  </div>
</div>

<div class="lead-notice" data-lead-notice hidden role="dialog" aria-modal="true" aria-labelledby="lead-notice-title">
  <button type="button" class="lead-notice-backdrop" aria-label="Закрыть уведомление" data-lead-notice-close></button>
  <div class="lead-notice-panel" role="document">
    <button type="button" class="lead-notice-close" aria-label="Закрыть" data-lead-notice-close>
      <span aria-hidden="true">×</span>
    </button>
    <span class="v3-eyebrow" data-lead-notice-eyebrow>Заявка отправлена</span>
    <h2 id="lead-notice-title" class="lead-notice-title">Спасибо, мы получили обращение</h2>
    <p class="v3-body" data-lead-notice-text>
      Администратор свяжется в рабочее время. Если удобно написать самим, выберите мессенджер.
    </p>
    <p class="lead-notice-hours">Пн–Вс 9:00–20:00</p>
    <div class="lead-notice-links" aria-label="Мессенджеры клиники">
      <a href="https://t.me/platinental_kazan" class="v3-btn v3-btn-secondary" target="_blank" rel="noopener noreferrer">Telegram</a>
      <a href="https://max.ru/u/f9LHodD0cOKLXxHeIK067LNPbNjsqlGF8qj74HK5vOo0CfBOPaTkNZmUAXI" class="v3-btn v3-btn-secondary" target="_blank" rel="noopener noreferrer">Max</a>
      <a href="https://wa.me/78432236666" class="v3-btn v3-btn-secondary" target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </div>
</div>

<script>
  function initBooking() {
    const root = document.querySelector<HTMLElement>('[data-booking]');
    if (!root) return;
    if (root.dataset.bookingInitialized === '1') return;
    root.dataset.bookingInitialized = '1';

    const titleEl = root.querySelector<HTMLElement>('[data-booking-title]');
    const leadEl = root.querySelector<HTMLElement>('[data-booking-lead]');
    const panel = root.querySelector<HTMLElement>('.booking-panel');
    const nameInput = root.querySelector<HTMLInputElement>('input[name="name"]');
    const doctorInput = root.querySelector<HTMLInputElement>('[data-booking-doctor]');
    const form = root.querySelector<HTMLFormElement>('[data-booking-form]');
    const notice = document.querySelector<HTMLElement>('[data-lead-notice]');
    const noticeEyebrow = document.querySelector<HTMLElement>('[data-lead-notice-eyebrow]');
    const noticeText = document.querySelector<HTMLElement>('[data-lead-notice-text]');
    const messageInput = root.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    const defaultTitle = titleEl?.textContent ?? 'Свяжемся и уточним удобное время';
    const defaultLead = leadEl?.textContent?.replace(/\s+/g, ' ').trim() ??
      'Оставьте телефон — администратор свяжется в рабочее время, сориентирует по консультации, стоимости и ближайшим вариантам записи.';
    const defaultMessagePlaceholder = messageInput?.placeholder ?? '';

    let lastFocus: HTMLElement | null = null;

    const showForm = () => {
      if (form) form.hidden = false;
    };

    const openLeadNotice = (status: 'success' | 'fallback') => {
      if (noticeEyebrow) {
        noticeEyebrow.textContent = status === 'success' ? 'Заявка отправлена' : 'Свяжитесь с клиникой';
      }
      if (noticeText) {
        noticeText.textContent = status === 'success'
          ? 'Администратор свяжется в рабочее время. Если удобно написать самим, выберите мессенджер.'
          : 'Не удалось автоматически отправить заявку. Напишите нам в удобный мессенджер, и администратор ответит в рабочее время.';
      }
      if (notice) {
        notice.hidden = false;
        document.documentElement.classList.add('lead-notice-open');
        document.documentElement.style.overflow = 'hidden';
        window.requestAnimationFrame(() => {
          notice.querySelector<HTMLElement>('[data-lead-notice-close]')?.focus();
        });
      }
    };

    const closeLeadNotice = () => {
      if (!notice) return;
      notice.hidden = true;
      document.documentElement.classList.remove('lead-notice-open');
      if (root.hidden) document.documentElement.style.overflow = '';
      lastFocus?.focus?.();
    };

    async function sendTelegramLead(payload: Record<string, unknown>) {
      const isVercelHost = window.location.hostname.endsWith('vercel.app');
      if (!isVercelHost) {
        fetch('/api/telegram-lead.php?store=1', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).catch(() => {});
      }

      const endpoints = isVercelHost
        ? ['/api/telegram-lead', '/api/telegram-lead.php']
        : [
            'https://platinental-kazan.vercel.app/api/telegram-lead',
            '/api/telegram-lead',
            '/api/telegram-lead.php',
          ];

      for (const endpoint of endpoints) {
        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (response.ok) return;
        } catch {}
      }

      throw new Error('telegram_lead_failed');
    }

    const open = (detail?: {
      doctor?: string;
      preset?: string;
      message?: string;
      title?: string;
      lead?: string;
      messagePlaceholder?: string;
    }) => {
      lastFocus = document.activeElement as HTMLElement;
      showForm();
      if (titleEl) {
        titleEl.textContent = detail?.title
          ? detail.title
          : detail?.preset
          ? `Консультация по направлению «${detail.preset}»`
          : detail?.doctor
            ? `Подберём время ${detail.doctor}`
            : defaultTitle;
      }
      if (leadEl) leadEl.textContent = detail?.lead ?? defaultLead;
      if (doctorInput) doctorInput.value = detail?.doctor ?? '';
      if (messageInput) {
        messageInput.value = detail?.message ?? '';
        messageInput.placeholder = detail?.messagePlaceholder ?? defaultMessagePlaceholder;
      }
      root.hidden = false;
      document.documentElement.classList.add('booking-open');
      document.documentElement.style.overflow = 'hidden';
      if (panel) panel.scrollTop = 0;
      window.requestAnimationFrame(() => {
        if (nameInput) {
          nameInput.focus({ preventScroll: true });
          return;
        }
        root.querySelector<HTMLElement>('[data-booking-close]')?.focus();
      });
    };

    const close = () => {
      root.hidden = true;
      document.documentElement.classList.remove('booking-open');
      if (notice?.hidden !== false) document.documentElement.style.overflow = '';
      lastFocus?.focus();
    };

    window.addEventListener('lead-notice', (e) => {
      const status = ((e as CustomEvent).detail?.status ?? 'success') as 'success' | 'fallback';
      openLeadNotice(status);
    });

    window.addEventListener('open-booking', (e) => {
      const detail = (e as CustomEvent).detail;
      open(detail);
    });

    // Унифицируем CTA: любые ссылки на #form открывают модалку записи.
    document.querySelectorAll<HTMLAnchorElement>('a[href="#form"]').forEach((link) => {
      if (link.dataset.bookingBound === '1') return;
      link.dataset.bookingBound = '1';
      link.addEventListener('click', (e) => {
        e.preventDefault();
        open({
          title: link.dataset.bookingCustomTitle,
          lead: link.dataset.bookingCustomLead,
          message: link.dataset.bookingCustomMessage,
          messagePlaceholder: link.dataset.bookingCustomPlaceholder,
        });
      });
    });

    root.querySelectorAll<HTMLElement>('[data-booking-close]').forEach((b) => b.addEventListener('click', close));
    notice?.querySelectorAll<HTMLElement>('[data-lead-notice-close]').forEach((b) => b.addEventListener('click', closeLeadNotice));
    document.addEventListener('keydown', (e) => {
      if (!root.hidden && e.key === 'Escape') close();
      if (notice?.hidden === false && e.key === 'Escape') closeLeadNotice();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const formData = new FormData(form);
      const name = String(formData.get('name') ?? '').trim();
      const phone = String(formData.get('phone') ?? '').trim();
      const message = String(formData.get('message') ?? '').trim();
      const doctor = String(formData.get('doctor') ?? '').trim();
      const consent = Boolean(formData.get('consent'));
      const legalConsent = Boolean(formData.get('legalConsent'));
      window.platinentalReachGoal?.('form_submit_consultation', { form: 'booking_modal', doctor });
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Отправляем заявку...';
      }

      try {
        await sendTelegramLead({
          source: 'Запись на консультацию',
          name,
          phone,
          message,
          doctor,
          consent,
          legalConsent,
          page: `${window.location.pathname}${window.location.search}`,
        });
        form.reset();
        close();
        openLeadNotice('success');
      } catch (error) {
        console.error('Telegram lead submit failed', error);
        close();
        openLeadNotice('fallback');
      } finally {
        window.setTimeout(() => {
          if (submit) {
            submit.disabled = false;
            submit.innerHTML = 'Отправить заявку <span aria-hidden="true">→</span>';
          }
        }, 1600);
      }
    });
  }

  if (document.readyState !== 'loading') initBooking();
  else document.addEventListener('DOMContentLoaded', initBooking);
  document.addEventListener('astro:page-load', initBooking);
</script>

<style>
  .booking[hidden] { display: none; }
  .booking {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0.75rem;
  }
  .booking-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.55);
    border: 0;
    padding: 0;
    cursor: pointer;
    animation: bk-fade 240ms var(--v3-ease-out, ease-out);
  }
  @keyframes bk-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .booking-panel {
    position: relative;
    background: var(--v3-cream);
    width: 100%;
    max-width: 32rem;
    max-height: calc(100dvh - 1.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 -20px 60px rgba(10, 10, 10, 0.18);
    animation: bk-slide 320ms var(--v3-ease-out, ease-out);
  }
  @keyframes bk-slide {
    from { transform: translateY(40px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @media (min-width: 720px) {
    .booking { align-items: center; }
    .booking-panel {
      border-radius: 4px;
      animation-name: bk-pop;
    }
    @keyframes bk-pop {
      from { transform: scale(0.96); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
  }
  .booking-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--v3-ink-muted);
    font-size: 1.75rem;
    line-height: 1;
    transition: color var(--v3-duration-fast, 160ms) var(--v3-ease-out, ease-out);
  }
  .booking-close:hover { color: var(--v3-ink); }

  .booking-header {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 1.5rem;
    padding-right: 2rem;
  }
  .booking-title {
    margin: 0;
    font-family: var(--v3-font-display);
    font-style: normal;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    line-height: 1.2;
    color: var(--v3-ink);
  }
  .booking-title em { font-style: normal; }
  .booking-lead { color: var(--v3-ink-secondary); margin: 0; font-size: 0.9375rem; }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .field { display: flex; flex-direction: column; gap: 0.4rem; }
  .field-label { color: var(--v3-ink-muted); }
  .field input,
  .field textarea {
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--v3-border-soft, rgba(10, 10, 10, 0.16));
    padding: 0.75rem 0;
    min-height: 44px;
    color: var(--v3-ink);
    font-family: var(--v3-font-body);
    font-size: 16px;
    line-height: 1.4;
    transition: border-color var(--v3-duration-fast, 160ms) var(--v3-ease-out, ease-out);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--v3-champagne, #917271);
  }
  .field input::placeholder,
  .field textarea::placeholder { color: var(--v3-ink-muted); }
  .field textarea { resize: vertical; min-height: 4.5rem; }

  .consent {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    color: var(--v3-ink-secondary);
    font-size: 0.8125rem;
    line-height: 1.45;
    cursor: pointer;
  }
  .consent-text { padding-top: 0.0625rem; }
  .consent-text .v3-link {
    display: inline;
    min-height: 0;
    padding: 0 0 0.12em;
    line-height: inherit;
    vertical-align: baseline;
    background-position: 0 100%;
  }
  .consent-text .v3-link::after {
    bottom: 0;
  }
  .consent input {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin: 0;
    accent-color: var(--v3-champagne, #917271);
    cursor: pointer;
  }

  .booking-submit { align-self: stretch; margin-top: 0.25rem; }
  .booking-messengers {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: -0.25rem;
    color: var(--v3-ink-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .booking-messengers .v3-link {
    color: var(--v3-ink);
    border-color: color-mix(in srgb, var(--v3-ink) 45%, transparent);
  }

  .lead-notice[hidden] { display: none; }
  .lead-notice {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .lead-notice-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(10, 10, 10, 0.52);
    cursor: pointer;
    animation: bk-fade 180ms var(--v3-ease-out, ease-out);
  }
  .lead-notice-panel {
    position: relative;
    width: min(100%, 34rem);
    background: var(--v3-cream);
    border-radius: 6px;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    box-shadow: 0 24px 70px rgba(10, 10, 10, 0.22);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation: bk-pop 240ms var(--v3-ease-out, ease-out);
  }
  .lead-notice-close {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--v3-ink-muted);
    cursor: pointer;
    font-size: 1.75rem;
    line-height: 1;
  }
  .lead-notice-title {
    margin: 0;
    padding-right: 2rem;
    font-family: var(--v3-font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.08;
    font-weight: 400;
    color: var(--v3-ink);
  }
  .lead-notice p { margin: 0; }
  .lead-notice [data-lead-notice-text] {
    color: var(--v3-ink-secondary);
    max-width: 34rem;
  }
  .lead-notice-hours {
    color: var(--v3-ink-muted);
    font-size: 0.875rem;
  }
  .lead-notice-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .lead-notice-links .v3-btn {
    min-width: 0;
    justify-content: center;
    padding-inline: 0.875rem;
  }

  @media (max-width: 560px) {
    .booking {
      align-items: flex-start;
      padding: max(0.5rem, env(safe-area-inset-top)) 0.375rem 0.375rem;
    }
    .booking-panel {
      max-height: calc(100dvh - max(0.875rem, env(safe-area-inset-top)));
      border-radius: var(--v3-radius-lg);
      padding: 1rem 1.125rem max(1rem, env(safe-area-inset-bottom));
    }
    .booking-close {
      top: 0.375rem;
      right: 0.375rem;
    }
    .booking-header {
      gap: 0.4rem;
      margin-bottom: 0.875rem;
      padding-right: 1.75rem;
    }
    .booking-title {
      font-size: clamp(1.25rem, 6vw, 1.5rem);
      line-height: 1.12;
    }
    .booking-lead {
      font-size: 0.875rem;
      line-height: 1.45;
    }
    .booking-form {
      gap: 0.8rem;
    }
    .field {
      gap: 0.25rem;
    }
    .field input,
    .field textarea {
      min-height: 44px;
      padding: 0.625rem 0;
      line-height: 1.35;
    }
    .field textarea {
      min-height: 3.25rem;
    }
    .consent {
      gap: 0.5rem;
      font-size: 0.75rem;
      line-height: 1.42;
      min-height: 44px;
      padding-block: 0.25rem;
      align-items: flex-start;
    }
    .consent input {
      width: 24px;
      height: 24px;
      margin-top: 0.125rem;
    }
    .booking-submit {
      min-height: 48px;
      width: 100%;
      margin-top: 0.125rem;
    }
    .booking-messengers {
      font-size: 0.8125rem;
      margin-top: -0.125rem;
    }
    .lead-notice {
      align-items: flex-start;
      padding: max(0.75rem, env(safe-area-inset-top)) 0.75rem 0.75rem;
    }
    .lead-notice-panel {
      border-radius: var(--v3-radius-lg);
      padding: 1.25rem 1.125rem 1.375rem;
      gap: 0.875rem;
    }
    .lead-notice-title {
      font-size: clamp(1.75rem, 9vw, 2.375rem);
    }
    .lead-notice-links {
      grid-template-columns: 1fr;
    }
  }
</style>
