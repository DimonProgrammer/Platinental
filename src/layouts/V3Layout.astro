---
import '../styles/tokens-v3.css';
import { ClientRouter } from 'astro:transitions';
import BookingModal from '../components/v3/BookingModal.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Platinental Казань — клиника пластической хирургии и косметологии',
  description = 'Platinental Казань — клиника пластической хирургии и эстетической медицины. Авторские методики, гармонизирующий подход. С 2011 года в Казани.',
  canonical = 'https://kzn.platinental.ru/',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FFFEF2" />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Platinental Казань" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>

  <body>
    <div data-v3>
      <slot />

      <!-- Custom cursor — внутри [data-v3] чтобы CSS-переменные --v3-* каскадировались -->
      <div data-v3-cursor aria-hidden="true">
        <div class="v3-cursor-dot"></div>
        <div class="v3-cursor-ring"></div>
      </div>

      <BookingModal />
    </div>

    <script>
      import '../scripts/motion-stagger.ts';
      import '../scripts/motion-scroll.ts';
      import '../scripts/motion-cursor.ts';
      import '../scripts/motion-faq.ts';
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'ZapfHumnst BT';
    src: url('/fonts/ZapfHumnstBT-Roman.otf') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'ZapfHumnst BT';
    src: url('/fonts/ZapfHumnstBT-Bold.otf') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  html, body {
    margin: 0;
    padding: 0;
    background: #FFFEF2;
    overflow-x: hidden;
  }
  body { min-height: 100vh; }
  *, *::before, *::after { box-sizing: border-box; }
  img, picture, svg { display: block; max-width: 100%; }
</style>
