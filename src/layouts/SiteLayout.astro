---
import '../styles/tokens.css';
import { ClientRouter } from 'astro:transitions';
import BookingModal from '../components/site/BookingModal.astro';
import MobileStickyCTA from '../components/site/MobileStickyCTA.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
  includeClinicSchema?: boolean;
  jsonLd?: unknown | unknown[];
}

const {
  title = 'The Platinental Казань — клиника пластической хирургии и косметологии',
  description = 'The Platinental Казань — клиника пластической хирургии и эстетической медицины. Авторские методики, гармонизирующий подход. С 2011 года в Казани.',
  canonical,
  ogImage = '/quote/iskornev-portrait-2026.png',
  robots,
  includeClinicSchema = true,
  jsonLd: pageJsonLd,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://kzn.platinental.ru');
const canonicalUrl = canonical ? new URL(canonical, siteUrl).toString() : new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const isNotFound = Astro.url.pathname === '/404' || Astro.url.pathname === '/404/';
const robotsContent = robots ?? (isNotFound ? 'noindex, follow' : undefined);
const yandexCounterId = import.meta.env.PUBLIC_YANDEX_COUNTER_ID ?? import.meta.env.YANDEX_COUNTER_ID;
const clinicJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  '@id': new URL('/#clinic', siteUrl).toString(),
  name: 'The Platinental Казань',
  legalName: 'ООО «Платинентал Казань»',
  url: new URL('/', siteUrl).toString(),
  telephone: '+7 843 223-66-66',
  priceRange: '₽₽₽',
  medicalSpecialty: ['PlasticSurgery', 'Dermatology'],
  image: ogImageUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Карла Маркса, 48, корп. 1',
    addressLocality: 'Казань',
    postalCode: '420015',
    addressCountry: 'RU',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '09:00',
      closes: '20:00',
    },
  ],
};
const schemaItems = [
  includeClinicSchema ? clinicJsonLd : null,
  ...(Array.isArray(pageJsonLd) ? pageJsonLd : pageJsonLd ? [pageJsonLd] : []),
].filter(Boolean);
---

<!doctype html>
<html lang="ru" class="v3-motion-ready">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FBF8F4" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    {robotsContent && <meta name="robots" content={robotsContent} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="The Platinental Казань" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="The Platinental Казань" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {yandexCounterId && (
      <>
        <script is:inline define:vars={{ yandexCounterId }}>
          window.__PLATINENTAL_METRIKA_ID = Number(yandexCounterId);
          (function(m,e,t,r,i,k,a){
            m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a);
          })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
          ym(window.__PLATINENTAL_METRIKA_ID, 'init', {
            clickmap: true,
            trackLinks: true,
            accurateTrackBounce: true,
            webvisor: true,
          });
        </script>
        <noscript>
          <div>
            <img src={`https://mc.yandex.ru/watch/${yandexCounterId}`} style="position:absolute; left:-9999px;" alt="" />
          </div>
        </noscript>
      </>
    )}
    <script is:inline>
      window.platinentalReachGoal = function(goal, params) {
        try {
          var id = window.__PLATINENTAL_METRIKA_ID;
          if (!id || typeof window.ym !== 'function') return;
          window.ym(id, 'reachGoal', goal, params || {});
        } catch {}
      };
      (() => {
        try {
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduced) {
            document.documentElement.classList.remove('v3-motion-ready');
            return;
          }
          window.setTimeout(() => {
            if (!document.documentElement.classList.contains('v3-motion-bound')) {
              document.documentElement.classList.add('v3-motion-fallback');
            }
          }, 2500);
        } catch {
          document.documentElement.classList.add('v3-motion-fallback');
        }
      })();
    </script>
    <noscript>
      <style>
        .v3-motion-ready [data-v3] [data-v3-reveal],
        .v3-motion-ready [data-v3] [data-v3-stagger] > * {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    {schemaItems.map((item) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
    ))}
    <ClientRouter />
  </head>

  <body>
    <div data-v3>
      <slot />

      <MobileStickyCTA />
      <BookingModal />
    </div>

    <script>
      import '../scripts/motion-stagger.ts';
      import '../scripts/motion-scroll.ts';
      import '../scripts/motion-faq.ts';
      import '../scripts/motion-quote.ts';
      import '../scripts/form-guards.ts';
      import '../scripts/analytics-goals.ts';
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Formular';
    src: url('/fonts/Formular-Regular.otf') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Formular';
    src: url('/fonts/Formular-Medium.otf') format('opentype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Formular';
    src: url('/fonts/Formular-Bold.otf') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'ZapfHumnst BT';
    src: url('/fonts/ZapfHumnstBT-Roman.otf') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'ZapfHumnst BT';
    src: url('/fonts/ZapfHumnstBT-Bold.otf') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  html, body {
    margin: 0;
    padding: 0;
    background: #FBF8F4;
  }
  body {
    min-height: 100vh;
    overflow-x: hidden;
    padding-top: var(--v3-nav-h, 4rem);
  }
  *, *::before, *::after { box-sizing: border-box; }
  img, picture, svg { display: block; max-width: 100%; }
  a[x-apple-data-detectors],
  a[x-apple-data-detectors='true'],
  [x-apple-data-detectors] {
    color: inherit !important;
    font-family: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    line-height: inherit !important;
    text-decoration: none !important;
  }
</style>
